    :ARG1 (p / pay-01
        :ARG3 (m2 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :condition (i / increase-01
        :ARG1 (r / rate
            :mod (i3 / interest))
        :ARG2 (p2 / percentage-entity
            :value "half"))
    :rel (a / amr-unknown))

