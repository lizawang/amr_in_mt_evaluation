# ::edge	purchase-01	ARG1	ticket	p3	t	
# ::edge	board-01	ARG0	passenger	b3	p	
# ::edge	allow-01	ARG1	board-01	a2	b3	
# ::edge	board-01	ARG1	plane	b3	p2	
# ::edge	backpack.	mod	only	b	o	
# ::edge	board-01	manner	backpack.	b3	b	
(a2 / allow-01
    :ARG0 (a / airline
        :name (n / name
            :op1 "Wizz"
            :op2 "Air"))
    :ARG1 (b3 / board-01
        :ARG0 (p / passenger
            :ARG0-of (p3 / purchase-01
                :ARG1 (t / ticket
                    :mod (b2 / basic))))
        :ARG1 (p2 / plane)
        :manner (b / backpack.
            :mod (o / only))))

