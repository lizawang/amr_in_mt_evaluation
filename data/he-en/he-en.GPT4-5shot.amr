# ::node	p	person	1-2
# ::node	f	foreign	1-2
# ::node	s	say-01	2-3
# ::node	g	government-organization	5-6
# ::node	n	name	5-6
# ::node	4	Ministry	5-6
# ::node	5	of	6-7
# ::node	2	Health's	7-8
# ::node	1	-	10-11
# ::node	a	allow-01	12-13
# ::node	e	enter-01	14-15
# ::node	c	country	15-16
# ::node	n2	name	15-16
# ::node	3	Israel.	15-16
# ::root	a	allow-01
# ::edge	person	mod	foreign	p	f	
# ::edge	foreign	polarity	-	f	0	
# ::edge	government-organization	name	name	g	n	
# ::edge	name	op1	Ministry	n	4	
# ::edge	name	op2	of	n	5	
# ::edge	name	op3	Health's	n	2	
# ::edge	allow-01	polarity	-	a	1	
# ::edge	allow-01	ARG1-of	say-01	a	s	
# ::edge	allow-01	ARG1	enter-01	a	e	
# ::edge	enter-01	ARG0	person	e	p	
# ::edge	enter-01	ARG1	country	e	c	
# ::edge	country	name	name	c	n2	
# ::edge	name	op1	Israel.	n2	3	
# ::edge	allow-01	rel	government-organization	a	g	
(a / allow-01
    :ARG1 (e / enter-01
        :ARG0 (p / person
            :mod (f / foreign
                :polarity -))
        :ARG1 (c / country
            :name (n2 / name
                :op1 "Israel.")))
    :ARG1-of (s / say-01)
    :polarity -
    :rel (g / government-organization
        :name (n / name
            :op1 "Ministry"
            :op2 "of"
            :op3 "Health's")))

# ::tok Foreigners from red countries, except those whose entry has been approved by the Exceptions Committee, will not be allowed to enter Israel.
# ::node	p	person	0-1
# ::node	f	foreign	0-1
# ::node	p2	person	0-1
# ::node	r	red-02	2-3
# ::node	e4	except-01	4-5
