(a / allow-01
    :ARG0 (t / they)
    :ARG1 (b2 / bring-01
        :ARG0 t
        :ARG1 (b / bag
            :mod (s3 / small)
            :mod (s2 / size,
                :mod (v / value-interval
                    :op1 30
                    :op2 40))))
    :condition (p / possible-01
        :ARG1 (f / fit-01
            :ARG1 b
            :ARG2 (u / under
                :op1 (s / seat.))))
    :location (c / company
        :name (n / name
            :op1 "EasyJet")))

