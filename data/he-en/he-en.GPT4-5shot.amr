# ::edge	stage.	mod	this	s	t	
# ::edge	renew-01	time	stage.	r	s	
(r / renew-01
    :ARG1 (p / plan
        :mod (g / group's))
    :polarity -
    :time (s / stage.
        :mod (t / this)))

# ::tok And what about red countries?
