(c / contrast-01
    :ARG1 (p / pay-01
        :ARG0 (y / you)
        :ARG1 (r / rate-entity-91
            :ARG1 (m2 / monetary-quantity
                :quant 40
                :unit (d3 / dollar))
            :ARG2 (p2 / person)
            :ARG2 (d / direction))
        :time (o2 / order-02
            :ARG0 y
            :ARG1 (s / suitcase
                :ARG1-of (w2 / weigh-01
                    :ARG2 (u / up-to
                        :op1 (m / mass-quantity
                            :quant 40
                            :unit (d2 / dollar)))))))
    :ARG2 (c2 / cost-01
        :ARG1 y
        :ARG2 (m3 / monetary-quantity
            :quant 80
            :unit (d4 / dollar))
        :location (a / airport))
    :condition (w / want-01
        :ARG0 y
        :ARG1 (o / order-02
            :ARG0 y
            :ARG1 s)))

