    :op1 (l2 / level
        :ARG1-of (h / have-degree-91
            :ARG2 (h3 / high-02
                :ARG1 l2)
            :ARG3 (m2 / most))
        :domain (t / this))
    :op2 (m / mean-01
        :ARG1 l2
        :ARG1 (a3 / and
            :op1 (t4 / travel-01
                :ARG0 (y / you)
                :ARG1 (c / country
                    :mod (t2 / this))
                :mode imperative
                :polarity -)
            :op2 (l / leave-11
