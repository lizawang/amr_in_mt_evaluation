# ::node	0	-	15-16
# ::node	b	buy-01	16-17
# ::node	e	even	17-18
# ::node	1	10	19-20
# ::node	m3	monetary-quantity	20-21
# ::node	t	they	21-22
# ::node	c	constant	23-24
# ::node	s	scam-01	24-25
# ::root	s	scam-01
# ::edge	man	mod	religious	m	r	
# ::edge	man	mod	deceitful	m	d	
# ::edge	and	op1	man	a	m	
# ::edge	man	ARG0-of	rule-03	m	r2	
# ::edge	rule-03	ARG1	society	r2	s2	
# ::edge	buy-01	polarity	-	b	0	
# ::edge	buy-01	ARG0	i	b	i	
# ::edge	buy-01	mod	even	b	e	
# ::edge	monetary-quantity	quant	10	m3	1	
# ::edge	buy-01	ARG3	monetary-quantity	b	m3	
# ::edge	scam-01	frequency	constant	s	c	
# ::edge	scam-01	ARG0	they	s	t	
# ::edge	scam-01	condition	buy-01	s	b	
# ::edge	scam-01	rel	and	s	a	
# ::edge	scam-01	rel	mess-up-02	s	m2	
(s / scam-01
    :ARG0 (t / they)
    :condition (b / buy-01
        :ARG0 (i / i)
        :ARG3 (m3 / monetary-quantity
            :quant 10)
        :mod (e / even)
        :polarity -)
    :frequency (c / constant)
    :rel (a / and
        :op1 (m / man
            :ARG0-of (r2 / rule-03
                :ARG1 (s2 / society))
            :mod (r / religious)
            :mod (d / deceitful)))
    :rel (m2 / mess-up-02))

# ::tok And then the company will cancel the flights and offer vouchers that will be worthless.
# ::node	a	and	0-1
# ::node	t	then	1-2
# ::node	c2	company	3-4
# ::node	c	cancel-01	5-6
# ::node	f	fly-01	7-8
# ::node	a2	and	8-9
# ::node	o	offer-01	9-10
# ::node	v	voucher	10-11
# ::node	0	-	13-14
# ::node	w	worth-01	14-15
# ::root	a	and
# ::edge	and	time	then	a	t	
# ::edge	cancel-01	ARG0	company	c	c2	
# ::edge	cancel-01	ARG1	fly-01	c	f	
# ::edge	and	op1	cancel-01	a2	c	
# ::edge	and	op2	and	a	a2	
# ::edge	and	op2	offer-01	a2	o	
# ::edge	offer-01	ARG0	company	o	c2	
# ::edge	offer-01	ARG1	voucher	o	v	
# ::edge	worth-01	polarity	-	w	0	
# ::edge	voucher	ARG1-of	worth-01	v	w	
(a / and
    :op2 (a2 / and
        :op1 (c / cancel-01
            :ARG0 (c2 / company)
            :ARG1 (f / fly-01))
        :op2 (o / offer-01
            :ARG0 c2
            :ARG1 (v / voucher
                :ARG1-of (w / worth-01
                    :polarity -))))
    :time (t / then))

# ::tok Because their implementation will be with an additional price change.
# ::node	c	cause-01	0-1
# ::node	t	they	1-2
# ::node	i	implement-01	2-3
# ::node	a	add-02	7-8
# ::node	m	monetary-quantity	8-9
# ::node	p	price-01	8-9
# ::node	c2	change-01	9-10
# ::root	c	cause-01
# ::edge	implement-01	ARG1	they	i	t	
# ::edge	cause-01	ARG0	implement-01	c	i	
# ::edge	monetary-quantity	ARG1-of	add-02	m	a	
# ::edge	monetary-quantity	ARG2-of	price-01	m	p	
# ::edge	change-01	ARG1	monetary-quantity	c2	m	
# ::edge	implement-01	accompanier	change-01	i	c2	
(c / cause-01
    :ARG0 (i / implement-01
        :ARG1 (t / they)
        :accompanier (c2 / change-01
            :ARG1 (m / monetary-quantity
                :ARG1-of (a / add-02)
                :ARG2-of (p / price-01)))))

# ::tok Whoever purchases tickets from El Al puts their money on the wing of the plane.
# ::node	p	person	0-1
# ::node	a	any	0-1
# ::node	p3	purchase-01	1-2
# ::node	t	ticket	2-3
# ::node	c	company	4-5
# ::node	n	name	4-5
# ::node	1	El	4-5
# ::node	0	Al	5-6
# ::node	p4	put-01	6-7
# ::node	m	money	8-9
# ::node	w	wing	11-12
# ::node	p2	plane.	14-15
# ::root	p4	put-01
# ::edge	person	mod	any	p	a	
# ::edge	person	ARG0-of	purchase-01	p	p3	
# ::edge	purchase-01	ARG1	ticket	p3	t	
# ::edge	purchase-01	ARG2	company	p3	c	
# ::edge	company	name	name	c	n	
# ::edge	name	op1	El	n	1	
# ::edge	name	op2	Al	n	0	
# ::edge	put-01	ARG0	person	p4	p	
# ::edge	put-01	ARG1	money	p4	m	
# ::edge	money	poss	person	m	p	
# ::edge	put-01	ARG2	wing	p4	w	
# ::edge	wing	part-of	plane.	w	p2	
(p4 / put-01
    :ARG0 (p / person
        :ARG0-of (p3 / purchase-01
            :ARG1 (t / ticket)
            :ARG2 (c / company
                :name (n / name
                    :op1 "El"
                    :op2 "Al")))
        :mod (a / any))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing
        :part-of (p2 / plane.)))

