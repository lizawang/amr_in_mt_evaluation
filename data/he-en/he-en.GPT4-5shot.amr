# ::node	a	and	8-9
# ::node	f	food.	10-11
# ::root	a	and
# ::edge	suitcase	polarity	-	s2	1	
# ::edge	tax-01	polarity	-	t	2	
# ::edge	and	op1	tax-01	a	t	
# ::edge	and	mod	certain	a	c	
# ::edge	suitcase	prep-without	and	s2	a	
# ::edge	and	op2	food.	a	f	
# ::edge	and	rel	suitcase	a	s2	
# ::edge	and	rel	-	a	0	
# ::edge	and	rel	seat	a	s	
(a / and
    :mod (c / certain)
    :op1 (t / tax-01
        :polarity -)
    :op2 (f / food.)
    :rel (s2 / suitcase
        :polarity -
        :prep-without a)
    :rel -
    :rel (s / seat))

