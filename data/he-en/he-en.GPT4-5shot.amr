# ::node	a2	approve-01	10-11
# ::node	2	Exceptions	13-14
# ::node	g	government-organization	14-15
# ::node	n	name	14-15
# ::node	1	Committee,	14-15
# ::node	0	-	16-17
# ::node	a	allow-01	18-19
# ::node	e3	enter-01	20-21
# ::node	c	country	21-22
# ::node	n2	name	21-22
# ::node	3	Israel.	21-22
# ::root	a	allow-01
# ::edge	person	mod	foreign	p	f	
# ::edge	except-01	ARG1	person	e4	p2	
# ::edge	person	ARG2-of	except-01	p	e4	
# ::edge	person	ARG0-of	enter-01	p2	e	
# ::edge	person	ARG0-of	enter-01	p2	e2	
# ::edge	enter-01	ARG1-of	approve-01	e2	a2	
# ::edge	approve-01	ARG0	government-organization	a2	g	
# ::edge	government-organization	name	name	g	n	
# ::edge	name	op1	Exceptions	n	2	
# ::edge	name	op2	Committee,	n	1	
# ::edge	allow-01	polarity	-	a	0	
# ::edge	allow-01	ARG1	enter-01	a	e3	
# ::edge	enter-01	ARG0	person	e3	p	
# ::edge	enter-01	ARG1	country	e3	c	
# ::edge	country	name	name	c	n2	
# ::edge	name	op1	Israel.	n2	3	
# ::edge	allow-01	rel	red-02	a	r	
(a / allow-01
    :ARG1 (e3 / enter-01
        :ARG0 (p / person
            :ARG2-of (e4 / except-01
                :ARG1 (p2 / person
                    :ARG0-of (e / enter-01)
                    :ARG0-of (e2 / enter-01
                        :ARG1-of (a2 / approve-01
                            :ARG0 (g / government-organization
                                :name (n / name
                                    :op1 "Exceptions"
                                    :op2 "Committee,"))))))
            :mod (f / foreign))
        :ARG1 (c / country
            :name (n2 / name
                :op1 "Israel.")))
    :polarity -
    :rel (r / red-02))

# ::tok The group's plan will not be renewed at this stage.
# ::node	g	group's	1-2
# ::node	p	plan	2-3
