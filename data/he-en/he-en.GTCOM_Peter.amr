# ::node	4	well	13-14
# ::node	3	nation	13-14
# ::node	a3	assume-02	15-16
# ::node	i2	increase-01	21-22
# ::node	a2	another	23-24
# ::node	p2	percentage-entity	24-25
# ::node	1	0.5%	24-25
# ::node	n2	next	25-26
# ::node	m	month.	26-27
# ::root	c	complete-01
# ::edge	route	mod	prime	r	p3	
# ::edge	route	location	percentage-entity	r	p	
# ::edge	percentage-entity	value	(40%	p	0	
# ::edge	complete-01	ARG0	route	c	r	
# ::edge	complete-01	ARG1	increase-01	c	i	
# ::edge	increase-01	ARG2	about	i	a	
# ::edge	about	op1	product	a	p4	
# ::edge	product	name	name	p4	n	
# ::edge	name	op1	intercontinental	n	2	
# ::edge	name	op2	well	n	4	
# ::edge	name	op3	nation	n	3	
# ::edge	complete-01	condition	assume-02	c	a3	
# ::edge	assume-02	ARG1	increase-01	a3	i2	
# ::edge	percentage-entity	mod	another	p2	a2	
# ::edge	increase-01	ARG2	percentage-entity	i2	p2	
# ::edge	percentage-entity	value	0.5%	p2	1	
# ::edge	month.	mod	next	m	n2	
# ::edge	increase-01	time	month.	i2	m	
(c / complete-01
    :ARG0 (r / route
        :location (p / percentage-entity
            :value "(40%")
        :mod (p3 / prime))
    :ARG1 (i / increase-01
        :ARG2 (a / about
            :op1 (p4 / product
                :name (n / name
                    :op1 "intercontinental"
                    :op2 "well"
                    :op3 "nation"))))
    :condition (a3 / assume-02
        :ARG1 (i2 / increase-01
            :ARG2 (p2 / percentage-entity
                :mod (a2 / another)
                :value 0.5%)
            :time (m / month.
                :mod (n2 / next)))))

