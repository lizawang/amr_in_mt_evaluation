# ::edge	monetary-quantity	unit	renminbi	m2	r3	
# ::edge	monetary-quantity	quant	125.	m2	1	
(i / increase-01
    :ARG1 (r4 / repay-01
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m3 / month))))
    :ARG2 (m2 / monetary-quantity
        :quant 125.
        :unit (p2 / pound)
        :unit (r3 / renminbi))
    :manner (m4 / mortgage-01
        :ARG1 (m / monetary-quantity)
        :ARG1-of (c / consist-01
            :ARG2 (t2 / track,
                :mod (r / rate
                    :quant (p / percentage-entity
                        :value 40%)
                    :mod (i2 / interest
                        :mod (p3 / prime)))))))

