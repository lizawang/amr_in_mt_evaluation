        :mod (a / also))
    :ARG1 (t / this)
    :rel (t2 / track
        :ARG0-of (m / make-up-07
            :ARG1 (m2 / mortgage-01))
        :mod (o / other)))

# ::tok If the interest rate does rise by half a percent, the increase in price will amount, according to Zror's estimate, to about NIS 620 on a mortgage of about NIS 1.2 million.
# ::node	i2	interest	2-3
# ::node	r	rate	3-4
# ::node	r2	rise-01	5-6
