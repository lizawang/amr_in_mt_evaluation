# ::node	p2	pound	22-23
# ::node	r3	renminbi	22-23
# ::node	1	125.	23-24
# ::root	i	increase-01
# ::edge	mortgage-01	ARG1	monetary-quantity	m4	m	
# ::edge	mortgage-01	ARG1-of	consist-01	m4	c	
# ::edge	percentage-entity	value	40%	p	2	
# ::edge	interest	mod	prime	i2	p3	
# ::edge	rate	mod	interest	r	i2	
# ::edge	rate	quant	percentage-entity	r	p	
# ::edge	track,	mod	rate	t2	r	
# ::edge	consist-01	ARG2	track,	c	t2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m3	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	repay-01	frequency	rate-entity-91	r4	r2	
# ::edge	increase-01	ARG1	repay-01	i	r4	
# ::edge	increase-01	manner	mortgage-01	i	m4	
