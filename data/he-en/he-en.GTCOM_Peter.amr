(i / include-01
    :ARG1 (h / handbag
        :ARG0-of (e / exceed-01
            :ARG1 (b2 / between
                :op1 (d / distance-quantity
                    :quant 55
                    :op2 20)
                :op2 (t / temporal-quantity
                    :quant 40))
            :polarity -)
        :ARG1-of (w / weigh-01
            :ARG2 (u / up-to
                :op1 (m / mass-quantity
                    :quant 7
                    :unit (k / kilogram)))))
    :ARG2 (t2 / thing
