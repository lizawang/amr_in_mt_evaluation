    :ARG1 (a / add-02
        :ARG0 (y / you)
        :ARG1 (b / baggage,)
        :manner (a2 / and
            :op1 (o / online)
            :op2 (i / in-advance-04
                :ARG1 a)))
    :ARG2 y
    :condition y
    :rel (w / want-01
        :ARG0 y
        :ARG1 a))

