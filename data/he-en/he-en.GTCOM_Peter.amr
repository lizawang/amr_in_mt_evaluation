# ::tok If the interest rate rises by half a percent - how much will the monthly payment on the mortgage cost?
# ::node	i	interest	2-3
# ::node	r	rate	3-4
# ::node	r3	rise-01	4-5
# ::node	h	half	6-7
# ::node	p2	percentage-entity	8-9
# ::node	a	amr-unknown	10-11
# ::node	r2	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	m2	month	14-15
# ::node	0	1	14-15
# ::node	p	pay-01	15-16
# ::node	m3	mortgage-01	18-19
# ::node	m	monetary-quantity	19-20
# ::node	c	cost-01	19-20
# ::root	p	pay-01
