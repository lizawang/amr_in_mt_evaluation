# ::tok The index is updated once a year and weighs four different ratings in each local authority: Business satisfaction, accessibility to tenders, accessibility of information and property taxes.
# ::node	i	index	1-2
# ::node	u	update-01	3-4
# ::node	r2	rate-entity-91	4-5
# ::node	0	1	4-5
# ::node	t3	temporal-quantity	6-7
# ::node	y	year	6-7
# ::node	a4	and	7-8
# ::node	w	weigh-01	8-9
# ::node	1	4	9-10
# ::node	d	differ-02	10-11
# ::node	r	rate-01	11-12
# ::node	e	each	13-14
# ::node	l	local-02	14-15
# ::node	a6	authority:	15-16
# ::node	b	business	16-17
# ::node	s	satisfy-01	17-18
# ::node	a	access-01	18-19
# ::node	c	company	20-21
# ::node	t	tax-01	20-21
# ::node	a2	access-01	21-22
# ::node	a3	access-01	21-22
# ::node	i2	information	23-24
# ::node	a5	and	24-25
# ::node	p	property	25-26
# ::node	t2	tax-01	26-27
# ::root	a4	and
# ::edge	update-01	ARG1	index	u	i	
# ::edge	update-01	frequency	rate-entity-91	u	r2	
# ::edge	temporal-quantity	quant	1	t3	0	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t3	
# ::edge	temporal-quantity	unit	year	t3	y	
# ::edge	and	op1	update-01	a4	u	
# ::edge	and	op2	weigh-01	a4	w	
# ::edge	weigh-01	ARG1	index	w	i	
# ::edge	rate-01	ARG1-of	differ-02	r	d	
# ::edge	rate-01	quant	4	r	1	
# ::edge	weigh-01	ARG3	rate-01	w	r	
# ::edge	authority:	ARG1-of	local-02	a6	l	
# ::edge	authority:	mod	each	a6	e	
# ::edge	rate-01	ARG0	authority:	r	a6	
# ::edge	satisfy-01	ARG1	business	s	b	
# ::edge	access-01	ARG0	company	a	c	
# ::edge	company	ARG0-of	tax-01	c	t	
# ::edge	access-01	ARG1	information	a2	i2	
# ::edge	and	op3	access-01	a5	a3	
# ::edge	and	op2	access-01	a5	a	
# ::edge	and	op1	satisfy-01	a5	s	
# ::edge	rate-01	ARG1	and	r	a5	
# ::edge	tax-01	ARG3	property	t2	p	
# ::edge	access-01	ARG1	tax-01	a3	t2	
# ::edge	and	rel	access-01	a4	a2	
(a4 / and
    :op1 (u / update-01
        :ARG1 (i / index)
        :frequency (r2 / rate-entity-91
            :ARG3 (t3 / temporal-quantity
                :quant 1
                :unit (y / year))))
    :op2 (w / weigh-01
        :ARG1 i
        :ARG3 (r / rate-01
            :quant 4
            :ARG0 (a6 / "authority:"
                :ARG1-of (l / local-02)
                :mod (e / each))
            :ARG1 (a5 / and
                :op1 (s / satisfy-01
                    :ARG1 (b / business))
                :op2 (a / access-01
                    :ARG0 (c / company
                        :ARG0-of (t / tax-01)))
                :op3 (a3 / access-01
                    :ARG1 (t2 / tax-01
                        :ARG3 (p / property))))
            :ARG1-of (d / differ-02)))
    :rel (a2 / access-01
        :ARG1 (i2 / information)))

# ::tok The ranking shows that Ramat Gan dropped from second to eighth place, Bat Yam dropped from fourth to 12th place and Netanya dropped from fifth to 13th place.
# ::node	r	rank-01	1-2
# ::node	s	show-01	2-3
