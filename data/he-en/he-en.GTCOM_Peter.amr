(c / cost-01
    :ARG1 (s / suitcase
        :ARG1-of (w / weigh-01
            :ARG3 (u / up-to
                :op1 (m / mass-quantity
                    :quant 20
                    :unit (k / kilogram)))))
    :ARG2 (r / rate-entity-91
        :ARG1 (m2 / monetary-quantity
            :quant 40
            :unit (d2 / dollar))
        :ARG2 (d / direction))
    :condition (o / order-02
        :ARG1 s))

