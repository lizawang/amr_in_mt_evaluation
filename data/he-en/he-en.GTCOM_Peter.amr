# ::edge	level	degree-of	friendly-01	l	f	
# ::edge	friendly-01	ARG1	authority	f	a2	
# ::edge	test-01	location	authority	t	a2	
# ::edge	friendly-01	ARG2	business	f	b2	
# ::edge	business	location	area.	b2	a	
# ::edge	area.	poss	authority	a	a2	
# ::edge	base-02	rel	each	b	e	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (e2 / examine-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG1 (a2 / authority)
                    :ARG2 (b2 / business
                        :location (a / area.
                            :poss a2)))))
        :ARG1-of (t / test-01
            :location a2))
    :rel (e / each))

# ::tok The index divides the authorities into three size groups according to the number of residents, since a local authority of up to 50,000 residents is not comparable to a local authority of more than 150,000 residents.
