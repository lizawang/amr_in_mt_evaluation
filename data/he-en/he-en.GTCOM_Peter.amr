# ::edge	rise-01	ARG1	rate	r3	r	
# ::edge	percentage-entity	quant	half	p2	h	
# ::edge	rise-01	ARG2	percentage-entity	r3	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m2	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	pay-01	ARG3	amr-unknown	p	a	
# ::edge	pay-01	condition	rise-01	p	r3	
# ::edge	pay-01	ARG1	monetary-quantity	p	m	
# ::edge	monetary-quantity	ARG2-of	cost-01	m	c	
# ::edge	cost-01	ARG1	mortgage-01	c	m3	
(p / pay-01
    :ARG1 (m / monetary-quantity
        :ARG2-of (c / cost-01
            :ARG1 (m3 / mortgage-01)))
    :ARG3 (a / amr-unknown)
    :condition (r3 / rise-01
        :ARG1 (r / rate
            :mod (i / interest))
        :ARG2 (p2 / percentage-entity
            :quant (h / half)))
    :frequency (r2 / rate-entity-91
        :ARG3 (t / temporal-quantity
            :quant 1
            :unit (m2 / month))))

# ::tok On a mortgage of NIS 1.2 million, which consists of a 40% prime interest rate track, the monthly repayment will increase by NIS 125.
# ::node	m4	mortgage-01	2-3
