(d / divide-02
    :ARG0 (i / index)
    :ARG1 (a / authority)
    :ARG1-of (s / say-01
        :ARG0 (n / number))
    :ARG1-of (c / cause-01
        :ARG0 (c2 / comparable-03
            :ARG1 (a2 / authority
                :ARG1-of (l / local-02
                    :ARG1 (a3 / authority
                        :consist-of (p2 / person
                            :quant (m / more-than
                                :op1 150000)
                            :ARG0-of (r3 / reside-01))))
                :consist-of (p / person
                    :quant (u / up-to
                        :op1 50000)
                    :ARG0-of (r2 / reside-01)))
            :ARG2 a3
            :polarity -))
    :ARG2 (g / group
        :mod (s2 / size
            :quant 3))
    :rel (r / reside-01))

