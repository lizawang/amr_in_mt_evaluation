# ::node	t	thing	2-3
# ::node	a2	answer-01	2-3
# ::root	t	thing
# ::edge	thing	mod	all	t	a	
# ::edge	thing	ARG2-of	answer-01	t	a2	
(t / thing
    :ARG2-of (a2 / answer-01)
    :mod (a / all))

# ::tok The worsening inflation in Israel, which has already reached a rate of more than 4% over the past year, will force the Bank of Israel to raise the interest rate on the shekel as early as next week.
# ::node	w2	worsen-01	1-2
# ::node	i	inflation	2-3
# ::node	a	already	7-8
# ::node	r3	reach-01	8-9
# ::node	m	more-than	12-13
# ::node	p	percentage-entity	14-15
# ::node	0	4%	14-15
# ::node	b	before	17-18
# ::node	f	force-01	20-21
# ::node	c	company	22-23
# ::node	n	name	22-23
# ::node	1	Bank	22-23
# ::node	3	of	23-24
# ::node	2	Israel	24-25
# ::node	r	raise-01	26-27
# ::node	i2	interest	28-29
# ::node	r2	rate	29-30
# ::node	s	shekel	32-33
# ::node	e	early	34-35
# ::node	n2	next	36-37
# ::node	w	week.	37-38
# ::root	f	force-01
# ::edge	inflation	ARG1-of	worsen-01	i	w2	
# ::edge	reach-01	time	already	r3	a	
# ::edge	inflation	ARG0-of	reach-01	i	r3	
# ::edge	reach-01	ARG1	more-than	r3	m	
# ::edge	more-than	op1	percentage-entity	m	p	
# ::edge	percentage-entity	value	4%	p	0	
# ::edge	reach-01	time	before	r3	b	
# ::edge	force-01	ARG0	inflation	f	i	
# ::edge	force-01	ARG1	company	f	c	
# ::edge	company	name	name	c	n	
# ::edge	name	op1	Bank	n	1	
# ::edge	name	op2	of	n	3	
# ::edge	name	op3	Israel	n	2	
# ::edge	raise-01	ARG0	company	r	c	
# ::edge	force-01	ARG2	raise-01	f	r	
# ::edge	rate	mod	interest	r2	i2	
# ::edge	raise-01	ARG1	rate	r	r2	
# ::edge	interest	prep-on	shekel	i2	s	
# ::edge	week.	mod	next	w	n2	
# ::edge	week.	mod	early	w	e	
# ::edge	raise-01	time	week.	r	w	
(f / force-01
    :ARG0 (i / inflation
        :ARG0-of (r3 / reach-01
            :ARG1 (m / more-than
                :op1 (p / percentage-entity
                    :value 4%))
            :time (a / already)
            :time (b / before))
        :ARG1-of (w2 / worsen-01))
    :ARG1 (c / company
        :name (n / name
            :op1 "Bank"
            :op2 "of"
            :op3 "Israel"))
    :ARG2 (r / raise-01
        :ARG0 c
        :ARG1 (r2 / rate
            :mod (i2 / interest
                :prep-on (s / shekel)))
        :time (w / week.
            :mod (n2 / next)
            :mod (e / early))))

# ::tok Analysts' estimates speak of a rate of increase ranging from 0.25% to 0.5%.
# ::node	p3	person	0-1
# ::node	e	estimate-01	1-2
# ::node	s	speak-01	2-3
# ::node	r2	rate	5-6
# ::node	i	increase-01	7-8
# ::node	r	range-01	8-9
# ::node	p	percentage-entity	10-11
# ::node	p2	percentage-entity	10-11
# ::node	0	0.25%	10-11
# ::node	1	0.5%.	12-13
# ::root	s	speak-01
# ::edge	estimate-01	ARG0	person	e	p3	
# ::edge	speak-01	ARG0	estimate-01	s	e	
# ::edge	speak-01	ARG1	rate	s	r2	
# ::edge	rate	mod	increase-01	r2	i	
# ::edge	increase-01	ARG1-of	range-01	i	r	
# ::edge	range-01	ARG3	percentage-entity	r	p	
# ::edge	range-01	ARG4	percentage-entity	r	p2	
# ::edge	percentage-entity	value	0.25%	p	0	
# ::edge	percentage-entity	value	0.5%.	p2	1	
(s / speak-01
    :ARG0 (e / estimate-01
        :ARG0 (p3 / person))
    :ARG1 (r2 / rate
        :mod (i / increase-01
            :ARG1-of (r / range-01
                :ARG3 (p / percentage-entity
                    :value 0.25%)
                :ARG4 (p2 / percentage-entity
                    :value 0.5%.)))))

# ::tok If the interest rate does rise by half a percentage point, it will already be 1.25%, the highest level in nine years.
# ::node	i	interest	2-3
# ::node	r	rate	3-4
# ::node	r2	rise-01	5-6
# ::node	2	half	7-8
# ::node	p	percentage-entity	9-10
# ::node	a	already	13-14
# ::node	p2	percentage-entity	15-16
# ::node	0	1.25%,	15-16
# ::node	h	have-degree-91	17-18
# ::node	h2	high-02	17-18
# ::node	m	most	17-18
# ::node	l	level	18-19
# ::node	1	9	20-21
# ::node	t	temporal-quantity	21-22
# ::node	y	year	21-22
# ::root	h	have-degree-91
# ::edge	rate	mod	interest	r	i	
# ::edge	rise-01	ARG1	rate	r2	r	
# ::edge	percentage-entity	value	half	p	2	
# ::edge	rise-01	ARG2	percentage-entity	r2	p	
# ::edge	percentage-entity	time	already	p2	a	
# ::edge	percentage-entity	condition	rise-01	p2	r2	
# ::edge	percentage-entity	ARG1	rate	p2	r	
# ::edge	percentage-entity	value	1.25%,	p2	0	
# ::edge	have-degree-91	ARG1	percentage-entity	h	p2	
# ::edge	have-degree-91	ARG2	high-02	h	h2	
# ::edge	have-degree-91	ARG3	most	h	m	
# ::edge	have-degree-91	ARG5	level	h	l	
# ::edge	temporal-quantity	quant	9	t	1	
# ::edge	temporal-quantity	unit	year	t	y	
# ::edge	have-degree-91	rel	temporal-quantity	h	t	
(h / have-degree-91
    :ARG1 (p2 / percentage-entity
        :ARG1 (r / rate
            :mod (i / interest))
        :condition (r2 / rise-01
            :ARG1 r
            :ARG2 (p / percentage-entity
                :value "half"))
        :time (a / already)
        :value 1.25%,)
    :ARG2 (h2 / high-02)
    :ARG3 (m / most)
    :ARG5 (l / level)
    :rel (t / temporal-quantity
        :quant 9
        :unit (y / year)))

