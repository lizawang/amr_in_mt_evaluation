# ::edge	help-01	ARG0	person	h	p2	
# ::edge	look-01	ARG0	person	l	p2	
# ::edge	look-01	ARG2-of	help-01	l	h	
# ::edge	monetary-quantity	quant-of	more	m	m2	
# ::edge	pay-01	ARG1-of	possible-01	p	p3	
# ::edge	pay-01	ARG0	we	p	w	
# ::edge	monetary-quantity	ARG1-of	pay-01	m	p	
# ::edge	and	op1	monetary-quantity	a	m	
# ::edge	look-01	ARG1	and	l	a	
# ::edge	and	op2	thing	a	t	
# ::edge	do-02	ARG1-of	recommend-01	d	r	
# ::edge	thing	ARG1-of	do-02	t	d	
# ::edge	do-02	ARG0	we	d	w	
# ::edge	do-02	time	now.	d	n	
# ::edge	look-01	rel	mortgage-01	l	m3	
(l / look-01
    :ARG0 (p2 / person)
    :ARG1 (a / and
        :op1 (m / monetary-quantity
            :ARG1-of (p / pay-01
                :ARG0 (w / we)
                :ARG1-of (p3 / possible-01))
            :quant-of (m2 / more))
        :op2 (t / thing
            :ARG1-of (d / do-02
                :ARG0 w
                :ARG1-of (r / recommend-01)
                :time (n / now.))))
    :ARG2-of (h / help-01
        :ARG0 p2)
    :rel (m3 / mortgage-01))

# ::tok If the interest goes up by half a percent, how much will the monthly mortgage payment cost?
# ::node	i	interest	2-3
# ::node	g	go-01	3-4
# ::node	u	up	4-5
# ::node	h	half	6-7
# ::node	a	amr-unknown	9-10
# ::node	r	rate-entity-91	13-14
# ::node	t	temporal-quantity	13-14
# ::node	m2	month	13-14
# ::node	0	1	13-14
# ::node	m3	mortgage-01	14-15
# ::node	p	pay-01	15-16
# ::node	m	monetary-quantity	16-17
# ::root	m	monetary-quantity
# ::edge	go-01	ARG1	interest	g	i	
# ::edge	go-01	direction	up	g	u	
# ::edge	go-01	ARG2	half	g	h	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r	t	
# ::edge	temporal-quantity	unit	month	t	m2	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	pay-01	ARG3	mortgage-01	p	m3	
# ::edge	monetary-quantity	ARG3-of	pay-01	m	p	
# ::edge	monetary-quantity	quant	amr-unknown	m	a	
# ::edge	monetary-quantity	condition	go-01	m	g	
# ::edge	monetary-quantity	rel	rate-entity-91	m	r	
(m / monetary-quantity
    :quant (a / amr-unknown)
    :ARG3-of (p / pay-01
        :ARG3 (m3 / mortgage-01))
    :condition (g / go-01
        :ARG1 (i / interest)
        :ARG2 (h / half)
        :direction (u / up))
    :rel (r / rate-entity-91
        :ARG3 (t / temporal-quantity
            :quant 1
            :unit (m2 / month))))

# ::tok For a mortgage of NIS 1.2 million, with a 40% prime interest rate, the monthly repayment will be NIS 125.
# ::node	m4	mortgage-01	2-3
# ::node	m	monetary-quantity	4-5
# ::node	h	have-03	7-8
# ::node	p	percentage-entity	9-10
# ::node	2	40%	9-10
# ::node	p4	prime	10-11
# ::node	i	interest	11-12
# ::node	r	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	m3	month	14-15
# ::node	0	1	14-15
# ::node	r2	repay-01	15-16
# ::node	m2	monetary-quantity	18-19
# ::node	p2	pound	18-19
# ::node	p3	pound	18-19
# ::node	1	125.	19-20
# ::root	r2	repay-01
# ::edge	mortgage-01	ARG1	monetary-quantity	m4	m	
# ::edge	mortgage-01	ARG0-of	have-03	m4	h	
# ::edge	percentage-entity	value	40%	p	2	
# ::edge	interest	mod	prime	i	p4	
# ::edge	interest	mod	percentage-entity	i	p	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r	t	
# ::edge	temporal-quantity	unit	month	t	m3	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	repay-01	frequency	rate-entity-91	r2	r	
# ::edge	repay-01	purpose	mortgage-01	r2	m4	
# ::edge	repay-01	ARG1	monetary-quantity	r2	m2	
# ::edge	monetary-quantity	unit	pound	m2	p2	
# ::edge	monetary-quantity	unit	pound	m	p3	
# ::edge	monetary-quantity	quant	125.	m2	1	
# ::edge	repay-01	rel	interest	r2	i	
(r2 / repay-01
    :purpose (m4 / mortgage-01
        :ARG0-of (h / have-03)
        :ARG1 (m / monetary-quantity
            :unit (p3 / pound)))
    :ARG1 (m2 / monetary-quantity
        :quant 125.
        :unit (p2 / pound))
    :frequency (r / rate-entity-91
        :ARG3 (t / temporal-quantity
            :quant 1
            :unit (m3 / month)))
    :rel (i / interest
        :mod (p4 / prime)
        :mod (p / percentage-entity
            :value 40%)))

# ::tok What was the average mortgage price at the beginning of the year?
# ::node	a	amr-unknown	0-1
# ::node	a2	average-04	3-4
# ::node	m2	mortgage-01	4-5
# ::node	m	monetary-quantity	5-6
# ::node	p	price-01	5-6
# ::node	b	begin-01	8-9
# ::node	y	year?	11-12
