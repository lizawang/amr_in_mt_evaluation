        :quant (a2 / about
            :op1 (m3 / monetary-quantity
                :quant 1000000
                :unit (p3 / pound)))
        :ARG3 (m2 / monetary-quantity
            :quant 1000000
            :unit (s2 / she)
            :unit (p2 / pound)))
    :rel (p / person
        :name (n / name
            :op1 "Kroser's")))

