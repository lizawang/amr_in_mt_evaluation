        :manner (a2 / and
            :op1 (o / online)
            :op2 (i / in-advance-04)))
    :ARG2-of (h / have-degree-91
        :ARG1 d
        :ARG3 (m / most))
    :condition (l / like-02
        :ARG1 (a / add-02)))

