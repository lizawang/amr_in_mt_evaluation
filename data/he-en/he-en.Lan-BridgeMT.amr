# ::edge	monetary-quantity	quant	amr-unknown	m	a	
# ::edge	monetary-quantity	ARG2-of	price-01	m	p	
# ::edge	price-01	ARG1	mortgage-01	p	m2	
# ::edge	monetary-quantity	time	begin-01	m	b	
# ::edge	begin-01	ARG1	year?	b	y	
(m / monetary-quantity
    :quant (a / amr-unknown)
    :ARG2-of (a2 / average-04)
    :ARG2-of (p / price-01
        :ARG1 (m2 / mortgage-01))
    :time (b / begin-01
        :ARG1 (y / year?)))

# ::tok Since the beginning of the year, it's been a significantly sharper increase.
# ::node	s3	since	0-1
# ::node	b	begin-01	2-3
# ::node	s2	significant-02	9-10
# ::node	h	have-degree-91	10-11
# ::node	s	sharp-02	10-11
# ::node	m	more	10-11
# ::node	i	increase-01	11-12
# ::root	i	increase-01
# ::edge	since	op1	begin-01	s3	b	
# ::edge	have-degree-91	ARG2	sharp-02	h	s	
# ::edge	have-degree-91	ARG3	more	h	m	
# ::edge	more	ARG1-of	significant-02	m	s2	
# ::edge	sharp-02	ARG1	increase-01	s	i	
# ::edge	increase-01	ARG1-of	have-degree-91	i	h	
# ::edge	increase-01	time	since	i	s3	
(i / increase-01
    :ARG1-of (h / have-degree-91
        :ARG2 (s / sharp-02
            :ARG1 i)
        :ARG3 (m / more
            :ARG1-of (s2 / significant-02)))
    :time (s3 / since
        :op1 (b / begin-01)))

# ::tok This is because interest rates on the other mortgage-backed lines (and not just on the prime line) have also increased - on the fixed-rate and the fixed-rate lines.
# ::node	t	this	0-1
