# ::node	s	surround-01	2-3
# ::node	v	vehicle	4-5
# ::node	a2	and	5-6
# ::node	b	begin-01	6-7
# ::node	q	question-01	7-8
# ::node	p2	person	9-10
# ::node	p	passenger	9-10
# ::root	a2	and
# ::edge	surround-01	ARG1	activist	s	a	
# ::edge	surround-01	ARG2	vehicle	s	v	
# ::edge	and	op1	surround-01	a2	s	
# ::edge	and	op2	begin-01	a2	b	
# ::edge	begin-01	ARG0	activist	b	a	
# ::edge	begin-01	ARG1	question-01	b	q	
# ::edge	question-01	ARG0	activist	q	a	
# ::edge	question-01	ARG1	person	q	p2	
# ::edge	person	poss	vehicle	p2	v	
# ::edge	person	mod	passenger	p2	p	
(a2 / and
    :op1 (s / surround-01
        :ARG1 (a / activist)
        :ARG2 (v / vehicle))
    :op2 (b / begin-01
        :ARG0 a
        :ARG1 (q / question-01
            :ARG0 a
            :ARG1 (p2 / person
                :mod (p / passenger)
                :poss v))))

# ::tok The field investigation lasted about 45 minutes, during which time it became more and more aggressive.
# ::node	f	field	1-2
