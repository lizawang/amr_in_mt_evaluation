# ::edge	aggressive.	ARG1-of	increase-01	a2	i	
# ::edge	become-01	ARG2	aggressive.	b	a2	
(l / last-01
    :ARG1 (i2 / investigate-01
        :mod (f / field)
        :time-of (b / become-01
            :ARG1 i2
            :ARG2 (a2 / aggressive.
                :ARG1-of (i / increase-01))))
    :ARG2 (a / about
        :op1 (t / temporal-quantity
            :quant 45
            :unit (m / minute))))

