# ::edge	cancel-01	ARG0	company	c	c2	
# ::edge	cancel-01	ARG1	fly-01	c	f	
# ::edge	and	op1	cancel-01	a2	c	
# ::edge	and	op2	and	a	a2	
# ::edge	and	op2	offer-01	a2	o	
# ::edge	offer-01	ARG0	company	o	c2	
# ::edge	offer-01	ARG1	voucher	o	v	
# ::edge	worth-01	polarity	-	w	0	
# ::edge	voucher	ARG1-of	worth-01	v	w	
(a / and
    :op2 (a2 / and
        :op1 (c / cancel-01
            :ARG0 (c2 / company)
            :ARG1 (f / fly-01))
        :op2 (o / offer-01
            :ARG0 c2
            :ARG1 (v / voucher
                :ARG1-of (w / worth-01
                    :polarity -))))
    :time (t / then))

# ::tok Because their implementation would be in addition to the price change.
# ::node	c	cause-01	0-1
# ::node	t	they	1-2
# ::node	i	implement-01	2-3
# ::node	a	add-02	6-7
# ::node	t2	thing	9-10
# ::node	p	price-01	9-10
# ::node	c2	change-01	10-11
# ::root	c	cause-01
# ::edge	implement-01	ARG1	they	i	t	
# ::edge	add-02	ARG1	implement-01	a	i	
# ::edge	cause-01	ARG0	add-02	c	a	
# ::edge	thing	ARG2-of	price-01	t2	p	
# ::edge	change-01	ARG1	thing	c2	t2	
# ::edge	add-02	ARG2	change-01	a	c2	
(c / cause-01
    :ARG0 (a / add-02
        :ARG1 (i / implement-01
            :ARG1 (t / they))
        :ARG2 (c2 / change-01
            :ARG1 (t2 / thing
                :ARG2-of (p / price-01)))))

# ::tok Whoever buys tickets at the airport puts their money on the wing.
# ::node	p	person	0-1
# ::node	a2	any	0-1
# ::node	b	buy-01	1-2
# ::node	t	ticket	2-3
# ::node	a	airport	5-6
# ::node	p2	put-01	6-7
# ::node	m	money	8-9
# ::node	w	wing.	11-12
# ::root	p2	put-01
# ::edge	person	mod	any	p	a2	
# ::edge	person	ARG0-of	buy-01	p	b	
# ::edge	buy-01	ARG1	ticket	b	t	
# ::edge	buy-01	location	airport	b	a	
# ::edge	put-01	ARG0	person	p2	p	
# ::edge	put-01	ARG1	money	p2	m	
# ::edge	money	poss	person	m	p	
# ::edge	put-01	ARG2	wing.	p2	w	
(p2 / put-01
    :ARG0 (p / person
        :ARG0-of (b / buy-01
            :ARG1 (t / ticket)
            :location (a / airport))
        :mod (a2 / any))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing.))

# ::tok It's a tin company.
# ::node	i	it	0-1
# ::node	t	tin	2-3
# ::node	c	company.	3-4
# ::root	c	company.
# ::edge	company.	consist-of	tin	c	t	
# ::edge	company.	domain	it	c	i	
(c / company.
    :consist-of (t / tin)
    :domain (i / it))

# ::tok It's a low-cost company exercise.
# ::node	c2	cost-01	2-3
# ::node	l	low-04	2-3
# ::node	c	company	3-4
# ::node	e	exercise-02	4-5
# ::root	e	exercise-02
# ::edge	cost-01	ARG2	low-04	c2	l	
# ::edge	exercise-02	ARG0	company	e	c	
# ::edge	exercise-02	ARG1-of	cost-01	e	c2	
(e / exercise-02
    :ARG0 (c / company)
    :ARG1-of (c2 / cost-01
        :ARG2 (l / low-04)))

# ::tok No luggage, no seat selection, probably no taxes and no food.
# ::node	l	luggage,	1-2
# ::node	0	-	2-3
# ::node	1	-	2-3
# ::node	s	seat	3-4
# ::node	p	probable	5-6
# ::node	2	-	6-7
# ::node	t	tax-01	7-8
# ::node	a	and	8-9
# ::node	3	-	9-10
# ::node	f	food.	10-11
# ::root	a	and
# ::edge	luggage,	polarity	-	l	1	
# ::edge	tax-01	polarity	-	t	2	
# ::edge	tax-01	mod	probable	t	p	
# ::edge	and	op2	tax-01	a	t	
# ::edge	and	op1	luggage,	a	l	
# ::edge	food.	polarity	-	f	3	
# ::edge	and	op3	food.	a	f	
# ::edge	and	rel	-	a	0	
# ::edge	and	rel	seat	a	s	
(a / and
    :op1 (l / luggage,
        :polarity -)
    :op2 (t / tax-01
        :mod (p / probable)
        :polarity -)
    :op3 (f / food.
        :polarity -)
    :rel -
    :rel (s / seat))

# ::tok Vacation and Corona flights...
# ::node	v	vacation-01	0-1
# ::node	a	and	1-2
# ::node	c	city	2-3
# ::node	n	name	2-3
# ::node	0	Corona	2-3
# ::node	f	fly-01	3-4
# ::root	f	fly-01
# ::edge	and	op1	vacation-01	a	v	
# ::edge	and	op2	city	a	c	
# ::edge	city	name	name	c	n	
# ::edge	name	op1	Corona	n	0	
# ::edge	fly-01	ARG3	and	f	a	
(f / fly-01
    :ARG3 (a / and
        :op1 (v / vacation-01)
        :op2 (c / city
            :name (n / name
                :op1 "Corona"))))

# ::tok To all the members of the guillotine... on me!
# ::node	a	all	1-2
# ::node	p	person	3-4
# ::node	h	have-org-role-91	3-4
# ::node	m	member	3-4
# ::node	g	guillotine...	6-7
# ::node	i	i	8-9
# ::root	p	person
# ::edge	person	mod	all	p	a	
# ::edge	person	ARG0-of	have-org-role-91	p	h	
# ::edge	have-org-role-91	ARG2	member	h	m	
# ::edge	have-org-role-91	ARG1	guillotine...	h	g	
# ::edge	person	rel	i	p	i	
(p / person
    :ARG0-of (h / have-org-role-91
        :ARG1 (g / guillotine...)
        :ARG2 (m / member))
    :mod (a / all)
    :rel (i / i))

# ::tok Nature makes fools thin! - What?
# ::node	n	nature	0-1
# ::node	m	make-02	1-2
# ::node	f	fool	2-3
# ::node	m2	multi-sentence	4-5
# ::node	a	amr-unknown	5-6
# ::root	m2	multi-sentence
# ::edge	make-02	ARG0	nature	m	n	
# ::edge	multi-sentence	snt1	make-02	m2	m	
# ::edge	multi-sentence	snt2	amr-unknown	m2	a	
# ::edge	multi-sentence	rel	fool	m2	f	
(m2 / multi-sentence
    :rel (f / fool)
    :snt1 (m / make-02
        :ARG0 (n / nature))
    :snt2 (a / amr-unknown))

