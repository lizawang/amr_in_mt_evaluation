(c / cause-01
    :ARG0 (i / increase-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG4 (a2 / and
            :op1 (l3 / line
                :mod (f / fixed-rate)))
        :mod (a / also))
    :ARG1 (t / this)
    :rel (a3 / and
        :op1 (l / line
            :ARG1-of (m / mortgage-01)
            :mod (o / other))
        :op2 (l2 / line
            :domain a3
            :mod (p / prime)
            :mod (j / just
                :polarity -))))

