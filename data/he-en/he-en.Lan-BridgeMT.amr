(a3 / and
    :condition (w / want-01
        :ARG0 (y / you)
        :ARG1 (a / add-02
            :ARG0 y
            :ARG1 (w3 / weight,
                :mod (m3 / more))))
    :op1 (v / vary-01
        :ARG0-of (d / depend-01
