# ::edge	multi-sentence	rel	imperative	m	i	
(m / multi-sentence
    :rel (i / imperative)
    :snt1 (a2 / and
        :op1 (g / go-02
            :ARG0 (y / you)
            :ARG4 (h / home)
            :mode imperative)
        :op2 (n / nice-01
            :ARG1 y
            :mode imperative
            :time (e / early!
                :op1 (t / temporal-quantity
                    :quant 1
                    :unit (h2 / hour)))))
    :snt2 (a / amr-unknown))

