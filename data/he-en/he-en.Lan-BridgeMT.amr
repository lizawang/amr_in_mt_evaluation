# ::edge	under	op1	seat.	u	s	
(a / allow-01
    :ARG0 (c2 / company
        :name (n / name
            :op1 "EasyJet"))
    :ARG1 (c / carry-01
        :ARG0 (y2 / you)
        :ARG1 (b / bag,
            :mod (p / product-of
