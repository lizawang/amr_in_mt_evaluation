(c / cost-01
    :ARG1-of (s / say-01)
    :ARG2 (a / about)
    :condition (g / go-01
        :ARG1 (r / rate
            :mod (i / interest))
        :ARG2 (m / monetary-quantity
            :quant (h / half)
            :quant 620)
        :direction (u / up))
