# ::tok If the interest rate goes up by half a percent, how much will the monthly mortgage payment go up?
# ::node	i4	interest	2-3
# ::node	r	rate	3-4
# ::node	i	increase-01	5-6
# ::node	i2	increase-01	5-6
# ::node	1	half	7-8
# ::node	p2	percentage-entity	9-10
# ::node	a	amr-unknown	10-11
# ::node	r2	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	m2	month	14-15
# ::node	0	1	14-15
# ::node	m3	mortgage-01	15-16
# ::node	m	monetary-quantity	16-17
# ::node	p	pay-01	16-17
# ::node	i3	increase-01	18-19
# ::root	i3	increase-01
# ::edge	rate	mod	interest	r	i4	
# ::edge	increase-01	ARG1	rate	i2	r	
# ::edge	percentage-entity	value	half	p2	1	
# ::edge	increase-01	ARG2	percentage-entity	i2	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m2	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	monetary-quantity	frequency	rate-entity-91	m	r2	
# ::edge	monetary-quantity	ARG1-of	pay-01	m	p	
# ::edge	pay-01	ARG3	mortgage-01	p	m3	
