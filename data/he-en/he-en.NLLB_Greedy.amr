# ::edge	increase-01	rel	increase-01	i3	i	
# ::edge	increase-01	rel	amr-unknown	i3	a	
(i3 / increase-01
    :ARG1 (m / monetary-quantity
        :ARG1-of (p / pay-01
            :ARG3 (m3 / mortgage-01))
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m2 / month))))
    :condition (i2 / increase-01
        :ARG1 (r / rate
            :mod (i4 / interest))
        :ARG2 (p2 / percentage-entity
            :value "half"))
    :rel (i / increase-01)
    :rel (a / amr-unknown))

