(p / pay-01
    :purpose (m4 / mortgage-01
        :ARG1 (m / monetary-quantity
            :quant 1000000
            :unit (d / dollar))
        :ARG1-of (c / consist-01
            :ARG2 (p3 / premium,
                :mod (r / rate
                    :quant (p2 / percentage-entity
                        :value 40)
