(a3 / amount-01
    :ARG1 (i / increase-01
        :ARG1 (g / go-01
            :ARG1 (i2 / interest)
            :ARG2 (p / percentage-entity
                :value "half")
            :direction (u / up)))
    :ARG1-of (e / estimate-01
        :ARG0 (p2 / person
            :name (n / name
                :op1 "Chrour")))
    :ARG2 (a / about
        :op1 (m / monetary-quantity
            :quant 400000
            :unit (d / dollar)))
