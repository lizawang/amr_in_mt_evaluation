# ::edge	level	degree-of	friendly-01	l	f	
# ::edge	friendly-01	ARG2	business	f	b2	
# ::edge	business	location	jurisdiction.	b2	j	
# ::edge	jurisdiction.	poss	authority,	j	a	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (n / number)
        :ARG0-of (t2 / test-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG2 (b2 / business
                        :location (j / jurisdiction.
                            :poss (a / authority,
                                :mod (e / each)))))
                :poss a))
        :ARG1-of (t / test-01
            :ARG0 a)))

# ::tok The index divides municipalities into three size groups by the number of inhabitants, since a local authority of up to 50,000 inhabitants is not the same as a local authority of more than 150,000.
