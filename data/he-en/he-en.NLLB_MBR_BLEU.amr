# ::root	c	cause-01
# ::edge	cause-01	ARG1	this	c	t	
# ::edge	rate	mod	interest	r	i	
# ::edge	way	mod	other	w	o	
# ::edge	way	mod	all	w	a	
# ::edge	rate	poss	way	r	w	
# ::edge	way	ARG2-of	comprise-01	w	c2	
# ::edge	comprise-01	ARG1	mortgage-01	c2	m2	
# ::edge	way	ARG1-of	contrast-01	w	c3	
# ::edge	just	polarity	-	j	0	
# ::edge	path)	mod	prime	p2	p4	
# ::edge	path)	mod	just	p2	j	
# ::edge	contrast-01	ARG2	path)	c3	p2	
# ::edge	go-01	mod	also	g	a2	
# ::edge	go-01	ARG1	rate	g	r	
# ::edge	cause-01	ARG0	go-01	c	g	
# ::edge	go-01	direction	up	g	u	
# ::edge	meter	ARG1-of	narrow-02	m	n	
# ::edge	path	mod	meter	p	m	
# ::edge	and	op1	path	a3	p	
# ::edge	way	example	and	w	a3	
# ::edge	rate	ARG1-of	fix-03	r2	f	
# ::edge	path.	mod	rate	p3	r2	
# ::edge	and	op2	path.	a3	p3	
(c / cause-01
    :ARG0 (g / go-01
        :ARG1 (r / rate
            :mod (i / interest)
            :poss (w / way
                :ARG1-of (c3 / contrast-01
                    :ARG2 (p2 / "path)"
                        :mod (p4 / prime)
                        :mod (j / just
                            :polarity -)))
                :ARG2-of (c2 / comprise-01
                    :ARG1 (m2 / mortgage-01))
                :example (a3 / and
                    :op1 (p / path
                        :mod (m / meter
                            :ARG1-of (n / narrow-02)))
                    :op2 (p3 / path.
                        :mod (r2 / rate
                            :ARG1-of (f / fix-03))))
                :mod (o / other)
                :mod (a / all)))
        :direction (u / up)
        :mod (a2 / also))
    :ARG1 (t / this))

