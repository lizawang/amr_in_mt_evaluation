(t / thing
    :ARG1-of (h / have-degree-91
        :ARG2 (g / good-02
            :ARG1 t)
        :ARG3 (m / most))
    :ARG1-of (d / do-02
        :time (t2 / today?))
    :domain (a / amr-unknown))

# ::tok For those who have a mortgage that's mostly close to the meter, the chain recommends considering recycling to non-contiguous pathways.
# ::node	p	person	1-2
# ::node	t	that	1-2
# ::node	m	mortgage-01	5-6
# ::node	m2	most	7-8
# ::node	c3	close-10	8-9
