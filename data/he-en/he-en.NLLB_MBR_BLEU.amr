# ::edge	do-02	time	now.	d	n2	
# ::edge	look-01	rel	mortgage-01	l	m3	
(l / look-01
    :ARG0 (w / we)
    :ARG1 (a / and
        :op1 (m / monetary-quantity
            :quant (m2 / more)
            :ARG1-of (p / pay-01
                :ARG0 w
                :ARG1-of (p3 / possible-01)))
        :op2 (t / thing
            :ARG1-of (d / do-02
                :ARG0 w
                :time (n2 / now.
                    :mod (r / right)))))
    :manner (h / help-01
        :ARG0 (p2 / person
            :name (n / name
                :op1 "Shae"
                :op2 "Zarror,")))
    :rel (m3 / mortgage-01))

# ::tok If the interest rate goes up by a half a percent, how much will the monthly mortgage payment cost?
# ::node	i	interest	2-3
# ::node	r	rate	3-4
# ::node	g	go-01	4-5
# ::node	u	up	5-6
# ::node	1	1/2	8-9
# ::node	p2	percentage-entity	10-11
# ::node	a	amr-unknown	11-12
# ::node	r2	rate-entity-91	15-16
# ::node	t	temporal-quantity	15-16
# ::node	m2	month	15-16
# ::node	0	1	15-16
# ::node	m3	mortgage-01	16-17
# ::node	p	pay-01	17-18
# ::node	m	monetary-quantity	18-19
# ::node	c	cost-01	18-19
# ::root	m	monetary-quantity
# ::edge	rate	mod	interest	r	i	
# ::edge	go-01	ARG1	rate	g	r	
# ::edge	go-01	direction	up	g	u	
# ::edge	percentage-entity	value	1/2	p2	1	
# ::edge	go-01	ARG2	percentage-entity	g	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m2	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	pay-01	ARG3	mortgage-01	p	m3	
# ::edge	monetary-quantity	ARG1-of	pay-01	m	p	
# ::edge	monetary-quantity	quant	amr-unknown	m	a	
# ::edge	monetary-quantity	condition	go-01	m	g	
# ::edge	monetary-quantity	ARG2-of	cost-01	m	c	
# ::edge	cost-01	ARG1	pay-01	c	p	
# ::edge	monetary-quantity	rel	rate-entity-91	m	r2	
(m / monetary-quantity
    :quant (a / amr-unknown)
    :ARG1-of (p / pay-01
        :ARG3 (m3 / mortgage-01))
    :ARG2-of (c / cost-01
        :ARG1 p)
    :condition (g / go-01
        :ARG1 (r / rate
            :mod (i / interest))
        :ARG2 (p2 / percentage-entity
            :value "1/2")
        :direction (u / up))
    :rel (r2 / rate-entity-91
        :ARG3 (t / temporal-quantity
            :quant 1
            :unit (m2 / month))))

# ::tok On a mortgage of $1,200,000, consisting of a 40 percent rate, the monthly payment will be $1.40.
# ::node	m4	mortgage-01	2-3
# ::node	m	monetary-quantity	4-5
# ::node	d	dollar	4-5
# ::node	2	200000	4-5
# ::node	c	consist-01	5-6
# ::node	3	40	8-9
# ::node	p2	percentage-entity	9-10
# ::node	r	rate-entity-91	12-13
# ::node	t	temporal-quantity	12-13
# ::node	m3	month	12-13
# ::node	0	1	12-13
# ::node	p	pay-01	13-14
# ::node	m2	monetary-quantity	16-17
# ::node	d2	dollar	16-17
# ::node	1	1	16-17
# ::root	p	pay-01
# ::edge	mortgage-01	ARG1	monetary-quantity	m4	m	
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	monetary-quantity	quant	200000	m	2	
# ::edge	mortgage-01	ARG1-of	consist-01	m4	c	
# ::edge	percentage-entity	value	40	p2	3	
# ::edge	rate-entity-91	ARG2	temporal-quantity	r	t	
