# ::edge	rise-01	ARG1	it's	r	i	
# ::edge	rise-01	time	since	r	s2	
(r / rise-01
    :ARG1 (i / it's)
    :ARG1-of (s / significant-02)
    :time (s2 / since
        :op1 (b / begin-01)))

# ::tok This is because the interest rates on all the other paths that comprise a mortgage (and not just the prime path) have also gone up -- the narrow meter path and the fixed rate path.
# ::node	t	this	0-1
# ::node	c	cause-01	2-3
# ::node	i	interest	4-5
# ::node	r	rate	5-6
# ::node	a	all	7-8
# ::node	o	other	9-10
# ::node	w	way	10-11
# ::node	c2	comprise-01	12-13
# ::node	m2	mortgage-01	14-15
# ::node	c3	contrast-01	16-17
# ::node	0	-	16-17
# ::node	j	just	17-18
# ::node	p4	prime	19-20
# ::node	p2	path)	20-21
# ::node	a2	also	22-23
