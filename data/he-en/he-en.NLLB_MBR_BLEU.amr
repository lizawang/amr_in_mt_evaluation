(d / divide-02
    :ARG0 (i / index)
    :ARG1 (m2 / municipality)
    :ARG1-of (c / cause-01
        :ARG0 (s / same-01
            :ARG1 (a / authority
                :ARG0-of (i2 / inhabit-01
                    :quant (u / up-to
                        :op1 50000)
                    :ARG1 (p / person))
                :ARG1-of (l / local-02
                    :ARG1 (a2 / authority
                        :quant (m / more-than
                            :op1 150000))))
            :ARG2 a2
            :polarity -))
    :ARG2 (g / group
        :mod (s2 / size
            :quant 3))
    :ARG5 (n / number))

