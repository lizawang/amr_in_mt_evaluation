(i / increase-01
    :ARG1 (p / path
        :mod (r / rate
            :ARG1-of (f / fix-03)
            :ARG1-of (c / contrast-01
                :ARG2 (r2 / rate
                    :ARG1-of (n / narrow-02
                        :polarity -)
                    :location (p2 / "path)"
                        :mod (t / this)
                        :mod r)))))
    :ARG2 (m / monetary-quantity
        :quant 220.
        :unit (p3 / pound)))

