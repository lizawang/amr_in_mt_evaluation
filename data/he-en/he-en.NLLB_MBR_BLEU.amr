# ::edge	report-01	ARG1	event	r	e	
# ::edge	command.	mod	forward	c	f	
# ::edge	report-01	ARG2	command.	r	c	
(a4 / and
    :condition (s / scenario,
        :ARG1-of (t / true-01
            :ARG1 (e / event)))
    :op1 (a / activate-01
        :ARG1 (a3 / alert-01
            :mod (a2 / additional)))
    :op2 (r / report-01
        :ARG1 e
        :ARG2 (c / command.
            :mod (f / forward))))

