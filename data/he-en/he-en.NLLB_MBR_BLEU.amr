# ::edge	monetary-quantity	unit	dollar	m2	d2	
# ::edge	monetary-quantity	quant	1	m2	1	
# ::edge	pay-01	rel	percentage-entity	p	p2	
(p / pay-01
    :ARG1 (m2 / monetary-quantity
        :quant 1
        :unit (d2 / dollar))
    :frequency (r / rate-entity-91
        :ARG2 (t / temporal-quantity
            :quant 1
            :unit (m3 / month)))
    :manner (m4 / mortgage-01
        :ARG1 (m / monetary-quantity
            :quant 200000
            :unit (d / dollar))
        :ARG1-of (c / consist-01))
    :rel (p2 / percentage-entity
        :value 40))

# ::tok What was the average mortgage since the beginning of the year?
# ::node	a	amr-unknown	0-1
# ::node	a2	average-04	3-4
# ::node	m	mortgage-01	4-5
# ::node	s	since	5-6
# ::node	b	begin-01	7-8
# ::node	y	year?	10-11
# ::root	m	mortgage-01
# ::edge	mortgage-01	ARG1-of	average-04	m	a2	
# ::edge	mortgage-01	quant	amr-unknown	m	a	
# ::edge	mortgage-01	time	since	m	s	
# ::edge	since	op1	begin-01	s	b	
# ::edge	begin-01	ARG1	year?	b	y	
(m / mortgage-01
    :quant (a / amr-unknown)
    :ARG1-of (a2 / average-04)
    :time (s / since
        :op1 (b / begin-01
            :ARG1 (y / year?))))

# ::tok Since the beginning of the year, it's been a significant rise.
# ::node	s2	since	0-1
