# ::edge	recycle-01	ARG0	person	r2	p	
# ::edge	recycle-01	ARG1-of	cause-01	r2	c	
# ::edge	possible-01	polarity	-	p2	0	
# ::edge	road	ARG1-of	possible-01	r3	p2	
# ::edge	recycle-01	destination	road	r2	r3	
(r / recommend-01
    :ARG0 (c2 / chain)
    :ARG1 (c4 / consider-02
        :ARG0 (p / person
            :ARG0-of (m / mortgage-01
                :ARG1-of (c3 / close-10
                    :mod (m2 / most)))
            :mod (t / that))
        :ARG1 (r2 / recycle-01
            :ARG0 p
            :ARG1-of (c / cause-01)
            :destination (r3 / road
                :ARG1-of (p2 / possible-01
                    :polarity -))))
    :ARG2 p)

# ::tok For mortgage borrowers whose monthly returns have increased significantly and who find it difficult to meet repayments - he recommends taking a mortgage restructuring and rescheduling it over a longer period.
# ::node	m4	mortgage-01	1-2
