(c / complete-01
    :ARG0 (p / path
        :quant (p2 / percentage-entity
            :value "(26.7%")
        :mod (r2 / rate
            :ARG1-of (v / vary-01)
            :mod (i2 / interest))
        :mod (t / this))
    :ARG1 (i / increase-01
        :ARG2 (a / about
            :op1 (m / monetary-quantity
                :quant 100
                :unit (d / dollar))))
    :rel (r / Great))

