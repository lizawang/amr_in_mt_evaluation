# ::node	l	level	17-18
# ::node	f	friendly-01	19-20
# ::node	b2	business	21-22
# ::node	j	jurisdiction.	24-25
# ::root	b	base-02
# ::edge	base-02	ARG1	index	b	i	
# ::edge	parameter	quant	number	p	n	
# ::edge	base-02	ARG2	parameter	b	p	
# ::edge	parameter	ARG1-of	test-01	p	t	
# ::edge	authority,	mod	each	a	e	
# ::edge	test-01	ARG0	authority,	t	a	
# ::edge	parameter	ARG0-of	test-01	p	t2	
# ::edge	test-01	ARG1	level	t2	l	
