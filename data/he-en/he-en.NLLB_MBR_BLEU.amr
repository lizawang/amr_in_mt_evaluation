# ::node	r3	road	19-20
# ::root	r	recommend-01
# ::edge	person	mod	that	p	t	
# ::edge	person	ARG0-of	mortgage-01	p	m	
# ::edge	close-10	mod	most	c3	m2	
# ::edge	mortgage-01	ARG1-of	close-10	m	c3	
