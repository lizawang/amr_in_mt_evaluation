# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	file-01	frequency	temporal-quantity	f	t	
# ::edge	temporal-quantity	unit	year.	t	y	
(c / contrast-01
    :ARG2 (f / file-01
        :ARG0 (p / person
            :quant (s / several
                :op1 (m / multiple
                    :op1 10000))
            :ARG1-of (e / employ-01))
        :frequency (t / temporal-quantity
            :quant 1
            :unit (y / year.))))

# ::tok If you think that these funds have just disappeared anyway, think again: employees can file a tax return for six years back.
# ::node	y2	you	1-2
# ::node	t3	think-01	2-3
# ::node	t5	this	4-5
# ::node	f2	fund	5-6
# ::node	j	just	7-8
# ::node	d	disappear-01	8-9
# ::node	t4	think-01	10-11
# ::node	1	imperative	10-11
# ::node	a	again:	11-12
# ::node	p	person	12-13
# ::node	e	employ-01	12-13
# ::node	p2	possible-01	13-14
# ::node	f	file-01	14-15
# ::node	t	tax-01	16-17
# ::node	r	return-06	17-18
# ::node	0	6	19-20
# ::node	t2	temporal-quantity	20-21
# ::node	y	year	20-21
# ::root	t4	think-01
# ::edge	think-01	ARG0	you	t3	y2	
# ::edge	fund	mod	this	f2	t5	
# ::edge	disappear-01	mod	just	d	j	
# ::edge	disappear-01	ARG1	fund	d	f2	
# ::edge	think-01	ARG1	disappear-01	t3	d	
# ::edge	think-01	condition	think-01	t4	t3	
# ::edge	think-01	ARG0	you	t4	y2	
# ::edge	think-01	mode	imperative	t4	1	
# ::edge	think-01	mod	again:	t4	a	
# ::edge	person	ARG1-of	employ-01	p	e	
# ::edge	think-01	ARG1	possible-01	t4	p2	
# ::edge	possible-01	ARG1	file-01	p2	f	
# ::edge	file-01	ARG0	person	f	p	
# ::edge	return-06	ARG1	tax-01	r	t	
# ::edge	file-01	ARG1	return-06	f	r	
# ::edge	temporal-quantity	quant	6	t2	0	
# ::edge	file-01	duration	temporal-quantity	f	t2	
# ::edge	temporal-quantity	unit	year	t2	y	
(t4 / think-01
    :ARG0 (y2 / you)
    :ARG1 (p2 / possible-01
        :ARG1 (f / file-01
            :ARG0 (p / person
                :ARG1-of (e / employ-01))
            :ARG1 (r / return-06
                :ARG1 (t / tax-01))
            :duration (t2 / temporal-quantity
                :quant 6
                :unit (y / year))))
    :condition (t3 / think-01
        :ARG0 y2
        :ARG1 (d / disappear-01
            :ARG1 (f2 / fund
                :mod (t5 / this))
            :mod (j / just)))
    :mod (a / "again:")
    :mode imperative)

# ::tok Tax:On conducted an in-depth survey of 4,000 of its customers' tax returns during 2020.
# ::node	c	conduct-01	1-2
# ::node	i	in-depth	3-4
# ::node	s	survey-01	4-5
# ::node	1	4000	6-7
# ::node	i2	include-91	7-8
# ::node	i3	it	8-9
# ::node	t	tax-01	10-11
# ::node	t2	tax-01	10-11
