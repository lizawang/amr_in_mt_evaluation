# ::edge	test-01	ARG1-of	negative-02	t	n2	
# ::edge	isolate-01	manner	test-01	i	t	
(r / receive-01
    :ARG0 (p / passenger)
    :ARG1 (n3 / notice-03
        :ARG0 (g / government-organization
            :name (n / name
                :op1 "Ministry"
                :op2 "of"
                :op3 "Health"))
        :ARG1 (e / exempt-01
            :ARG1 p
            :ARG2 (o / obligate-01
                :ARG1 p
                :ARG2 (i / isolate-01
                    :ARG1 p
                    :manner (t / test-01
                        :ARG1 (c / coronavirus)
                        :ARG1-of (n2 / negative-02)))))
        :ARG2 p))

