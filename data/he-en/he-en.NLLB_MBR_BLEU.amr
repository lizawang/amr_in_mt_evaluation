# ::edge	help-01	ARG0	person	h	p2	
# ::edge	name	op2	Zarror,	n	1	
# ::edge	look-01	ARG0	we	l	w	
# ::edge	look-01	manner	help-01	l	h	
# ::edge	monetary-quantity	quant	more	m	m2	
# ::edge	pay-01	ARG1-of	possible-01	p	p3	
# ::edge	monetary-quantity	ARG1-of	pay-01	m	p	
# ::edge	pay-01	ARG0	we	p	w	
# ::edge	and	op1	monetary-quantity	a	m	
# ::edge	look-01	ARG1	and	l	a	
# ::edge	and	op2	thing	a	t	
