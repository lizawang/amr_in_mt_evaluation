# ::edge	some	mod	R16,	s	a	
# ::edge	route	ARG0-of	assume-02	r	a2	
# ::edge	increase-01	degree	further	i3	f	
# ::edge	assume-02	ARG1	increase-01	a2	i3	
# ::edge	increase-01	ARG2	0.5%	i3	0	
# ::edge	month.	mod	next	m	n	
# ::edge	increase-01	time	month.	i3	m	
(c / complete-01
    :ARG0 (r / route
        :ARG0-of (a2 / assume-02
            :ARG1 (i3 / increase-01
                :ARG2 0.5%
                :degree (f / further)
                :time (m / month.
                    :mod (n / next))))
        :mod (p2 / prime)
        :mod (p / percentage-entity
            :ARG1-of (i / include-91
                :ARG2 (r2 / "route)"
                    :mod (t / this)))))
    :ARG1 (i2 / increase-01
        :ARG2 (s / some
            :mod (a / R16,))))

