# ::node	p	person	1-2
# ::node	e	employ-01	1-2
# ::node	p4	possible-01	2-3
# ::node	g	get-01	3-4
# ::node	l	large	5-6
# ::node	s	sum,	6-7
# ::node	c	cause-01	7-8
# ::node	0	4	8-9
# ::node	i	include-91	10-11
# ::node	1	5	11-12
# ::node	p2	person	12-13
# ::node	p3	person	12-13
# ::node	e2	employ-01	12-13
# ::node	e3	entitle-01	14-15
# ::node	t	tax-01	17-18
# ::node	r	refund-01	18-19
# ::root	p4	possible-01
# ::edge	person	quant	many	p	m	
# ::edge	person	ARG1-of	employ-01	p	e	
# ::edge	possible-01	ARG1	get-01	p4	g	
# ::edge	get-01	ARG0	person	g	p	
# ::edge	sum,	mod	large	s	l	
# ::edge	get-01	ARG1	sum,	g	s	
# ::edge	possible-01	ARG1-of	cause-01	p4	c	
# ::edge	person	ARG1-of	include-91	p2	i	
# ::edge	person	quant	4	p2	0	
# ::edge	person	quant	5	p3	1	
# ::edge	include-91	ARG2	person	i	p3	
# ::edge	person	ARG1-of	employ-01	p3	e2	
# ::edge	employ-01	ARG0	person	e2	p	
# ::edge	entitle-01	ARG2	person	e3	p2	
# ::edge	cause-01	ARG0	entitle-01	c	e3	
# ::edge	refund-01	ARG1	tax-01	r	t	
# ::edge	entitle-01	ARG1	refund-01	e3	r	
# ::edge	refund-01	ARG2	person	r	p2	
(p4 / possible-01
    :ARG1 (g / get-01
        :ARG0 (p / person
            :quant (m / many)
            :ARG1-of (e / employ-01))
        :ARG1 (s / sum,
            :mod (l / large)))
    :ARG1-of (c / cause-01
        :ARG0 (e3 / entitle-01
            :ARG1 (r / refund-01
                :ARG1 (t / tax-01)
                :ARG2 (p2 / person
                    :quant 4
                    :ARG1-of (i / include-91
                        :ARG2 (p3 / person
                            :quant 5
                            :ARG1-of (e2 / employ-01
                                :ARG0 p)))))
            :ARG2 p2)))

# ::tok In practice, however, several tens of thousands of employees file a year.
# ::node	c	contrast-01	2-3
# ::node	s	several	3-4
# ::node	m	multiple	6-7
# ::node	1	10000	6-7
# ::node	p	person	8-9
