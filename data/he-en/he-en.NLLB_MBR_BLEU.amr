# ::edge	conduct-01	ARG0	it	c	i3	
# ::edge	return-06	mod	tax-01	r	t	
# ::edge	return-06	ARG1-of	include-91	r	i2	
# ::edge	return-06	quant	4000	r	1	
# ::edge	survey-01	ARG1	return-06	s	r	
# ::edge	return-06	ARG1	tax-01	r2	t	
# ::edge	return-06	ARG0	it	r2	i3	
# ::edge	include-91	ARG2	return-06	i2	r2	
# ::edge	conduct-01	time	date-entity	c	d	
# ::edge	date-entity	year	2020.	d	0	
# ::edge	conduct-01	rel	tax-01	c	t2	
(c / conduct-01
    :ARG0 (i3 / it)
    :ARG1 (s / survey-01
        :ARG1 (r / return-06
            :quant 4000
            :ARG1-of (i2 / include-91
                :ARG2 (r2 / return-06
                    :ARG0 i3
                    :ARG1 (t / tax-01)))
            :mod t)
        :manner (i / in-depth))
    :rel (t2 / tax-01)
    :time (d / date-entity
        :year 2020.))

