        :ARG1-of (c2 / cost-01
            :ARG2 (l / low-04))))

# ::tok No luggage, no seat selection, certainly no taxes and no food.
# ::node	0	-	0-1
# ::node	l	luggage,	1-2
# ::node	s	seat	3-4
# ::node	c	certain	5-6
# ::node	1	-	6-7
# ::node	t	tax-01	7-8
# ::node	a	and	8-9
# ::node	2	-	9-10
# ::node	f	food.	10-11
# ::root	a	and
# ::edge	luggage,	polarity	-	l	0	
# ::edge	tax-01	polarity	-	t	1	
# ::edge	tax-01	mod	certain	t	c	
# ::edge	and	op2	tax-01	a	t	
# ::edge	and	op1	luggage,	a	l	
# ::edge	food.	polarity	-	f	2	
# ::edge	and	op3	food.	a	f	
# ::edge	and	rel	seat	a	s	
(a / and
    :op1 (l / luggage,
        :polarity -)
    :op2 (t / tax-01
        :mod (c / certain)
        :polarity -)
    :op3 (f / food.
        :polarity -)
    :rel (s / seat))

