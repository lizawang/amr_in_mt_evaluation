# ::edge	tax-01	mod	city	t2	c	
# ::edge	and	op3	tax-01	a4	t2	
# ::edge	and	rel	access-01	a3	a	
(a3 / and
    :op1 (u / update-01
        :ARG1 (i / index)
        :frequency (r2 / rate-entity-91
            :ARG3 (t3 / temporal-quantity
                :quant 1
                :unit (y / year))))
    :op2 (w / weigh-01
        :ARG1 i
        :ARG3 (r / rate-01
            :quant 4
            :ARG0 (a5 / "authority:"
                :ARG1-of (l / local-02)
                :mod (e / each))
            :ARG1 (a4 / and
                :op1 (s / satisfy-01
                    :ARG1 (b / business))
                :op2 (a2 / access-01
                    :ARG1 (i2 / information,))
                :op3 (t2 / tax-01
                    :mod (c / city)))
            :ARG1-of (d / differ-02)))
    :rel (a / access-01
        :ARG0 (c2 / company
            :ARG0-of (t / tax-01))
        :ARG1 s))

