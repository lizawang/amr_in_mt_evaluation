(s / surge-01
    :ARG1 (c / city
        :name (n / name
            :op1 "Tel"
            :op2 "Aviv"))
    :time (y / year
        :mod (t / this)))

# ::tok The index is updated once a year and weighs four different ratings in each local authority: business satisfaction, accessibility to tenders, accessibility of information, and municipal taxes.
# ::node	i	index	1-2
# ::node	u	update-01	3-4
# ::node	r2	rate-entity-91	4-5
# ::node	0	1	4-5
# ::node	t3	temporal-quantity	6-7
