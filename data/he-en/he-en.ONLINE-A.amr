# ::edge	suitcase	quant	2	s4	1	
# ::edge	suitcase	mod	business	s4	b	
# ::edge	and	op3	suitcase	a	s4	
# ::edge	suitcase	ARG1-of	weigh-01	s4	w2	
# ::edge	mass-quantity	quant	32	m2	3	
# ::edge	weigh-01	ARG3	mass-quantity	w2	m2	
# ::edge	mass-quantity	unit	kilogram	m2	k2	
# ::edge	offer-01	rel	economy	o	e	
(o / offer-01
    :ARG0 (c / company
        :name (n / name
            :op1 "United"
            :op2 "Airlines"))
    :ARG1 (a / and
        :op1 (s2 / suitcase
            :ARG1-of (w / weigh-01
                :ARG3 (u / up-to
                    :op1 (m / mass-quantity
                        :quant 23
                        :unit (k / kilogram)))))
        :op2 (s3 / suitcase
            :quant 2
            :ARG1-of (w3 / weight-01
                :ARG1-of (s / same-01))
            :mod (p / premium))
        :op3 (s4 / suitcase
            :quant 2
            :ARG1-of (w2 / weigh-01
                :ARG3 (m2 / mass-quantity
                    :quant 32
                    :unit (k2 / kilogram)))
            :mod (b / business)))
    :rel (e / economy))

