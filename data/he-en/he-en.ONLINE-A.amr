    :ARG0 (y / you)
    :ARG1 (g2 / guide-01
        :ARG1-of (s / step-01)
        :ARG2 (t / thing
            :ARG2-of (p / price-01
                :ARG1 (b / baggage)
                :poss (a / airline
                    :ARG1-of (d / differ-02)))))
    :mode imperative)

