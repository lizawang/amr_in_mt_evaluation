(d / divide-02
    :ARG0 (i / index)
    :ARG1 (m2 / municipality)
    :ARG1-of (s / say-01
        :ARG0 (n / number))
    :ARG1-of (c / cause-01
        :ARG0 (r / resemble-01
            :ARG1 (m3 / municipality)
            :ARG2 (m4 / municipality
                :poss-of (p2 / person
                    :quant (m / more-than
                        :op1 150000)
                    :ARG0-of (r4 / reside-01)))
            :polarity -))
    :ARG2 (g / group
        :mod (s2 / size
            :quant 3))
    :rel (r2 / reside-01
        :ARG0 (p / person
            :quant (u / up-to
                :op1 50000)
            :ARG0-of (r3 / reside-01))))

# ::tok Tel Aviv surged this year
