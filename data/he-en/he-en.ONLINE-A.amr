# ::edge	name	op4	app.	n	3	
# ::edge	and	rel	government-organization	a4	g	
(a4 / and
    :condition (s / scenario,
        :ARG1-of (r / real-04))
    :op1 (a / activate-01
        :ARG1 (a3 / alert-01
            :mod (a2 / additional)))
    :op2 (r3 / report-01
        :ARG1 (e / event
            :ARG1-of (r2 / real-04)))
    :rel (g / government-organization
        :name (n / name
            :op1 "Home"
            :op2 "Front"
            :op3 "Command"
            :op4 "app.")))

