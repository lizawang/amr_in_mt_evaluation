# ::edge	divide-02	ARG1-of	say-01	d	s	
# ::edge	say-01	ARG0	number	s	n	
# ::edge	divide-02	ARG1-of	cause-01	d	c	
# ::edge	up-to	op1	50000	u	3	
# ::edge	person	quant	up-to	p	u	
# ::edge	reside-01	ARG0	person	r2	p	
# ::edge	person	ARG0-of	reside-01	p	r3	
# ::edge	resemble-01	polarity	-	r	0	
# ::edge	resemble-01	ARG1	municipality	r	m3	
# ::edge	cause-01	ARG0	resemble-01	c	r	
# ::edge	resemble-01	ARG2	municipality	r	m4	
