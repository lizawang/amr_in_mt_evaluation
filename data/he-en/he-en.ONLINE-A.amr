(a / allow-01
    :ARG0 (c / company
        :name (n / name
            :op1 "Virgin"
            :op2 "Atlantic"))
    :ARG1 (b2 / board-01
        :ARG0 (y / you)
        :ARG1 (p / plane)
        :duration (u / up-to
            :op1 (r / ratio-of
                :op1 28
                :op2 32))
        :instrument (o / or
            :op1 (t / trolley)
            :op2 (b / bag))))

