                    :quant 7
                    :unit (k / kilogram))))
        :mod (l / large
            :ARG2-of (h2 / have-degree-91
                :ARG1 h
                :ARG3 (m3 / more)
                :ARG4 (t / temporal-quantity
                    :quant 30
                    :quant 40))
            :polarity -))
    :ARG2 (m2 / monetary-quantity
        :ARG2-of (p / price-01
            :ARG1 (t2 / ticket)
            :mod (b / basic)))
    :location (f / facility
        :name (n / name
            :op1 "Arkia,")))

