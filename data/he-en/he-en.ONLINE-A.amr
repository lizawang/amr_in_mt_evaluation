    :ARG1 (a2 / alert-01
        :ARG2 (f / fire-01
            :ARG1 (a3 / and
                :op1 (r / rocket)
                :op2 (m / missile))
            :location (c2 / city
                :name (n / name
                    :op1 "Tel"
                    :op2 "Aviv")
                :ARG1-of (h / have-org-role-91
                    :ARG2 (c / center.)))))
