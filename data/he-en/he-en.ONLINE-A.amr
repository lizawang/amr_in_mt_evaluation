# ::edge	friendly-01	ARG2	business	f	b3	
# ::edge	business	location	boundary	b3	b2	
# ::edge	boundary	mod	each	b2	e	
# ::edge	base-02	rel	parameter	b	p	
(b / base-02
    :ARG1 (i / index)
    :rel (p / parameter
        :quant (s / several)
        :ARG0-of (e3 / examine-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG2 (b3 / business
                        :location (b2 / boundary
                            :mod (e / each))))))
        :ARG1-of (e2 / examine-01)))

# ::tok The index divides municipalities into three size groups according to the number of residents, since a municipality with up to 50,000 residents is not similar to a municipality with more than 150,000 residents.
