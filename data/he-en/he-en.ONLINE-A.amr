(p2 / percentage-entity
    :condition (r / raise-01
        :ARG1 (r2 / rate
            :mod (i2 / interest))
        :ARG2 (p / percentage-entity
            :value "half")
        :mod (i / indeed))
    :mod (l / level
        :ARG1-of (h / have-degree-91
            :ARG2 (h2 / high-02)
            :ARG3 (m / most)
            :ARG5 (l2 / level
                :duration (t / temporal-quantity
