# ::edge	update-01	ARG1	index	u	i	
# ::edge	update-01	frequency	rate-entity-91	u	r2	
# ::edge	temporal-quantity	quant	1	t3	0	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t3	
# ::edge	temporal-quantity	unit	year	t3	y	
# ::edge	and	op1	update-01	a3	u	
# ::edge	and	op2	weigh-01	a3	w	
# ::edge	weigh-01	ARG1	index	w	i	
# ::edge	rate-01	ARG1-of	differ-02	r	d	
# ::edge	rate-01	quant	4	r	1	
# ::edge	weigh-01	ARG3	rate-01	w	r	
# ::edge	authority:	ARG1-of	local-02	a5	l	
# ::edge	authority:	mod	each	a5	e	
# ::edge	rate-01	ARG0	authority:	r	a5	
# ::edge	satisfy-01	ARG1	business	s	b	
# ::edge	access-01	ARG1	satisfy-01	a	s	
# ::edge	access-01	ARG0	company	a	c2	
# ::edge	company	ARG0-of	tax-01	c2	t	
# ::edge	access-01	ARG1	information,	a2	i2	
# ::edge	and	op2	access-01	a4	a2	
