# ::edge	and	op2	in-advance-04	a2	i	
# ::edge	in-advance-04	ARG1	add-02	i	a	
(r / recommend-01
    :ARG1 (a / add-02
        :ARG0 (y / you)
        :ARG1 (b / baggage,)
        :manner (a2 / and
            :op1 (o / online)
            :op2 (i / in-advance-04
                :ARG1 a)))
    :ARG2 y
    :condition (w / wish-01
        :ARG0 y
        :ARG1 a))

