# ::edge	purchase-01	ARG1	ticket	p3	t	
# ::edge	company	name	name	c	n	
# ::edge	purchase-01	ARG2	company	p3	c	
# ::edge	name	mod	official	n	0	
# ::edge	put-01	ARG0	person	p4	p	
# ::edge	put-01	ARG1	money	p4	m	
# ::edge	money	poss	person	m	p	
# ::edge	put-01	ARG2	wing	p4	w	
# ::edge	wing	part-of	plane.	w	p2	
(p4 / put-01
    :ARG0 (p / person
        :ARG0-of (p3 / purchase-01
            :ARG1 (t / ticket)
            :ARG2 (c / company
                :name (n / name
                    :mod "official")))
        :mod (a / any))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing
        :part-of (p2 / plane.)))

# ::tok Tin Company.
# ::node	1	Tin	0-1
# ::node	c	company	1-2
# ::node	n	name	1-2
# ::node	0	Company.	1-2
# ::root	c	company
# ::edge	company	name	name	c	n	
# ::edge	name	op1	Tin	n	1	
# ::edge	name	op2	Company.	n	0	
(c / company
    :name (n / name
        :op1 "Tin"
        :op2 "Company."))

