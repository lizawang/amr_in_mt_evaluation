(d / divide-02
    :ARG0 (i / index)
    :ARG1 (a2 / authority)
    :ARG1-of (a / accord-02
        :ARG2 (n / number))
    :ARG1-of (c / cause-01
        :ARG0 (r / resemble-01
            :ARG1 (a3 / authority
                :ARG1-of (l / local-02
                    :ARG1 (a4 / authority
                        :mod (p2 / person
                            :quant (m / more-than
                                :op1 150000)
                            :ARG0-of (i2 / inhabit-01))))
                :consist-of (p / person
                    :quant (u / up-to
                        :op1 50000)
                    :ARG0-of i2
                    :ARG0-of (i3 / inhabit-01)))
            :ARG2 a4
            :polarity -))
    :ARG2 (g / group
        :mod (s / size
            :quant 3)))

