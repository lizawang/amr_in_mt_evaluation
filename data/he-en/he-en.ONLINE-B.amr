(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (e2 / examine-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG1 (a2 / authority)
                    :ARG2 (b2 / business
                        :location (a / area.
                            :poss a2)))))
        :ARG1-of (t / test-01
            :location a2))
    :rel (e / each))

# ::tok The index divides the authorities into three size groups according to the number of inhabitants, since a local authority of up to 50 thousand inhabitants is not similar to a local authority of more than 150 thousand inhabitants.
