# ::node	c	certain	5-6
# ::node	1	-	6-7
# ::node	t	tax-01	7-8
# ::node	a	and	8-9
# ::node	2	-	9-10
# ::node	f	food.	10-11
# ::root	a	and
# ::edge	luggage,	polarity	-	l	0	
# ::edge	tax-01	polarity	-	t	1	
# ::edge	tax-01	mod	certain	t	c	
# ::edge	and	op2	tax-01	a	t	
# ::edge	and	op1	luggage,	a	l	
# ::edge	food.	polarity	-	f	2	
# ::edge	and	op3	food.	a	f	
# ::edge	and	rel	seat	a	s	
(a / and
    :op1 (l / luggage,
        :polarity -)
    :op2 (t / tax-01
        :mod (c / certain)
        :polarity -)
    :op3 (f / food.
        :polarity -)
    :rel (s / seat))

# ::tok Vacation and Corona flights...
# ::node	v	vacation-01	0-1
# ::node	a	and	1-2
# ::node	c	city	2-3
# ::node	n	name	2-3
# ::node	0	Corona	2-3
# ::node	f	fly-01	3-4
# ::root	f	fly-01
# ::edge	and	op1	vacation-01	a	v	
# ::edge	and	op2	city	a	c	
# ::edge	city	name	name	c	n	
# ::edge	name	op1	Corona	n	0	
# ::edge	fly-01	ARG3	and	f	a	
(f / fly-01
    :ARG3 (a / and
        :op1 (v / vacation-01)
        :op2 (c / city
            :name (n / name
                :op1 "Corona"))))

# ::tok To all the members of the "Goelicia"...Ali!
