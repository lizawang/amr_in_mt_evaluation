(c / compare-01
    :ARG1 (p / percentage
        :quant-of (e / employ-01
            :polarity -)
        :time (h / half
            :ord (o / ordinal-entity
                :value 1)
            :part-of (d / date-entity
                :month 12
                :year 2021)))
    :ARG2 (h3 / half
        :ord (o2 / ordinal-entity
            :value 2)
        :part-of (d2 / date-entity
            :month 11
            :year 2021.))
    :rel 4.3%
    :rel 4.5%
    :rel (h2 / half))

