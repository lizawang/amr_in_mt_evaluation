# ::edge	have-org-role-91	ARG1	organization	h	o	
# ::edge	organization	name	name	o	n	
# ::edge	name	op1	Islam	n	0	
(p / person
    :ARG0-of (h / have-org-role-91
        :ARG1 (o / organization
            :name (n / name
                :op1 "Islam"))
        :ARG2 (m / member))
    :mod (a / all))

