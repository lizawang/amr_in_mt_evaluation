# ::edge	and	rel	report-01	a	r2	
(a / and
    :op2 (s / side-01
        :ARG0 (p / person
            :ARG0-of (r / report-01)
            :example (p2 / person
                :name (n / name
                    :op1 "Asaf"
                    :op2 "Golan")))
        :ARG1 (t / they)
        :ARG1-of (r3 / resemble-01
            :ARG2 (s2 / side-01
                :ARG0 p
                :time (e / event
                    :name (n2 / name
                        :op1 "Corona.")))))
    :rel (r2 / report-01))

