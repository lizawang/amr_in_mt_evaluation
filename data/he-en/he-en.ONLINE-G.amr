# ::edge	name	op1	Home	n	2	
# ::edge	name	op4	app.	n	3	
# ::edge	and	rel	government-organization	a3	g	
(a3 / and
    :condition (s / scenario,
        :ARG1-of (t2 / true-01))
    :op1 (t / trigger-01
        :ARG1 (a2 / alert-01
            :mod (a / additional)))
    :op2 (r / report-01
        :ARG1 (e / event
            :ARG1-of (t3 / true-01)))
    :rel (g / government-organization
        :name (n / name
            :op1 "Home"
            :op2 "Front"
            :op3 "Command"
            :op4 "app.")))

