(a2 / and
    :op1 (i / include-01
        :ARG1 (b / baggage
            :ARG1-of (w / weigh-01
                :ARG2 (u / up-to
                    :op1 (m / mass-quantity
                        :quant 23
                        :unit (k / kilogram)))))
        :ARG2 (p3 / price-01
            :ARG1 (t2 / ticket))
        :location (c / class
            :ARG1-of (h2 / high-02)))
    :op2 (p / possible-01
        :ARG1 (t / take-01
            :ARG0 (y / you)
            :ARG1 (s / suitcase
                :quant 2)
            :condition (e / economy
                :mod (p2 / premium))
            :mod (a / also)))
    :rel (h / have-degree-91
        :ARG2 h2
        :ARG3 (m2 / more)))

