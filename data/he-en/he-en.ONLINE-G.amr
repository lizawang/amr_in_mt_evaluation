(h / have-degree-91
    :ARG1 (p / plane)
    :ARG2 (g / good-02)
    :ARG3 (m / more)
    :rel (g3 / ground-01
        :ARG1 p
        :ARG1-of (i / instead-of-91
            :ARG2 (a / and
                :op1 (f / fly-01
                    :destination (c / country,)
                    :direction (b / back))
                :op2 (a2 / avoid-01
                    :ARG1 (d / damage-01
                        :ARG1 (e / economy)))))
        :location (g2 / ground,)))

