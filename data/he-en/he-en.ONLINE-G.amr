    :ARG1 (m / monetary-quantity
        :ARG2-of (c / cost-01
            :ARG1 (m3 / mortgage-01)))
    :ARG3 (a / amr-unknown)
    :condition (i / increase-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG2 (p2 / percentage-entity
            :value "half"))
    :frequency (r2 / rate-entity-91
        :ARG2 (t / temporal-quantity
            :quant 1
            :unit (m2 / month))))

