(c / cost-01
    :ARG1 (s2 / supplement
        :mod (s / suitcase)
        :mod (l / large))
    :ARG2 (m / monetary-quantity
        :quant 75
        :unit (d / dollar))
    :condition (p2 / purchase-01
        :ARG0 (y / you)
        :ARG1 (p / product
            :name (n / name
                :op1 "Lite")))
    :location (f / field.))

