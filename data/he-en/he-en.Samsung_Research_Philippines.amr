# ::node	m4	mortgage-01	20-21
# ::node	m3	monetary-quantity	22-23
# ::node	p2	pound	22-23
# ::node	i2	intercontinental	22-23
# ::node	0	11	24-25
# ::root	a	amount-01
# ::edge	rate	mod	interest	r	i3	
# ::edge	go-01	ARG1	rate	g	r	
# ::edge	go-01	direction	up	g	u	
# ::edge	increase-01	ARG2	monetary-quantity	i	m	
