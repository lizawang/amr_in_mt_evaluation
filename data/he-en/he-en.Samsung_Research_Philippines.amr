# ::node	a	amr-unknown	1-2
# ::node	y	you	3-4
# ::node	g	goal	4-5
# ::node	s	season?	7-8
# ::root	g	goal
# ::edge	goal	poss	you	g	y	
# ::edge	goal	domain	amr-unknown	g	a	
# ::edge	goal	li	-1	g	0	
# ::edge	goal	time	season?	g	s	
(g / goal
    :li -1
    :domain (a / amr-unknown)
    :poss (y / you)
    :time (s / season?))

