(l / locate-01
    :ARG1 (a2 / and
        :op1 (c / city
            :name (n / name
                :op1 "Rishon"
                :op2 "LeZion,"))
        :op2 (c3 / city
            :name (n3 / name
                :op1 "Haifa,"
                :op1 "Ramat"
                :op2 "Holon,"))
        :op3 (c4 / city
            :name (n6 / name
                :op1 "Bnei"
                :op2 "Brak."))
        :op4 (c5 / city
            :name n6))
    :rel (c2 / city
        :name (n2 / name
            :op1 "Tel"
            :op2 "Aviv,"))
    :rel (n4 / name
        :op1 "Bat"
        :op2 "Yam,"
        :op3 "Beer"
        :op4 "Sheva,")
    :rel (n5 / name
        :op1 "Netanya")
    :time (a / after
        :op1 (t / they)))

# ::tok The agency edits the Local Authorities Index.
