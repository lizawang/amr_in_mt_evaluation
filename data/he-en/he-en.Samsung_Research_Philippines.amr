# ::edge	increase-01	ARG2	amr-unknown	i	a	
# ::edge	increase-01	condition	go-01	i	g	
(i / increase-01
    :ARG1 (p / pay-01
        :ARG3 (m2 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :ARG2 (a / amr-unknown)
    :condition (g / go-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG2 (p2 / percentage-entity
            :value "half")
        :direction (u / up)))

# ::tok In a NIS 1.2 million mortgage, which consists of a 40% prime rate route, monthly repayments will increase by NIS 125.
# ::node	m	monetary-quantity	4-5
# ::node	d	dollar	4-5
# ::node	1	120000000	4-5
# ::node	c	consist-01	7-8
# ::node	p	percentage-entity	10-11
# ::node	3	40%	10-11
# ::node	p3	prime	11-12
# ::node	r	rate	12-13
# ::node	r4	route,	13-14
# ::node	r2	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	m3	month	14-15
# ::node	0	1	14-15
# ::node	r3	repay-01	15-16
# ::node	i	increase-01	17-18
# ::node	m2	monetary-quantity	19-20
# ::node	p2	pound	19-20
# ::node	a	National	19-20
# ::node	2	125.	20-21
# ::root	i	increase-01
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	monetary-quantity	quant	120000000	m	1	
# ::edge	monetary-quantity	ARG1-of	consist-01	m	c	
# ::edge	percentage-entity	value	40%	p	3	
# ::edge	rate	mod	prime	r	p3	
# ::edge	rate	mod	percentage-entity	r	p	
# ::edge	route,	mod	rate	r4	r	
# ::edge	consist-01	ARG2	route,	c	r4	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m3	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	repay-01	frequency	rate-entity-91	r3	r2	
# ::edge	increase-01	ARG1	repay-01	i	r3	
# ::edge	increase-01	location	monetary-quantity	i	m	
# ::edge	increase-01	ARG2	monetary-quantity	i	m2	
# ::edge	monetary-quantity	unit	pound	m2	p2	
# ::edge	pound	mod	monetary-quantity	p2	m	
# ::edge	monetary-quantity	unit	National	m2	a	
# ::edge	monetary-quantity	quant	125.	m2	2	
(i / increase-01
    :ARG1 (r3 / repay-01
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m3 / month))))
    :ARG2 (m2 / monetary-quantity
        :quant 125.
        :unit (p2 / pound
            :mod (m / monetary-quantity
                :quant 120000000
                :ARG1-of (c / consist-01
                    :ARG2 (r4 / route,
                        :mod (r / rate
                            :mod (p3 / prime)
                            :mod (p / percentage-entity
                                :value 40%))))
                :unit (d / dollar)))
        :unit (a / National))
    :location m)

# ::tok How much has the average mortgage increased since the beginning of the year?
# ::node	a	amr-unknown	0-1
# ::node	a2	average-04	4-5
# ::node	m	mortgage-01	5-6
# ::node	i	increase-01	6-7
# ::node	s	since	7-8
# ::node	b	begin-01	9-10
# ::node	y	year?	12-13
# ::root	i	increase-01
# ::edge	mortgage-01	ARG1-of	average-04	m	a2	
# ::edge	increase-01	ARG1	mortgage-01	i	m	
# ::edge	increase-01	ARG2	amr-unknown	i	a	
# ::edge	increase-01	time	since	i	s	
# ::edge	since	op1	begin-01	s	b	
# ::edge	begin-01	ARG1	year?	b	y	
(i / increase-01
    :ARG1 (m / mortgage-01
        :ARG1-of (a2 / average-04))
    :ARG2 (a / amr-unknown)
    :time (s / since
        :op1 (b / begin-01
            :ARG1 (y / year?))))

# ::tok Since the beginning of the year, this is a significantly higher increase.
# ::node	s2	since	0-1
# ::node	b	begin-01	2-3
# ::node	t	this	6-7
# ::node	s	significant-02	9-10
# ::node	h	have-degree-91	10-11
# ::node	h2	high-02	10-11
# ::node	m	more	10-11
# ::node	i	increase-01	11-12
