# ::edge	before	op1	bear-02	b2	b	
# ::edge	result-01	frequency	sometimes	r	s	
# ::edge	identify-01	ARG1-of	result-01	i	r	
# ::edge	palsy.	mod	cerebrum	p	c	
# ::edge	result-01	ARG2	palsy.	r	p	
(i2 / involve-01
    :ARG1 (i / identify-01
        :ARG1 (d / distress-01
            :ARG1 (f / fetus))
        :ARG1-of (r / result-01
            :ARG2 (p / palsy.
                :mod (c / cerebrum))
            :frequency (s / sometimes))
        :polarity -
        :time (b2 / before
            :op1 (b / bear-02)))
    :ARG2 (m / malpractice
        :quant (m3 / most)
        :mod (m2 / medicine)
        :mod (c2 / contraction-stage)))

