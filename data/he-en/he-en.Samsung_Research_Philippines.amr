# ::edge	have-degree-91	ARG3	more	h	m	
# ::edge	more	ARG1-of	significant-02	m	s	
# ::edge	have-degree-91	ARG4	increase-01	h	i	
# ::edge	increase-01	ARG1	this	i	t	
(h / have-degree-91
    :ARG1 (t / this)
    :ARG2 (h2 / high-02)
    :ARG3 (m / more
        :ARG1-of (s / significant-02))
    :ARG4 (i / increase-01
        :ARG1 t)
    :time (s2 / since
        :op1 (b / begin-01)))

# ::tok That's because interest rates on the rest of the routes that make up a mortgage (not just a prime route) have also risen.
# ::node	c	cause-01	1-2
# ::node	i	interest	2-3
# ::node	r	rate	3-4
# ::node	r2	rest	6-7
# ::node	r4	route	9-10
# ::node	m	make-up-07	11-12
# ::node	m2	mortgage-01	14-15
# ::node	c2	contrast-01	15-16
# ::node	j	just	16-17
# ::node	p	prime	18-19
# ::node	r5	route)	19-20
# ::node	a	also	21-22
# ::node	r3	rise-01	22-23
# ::root	c	cause-01
# ::edge	rate	mod	interest	r	i	
# ::edge	route	mod	rest	r4	r2	
# ::edge	rate	location	route	r	r4	
# ::edge	route	ARG0-of	make-up-07	r4	m	
# ::edge	make-up-07	ARG1	mortgage-01	m	m2	
# ::edge	route	ARG1-of	contrast-01	r4	c2	
# ::edge	route)	mod	prime	r5	p	
# ::edge	route)	mod	just	r5	j	
# ::edge	contrast-01	ARG2	route)	c2	r5	
# ::edge	rise-01	mod	also	r3	a	
# ::edge	rise-01	ARG1	rate	r3	r	
# ::edge	cause-01	ARG0	rise-01	c	r3	
(c / cause-01
    :ARG0 (r3 / rise-01
        :ARG1 (r / rate
            :location (r4 / route
                :ARG0-of (m / make-up-07
                    :ARG1 (m2 / mortgage-01))
                :ARG1-of (c2 / contrast-01
                    :ARG2 (r5 / "route)"
                        :mod (p / prime)
                        :mod (j / just)))
                :mod (r2 / rest))
            :mod (i / interest))
        :mod (a / also)))

# ::tok If interest rates do go up by half a percent, the increase will amount to NIS 620 million in a mortgage of NIS 1.2 million.
