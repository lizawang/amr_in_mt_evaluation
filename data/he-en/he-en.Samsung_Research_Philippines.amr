# ::edge	city	name	name	c2	n2	
# ::edge	name	op1	Jerusalem.	n2	2	
(t / talk-01
    :quant (l2 / lot)
    :ARG1 (e / event
        :time (s2 / semi-final
            :time (s / season
                :mod (l / last)))
        :time (s3 / shout-01
            :ARG0 (i / i)
            :ARG1 (c / cause-01
                :ARG0 s3
                :ARG1 (c3 / come-01
                    :ARG1 (p / person
                        :name (n / name
                            :op1 "Ami"
                            :op2 "Biton,"))
                    :ARG4 (c2 / city
                        :name (n2 / name
                            :op1 "Jerusalem."))))
            :ARG2 p)))

