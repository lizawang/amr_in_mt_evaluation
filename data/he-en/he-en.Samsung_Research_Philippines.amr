# ::edge	name	op1	New	n2	4	
# ::edge	city	name	name	c	n2	
# ::edge	name	op2	York	n2	5	
# ::edge	and	op1	city	a	c	
# ::edge	passenger	destination	and	p	a	
# ::edge	and	op2	city	a	c2	
# ::edge	city	name	name	c2	n3	
# ::edge	name	op1	Miami	n3	3	
# ::edge	baggage	quant	23-pound	b	0	
# ::edge	and	op1	baggage	a2	b	
# ::edge	offer-01	ARG1	and	o	a2	
# ::edge	baggage.	mod	trolley	b2	t	
# ::edge	and	op2	baggage.	a2	b2	
(o / offer-01
    :ARG0 (c3 / company
        :name (n / name
            :op1 "American"
            :op2 "Airlines"))
    :ARG1 (a2 / and
        :op1 (b / baggage
            :quant 23-pound)
        :op2 (b2 / baggage.
            :mod (t / trolley)))
    :ARG3 (p / passenger
        :destination (a / and
            :op1 (c / city
                :name (n2 / name
                    :op1 "New"
                    :op2 "York"))
            :op2 (c2 / city
                :name (n3 / name
                    :op1 "Miami")))))

# ::tok If you want to add a large suitcase weighing 23 kilograms, you'll pay $100 towards it.
# ::node	y	you	1-2
# ::node	w	want-01	2-3
# ::node	a	add-02	4-5
# ::node	l	large	6-7
# ::node	s	suitcase	7-8
# ::node	w2	weigh-01	8-9
# ::node	1	23	9-10
# ::node	m	mass-quantity	10-11
# ::node	p2	pound	10-11
# ::node	p	pay-01	12-13
# ::node	m2	monetary-quantity	13-14
# ::node	d	dollar	13-14
# ::node	0	100	13-14
# ::root	p	pay-01
# ::edge	want-01	ARG0	you	w	y	
# ::edge	want-01	ARG1	add-02	w	a	
# ::edge	add-02	ARG0	you	a	y	
# ::edge	suitcase	mod	large	s	l	
# ::edge	add-02	ARG1	suitcase	a	s	
# ::edge	suitcase	ARG1-of	weigh-01	s	w2	
# ::edge	mass-quantity	quant	23	m	1	
# ::edge	weigh-01	ARG3	mass-quantity	w2	m	
# ::edge	mass-quantity	unit	pound	m	p2	
# ::edge	pay-01	ARG3	suitcase	p	s	
# ::edge	pay-01	ARG0	you	p	y	
# ::edge	pay-01	ARG1	monetary-quantity	p	m2	
# ::edge	monetary-quantity	unit	dollar	m2	d	
# ::edge	monetary-quantity	quant	100	m2	0	
# ::edge	pay-01	rel	want-01	p	w	
(p / pay-01
    :ARG0 (y / you)
    :ARG1 (m2 / monetary-quantity
        :quant 100
        :unit (d / dollar))
    :ARG3 (s / suitcase
        :ARG1-of (w2 / weigh-01
            :ARG3 (m / mass-quantity
                :quant 23
                :unit (p2 / pound)))
        :mod (l / large))
    :rel (w / want-01
        :ARG0 y
        :ARG1 (a / add-02
            :ARG0 y
            :ARG1 s)))

# ::tok United Airlines offers a suitcase weighing up to 23 kilograms in economy class, two suitcases at the same weight, and two suitcases at 32 kg.
