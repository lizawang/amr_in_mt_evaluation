# ::edge	lead-03	ARG0	job	l	j	
# ::edge	contrast-01	ARG2	lead-03	c2	l	
# ::edge	more-than	op1	38000000000	m	2	
# ::edge	search-01	quant	more-than	s	m	
# ::edge	lead-03	ARG2	search-01	l	s	
# ::edge	cause-01	ARG1-of	likely-01	c	l2	
# ::edge	lead-03	ARG1-of	cause-01	l	c	
# ::edge	cause-01	ARG0	return-01	c	r	
# ::edge	skill	polarity	-	s2	0	
# ::edge	person	mod	skill	p	s2	
# ::edge	return-01	ARG1	person	r	p	
# ::edge	person	ARG0-of	work-01	p	w	
(c2 / contrast-01
    :ARG2 (l / lead-03
        :ARG0 (j / job
            :ARG0-of (e / experience-01
                :polarity -))
        :ARG1-of (c / cause-01
            :ARG0 (r / return-01
                :ARG1 (p / person
                    :ARG0-of (w / work-01)
                    :mod (s2 / skill
                        :polarity -)))
            :ARG1-of (l2 / likely-01))
        :ARG2 (s / search-01
            :quant (m / more-than
                :op1 38000000000))))

