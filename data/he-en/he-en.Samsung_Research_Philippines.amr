# ::node	e	each	13-14
# ::node	l	local-02	14-15
# ::node	a4	authority:	15-16
# ::node	b	business	16-17
# ::node	s	satisfy-01	17-18
# ::node	t3	tend-02	18-19
# ::node	a	access-01	19-20
# ::node	a3	and	20-21
# ::node	t	tax-01	21-22
# ::root	a2	and
# ::edge	update-01	ARG1	index	u	i	
# ::edge	update-01	frequency	rate-entity-91	u	r2	
# ::edge	temporal-quantity	quant	1	t2	0	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t2	
# ::edge	temporal-quantity	unit	year	t2	y	
# ::edge	and	op1	update-01	a2	u	
# ::edge	and	op2	weigh-01	a2	w	
# ::edge	weigh-01	ARG1	index	w	i	
# ::edge	rank-01	ARG1-of	differ-02	r	d	
# ::edge	rank-01	quant	4	r	1	
# ::edge	weigh-01	ARG3	rank-01	w	r	
# ::edge	rank-01	ARG1	index	r	i	
# ::edge	authority:	ARG1-of	local-02	a4	l	
# ::edge	authority:	mod	each	a4	e	
# ::edge	rank-01	source	authority:	r	a4	
# ::edge	satisfy-01	ARG1	business	s	b	
# ::edge	access-01	ARG1	tend-02	a	t3	
# ::edge	and	op2	access-01	a3	a	
# ::edge	and	op1	satisfy-01	a3	s	
# ::edge	rank-01	ARG2	and	r	a3	
# ::edge	and	op3	tax-01	a3	t	
(a2 / and
    :op1 (u / update-01
        :ARG1 (i / index)
        :frequency (r2 / rate-entity-91
            :ARG3 (t2 / temporal-quantity
                :quant 1
                :unit (y / year))))
    :op2 (w / weigh-01
        :ARG1 i
        :ARG3 (r / rank-01
            :quant 4
            :ARG1 i
            :ARG1-of (d / differ-02)
            :ARG2 (a3 / and
                :op1 (s / satisfy-01
                    :ARG1 (b / business))
                :op2 (a / access-01
                    :ARG1 (t3 / tend-02))
                :op3 (t / tax-01))
            :source (a4 / "authority:"
                :ARG1-of (l / local-02)
                :mod (e / each)))))

