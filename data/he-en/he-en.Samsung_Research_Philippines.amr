    :ARG2 (a / and
        :op1 (i / increase-01
            :ARG1 (w / wage
                :time (d / date-entity
                    :year 2021))
            :ARG2 (p / percentage-entity
                :ARG1-of (c / compare-01
                    :ARG2 (d2 / date-entity
                        :year 2020,))
                :value 2%))
