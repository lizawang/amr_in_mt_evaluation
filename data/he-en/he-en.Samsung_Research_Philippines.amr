(e / edit-01
    :ARG0 (a / agency)
    :ARG1 (i / index
        :mod (a2 / authority
            :ARG1-of (l / local-02))))

# ::tok This is the fifth time, as it allows each authority to compare its performance to other authorities in a variety of parameters.
