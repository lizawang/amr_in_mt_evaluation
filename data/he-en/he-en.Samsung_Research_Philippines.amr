# ::edge	monetary-quantity	unit	pound	m3	p2	
# ::edge	pound	mod	intercontinental	p2	i2	
# ::edge	monetary-quantity	quant	11	m3	0	
# ::edge	amount-01	rel	half	a	h	
(a / amount-01
    :ARG1 (i / increase-01
        :ARG2 (m / monetary-quantity
            :ARG3-of (m4 / mortgage-01
                :ARG1 (m3 / monetary-quantity
                    :quant 11
                    :unit (p2 / pound
                        :mod (i2 / intercontinental))))))
    :ARG2 (m2 / monetary-quantity
        :quant 600000000
        :unit (p / pound))
    :condition (g / go-01
        :ARG1 (r / rate
            :mod (i3 / interest))
        :ARG2 i
        :direction (u / up))
    :rel (h / half))

