(p3 / possible-01
    :ARG1 (e / enter-01
        :ARG0 (p / person
            :ARG0-of (t / tour-01)
            :ARG1-of (v / vaccinate-01))
        :ARG1 (c / country
            :name (n / name
                :op1 "Israel"))
        :ARG1-of (r / resemble-01
            :ARG2 (p2 / person
                :ARG1-of (r2 / return-01
                    :ARG3 (c2 / country.
                        :mod (o / orange))))))
    :rel -
    :time (a / as-of
        :op1 (d / date-entity
            :day 9,
            :month 1)))

