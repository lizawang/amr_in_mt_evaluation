                    :mod (b / basic)))))
    :op2 (w / weigh-01
        :ARG1 h
        :ARG2 (u / up-to
            :op1 (m / mass-quantity
                :quant 7
                :unit (k / kilogram))))
    :rel (t2 / temporal-quantity
        :quant 40))

