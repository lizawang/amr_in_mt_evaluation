# ::edge	weigh-01	ARG3	up-to	w	u	
# ::edge	mass-quantity	quant	23	m	1	
# ::edge	up-to	op1	mass-quantity	u	m	
# ::edge	mass-quantity	unit	kilogram	m	k	
# ::edge	class,	mod	economy	c	e	
# ::edge	suitcase	mod	class,	s2	c	
# ::edge	same-01	ARG2	up-to	s	u	
# ::edge	and	op1	suitcase	a	s2	
# ::edge	offer-01	ARG1	and	o	a	
# ::edge	suitcase	quant	2	s3	0	
# ::edge	and	op2	suitcase	a	s3	
# ::edge	mass-quantity	quant	32	m2	2	
# ::edge	suitcase	mod	mass-quantity	s3	m2	
# ::edge	mass-quantity	unit	kilogram	m2	k2	
# ::edge	offer-01	rel	same-01	o	s	
(o / offer-01
    :ARG0 (c2 / company
        :name (n / name
            :op1 "United"
            :op2 "Airlines"))
    :ARG1 (a / and
        :op1 (s2 / suitcase
            :ARG1-of (w / weigh-01
                :ARG3 (u / up-to
                    :op1 (m / mass-quantity
                        :quant 23
                        :unit (k / kilogram))))
            :mod (c / class,
                :mod (e / economy)))
        :op2 (s3 / suitcase
            :quant 2
            :mod (m2 / mass-quantity
                :quant 32
                :unit (k2 / kilogram))))
    :rel (s / same-01
        :ARG2 u))

