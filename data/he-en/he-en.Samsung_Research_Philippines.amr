    :ARG0 (p2 / person
        :name (n / name
            :op1 "Blazer"))
    :ARG1 (f / future
        :poss p2)
    :concession (t2 / train-01
        :ARG0 p2
        :manner (i / intensive))
    :mod (a / also)
