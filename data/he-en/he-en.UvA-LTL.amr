(c / check-01
    :ARG0 (w / we)
    :ARG1 (a / and
        :op1 (m / monetary-quantity
            :quant (m2 / more)
            :ARG1-of (p / pay-01
                :ARG0 w))
        :op2 (t / thing
            :ARG1-of (d / do-02
                :ARG0 w
                :ARG1-of (r / recommend-01)
                :time (n2 / now.))))
