(a / and
    :location (a2 / article,
        :mod (t / this))
    :op1 (e / examine-01
        :ARG0 (w / we)
        :ARG1 (s / stage
            :mod (v / various)))
    :op2 (e2 / explain-01
        :ARG0 w
        :ARG1 (c / complicate-01
            :ARG1-of (p / possible-01)
            :time s))
    :time (r / rise-01
        :ARG1 c
        :ARG4 (m / malpractice.
            :mod (m2 / medicine))))

# ::tok The Axes Stage
# ::node	a	ass	1-2
# ::node	s	stage	2-3
# ::root	s	stage
# ::edge	stage	mod	ass	s	a	
(s / stage
    :mod (a / ass))

# ::tok The contraction stage lasts an average of 8 to 14 hours.
# ::node	c	contract-02	1-2
# ::node	s	stage	2-3
# ::node	l	last-01	3-4
# ::node	a	average-01	5-6
# ::node	b	between	7-8
# ::node	1	8	7-8
# ::node	0	14	9-10
# ::node	t	temporal-quantity	10-11
# ::node	h	hour	10-11
# ::node	t2	temporal-quantity	10-11
# ::node	h2	hour	10-11
# ::root	l	last-01
# ::edge	stage	mod	contract-02	s	c	
# ::edge	last-01	ARG1	stage	l	s	
# ::edge	between	ARG2-of	average-01	b	a	
# ::edge	last-01	ARG2	between	l	b	
