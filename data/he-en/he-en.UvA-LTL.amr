# ::root	e	expensive?
# ::edge	rate	mod	interest	r	i2	
# ::edge	increase-01	ARG1	rate	i	r	
# ::edge	increase-01	ARG2	half	i	h	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	unit	month	t	m	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	pay-01	ARG3	mortgage-01	p	m2	
# ::edge	expensive?	domain	pay-01	e	p	
# ::edge	expensive?	condition	increase-01	e	i	
# ::edge	expensive?	rel	amr-unknown	e	a	
(e / expensive?
    :condition (i / increase-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG2 (h / half))
    :domain (p / pay-01
        :ARG3 (m2 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :rel (a / amr-unknown))

# ::tok In a NIS 1.2 million mortgage, consisting of 40% prime interest rate, the monthly repayment will increase by NIS 125.
