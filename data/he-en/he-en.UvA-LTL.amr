# ::edge	name	op1	Nazism	n	3	
# ::edge	increase-01	rel	interest	i	i2	
(i / increase-01
    :ARG1 (r2 / repay-01
        :frequency (r / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m2 / month))))
    :ARG2 (m / monetary-quantity
        :quant 1200000000000
        :ARG1-of (c / consist-01)
        :unit (d / dollar
            :mod (c2 / country
                :name (n / name
                    :op1 "Nazism")))
        :unit (e / euro))
    :rel (i2 / interest
        :quant (p / percentage-entity
            :value 40%)
        :mod (p2 / prime)))

# ::tok How much is the average mortgage rate this year?
