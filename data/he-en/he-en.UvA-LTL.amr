    :ARG0 (l / land-01
        :location (c / country
            :name (n / name
                :op1 "Israel")))
    :ARG1 (n5 / notice-03
        :ARG0 (g / government-organization
            :name (n2 / name
                :op1 "Ministry"
                :op2 "of"
                :op3 "Health"))
        :ARG1 (e / exempt-01
            :ARG1 l
            :ARG2 (r3 / require-01
                :ARG1 (i / isolate-01))
