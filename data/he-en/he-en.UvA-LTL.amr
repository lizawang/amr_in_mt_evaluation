(c / cause-01
    :ARG0 (i / increase-01
        :ARG1 (r / rate
            :location (t5 / "track)"
                :mod (p / prime)
                :mod (o / only
                    :polarity -))
            :mod (i2 / interest))
        :location (a2 / and
