# ::edge	burden-01	ARG0	increase-01	b	i	
# ::edge	burden-01	ARG1	household	b	h	
(a / and
    :op1 (i2 / increase-01
        :ARG0 (i / increase-01
            :ARG1 (r / rate
                :mod (i3 / interest))
            :ARG1-of (s / sharp-02))
        :ARG1 (r2 / repay-01
            :ARG1 (m2 / mortgage-01))
        :ARG2 (m3 / multiple
            :op1 (m / monetary-quantity
                :quant 100
                :unit (s2 / she))))
    :op2 (b / burden-01
        :ARG0 i
        :ARG1 (h / household)
        :manner (d / drastic)))

