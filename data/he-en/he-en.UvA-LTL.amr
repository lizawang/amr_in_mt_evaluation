            :ARG1 (t / they))
        :ARG2 (c2 / change-01
            :ARG1 (t2 / thing
                :ARG2-of (p / price-01)))))

# ::tok Whoever buys tickets puts their money on the plane's wing.
# ::node	p	person	0-1
# ::node	a	any	0-1
# ::node	b	buy-01	1-2
# ::node	t	ticket	2-3
# ::node	p3	put-01	3-4
# ::node	m	money	5-6
# ::node	p2	plane's	8-9
# ::node	w	wing.	9-10
# ::root	p3	put-01
# ::edge	person	mod	any	p	a	
# ::edge	person	ARG0-of	buy-01	p	b	
# ::edge	buy-01	ARG1	ticket	b	t	
# ::edge	put-01	ARG0	person	p3	p	
# ::edge	put-01	ARG1	money	p3	m	
# ::edge	money	poss	person	m	p	
# ::edge	wing.	part-of	plane's	w	p2	
# ::edge	put-01	ARG2	wing.	p3	w	
(p3 / put-01
    :ARG0 (p / person
        :ARG0-of (b / buy-01
            :ARG1 (t / ticket))
        :mod (a / any))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing.
        :part-of (p2 / plane's)))

