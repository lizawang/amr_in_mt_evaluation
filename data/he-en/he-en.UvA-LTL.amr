# ::edge	monetary-quantity	polite	+	m	0	
# ::edge	monetary-quantity	quant	5	m	1	
(e / easy-05
    :quant (m / monetary-quantity
        :quant 5
        :polite +
        :unit (d / dollar))
    :manner (w / way))

# ::tok From the deceitful religious who controls the company along with his fucked-up son I don't even buy for $10, nonstop deceitful...
# ::node	p	person	2-3
# ::node	r	religious	3-4
# ::node	c2	control-01	5-6
# ::node	c	company	7-8
# ::node	a	and	9-10
# ::node	p2	person	12-13
# ::node	h	have-rel-role-91	12-13
# ::node	s	son	12-13
# ::node	i	i	13-14
# ::node	0	-	14-15
# ::node	e	even	15-16
# ::node	b	buy-01	16-17
# ::node	c3	cost-01	18-19
# ::node	m	monetary-quantity	18-19
# ::node	d2	dollar	18-19
# ::node	2	10	18-19
# ::node	s2	stop-01	19-20
# ::node	1	-	19-20
# ::node	d	deceitful...	20-21
# ::root	d	deceitful...
# ::edge	person	mod	religious	p	r	
# ::edge	person	ARG0-of	control-01	p	c2	
# ::edge	control-01	ARG1	company	c2	c	
# ::edge	and	op1	person	a	p	
# ::edge	and	op2	person	a	p2	
# ::edge	person	ARG0-of	have-rel-role-91	p2	h	
# ::edge	have-rel-role-91	ARG1	person	h	p	
# ::edge	have-rel-role-91	ARG2	son	h	s	
# ::edge	buy-01	mod	even	b	e	
# ::edge	buy-01	polarity	-	b	0	
# ::edge	buy-01	ARG0	i	b	i	
# ::edge	person	ARG1-of	buy-01	p2	b	
# ::edge	buy-01	ARG1-of	cost-01	b	c3	
# ::edge	cost-01	ARG2	monetary-quantity	c3	m	
# ::edge	monetary-quantity	unit	dollar	m	d2	
# ::edge	monetary-quantity	quant	10	m	2	
# ::edge	stop-01	polarity	-	s2	1	
# ::edge	deceitful...	ARG1-of	stop-01	d	s2	
# ::edge	deceitful...	source	and	d	a	
(d / deceitful...
    :ARG1-of (s2 / stop-01
        :polarity -)
    :source (a / and
        :op1 (p / person
            :ARG0-of (c2 / control-01
                :ARG1 (c / company))
            :mod (r / religious))
        :op2 (p2 / person
            :ARG0-of (h / have-rel-role-91
                :ARG1 p
                :ARG2 (s / son))
            :ARG1-of (b / buy-01
                :ARG0 (i / i)
                :ARG1-of (c3 / cost-01
                    :ARG2 (m / monetary-quantity
                        :quant 10
                        :unit (d2 / dollar)))
                :mod (e / even)
                :polarity -))))

# ::tok And then the company will cancel the flights and offer vouchers that will be worthless.
# ::node	a	and	0-1
# ::node	t	then	1-2
# ::node	c2	company	3-4
# ::node	c	cancel-01	5-6
# ::node	f	fly-01	7-8
# ::node	a2	and	8-9
# ::node	o	offer-01	9-10
# ::node	v	voucher	10-11
# ::node	0	-	13-14
# ::node	w	worth-01	14-15
# ::root	a	and
# ::edge	and	time	then	a	t	
# ::edge	cancel-01	ARG0	company	c	c2	
# ::edge	cancel-01	ARG1	fly-01	c	f	
# ::edge	and	op1	cancel-01	a2	c	
# ::edge	and	op2	and	a	a2	
# ::edge	and	op2	offer-01	a2	o	
# ::edge	offer-01	ARG0	company	o	c2	
# ::edge	offer-01	ARG1	voucher	o	v	
# ::edge	worth-01	polarity	-	w	0	
# ::edge	voucher	ARG1-of	worth-01	v	w	
(a / and
    :op2 (a2 / and
        :op1 (c / cancel-01
            :ARG0 (c2 / company)
            :ARG1 (f / fly-01))
        :op2 (o / offer-01
            :ARG0 c2
            :ARG1 (v / voucher
                :ARG1-of (w / worth-01
                    :polarity -))))
    :time (t / then))

