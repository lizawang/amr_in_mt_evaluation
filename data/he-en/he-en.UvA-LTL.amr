                :year 2022))
        :ARG2 (r3 / reduce-01
            :ARG1 (r / rate
                :mod (c / consume-01
                    :ARG0 (p2 / person
                        :ARG0-of (c2 / consume-01
                            :ARG1 (h / household)))
                    :ARG1 e))
            :ARG2 (a / about
                :op1 (p / percentage-entity
                    :value 4%))))
    :rel (c3 / country
        :name (n / name
            :op1 "neo-Nazism")))

