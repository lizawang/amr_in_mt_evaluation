# ::edge	allow-01	ARG0	cervix	a2	c2	
# ::edge	pass-03	ARG1	fetus	p	f	
# ::edge	allow-01	ARG1	pass-03	a2	p	
# ::edge	pass-03	time	bear-02	p	b	
# ::edge	and	op1	open-01	a3	o	
# ::edge	and	time	this	a3	t	
# ::edge	end-01	ARG1	process-02	e	p2	
# ::edge	and	op2	recommend-01	a3	r2	
# ::edge	recommend-01	ARG1	reach-01	r2	r	
# ::edge	reach-01	time	end-01	r	e	
# ::edge	reach-01	ARG0	cervix	r	c2	
# ::edge	reach-01	ARG1	diameter	r	d	
# ::edge	diameter	mod	about	d	a	
# ::edge	distance-quantity	quant	10	d2	0	
# ::edge	about	op1	distance-quantity	a	d2	
# ::edge	distance-quantity	unit	centimeter	d2	c	
(a3 / and
    :op1 (o / open-01
        :purpose (a2 / allow-01
            :ARG0 (c2 / cervix)
            :ARG1 (p / pass-03
                :ARG1 (f / fetus)
                :time (b / bear-02)))
        :ARG1 c2
        :manner (g / gradual))
    :op2 (r2 / recommend-01
        :ARG1 (r / reach-01
            :ARG0 c2
            :ARG1 (d / diameter
                :mod (a / about
                    :op1 (d2 / distance-quantity
                        :quant 10
                        :unit (c / centimeter))))
            :time (e / end-01
                :ARG1 (p2 / process-02))))
    :time (t / this))

# ::tok Most cases of medical negligence at the contraction stage deal with the failure to identify fetal distress prior to birth, which caused damage to the newborn, which is sometimes even expressed in cerebral palsy.
# ::node	m2	most	0-1
# ::node	c	case-04	1-2
# ::node	m	medicine	3-4
# ::node	n	neglect-01	4-5
# ::node	c4	contract-02	7-8
