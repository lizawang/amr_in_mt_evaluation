(a4 / and
    :condition (w / want-01
        :ARG0 (y / you)
        :ARG1 (a2 / add-02
            :ARG0 y
            :ARG1 (b / baggage,
                :mod (m5 / more))))
    :op1 (v / vary-01
        :ARG1 (t / thing
            :ARG2-of (p4 / price-01))
        :ARG1-of (a / accord-02
            :ARG2 (a3 / and
                :op1 (t4 / type
                    :mod (t3 / ticket
                        :ARG1-of (p6 / purchase-01
                            :ARG0 y)))
                :op2 (d2 / destination,))))
    :op2 (p / possible-01
        :ARG1 (r2 / reach-01
            :ARG0 (t2 / thing
                :ARG2-of (p5 / price-01))
            :ARG0-of (d / depend-01
                :ARG1 (m / mass-quantity
                    :poss (s3 / suitcase
                        :ARG1-of (c / choose-01
                            :ARG0 y))))
            :ARG1 (r / rate-entity-91
                :ARG1 (s / several
                    :op1 (m2 / monetary-quantity
                        :quant 100
                        :quant (h / hyperlink-91)))
                :ARG2 (s2 / suitcase)
                :ARG2 (b2 / between
                    :op1 (m3 / monetary-quantity
                        :quant 150
                        :unit (p2 / pound))
                    :op2 (m4 / monetary-quantity
                        :quant 2000000
                        :unit (p3 / pound)))))))

# ::tok EasyJet allows you to upload a small bag size of 45*36*20 on condition that it can fit under the seat.
# ::node	c	company	0-1
# ::node	n	name	0-1
# ::node	2	EasyJet	0-1
# ::node	a	allow-01	1-2
# ::node	y	you	2-3
