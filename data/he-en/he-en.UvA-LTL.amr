(s / say-01
    :ARG1 (i / increase-01
        :ARG2 (a / about
            :ARG2-of (m4 / mortgage-01
                :ARG2-of (h2 / have-mod-91
                    :ARG1 (m / monetary-quantity
                        :quant (h / half)))
                :ARG3 (m2 / monetary-quantity
                    :quant 620
                    :unit (p2 / pound))
                :mod (c / country
                    :name (n2 / name
                        :mod (i3 / "intercontinental"
                            :op1 (m3 / monetary-quantity
                                :quant 1200000000000
                                :unit (d / dollar))))))))
    :condition (r2 / rise-01
        :ARG1 (r / rate
            :mod (i4 / interest))
        :ARG2 m
        :mod (i2 / indeed))
    :rel (p / person
        :name (n / name
            :op1 "Tsror's")))

# ::tok The prime track (40% on this track) will increase by about NIS 280, assuming there will be another 0.5% increase next month.
