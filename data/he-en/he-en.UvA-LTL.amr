# ::edge	between	op1	temporal-quantity	b	t	
# ::edge	temporal-quantity	unit	hour	t	h	
# ::edge	temporal-quantity	quant	14	t2	0	
# ::edge	between	op2	temporal-quantity	b	t2	
# ::edge	temporal-quantity	unit	hour	t2	h2	
(l / last-01
    :ARG1 (s / stage
        :mod (c / contract-02))
    :ARG2 (b / between
        :ARG2-of (a / average-01)
        :op1 (t / temporal-quantity
            :quant 8
            :unit (h / hour))
        :op2 (t2 / temporal-quantity
            :quant 14
            :unit (h2 / hour))))

# ::tok At this stage, the cervix is gradually opened (in order to allow the fetal passage at birth) and at the end of the process should reach a diameter of about ten centimeters.
# ::node	t	this	1-2
# ::node	c2	cervix	4-5
# ::node	g	gradual	6-7
# ::node	o	open-01	7-8
# ::node	a2	allow-01	11-12
# ::node	f	fetus	13-14
# ::node	p	pass-03	14-15
# ::node	b	bear-02	16-17
