# ::edge	possible-01	ARG1	and	p2	a	
# ::edge	and	op2	harm-01	a	h	
# ::edge	harm-01	ARG0	person	h	p	
# ::edge	harm-01	ARG1	country	h	c	
# ::edge	attack-01	ARG1	country	a3	c	
# ::edge	country	name	name	c	n2	
