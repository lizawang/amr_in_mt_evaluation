# ::edge	post-01	ARG0	you	p2	y	
# ::edge	allow-01	ARG1	post-01	a	p2	
# ::edge	bag	mod	small	b	s3	
# ::edge	size-01	ARG1	bag	s2	b	
# ::edge	post-01	ARG1	size-01	p2	s2	
# ::edge	size-01	ARG2	ratio-of	s2	r	
# ::edge	ratio-of	op1	30	r	0	
# ::edge	ratio-of	op2	40	r	1	
# ::edge	post-01	condition	possible-01	p2	p	
# ::edge	possible-01	ARG1	fit-01	p	f	
# ::edge	fit-01	ARG1	bag	f	b	
# ::edge	fit-01	ARG2	under	f	u	
# ::edge	under	op1	seat.	u	s	
(a / allow-01
    :ARG0 (c / company
        :name (n / name
            :op1 "EasyJet"))
    :ARG1 (p2 / post-01
        :ARG0 (y / you)
        :ARG1 (s2 / size-01
            :ARG1 (b / bag
                :mod (s3 / small))
            :ARG2 (r / ratio-of
                :op1 30
                :op2 40))
        :condition (p / possible-01
            :ARG1 (f / fit-01
                :ARG1 b
                :ARG2 (u / under
                    :op1 (s / seat.))))))

