# ::node	d2	deal-01	9-10
# ::node	f	fail-01	12-13
# ::node	i	identify-01	14-15
# ::node	f2	fetus	15-16
# ::node	d3	distress-01	16-17
# ::node	p2	prior	17-18
# ::node	c2	cause-01	21-22
# ::node	d	damage-01	22-23
# ::node	s	sometimes	28-29
# ::node	e	even	29-30
# ::node	e2	express-01	30-31
# ::node	c3	cerebrum	32-33
# ::node	p	palsy.	33-34
# ::root	d2	deal-01
# ::edge	case-04	quant	most	c	m2	
# ::edge	neglect-01	ARG0	medicine	n	m	
# ::edge	case-04	ARG1	neglect-01	c	n	
# ::edge	stage	mod	contract-02	s2	c4	
# ::edge	neglect-01	time	stage	n	s2	
# ::edge	deal-01	ARG0	case-04	d2	c	
# ::edge	deal-01	ARG2	fail-01	d2	f	
# ::edge	fail-01	ARG2	identify-01	f	i	
# ::edge	distress-01	ARG1	fetus	d3	f2	
# ::edge	identify-01	ARG1	distress-01	i	d3	
# ::edge	identify-01	time	prior	i	p2	
# ::edge	fail-01	ARG0-of	cause-01	f	c2	
# ::edge	cause-01	ARG1	damage-01	c2	d	
# ::edge	express-01	mod	even	e2	e	
# ::edge	express-01	frequency	sometimes	e2	s	
# ::edge	damage-01	ARG1-of	express-01	d	e2	
# ::edge	palsy.	mod	cerebrum	p	c3	
# ::edge	express-01	ARG0	palsy.	e2	p	
(d2 / deal-01
    :ARG0 (c / case-04
        :quant (m2 / most)
        :ARG1 (n / neglect-01
            :ARG0 (m / medicine)
            :time (s2 / stage
                :mod (c4 / contract-02))))
    :ARG2 (f / fail-01
        :ARG0-of (c2 / cause-01
            :ARG1 (d / damage-01
                :ARG1-of (e2 / express-01
                    :ARG0 (p / palsy.
                        :mod (c3 / cerebrum))
                    :frequency (s / sometimes)
                    :mod (e / even))))
        :ARG2 (i / identify-01
            :ARG1 (d3 / distress-01
                :ARG1 (f2 / fetus))
            :time (p2 / prior))))

# ::tok Cerebral Palsy (CP):
