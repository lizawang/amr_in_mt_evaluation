(a2 / and
    :op1 (w / want-01
        :ARG0 (p / person
            :name (n / name
                :op1 "Bennett"))
        :ARG1 (s / see-01
            :ARG0 p
            :ARG1 (t / thing
                :degree-of (p2 / possible-01
                    :ARG1 (a / and
                        :op1 (a3 / attack-01
                            :ARG0 p
                            :ARG1 (c / country
                                :name (n2 / name
                                    :op1 "Israel,")))
                        :op2 (h / harm-01
                            :ARG0 p
                            :ARG1 c))))))
    :op2 (w2 / win-01
        :ARG0 p
        :ARG1 (s3 / support-01
            :ARG0 (f / fan
                :ARG1-of (n3 / new-01)
                :poss p))
        :mod (s2 / still)))

