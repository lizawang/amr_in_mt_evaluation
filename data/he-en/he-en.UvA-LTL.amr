(a2 / and
    :op1 (i / include-01
        :ARG1 (b / baggage)
        :ARG2 (p3 / price-01
            :ARG1 (t2 / ticket)
            :ARG2 (u / up-to
                :op1 (m / mass-quantity
                    :quant 23
                    :unit (k / kilogram))))
        :location (c / class
            :ARG1-of (h / have-degree-91
                :ARG2 (h2 / high-02
                    :ARG1 c)
                :ARG3 (m2 / more))))
