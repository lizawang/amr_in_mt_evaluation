(s / state-01
    :ARG0 (m / ministry)
    :ARG1 (p / passenger
        :mod (o3 / only))
    :concession (r3 / report-01
        :ARG0 (p2 / person
            :ARG1-of (r4 / return-01
                :ARG3 (c / country
                    :mod (o4 / orange))
                :source (c2 / country
                    :ARG1-of (r2 / red-02))))
        :ARG1 (r / receive-01
            :ARG0 p2
            :ARG1 (n / notice-03))
        :mod (a2 / also))
    :mod (o / official)
    :time (a / after
        :mod (o2 / only)))

