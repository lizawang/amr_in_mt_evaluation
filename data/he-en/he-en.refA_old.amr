# ::edge	name	op1	Lapid	n2	2	
# ::edge	and	op2	person	a	p2	
# ::edge	and	op1	person	a	p	
# ::edge	and	op3	person	a	p3	
# ::edge	person	name	name	p3	n3	
# ::edge	name	op1	Gantz	n3	1	
