(t3 / think-01
    :ARG0 (y2 / you)
    :ARG1 (p2 / possible-01
        :ARG1 (a2 / apply-01
            :ARG0 (p / person
                :ARG1-of (e / employ-01))
            :ARG1 (r / refund-01
                :ARG2 p
                :duration (t / temporal-quantity
                    :quant 6
                    :unit (y / year)))
            :ARG2 (g / government-organization
                :name (n / name
                    :op1 "IRS"))
            :mod (r2 / retroactive)))
    :condition (t2 / think-01
        :ARG0 y2
        :ARG1 (l / lose-02
            :ARG1 (f / fund
                :mod (t4 / this))))
    :mod (a / "again:")
    :mode imperative)

# ::tok The Tax:On company has conducted an in-depth study among 4,000 of its customers regarding tax refunds during the year of 2020.
