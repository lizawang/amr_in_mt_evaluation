# ::edge	study-01	ARG1	refund-01	s	r	
# ::edge	refund-01	time	date-entity	r	d	
# ::edge	date-entity	year	2020.	d	0	
(c2 / conduct-01
    :ARG0 (c / company)
    :ARG1 (s / study-01
        :ARG0 (c3 / customer
            :quant 4000
            :ARG1-of (i2 / include-91
                :ARG2 (c4 / customer
                    :poss c)))
        :ARG1 (r / refund-01
            :ARG3 (t / tax-01)
            :time (d / date-entity
                :year 2020.))
        :manner (i / in-depth)))

