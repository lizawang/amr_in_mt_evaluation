(a / apply-01
    :ARG1 (i / it.)
    :frequency (r / rate-entity-91
        :ARG1 (p / person
            :quant (s / several
                :op1 (m / multiple
                    :op1 10000))
            :ARG1-of (e / employ-01))
        :ARG2 (t / temporal-quantity
            :quant 1
            :unit (y / year))
        :mod (o / only)))

# ::tok If you think these funds are lost anyway, think again: employees can apply to the IRS for refunds for six years retroactively.
