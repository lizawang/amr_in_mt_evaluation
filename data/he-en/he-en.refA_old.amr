# ::edge	guide-01	ARG0	person	g	p4	
# ::edge	ready-01	ARG1	ready-01	r	r2	
# ::edge	ready-01	ARG1	you	r2	y	
# ::edge	ready-01	ARG0	you	r	y	
# ::edge	guide-01	rel	ready-01	g	r	
(g / guide-01
    :ARG0 (p4 / person)
    :ARG1 (a / and
        :op1 (p / person
            :name (n / name
                :op1 "Bennett,"))
        :op2 (p2 / person
            :name (n2 / name
                :op1 "Lapid"))
        :op3 (p3 / person
            :name (n3 / name
                :op1 "Gantz")))
    :rel (r / ready-01
        :ARG0 (y / you)
        :ARG1 (r2 / ready-01
            :ARG1 y)))

