        :quant (a2 / amr-unknown)
        :ARG0-of (s / succeed-01
            :ARG1 (a6 / attempt-01
                :ARG1 p
                :ARG1 o)))
    :time (b / before
        :duration (t / temporal-quantity
            :quant 3
            :unit (y / year))
        :op1 (n2 / now)))

