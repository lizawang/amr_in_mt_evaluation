# ::edge	buy-01	ARG1	ticket	b	t2	
# ::edge	buy-01	location	facility	b	f	
# ::edge	facility	name	name	f	n	
# ::edge	name	op1	El	n	1	
# ::edge	name	op2	Al	n	0	
# ::edge	put-01	ARG0	person	p3	p	
# ::edge	put-01	ARG1	money	p3	m	
# ::edge	money	poss	person	m	p	
# ::edge	wing.	part-of	plane	w	p2	
# ::edge	put-01	ARG2	wing.	p3	w	
(p3 / put-01
    :ARG0 (p / person
        :ARG0-of (b / buy-01
            :ARG1 (t2 / ticket)
            :location (f / facility
                :name (n / name
                    :op1 "El"
                    :op2 "Al")))
        :mod (t / that))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing.
        :part-of (p2 / plane)))

# ::tok El Al is a bin Company.
# ::node	n	name	0-1
# ::node	1	El	0-1
# ::node	0	Al	1-2
# ::node	p	person	4-5
# ::node	n2	name	4-5
# ::node	2	bin	4-5
# ::node	c	company	5-6
# ::root	c	company
# ::edge	name	op1	El	n	1	
# ::edge	name	op2	Al	n	0	
# ::edge	person	name	name	p	n2	
# ::edge	name	op1	bin	n2	2	
# ::edge	company	mod	person	c	p	
# ::edge	company	name	name	c	n	
(c / company
    :name (n / name
        :op1 "El"
        :op2 "Al")
    :mod (p / person
        :name (n2 / name
            :op1 "bin")))

