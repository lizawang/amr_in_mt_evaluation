    :ARG1 (f / fly-01)
    :rel (d2 / destination
        :domain (a / and
            :op1 (c2 / city
                :name (n / name
                    :op1 "Warsaw,"))
            :op2 (c3 / city
                :name (n2 / name
                    :op1 "Toronto"))
            :op3 (c4 / city
                :name (n3 / name
                    :op1 "Brussels."))))
    :time (a2 / as-of
        :op1 (d / date-entity
            :month 11)))

