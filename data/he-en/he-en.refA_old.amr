(i2 / issue-01
    :ARG0 (m / ministry)
    :ARG1 (a2 / announce-01
        :ARG0 m
        :ARG0-of (s / state-01
            :ARG1 (i / include-01
                :ARG1 (p / person
                    :ARG0-of (t2 / travel-01)
                    :mod (o3 / only)
                    :source (c / country
                        :mod (o4 / orange)))))
        :mod (o / official))
    :concession (r3 / report-01
        :ARG0 (p2 / person
            :ARG1-of (r4 / return-01
                :ARG3 (c2 / country
                    :ARG1-of (r2 / red-02))))
        :ARG1 (r / receive-01
            :ARG0 p2
            :ARG1 a2)
        :mod (a / also))
    :mod (o2 / only)
    :time (t / then))

