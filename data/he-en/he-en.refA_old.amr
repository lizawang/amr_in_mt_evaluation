(a4 / and
    :op1 (a5 / attempt-01
        :quant (a / amr-unknown)
        :ARG1 (a3 / and
            :op1 (i / infiltrate-01
                :ARG1 (o / organization
                    :name (n / name
                        :op1 "Election"
                        :op2 "Committee")))
            :op2 (d / disrupt-01)))
