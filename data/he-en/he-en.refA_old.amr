# ::edge	assume-02	ARG1	increase-01	a3	i2	
# ::edge	month.	mod	next	m2	n	
# ::edge	increase-01	time	month.	i2	m2	
(c / complete-01
    :ARG0 (r / route
        :quant (p / percentage-entity
            :value "(40%")
        :mod (p4 / prime)
        :mod (t / this))
    :ARG1 (i / increase-01
        :ARG1 (m / monetary-quantity
            :ARG2-of (p3 / price-01))
        :ARG2 (a / about
            :op1 280)
        :condition (a3 / assume-02
            :ARG1 (i2 / increase-01
                :ARG2 (p2 / percentage-entity
                    :value 0.5%)
                :mod (a2 / another)
                :time (m2 / month.
                    :mod (n / next))))
        :location r))

