# ::edge	route	mod	prime	r	p4	
# ::edge	route	quant	percentage-entity	r	p	
# ::edge	percentage-entity	value	(40%	p	0	
# ::edge	route	mod	this	r	t	
# ::edge	complete-01	ARG0	route	c	r	
# ::edge	monetary-quantity	ARG2-of	price-01	m	p3	
# ::edge	increase-01	ARG1	monetary-quantity	i	m	
# ::edge	complete-01	ARG1	increase-01	c	i	
# ::edge	increase-01	location	route	i	r	
# ::edge	increase-01	ARG2	about	i	a	
# ::edge	about	op1	280	a	2	
# ::edge	increase-01	condition	assume-02	i	a3	
# ::edge	percentage-entity	value	0.5%	p2	1	
# ::edge	increase-01	ARG2	percentage-entity	i2	p2	
