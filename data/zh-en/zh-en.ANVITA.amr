# ::edge	name	op1	assemble-02	n2	0	
# ::edge	language	mod	language	l2	l	
# ::edge	source-02	ARG1	language	s	l2	
# ::edge	program;	ARG0-of	source-02	p	s	
# ::edge	multi-sentence	snt2	program;	m	p	
# ::edge	multi-sentence	snt1	language	m	l	
# ::edge	multi-sentence	rel	name	m	n	
(m / multi-sentence
    :rel (n / name)
    :snt1 (l / language
        :name (n2 / name
            :op1 "assemble-02"))
    :snt2 (p / program;
        :ARG0-of (s / source-02
            :ARG1 (l2 / language
                :mod l))))

# ::tok Assembly language source code; preprocessing, assembly
# ::node	n	name	0-1
# ::node	0	Assembly	0-1
# ::node	l	language	1-2
# ::node	1	language	1-2
# ::node	s	source-02	2-3
# ::node	c	code;	3-4
# ::node	b	before	4-5
# ::node	a	assemble-02	5-6
# ::root	c	code;
# ::edge	name	op1	Assembly	n	0	
# ::edge	language	name	name	l	n	
# ::edge	name	op2	language	n	1	
# ::edge	source-02	mod	language	s	l	
# ::edge	code;	ARG0-of	source-02	c	s	
# ::edge	before	op1	assemble-02	b	a	
# ::edge	code;	rel	before	c	b	
(c / code;
    :ARG0-of (s / source-02
        :mod (l / language
            :name (n / name
                :op1 "Assembly"
                :op2 "language")))
    :rel (b / before
        :op1 (a / assemble-02)))

# ::tok .h preprocessor files; files that do not normally appear on the command line with other post-names are passed to the linker.
# ::node	a	amr-empty	0-1
