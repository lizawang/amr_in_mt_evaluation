# ::edge	country	name	name	c	n	
# ::edge	name	op1	Japan	n	2	
# ::edge	earthquake	ARG0-of	have-03	e2	h	
# ::edge	have-03	ARG1	seismic-quantity	h	s	
# ::edge	seismic-quantity	quant	more-than	s	m	
# ::edge	more-than	op1	seismic-quantity	m	s2	
# ::edge	seismic-quantity	quant	9.	s2	1	
(e2 / earthquake
    :ARG0-of (h / have-03
        :ARG1 (s / seismic-quantity
            :quant (m / more-than
                :op1 (s2 / seismic-quantity
                    :quant 9.))))
    :ARG1-of (r / record-01
        :location (c / country
            :name (n / name
                :op1 "Japan")))
    :domain (e / earthquake)
    :ord (o / ordinal-entity
        :value 1))

# ::tok About 22,000 people were killed in the disaster, and about 400,000 buildings were completely destroyed or collapsed.
# ::node	a	about	0-1
# ::node	0	22000	1-2
# ::node	p	person	2-3
# ::node	k	kill-01	4-5
# ::node	d2	disaster,	7-8
# ::node	a3	and	8-9
# ::node	a2	about	9-10
# ::node	1	400000	10-11
# ::node	b	building	11-12
# ::node	c2	complete-02	13-14
# ::node	d	destroy-01	14-15
# ::node	o	or	15-16
# ::node	c	collapse-01	16-17
# ::root	a3	and
# ::edge	about	op1	22000	a	0	
# ::edge	person	quant	about	p	a	
# ::edge	kill-01	ARG1	person	k	p	
# ::edge	kill-01	ARG0	disaster,	k	d2	
# ::edge	and	op1	kill-01	a3	k	
# ::edge	about	op1	400000	a2	1	
# ::edge	building	quant	about	b	a2	
# ::edge	destroy-01	ARG1-of	complete-02	d	c2	
# ::edge	destroy-01	ARG1	building	d	b	
# ::edge	or	op1	destroy-01	o	d	
# ::edge	and	op2	or	a3	o	
# ::edge	or	op2	collapse-01	o	c	
# ::edge	collapse-01	ARG1	building	c	b	
(a3 / and
    :op1 (k / kill-01
        :ARG0 (d2 / disaster,)
        :ARG1 (p / person
            :quant (a / about
                :op1 22000)))
    :op2 (o / or
        :op1 (d / destroy-01
            :ARG1 (b / building
                :quant (a2 / about
                    :op1 400000))
            :ARG1-of (c2 / complete-02))
        :op2 (c / collapse-01
            :ARG1 b)))

