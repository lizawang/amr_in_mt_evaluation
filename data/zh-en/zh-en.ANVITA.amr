# ::tok First byte 0xA8 to 0xA9 Double byte 5: 192 bits
# ::node	o	ordinal-entity	0-1
# ::node	2	1	0-1
# ::node	b3	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8	2-3
