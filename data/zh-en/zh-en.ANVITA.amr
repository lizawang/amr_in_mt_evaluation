# ::edge	source	ARG1-of	differ-02	s4	d	
# ::edge	character	poss-of	source	c2	s4	
# ::edge	character	ARG1-of	contrast-01	c2	c5	
# ::edge	thug	ARG1-of	same-01	t2	s	
