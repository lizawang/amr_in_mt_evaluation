# ::edge	name	op2	11383	n	1	
# ::edge	rule	time	date-entity	r	d	
# ::edge	date-entity	year	1989.	d	2	
(a / assign-01
    :ARG1 (p / point
        :mod (c / code)
        :part-of (p2 / portion
            :mod (s / single-byte)))
    :ARG1-of (c2 / conform-01
        :ARG2 (r / rule
            :mod (p3 / product
                :name (n / name
                    :op2 11383))
            :mod (p4 / product
                :name (n2 / name
                    :op1 +))
            :time (d / date-entity
                :year 1989.))))

