# ::node	u	use-01	15-16
# ::node	0	-	16-17
# ::node	c	compile-01	18-19
# ::node	e	err-01	19-20
# ::node	p	prevent-01	20-21
# ::node	c2	complete-02	22-23
# ::node	p2	process-02	23-24
# ::root	t	thing
# ::edge	thing	domain	connect-01	t	c3	
# ::edge	ordinal-entity	value	-1	o3	1	
# ::edge	step-01	ord	last	s	l	
# ::edge	thing	ARG4-of	step-01	t	s	
# ::edge	step-01	time	always	s	a	
# ::edge	or	op1	string-entity	o2	s2	
# ::edge	or	op2	string-entity	o2	s3	
# ::edge	string-entity	value	or	s3	2	
# ::edge	option	mod	string-entity	o	s2	
# ::edge	use-01	ARG1	option	u	o	
# ::edge	thing	condition	use-01	t	u	
# ::edge	use-01	polarity	-	u	0	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	thing	concession	prevent-01	t	p	
# ::edge	process-02	ARG1-of	complete-02	p2	c2	
# ::edge	prevent-01	ARG1	process-02	p	p2	
# ::edge	thing	rel	ordinal-entity	t	o3	
# ::edge	thing	rel	or	t	o2	
(t / thing
    :ARG4-of (s / step-01
        :ord (l / last)
        :time (a / always))
    :concession (p / prevent-01
        :ARG0 (e / err-01
            :ARG1 (c / compile-01))
        :ARG1 (p2 / process-02
            :ARG1-of (c2 / complete-02)))
    :condition (u / use-01
        :ARG1 (o / option
            :mod (s2 / string-entity))
        :polarity -)
    :domain (c3 / connect-01)
    :rel (o3 / ordinal-entity
        :value -1)
    :rel (o2 / or
        :op1 s2
        :op2 (s3 / string-entity
            :value "or")))

# ::tok In the connection phase, all .e files corresponding to the source program, -1 library files, unrecognized file names (including specified .o H tag files and .a library files) are passed to the connector options (OPTIONS) in the order they are in the command line.
# ::node	c2	connect-01	2-3
# ::node	p2	phase,	3-4
# ::node	a	all	4-5
# ::node	f	file	6-7
# ::node	c4	correspond-02	7-8
# ::node	s	source	10-11
# ::node	p3	program,	11-12
# ::node	0	-	12-13
# ::node	l	library	13-14
# ::node	r	recognize-02	15-16
# ::node	f2	file	16-17
# ::node	n	name	17-18
# ::node	i	include-91	18-19
# ::node	s2	specify-01	19-20
# ::node	n2	name	20-21
# ::node	1	H	21-22
# ::node	t	tag-01	22-23
# ::node	f3	file	23-24
# ::node	a2	and	24-25
# ::node	l2	library	26-27
# ::node	f4	file	27-28
# ::node	p	pass-05	29-30
# ::node	c3	connect-01	32-33
# ::node	o	option	33-34
# ::node	o2	order-03	37-38
# ::node	b	be-located-at-91	40-41
# ::node	c	command-02	42-43
# ::node	l3	line.	43-44
# ::root	p	pass-05
# ::edge	phase,	mod	connect-01	p2	c2	
# ::edge	file	mod	all	f	a	
# ::edge	file	ARG1-of	correspond-02	f	c4	
# ::edge	program,	mod	source	p3	s	
# ::edge	correspond-02	ARG2	program,	c4	p3	
# ::edge	recognize-02	polarity	-	r	0	
# ::edge	name	mod	file	n	f2	
# ::edge	name	ARG1-of	recognize-02	n	r	
# ::edge	name	ARG2-of	include-91	n	i	
# ::edge	name	op1	H	n2	1	
# ::edge	file	ARG1-of	tag-01	f3	t	
# ::edge	file	name	name	f3	n2	
# ::edge	and	op1	file	a2	f3	
# ::edge	include-91	ARG1	and	i	a2	
# ::edge	file	mod	library	f4	l2	
# ::edge	and	op2	file	a2	f4	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	pass-05	time	phase,	p	p2	
# ::edge	option	mod	connect-01	o	c3	
# ::edge	pass-05	ARG2	option	p	o	
# ::edge	option	manner	order-03	o	o2	
# ::edge	order-03	ARG1	file	o2	f	
# ::edge	order-03	ARG2	be-located-at-91	o2	b	
# ::edge	be-located-at-91	ARG1	file	b	f	
# ::edge	line.	mod	command-02	l3	c	
# ::edge	be-located-at-91	ARG2	line.	b	l3	
# ::edge	pass-05	rel	name	p	n	
# ::edge	pass-05	rel	specify-01	p	s2	
# ::edge	pass-05	rel	library	p	l	
(p / pass-05
    :ARG1 (f / file
        :ARG1-of (c4 / correspond-02
            :ARG2 (p3 / program,
                :mod (s / source)))
        :mod (a / all))
    :ARG2 (o / option
        :manner (o2 / order-03
            :ARG1 f
            :ARG2 (b / be-located-at-91
                :ARG1 f
                :ARG2 (l3 / line.
                    :mod (c / command-02))))
        :mod (c3 / connect-01))
    :rel (n / name
        :ARG1-of (r / recognize-02
            :polarity -)
        :ARG2-of (i / include-91
            :ARG1 (a2 / and
                :op1 (f3 / file
                    :name (n2 / name
                        :op1 "H")
                    :ARG1-of (t / tag-01))
                :op2 (f4 / file
                    :mod (l2 / library))))
        :mod (f2 / file))
    :rel (s2 / specify-01)
    :rel (l / library)
    :time (p2 / phase,
        :mod (c2 / connect-01)))

# ::tok Options must be given separately: de 'is completely different from' -d -r '.
# ::node	o2	option	0-1
# ::node	o	obligate-01	1-2
# ::node	g	give-01	3-4
# ::node	d	de	5-6
