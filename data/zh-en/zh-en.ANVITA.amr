# ::tok Where the number is preceded by a 0x in the text, hexadecimal is used; where the number is not marked with a 0x, decimal is used.
# ::node	n	number	2-3
# ::node	p	precede-01	4-5
# ::node	s	string-entity	7-8
# ::node	1	0x	7-8
# ::node	h	hexadecimal	11-12
# ::node	0	-	18-19
# ::node	m	mark-02	19-20
# ::node	d	decimal	23-24
# ::node	u	use-01	25-26
# ::node	u2	use-01	25-26
# ::root	u	use-01
# ::edge	precede-01	ARG1	number	p	n	
# ::edge	precede-01	ARG2	string-entity	p	s	
# ::edge	string-entity	value	0x	s	1	
# ::edge	mark-02	polarity	-	m	0	
# ::edge	mark-02	ARG1	number	m	n	
# ::edge	use-01	ARG1	decimal	u	d	
# ::edge	use-01	condition	precede-01	u	p	
# ::edge	use-01	ARG0	number	u	n	
# ::edge	use-01	ARG1	decimal	u2	d	
# ::edge	mark-02	condition	use-01	m	u2	
# ::edge	use-01	rel	mark-02	u	m	
# ::edge	use-01	rel	hexadecimal	u	h	
(u / use-01
    :ARG0 (n / number)
    :ARG1 (d / decimal)
    :condition (p / precede-01
        :ARG1 n
        :ARG2 (s / string-entity
            :value 0x))
    :rel (m / mark-02
        :ARG1 n
        :condition (u2 / use-01
            :ARG1 d)
        :polarity -)
    :rel (h / hexadecimal))

# ::tok In the appendix where the representation of the code is in hexadecimal, the representation of the other numbers are in decimal.
# ::node	a	appendix	2-3
# ::node	c	code	8-9
# ::node	h3	hexadecimal,	11-12
# ::node	r	represent-01	13-14
# ::node	r2	represent-01	13-14
# ::node	o	other	16-17
