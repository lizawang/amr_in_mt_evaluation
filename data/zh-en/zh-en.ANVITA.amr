# ::edge	location.	ARG1-of	share-01	l	s3	
# ::edge	assign-01	ARG2	location.	a3	l	
# ::edge	assign-01	rel	assign-01	a3	a2	
(a3 / assign-01
    :ARG1 (c2 / character
        :ARG1-of (c5 / contrast-01
            :ARG2 (t2 / thug
                :ARG1-of (s / same-01)
                :mod (a / abstract)))
        :poss-of (s4 / source
            :ARG1-of (d / differ-02)))
    :ARG2 (l / location.
        :ARG1-of (s3 / share-01)
        :mod (c4 / code))
    :rel (a2 / assign-01
        :ARG1 (l2 / location;
            :ARG1-of (s2 / separate-02)
            :mod (c3 / code))
        :ARG2 (c / character
            :ARG0-of (h / have-03
                :ARG1 (t / thug
                    :ARG1-of (u / unique-01)
                    :mod a)))))

# ::tok The encoded Chinese characters are called CCJK Unified Ideographs, where CJK stands for China, Japan, and South Korea.
