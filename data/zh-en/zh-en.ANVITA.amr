(m / measure-01
    :ARG1 (s / small-molecule
        :ARG2-of (i / include-01
            :ARG1 (a / and
                :ARG1-of (h / have-half-life-01
                    :ARG2 (t / temporal-quantity
                        :quant 30
                        :unit (y / year)))
                :op1 (s2 / small-molecule
                    :name (n2 / name
                        :op1 "iodine"))
                :op2 (s3 / small-molecule
                    :name (n3 / name
                        :op1 "cesium"))))
        :location (f / facility
            :name (n / name
                :op1 "Fukushima"))
        :mod (r / radioactive)
        :mod (t2 / trace))
    :location (w / worldwide.)
    :rel (r2 / result-01
        :ARG1 s)
    :rel (n4 / nucleus))

