# ::edge	name	op4	Scale	n	4	
# ::edge	scale	name	name	s	n	
# ::edge	name	op3	Event	n	1	
# ::edge	name	op2	Nuclear	n	3	
# ::edge	name	op1	International	n	2	
(c / classify-01
    :ARG1 (a / accident)
    :ARG2 (a2 / accident
        :mod (l / level
            :degree 7
            :scale (s / scale
                :name (n / name
                    :op1 "International"
                    :op2 "Nuclear"
                    :op3 "Event"
                    :op4 "Scale")))))

# ::tok As a result of the Fukushima nuclear accident, trace radioactive substances, including iodine-131 and caesium-137 (with a half-life of 30 years), have been measured worldwide.
# ::node	r2	result-01	2-3
