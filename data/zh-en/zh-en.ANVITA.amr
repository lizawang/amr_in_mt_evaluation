# ::node	n	name	8-9
# ::node	2	Japan	8-9
# ::node	h	have-03	10-11
# ::node	s	seismic-quantity	13-14
# ::node	m	more-than	13-14
# ::node	s2	seismic-quantity	15-16
# ::node	1	9.	15-16
# ::root	e2	earthquake
# ::edge	ordinal-entity	value	1	o	0	
# ::edge	earthquake	ARG1-of	record-01	e2	r	
# ::edge	earthquake	ord	ordinal-entity	e2	o	
