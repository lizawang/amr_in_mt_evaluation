# ::edge	represent-01	ARG2-of	have-manner-91	r	h	
# ::edge	have-mod-91	ARG1	number	h2	n	
# ::edge	represent-01	ARG2-of	have-mod-91	r	h2	
# ::edge	represent-01	mod	decimal.	r	d	
# ::edge	represent-01	rel	code	r	c	
# ::edge	represent-01	rel	hexadecimal,	r	h3	
(r / represent-01
    :ARG0 (a / appendix)
    :ARG2-of (h / have-manner-91
        :ARG1 (r2 / represent-01
            :ARG1 (n / number
                :mod (o / other))))
    :ARG2-of (h2 / have-mod-91
        :ARG1 n)
    :location a
    :mod (d / decimal.)
    :rel (c / code)
    :rel (h3 / hexadecimal,))

# ::tok The single-byte part uses the encoding structure of GB / T 11383 a 1989, using 0x00 ~ 0x7F code point.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	u	use-01	3-4
# ::node	e	encode-01	5-6
# ::node	s3	structure	6-7
# ::node	p3	product	8-9
