# ::edge	differ-02	ARG1	and	d2	a	
# ::edge	and	op2	option	a	o2	
# ::edge	and	op1	option	a	o2	
# ::edge	obligate-01	rel	de	o	d	
(o / obligate-01
    :ARG2 (g / give-01
        :ARG1 (o2 / option)
        :mod (s / string-entity
            :ARG1-of (d2 / differ-02
                :ARG1 (a / and
                    :op1 o2
                    :op2 o2)
                :ARG1-of (c / complete-02)
                :ARG2 (s2 / string-entity
                    :polarity -))))
    :rel (d / de))

# ::tok Most of the '- = E: and' -W 'options have two opposite formats: -fname and -fno-name (or -Wname and -Wno-name).
# ::node	m	most	0-1
