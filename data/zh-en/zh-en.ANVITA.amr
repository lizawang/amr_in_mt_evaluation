# ::node	f	file	2-3
# ::root	f	file
# ::edge	file	mod	internet	f	i	
(f / file
    :mod (i / internet))

# ::tok The connection is always the last step unless the -cec, -s, or -E option is used (or a compilation error prevents the complete process).
# ::node	c3	connect-01	1-2
# ::node	a	always	3-4
# ::node	t	thing	4-5
# ::node	l	last	5-6
# ::node	o3	ordinal-entity	5-6
