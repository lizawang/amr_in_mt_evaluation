# ::edge	thing	location	here	t	h	
# ::edge	thing	ARG2-of	summarize-01	t	s	
# ::edge	option	mod	all	o	a	
# ::edge	summarize-01	ARG1	option	s	o	
# ::edge	option	ARG1-of	group-01	o	g	
# ::edge	thing	ARG1-of	explain-01	t	e	
# ::edge	chapter	ARG1-of	follow-01	c	f	
# ::edge	explain-01	medium	chapter	e	c	
(t / thing
    :ARG1-of (e / explain-01
        :medium (c / chapter
            :ARG1-of (f / follow-01)))
    :ARG2-of (s / summarize-01
        :ARG1 (o / option
            :ARG1-of (g / group-01)
            :mod (a / all)))
    :location (h / here))

# ::tok Code Generation Option
# ::node	c	code	0-1
# ::node	g	generation	1-2
