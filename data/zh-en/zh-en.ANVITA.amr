        :quant 66
        :ARG1-of (u / unify-01
            :ARG3 (c3 / character
                :mod (r2 / religious-group
                    :name (n2 / name)))))
    :rel (e / exclude-01
        :ARG1 (c2 / character
            :quant 8
            :ARG1-of (r / range-01
                :ARG4 (d / date-interval
                    :op1 9FB4))))
    :rel (e2 / expand-01
        :ARG1 c3)
    :rel (e3 / expand-01
        :ARG0 (y / you)
        :ARG1 c3
        :ARG4 (c4 / character
            :mod r2))
    :rel (n3 / name
        :op1 "DCJK")
    :rel (e4 / expand-01
        :ARG1 c4)
    :rel (n / name))

