(c / call-01
    :ARG1 (c2 / character
        :ARG1-of (e / encode-01)
        :mod (c3 / country
            :name (n / name
                :op1 "China")))
    :ARG2 (s2 / string-entity
        :name (n2 / name
            :op1 "Unified"
            :op1 "CJK"
            :op2 "Ideographs,")
        :ARG0-of (s / stand-08
            :ARG1 (a / and
                :op1 (c4 / country
                    :name (n3 / name
                        :op1 "Japan,"))
                :op2 c4
                :op3 (c5 / country
                    :name (n4 / name
                        :op1 "South"
                        :op2 "Korea."))))))

