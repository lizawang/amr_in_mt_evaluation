(h / hit-01
    :ARG1 (f / facility
        :name (n / name
            :op1 "Fukushima"
            :op2 "Daiichi"
            :op3 "Nuclear"
            :op4 "Power"
            :op5 "Plant"))
    :ARG2 (a / and
        :op1 (e / earthquake)
        :op2 (t / tsunami.)))

# ::tok The accident was classified as a Level 7 accident on the International Nuclear Event Scale (INES).
# ::node	a	accident	1-2
