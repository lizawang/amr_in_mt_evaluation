# ::node	a2	and	20-21
# ::node	n5	name	21-22
# ::node	r	region	21-22
# ::root	c2	code
# ::edge	variable	name	name	v	n	
# ::edge	name	op1	T-Mobile	n	4	
# ::edge	string-entity	value	13000	s	0	
# ::edge	code	ARG1-of	unify-01	c2	u	
# ::edge	code	domain	variable	c2	v	
# ::edge	country	name	name	c3	n2	
# ::edge	name	op1	China	n2	1	
# ::edge	character	mod	country	c	c3	
# ::edge	code	purpose	character	c2	c	
# ::edge	character	ARG1-of	use-01	c	u2	
# ::edge	country	name	name	c4	n3	
# ::edge	name	op1	China,	n3	2	
# ::edge	name	op1	Japan,	n4	3	
# ::edge	country	name	name	c5	n4	
# ::edge	and	op2	country	a	c5	
# ::edge	and	op1	country	a	c4	
# ::edge	use-01	location	and	u2	a	
# ::edge	and	op1	country	a2	c6	
# ::edge	and	mod	other	a2	o	
# ::edge	and	op3	and	a	a2	
# ::edge	name	op1	Vietnam	n5	5	
# ::edge	country	name	name	c5	n5	
# ::edge	and	op2	region	a2	r	
# ::edge	code	rel	string-entity	c2	s	
(c2 / code
    :purpose (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c4 / country
                    :name (n3 / name
                        :op1 "China,"))
                :op2 (c5 / country
                    :name (n4 / name
                        :op1 "Japan,")
                    :name (n5 / name
                        :op1 "Vietnam"))
                :op3 (a2 / and
                    :mod (o / other)
                    :op1 (c6 / country)
                    :op2 (r / region))))
        :mod (c3 / country
            :name (n2 / name
                :op1 "China")))
    :ARG1-of (u / unify-01)
    :domain (v / variable
        :name (n / name
            :op1 "T-Mobile"))
    :rel (s / string-entity
        :value 13000))

# ::tok Characters with unique abstract glyphs are assigned a separate code location; characters with different sources but the same abstract glyphs are assigned a common code location.
