# ::tok The earthquake was the first recorded earthquake in Japan to have a magnitude greater than 9.
# ::node	e	earthquake	1-2
# ::node	o	ordinal-entity	4-5
# ::node	0	1	4-5
# ::node	r	record-01	5-6
# ::node	e2	earthquake	6-7
