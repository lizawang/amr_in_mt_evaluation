# ::tok The graphics, code locations, and functions of the ideographic descriptors shall conform to the provisions of Appendix B.
# ::node	g	graphic	1-2
# ::node	c2	code	2-3
# ::node	l	location	3-4
# ::node	a	and	4-5
# ::node	f	function-01	5-6
# ::node	i	ideology	8-9
# ::node	p	person	9-10
# ::node	d	describe-01	9-10
# ::node	o	obligate-01	10-11
# ::node	c3	conform-01	11-12
# ::node	t	thing	14-15
# ::node	p2	provide-01	14-15
# ::node	c	chapter	16-17
# ::node	n	name	16-17
# ::node	0	Appendix	16-17
# ::node	1	B.	17-18
# ::root	o	obligate-01
# ::edge	location	mod	code	l	c2	
# ::edge	and	op2	location	a	l	
# ::edge	and	op1	graphic	a	g	
# ::edge	and	op3	function-01	a	f	
# ::edge	function-01	ARG0	person	f	p	
# ::edge	and	poss	person	a	p	
# ::edge	person	ARG0-of	describe-01	p	d	
# ::edge	describe-01	ARG1	ideology	d	i	
# ::edge	obligate-01	ARG2	conform-01	o	c3	
# ::edge	conform-01	ARG1	and	c3	a	
# ::edge	conform-01	ARG2	thing	c3	t	
# ::edge	thing	ARG1-of	provide-01	t	p2	
# ::edge	provide-01	ARG0	chapter	p2	c	
# ::edge	chapter	name	name	c	n	
# ::edge	name	op1	Appendix	n	0	
# ::edge	name	op2	B.	n	1	
(o / obligate-01
    :ARG2 (c3 / conform-01
        :ARG1 (a / and
            :op1 (g / graphic)
            :op2 (l / location
                :mod (c2 / code))
            :op3 (f / function-01
                :ARG0 (p / person
                    :ARG0-of (d / describe-01
                        :ARG1 (i / ideology))))
            :poss p)
        :ARG2 (t / thing
            :ARG1-of (p2 / provide-01
                :ARG0 (c / chapter
                    :name (n / name
                        :op1 "Appendix"
                        :op2 "B."))))))

# ::tok Note: GB / T 13000 is a unified code for Chinese characters used in China, Japan, Vietnam and other countries and regions.
# ::node	s	string-entity	1-2
# ::node	v	variable	3-4
# ::node	n	name	3-4
# ::node	4	T-Mobile	3-4
# ::node	0	13000	4-5
