# ::edge	between	op1	byte	b	b3	
# ::edge	bit	quant	192	b2	3	
# ::edge	bit	mod	5:	b2	4	
# ::edge	byte	mod	bit	b4	b2	
# ::edge	byte	rel	name	b4	n	
# ::edge	byte	rel	between	b4	b	
# ::edge	byte	rel	0xA9	b4	1	
(b4 / byte
    :ARG1-of (d / double-01)
    :mod (b2 / bit
        :quant 192
        :mod "5:")
    :rel (n / name
        :op1 "0xA8")
    :rel (b / between
        :op1 (b3 / byte
            :ord (o / ordinal-entity
                :value 1))
        :op2 (b5 / byte
            :ARG1-of d))
    :rel 0xA9)

