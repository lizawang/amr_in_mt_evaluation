# ::node	t	thing	18-19
# ::node	l2	linker.	20-21
# ::root	m	multi-sentence
# ::edge	before	op1	amr-empty	b	a	
# ::edge	multi-sentence	snt1	before	m	b	
# ::edge	appear-01	ARG1-of	normal-02	a2	n3	
# ::edge	appear-01	polarity	-	a2	0	
# ::edge	file	ARG1-of	appear-01	f	a2	
# ::edge	line	mod	command	l	c	
# ::edge	appear-01	location	line	a2	l	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	multi-sentence	snt2	pass-05	m	p	
# ::edge	thing	ARG0-of	post-01	t	p2	
# ::edge	thing	mod	other	t	o	
# ::edge	file	accompanier	thing	f	t	
# ::edge	pass-05	ARG2	linker.	p	l2	
# ::edge	multi-sentence	rel	name	m	n	
# ::edge	multi-sentence	rel	name	m	n2	
(m / multi-sentence
    :rel (n / name)
    :rel (n2 / name)
    :snt1 (b / before
        :op1 (a / amr-empty))
    :snt2 (p / pass-05
        :ARG1 (f / file
            :ARG1-of (a2 / appear-01
                :ARG1-of (n3 / normal-02)
                :location (l / line
                    :mod (c / command))
                :polarity -)
            :accompanier (t / thing
                :ARG0-of (p2 / post-01)
                :mod (o / other)))
        :ARG2 (l2 / linker.)))

# ::tok .0 Object file
# ::node	o	object	1-2
# ::node	f	file	2-3
# ::root	f	file
# ::edge	file	mod	object	f	o	
(f / file
    :mod (o / object))

# ::tok .a Archive file (Archive file)
