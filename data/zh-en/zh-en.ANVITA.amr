# ::root	o	option
# ::edge	generation	mod	code	g	c	
# ::edge	option	mod	generation	o	g	
(o / option
    :mod (g / generation
        :mod (c / code)))

# ::tok Overall Option
# ::node	o2	overall	0-1
# ::node	o	option	1-2
# ::root	o	option
# ::edge	option	mod	overall	o	o2	
(o / option
    :mod (o2 / overall))

# ::tok Make it clear that the language of the subsequent input file is language (rather than the default choice that follows the filename).
# ::node	m	make-02	0-1
# ::node	y	you	0-1
# ::node	0	imperative	0-1
# ::node	c2	clear-06	2-3
# ::node	l	language	5-6
# ::node	s	subsequent	8-9
# ::node	i	input	9-10
# ::node	f	file	10-11
# ::node	i2	instead-of-91	14-15
# ::node	d	default-01	16-17
# ::node	c	choose-01	17-18
# ::node	f3	follow-02	19-20
# ::node	f2	filename).	21-22
# ::root	m	make-02
# ::edge	make-02	ARG0	you	m	y	
# ::edge	make-02	mode	imperative	m	0	
# ::edge	make-02	ARG1	clear-06	m	c2	
# ::edge	clear-06	ARG1	language	c2	l	
# ::edge	file	mod	input	f	i	
# ::edge	file	time	subsequent	f	s	
# ::edge	language	poss	file	l	f	
# ::edge	language	ARG1-of	instead-of-91	l	i2	
# ::edge	choose-01	ARG2-of	default-01	c	d	
# ::edge	instead-of-91	ARG2	choose-01	i2	c	
# ::edge	choose-01	ARG0-of	follow-02	c	f3	
# ::edge	follow-02	ARG1	filename).	f3	f2	
(m / make-02
    :ARG0 (y / you)
    :ARG1 (c2 / clear-06
        :ARG1 (l / language
            :ARG1-of (i2 / instead-of-91
                :ARG2 (c / choose-01
                    :ARG0-of (f3 / follow-02
                        :ARG1 (f2 / "filename)."))
                    :ARG2-of (d / default-01)))
            :poss (f / file
                :mod (i / input)
                :time (s / subsequent))))
    :mode imperative)

# ::tok This option applies to all subsequent input files until the next '-x' option is encountered.
# ::node	t	this	0-1
# ::node	o	option	1-2
# ::node	a2	apply-02	2-3
# ::node	a	all	4-5
# ::node	s	subsequent	5-6
# ::node	i	input	6-7
# ::node	f	file	7-8
# ::node	u	until	8-9
# ::node	n2	next	10-11
# ::node	n	name	11-12
# ::node	0	'-x'	11-12
# ::node	o2	option	12-13
# ::node	e	encounter-01	14-15
# ::root	a2	apply-02
# ::edge	option	mod	this	o	t	
# ::edge	apply-02	ARG1	option	a2	o	
# ::edge	file	mod	input	f	i	
# ::edge	file	time	subsequent	f	s	
# ::edge	file	mod	all	f	a	
# ::edge	apply-02	ARG2	file	a2	f	
# ::edge	apply-02	time	until	a2	u	
# ::edge	name	op1	'-x'	n	0	
# ::edge	option	name	name	o2	n	
# ::edge	option	mod	next	o2	n2	
# ::edge	encounter-01	ARG1	option	e	o2	
# ::edge	until	op1	encounter-01	u	e	
(a2 / apply-02
    :ARG1 (o / option
        :mod (t / this))
    :ARG2 (f / file
        :mod (i / input)
        :mod (a / all)
        :time (s / subsequent))
    :time (u / until
        :op1 (e / encounter-01
            :ARG1 (o2 / option
                :name (n / name
                    :op1 "'-x'")
                :mod (n2 / next)))))

# ::tok Turn off any explicit specification of the language, thus depending on the filename after processing the subsequent file RE AS E '-x' option).
# ::node	t	turn-off-07	0-1
# ::node	y	you	0-1
# ::node	3	imperative	0-1
# ::node	a2	any	2-3
# ::node	e	explicit-03	3-4
# ::node	s	specify-01	4-5
# ::node	c	cause-01	8-9
# ::node	d	depend-01	9-10
# ::node	f2	filename	12-13
# ::node	a	after	13-14
# ::node	p	process-01	14-15
# ::node	s2	subsequent	16-17
# ::node	f	file	17-18
# ::node	n	name	19-20
# ::node	1	AS	19-20
# ::node	2	E	20-21
# ::node	0	'-x'	21-22
# ::root	t	turn-off-07
# ::edge	turn-off-07	ARG0	you	t	y	
# ::edge	turn-off-07	mode	imperative	t	3	
# ::edge	specify-01	ARG1-of	explicit-03	s	e	
# ::edge	specify-01	mod	any	s	a2	
# ::edge	turn-off-07	ARG1	specify-01	t	s	
# ::edge	turn-off-07	ARG0-of	cause-01	t	c	
# ::edge	cause-01	ARG1	depend-01	c	d	
# ::edge	depend-01	ARG1	filename	d	f2	
# ::edge	depend-01	time	after	d	a	
# ::edge	after	op1	process-01	a	p	
# ::edge	file	mod	subsequent	f	s2	
# ::edge	process-01	ARG1	file	p	f	
# ::edge	file	name	name	f	n	
# ::edge	name	op2	AS	n	1	
# ::edge	name	op3	E	n	2	
# ::edge	name	op4	'-x'	n	0	
(t / turn-off-07
    :ARG0 (y / you)
    :ARG0-of (c / cause-01
        :ARG1 (d / depend-01
            :ARG1 (f2 / filename)
            :time (a / after
                :op1 (p / process-01
                    :ARG1 (f / file
                        :name (n / name
                            :op2 "AS"
                            :op3 "E"
                            :op4 "'-x'")
                        :mod (s2 / subsequent))))))
    :ARG1 (s / specify-01
        :ARG1-of (e / explicit-03)
        :mod (a2 / any))
