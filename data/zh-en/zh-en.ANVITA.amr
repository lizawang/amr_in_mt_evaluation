# ::edge	opposite-01	ARG2	and	o	a2	
# ::edge	opposite-01	polarity	-	o	0	
# ::edge	string-entity	value	-	s4	1	
# ::edge	have-03	rel	equal-01	h	e	
# ::edge	have-03	rel	most	h	m	
# ::edge	have-03	rel	include-01	h	i	
(h / have-03
    :ARG1 (a / and
        :ARG1-of (o / opposite-01
            :ARG2 (a2 / and
                :op1 (s2 / string-entity
                    :value "string-entity")
                :op2 (s4 / string-entity
                    :value -))
            :polarity -)
        :op1 s2
        :op2 (s3 / string-entity
            :value "string-entity"))
    :rel (e / equal-01
        :ARG1 "string-entity"
        :ARG2 (s / string-entity))
    :rel (m / most)
    :rel (i / include-01))

# ::tok Only the formats that are not the default options are listed here.
# ::node	o	only	0-1
# ::node	f	format	2-3
# ::node	0	-	5-6
