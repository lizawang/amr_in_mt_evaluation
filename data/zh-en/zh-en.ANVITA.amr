# ::node	0	0x00	15-16
# ::node	l	location	17-18
# ::node	n2	name	17-18
# ::node	s2	string-entity	17-18
# ::node	1	0x7F	17-18
# ::node	c	code	18-19
# ::node	p2	point.	19-20
# ::root	u	use-01
# ::edge	part	mod	single-byte	p	s	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	structure	mod	encode-01	s3	e	
# ::edge	use-01	ARG1	structure	u	s3	
# ::edge	structure	mod	product	s3	p3	
# ::edge	product	name	name	p3	n	
# ::edge	use-01	ARG2-of	use-01	u	u2	
# ::edge	product	mod	location	p3	l	
# ::edge	location	name	name	l	n2	
# ::edge	name	op1	11383	n2	2	
# ::edge	string-entity	value	0x00	s2	0	
# ::edge	string-entity	value	0x7F	s2	1	
# ::edge	code	mod	string-entity	c	s2	
# ::edge	point.	mod	code	p2	c	
# ::edge	use-01	ARG1	point.	u2	p2	
(u / use-01
    :ARG0 (p / part
        :mod (s / single-byte))
    :ARG1 (s3 / structure
        :mod (e / encode-01)
        :mod (p3 / product
            :name (n / name)
            :mod (l / location
                :name (n2 / name
                    :op1 11383))))
    :ARG2-of (u2 / use-01
        :ARG1 (p2 / point.
            :mod (c / code
                :mod (s2 / string-entity
                    :value 0x00
                    :value 0x7F)))))

# ::tok The double-byte Gong part uses two eight-bit binary bit strings to represent a character, with the first byte code point starting from 0x81-0xFE and the last byte code points 0x401-0x7E and 0x80-0xFE.
