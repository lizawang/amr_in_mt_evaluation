# ::edge	format	mod	option	f	o2	
# ::edge	list-01	ARG1	format	l	f	
# ::edge	list-01	location	here.	l	h	
(l / list-01
    :ARG1 (f / format
        :mod (o / only)
        :mod (o2 / option
            :ARG1-of (d / default-02
                :polarity -)))
    :location (h / here.))

# ::tok Below is a summary of all options, grouped by type, explained in the following chapters.
# ::node	h	here	0-1
# ::node	t	thing	2-3
# ::node	s	summarize-01	3-4
# ::node	a	all	5-6
# ::node	o	option	6-7
