    :ARG1 (i / isotope
        :quant (n3 / number
            :mod (l / large)))
    :ARG2-of (r2 / result-01
        :ARG1 (a / accident.
            :mod (n2 / nucleus)))
    :destination (o / ocean
        :name (n / name
            :op1 "Pacific"
            :op2 "Ocean")))

