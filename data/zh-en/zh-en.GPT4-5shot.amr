# ::edge	sign-01	polarity	-	s2	0	
# ::edge	sign-01	ARG1	option	s2	o	
# ::edge	contrast-01	ARG2	sign-01	c2	s2	
# ::edge	sign-01	ARG0	field	s2	f	
(c2 / contrast-01
    :ARG1 (c / cause-01
        :ARG0 (i / inherit-01
            :ARG1 (f / field
                :mod (b2 / bit))
            :ARG2 (t / type
                :example (s / sign-01)
                :mod (i2 / integer)
                :mod (b / basic))))
    :ARG2 (s2 / sign-01
        :ARG0 f
        :ARG1 (o / option)
        :polarity -
        :time (a / always)))

