# ::edge	range-01	rel	byte	r	b4	
# ::edge	range-01	rel	range-01	r	r3	
# ::edge	range-01	rel	2	r	6	
# ::edge	range-01	rel	8	r	10	
(r / range-01
    :ARG1 (a / and
        :domain (t / that)
        :op1 (r2 / range-01
            :ARG1 (b3 / byte
                :value 0x30
                :value 0)
            :ARG4 (b / between
                :op1 0x30
                :op2 (v / value
                    :unit (e / encode-01
                        :ARG1 (b2 / byte
                            :ord (o / ordinal-entity
                                :value 1)
                            :part-of (c / character
                                :quant 4)))
                    :value 0x30)))
        :op2 (r4 / range-01
            :ARG2 0
            :ARG4 (s3 / string-entity
                :value a))
        :op5 (s4 / string-entity))
    :ARG4 e
    :rel (s / string-entity
        :value b2
        :value 0x81)
    :rel (b4 / byte
        :ord (o2 / ordinal-entity
            :value 3))
    :rel (r3 / range-01
        :ARG1 (b5 / byte
            :ord (o3 / ordinal-entity
                :value 4))
        :op3 (s2 / string-entity
            :ARG1-of r4
            :value 0x81318139;
            :value "freak"))
    :rel 2
    :rel 8)

