        :ARG1-of (e / encourage-01)
        :mod (c2 / country
            :name (n / name
                :op1 "China")))
    :rel (n2 / name
        :op1 "Unified"
        :op2 "Ideographs,"
        :op3 "Ideographs,")
    :rel (s / stand-08
        :ARG1 (s2 / string-entity)
        :ARG2 (a / and
            :op1 s2
