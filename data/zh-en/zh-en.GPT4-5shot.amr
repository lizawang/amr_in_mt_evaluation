(a / and
    :location (t / text,
        :mod (m / main))
    :op1 (h / have-mod-91
        :ARG1 (n / number
            :ARG1-of (p / precede-01
                :ARG2 (s / string-entity
                    :value 0x)))
        :ARG2 (h3 / hexadecimal,))
    :op2 (h2 / have-mod-91
        :ARG1 (n2 / number
            :ARG1-of (p2 / precede-01
                :ARG2 0x
                :polarity -))
        :ARG2 (d / decimal.)))

# ::tok In the appendix, all coded representations are in hexadecimal, while all other numbers are represented in decimal.
# ::node	a	all	3-4
# ::node	c	code-01	4-5
# ::node	r3	representation-02	5-6
# ::node	h	hexadecimal,	8-9
# ::node	c2	contrast-01	9-10
# ::node	a2	all	10-11
# ::node	o	other	11-12
# ::node	n	number	12-13
# ::node	r	represent-01	14-15
# ::node	r2	represent-01	14-15
# ::node	d	decimal.	16-17
# ::root	c2	contrast-01
# ::edge	representation-02	ARG1-of	code-01	r3	c	
# ::edge	representation-02	mod	all	r3	a	
# ::edge	number	mod	other	n	o	
# ::edge	number	mod	all	n	a2	
# ::edge	contrast-01	ARG1	represent-01	c2	r	
# ::edge	represent-01	ARG1	hexadecimal,	r	h	
# ::edge	represent-01	ARG1	number	r2	n	
# ::edge	contrast-01	ARG2	represent-01	c2	r2	
# ::edge	represent-01	ARG2	decimal.	r	d	
# ::edge	contrast-01	rel	representation-02	c2	r3	
(c2 / contrast-01
    :ARG1 (r / represent-01
        :ARG1 (h / hexadecimal,)
        :ARG2 (d / decimal.))
    :ARG2 (r2 / represent-01
        :ARG1 (n / number
            :mod (o / other)
            :mod (a2 / all)))
    :rel (r3 / representation-02
        :ARG1-of (c / code-01)
        :mod (a / all)))

# ::tok The single-byte part adopts the coding structure of GB/T 11383-1989, using the code positions 0x00~0x7F.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	a	adopt-01	3-4
# ::node	c2	code-01	5-6
# ::node	s2	structure	6-7
# ::node	5	GB/T	8-9
# ::node	p3	product	9-10
# ::node	n	name	9-10
# ::node	d3	date-interval	9-10
# ::node	d	date-entity	9-10
# ::node	d2	date-entity	9-10
# ::node	1	13	9-10
# ::node	2	2	9-10
# ::node	3	2003	9-10
# ::node	u	use-01	10-11
# ::node	c	code	12-13
# ::node	p2	position	13-14
# ::node	v	value-interval	14-15
# ::node	4	7	14-15
# ::node	0	0	14-15
# ::root	a	adopt-01
# ::edge	part	mod	single-byte	p	s	
# ::edge	adopt-01	ARG0	part	a	p	
# ::edge	structure	mod	code-01	s2	c2	
# ::edge	adopt-01	ARG1	structure	a	s2	
# ::edge	structure	poss	product	s2	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	5	
# ::edge	product	time	date-interval	p3	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	13	d	1	
# ::edge	date-entity	month	2	d	2	
# ::edge	date-entity	year	2003	d	3	
# ::edge	adopt-01	manner	use-01	a	u	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	position	mod	code	p2	c	
# ::edge	use-01	ARG1	position	u	p2	
# ::edge	position	mod	value-interval	p2	v	
# ::edge	value-interval	op1	7	v	4	
# ::edge	value-interval	op2	0	v	0	
(a / adopt-01
    :ARG0 (p / part
        :mod (s / single-byte))
    :ARG1 (s2 / structure
        :mod (c2 / code-01)
        :poss (p3 / product
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 13
                    :month 2
                    :year 2003)
                :op2 (d2 / date-entity))))
    :manner (u / use-01
        :ARG0 p
        :ARG1 (p2 / position
            :mod (c / code)
            :mod (v / value-interval
                :op1 7
                :op2 0))))

# ::tok The double-byte portion uses two eight-bit binary bit strings to represent a character, with the first byte code ranging from 0x81 to 0xFE, and the tail byte code being 0x40 to 0x7E and 0x80 to 0xFE.
# ::node	d	double-byte	1-2
# ::node	p	portion	2-3
