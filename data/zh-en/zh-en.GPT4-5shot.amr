# ::edge	character	quant	some	c2	s	
# ::edge	and	op3	character	a2	c2	
(i / include-01
    :ARG1 (a2 / and
        :op1 (c / character
            :location (b / book
                :name (n / name
                    :op1 "GB/T")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :day 13
                        :month 12
                        :year 2002)
                    :op2 (d2 / date-entity)))
            :mod (g / graphic)
            :mod (a / all))
        :op2 (p2 / publication
            :name (n2 / name
                :op1 "CJK"
                :op2 "Unified"
                :op3 "Ideographs")
            :prep-in (p3 / publication
                :name (n3 / name
                    :op1 "GB/T"
                    :op2 "13000,")))
        :op3 (c2 / character
            :quant (s / some)
            :mod (g2 / graphic)))
    :ARG2 (p / part
        :mod (d4 / double-byte)))

# ::tok The characters in the double-byte part are arranged according to Appendix A.
