(r / recommend-01
    :ARG1 (c3 / comply-01
        :ARG0 (a / and
            :op1 (g / graphic)
            :op2 (p / position
                :mod (c2 / code)
                :mod g)
            :op3 (f / function-01
                :ARG0 (v / variable
                    :ARG0-of (d / describe-01
