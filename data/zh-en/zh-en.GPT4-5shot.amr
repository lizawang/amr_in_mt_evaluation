# ::node	d2	double-01	4-5
# ::node	2	Ning	5-6
# ::node	s	section	6-7
# ::node	0	3	7-8
# ::node	1	6080	9-10
# ::node	d	distance-quantity	10-11
# ::node	y	yard	10-11
# ::node	p	position.	11-12
# ::node	l	location	11-12
# ::root	a	and
# ::edge	ship	name	name	s2	n	
# ::edge	name	op1	SS	n	4	
# ::edge	name	op2	WA	n	5	
# ::edge	and	op1	ship	a	s2	
# ::edge	name	op1	RS	n2	3	
# ::edge	name	op2	Ning	n2	2	
# ::edge	section	mod	3	s	0	
# ::edge	distance-quantity	quant	6080	d	1	
# ::edge	distance-quantity	unit	yard	d	y	
# ::edge	position.	mod	distance-quantity	p	d	
# ::edge	position.	mod	double-01	p	d2	
# ::edge	and	op2	position.	a	p	
# ::edge	section	part-of	location	s	l	
# ::edge	location	name	name	l	n2	
# ::edge	and	rel	section	a	s	
(a / and
    :op1 (s2 / ship
        :name (n / name
            :op1 "SS"
            :op2 "WA"))
    :op2 (p / position.
        :mod (d / distance-quantity
            :quant 6080
            :unit (y / yard))
        :mod (d2 / double-01))
    :rel (s / section
        :mod 3
        :part-of (l / location
            :name (n2 / name
                :op1 "RS"
                :op2 "Ning"))))

# ::tok First byte 0xA8~0xA9 double byte 5 area: 192 code positions.
# ::node	o	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8~0xA9	2-3
# ::node	d	double-01	3-4
# ::node	b2	byte	4-5
# ::node	3	5	5-6
# ::node	a	area:	6-7
# ::node	2	192	7-8
# ::node	c	code	8-9
# ::node	p	position-01	9-10
# ::root	a	area:
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	byte	ord	ordinal-entity	b	o	
# ::edge	name	op1	0xA8~0xA9	n	0	
# ::edge	byte	ARG1-of	double-01	b2	d	
# ::edge	byte	mod	5	b2	3	
# ::edge	area:	mod	byte	a	b2	
# ::edge	area:	mod	byte	a	b	
# ::edge	code	quant	192	c	2	
# ::edge	position-01	ARG1	code	p	c	
# ::edge	area:	ARG2-of	position-01	a	p	
# ::edge	area:	rel	name	a	n	
(a / "area:"
    :ARG2-of (p / position-01
        :ARG1 (c / code
            :quant 192))
    :mod (b2 / byte
        :ARG1-of (d / double-01)
        :mod 5)
    :mod (b / byte
        :ord (o / ordinal-entity
            :value 1))
    :rel (n / name
        :op1 "0xA8~0xA9"))

# ::tok 3. Diagram of the encoding space structure of the double-character vegetable section.
# ::node	0	3	0-1
# ::node	d	diagram	1-2
# ::node	e	encode-01	4-5
# ::node	s2	space	5-6
# ::node	s3	structure	6-7
# ::node	d2	double-character	9-10
# ::node	v	vegetable	10-11
# ::node	s	section.	11-12
