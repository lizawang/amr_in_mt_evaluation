# ::node	n	name	0-1
# ::node	0	Gao	0-1
# ::node	1	Qiao	1-2
# ::root	p	person
# ::edge	person	name	name	p	n	
# ::edge	name	op1	Gao	n	0	
# ::edge	name	op2	Qiao	n	1	
(p / person
    :name (n / name
        :op1 "Gao"
        :op2 "Qiao"))

