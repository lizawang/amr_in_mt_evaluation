# ::edge	publication	name	name	p	n	
# ::edge	name	op1	GB/I	n	2	
# ::edge	publication	time	date-interval	p	d3	
# ::edge	date-entity	year	11383	d	0	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	1989.	d2	1	
(a / arrange-01
    :ARG1 (s / section
        :mod (m / memory
            :mod (c / character
                :ARG1-of (s2 / single-02))))
    :ARG1-of (c3 / conform-01
        :ARG2 (o / order-03
            :ARG1 (c2 / character)
            :ARG1-of (c4 / correspond-02)
            :location (p / publication
                :name (n / name
                    :op1 "GB/I")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :year 11383)
                    :op2 (d2 / date-entity
                        :year 1989.))))))

# ::tok 6.2 Arrangement order of some characters in the double-word city section.
# ::node	0	6.2	0-1
# ::node	a	arrange-01	1-2
