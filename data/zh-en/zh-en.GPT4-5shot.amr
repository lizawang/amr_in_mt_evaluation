# ::edge	temporal-quantity	quant	360	t	0	
# ::edge	period	op1	temporal-quantity	p	t	
# ::edge	temporal-quantity	unit	day	t	d	
(a / available-02
    :ARG2 (p2 / product
        :quant 7
        :prep-with (p / period
            :ARG1-of (h / have-degree-91
                :ARG2 (s / short-07
                    :ARG1 p)
                :ARG3 (m / most))
            :duration-of (h2 / hold-01)
            :op1 (t / temporal-quantity
                :quant 360
                :unit (d / day)))
        :source (i / institution
            :mod (h3 / home))))

# ::tok Personal pension financial products have finally been launched.
# ::node	p2	personal-02	0-1
