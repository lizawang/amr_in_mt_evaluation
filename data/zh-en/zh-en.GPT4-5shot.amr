(p2 / provide-01
    :ARG0 (p / product
        :name (n / name
            :op1 "GB/T"
            :op2 13000))
    :ARG1 (e / encode-01
        :ARG1 (c / character
            :ARG1-of (u2 / use-01
                :location (a / and
                    :op1 (c3 / country
                        :name (n3 / name
                            :op1 "China,"))
                    :op2 (c4 / country
                        :name (n4 / name
                            :op1 "Japan,"))
                    :op3 (c5 / country
                        :name (n5 / name
                            :op1 "UK,"))
                    :op4 (a2 / and
                        :mod (o / other)
                        :op1 (c6 / country)
                        :op2 (r / region))))
            :mod (c2 / country
                :name (n2 / name
                    :op1 "China")))
        :ARG1-of (u / unify-01))
    :rel (i / Vietnam))

