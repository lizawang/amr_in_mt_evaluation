# ::root	r	range-01
# ::edge	range-01	ARG4	encode-01	r	e	
# ::edge	ordinal-entity	value	1	o	5	
# ::edge	byte	ord	ordinal-entity	b2	o	
# ::edge	encode-01	ARG1	byte	e	b2	
# ::edge	character	quant	4	c	8	
# ::edge	byte	part-of	character	b2	c	
# ::edge	string-entity	value	byte	s	b2	
