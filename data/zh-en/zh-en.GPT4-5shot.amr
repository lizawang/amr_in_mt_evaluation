# ::edge	go-06	ARG0	batch	g	b	
# ::edge	go-06	ARG1	sell-01	g	s	
# ::edge	sell-01	ARG1	batch	s	b	
(g / go-06
    :ARG0 (b / batch
        :consist-of (p3 / product
            :ARG0-of (m / manage-01
                :ARG1 (w / wealth)
                :ARG1 (p / pension))
            :ARG1-of (p2 / personal-02))
        :ord (o / ordinal-entity
            :value 1))
    :ARG1 (s / sell-01
        :ARG1 b))

# ::tok Seven products from the home institution are available, with the shortest holding period being 360 days.
