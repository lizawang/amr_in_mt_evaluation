# ::node	n3	name	33-34
# ::node	n4	name	33-34
# ::node	2	0x80	33-34
# ::node	5	0xFE.	35-36
# ::root	u	use-01
# ::edge	portion	mod	double-byte	p	d	
# ::edge	use-01	ARG0	portion	u	p	
# ::edge	bit	mod	binary	b2	b	
# ::edge	string	mod	bit	s	b2	
