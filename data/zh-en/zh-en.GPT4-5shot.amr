(s / say-01
    :ARG0 (d / data
        :source (g / government-organization
            :name (n / name
                :op1 "China"
                :op2 "Earthquake"
                :op3 "Administration,")))
    :rel (r / reach-01
        :ARG0 (e / earthquake)
