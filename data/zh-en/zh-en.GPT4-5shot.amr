# ::edge	say-01	ARG0	chapter	s	c	
# ::edge	chapter	mod	A.	c	a	
(a2 / arrange-01
    :ARG1 (c2 / character
        :location (p / part
            :mod (d / double-byte)))
    :ARG1-of (s / say-01
        :ARG0 (c / chapter
            :mod (a / A.))))

