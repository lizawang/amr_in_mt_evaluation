# ::edge	diagram	li	3	d	0	
# ::edge	structure	mod	space	s3	s2	
# ::edge	structure	ARG1-of	encode-01	s3	e	
# ::edge	diagram	topic	structure	d	s3	
# ::edge	section.	mod	vegetable	s	v	
# ::edge	section.	mod	double-character	s	d2	
# ::edge	structure	part-of	section.	s3	s	
(d / diagram
    :li 3
    :topic (s3 / structure
        :ARG1-of (e / encode-01)
        :mod (s2 / space)
        :part-of (s / section.
            :mod (v / vegetable)
            :mod (d2 / double-character))))

# ::tok Table 2: Code position arrangement of the double character part.
