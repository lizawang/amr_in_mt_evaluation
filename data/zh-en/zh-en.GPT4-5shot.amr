(a3 / assign-01
    :ARG1 (c2 / character
        :mod (c6 / country
            :name (n / name
                :op1 "China")))
    :ARG2 (p2 / position-01
        :ARG1 c2
        :ARG1-of (s2 / share-01)
        :ARG2 (c4 / code))
    :rel (a2 / assign-01
        :ARG1 (p / position
            :mod (c3 / code)
            :mod (i / individual))
        :ARG2 (c / character
