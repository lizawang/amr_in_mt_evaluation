# ::edge	arrange-01	ARG2	part.	a	p	
(a / arrange-01
    :ARG1 (p2 / position-01
        :ARG1 (c2 / code))
    :ARG2 (p / part.
        :mod (c / character
            :mod (d / double)))
    :source (t / table
        :mod "2:"))

# ::tok Human code range.
