(t / turn-off-07
    :ARG0 (y / you)
    :ARG1 (m / mode.
        :ARG1-of (p / personal-02)
        :mod (m2 / mute))
    :mode imperative)

# ::tok In standby mode, activate the voice assistant (the device needs to support voice functions and have quick wake-up settings enabled).
# ::node	s2	standby	1-2
# ::node	a	activate-01	3-4
# ::node	y	you	3-4
# ::node	0	imperative	3-4
# ::node	v	voice-01	5-6
# ::node	a4	assist-01	6-7
# ::node	d	device	8-9
# ::node	n	need-01	9-10
# ::node	s3	support-01	11-12
# ::node	f	function-01	13-14
# ::node	a2	and	14-15
# ::node	a3	and	14-15
# ::node	q	quick-02	16-17
# ::node	w	wake-up-02	17-18
# ::node	t	thing	18-19
# ::node	s	set-02	18-19
# ::node	e	enable-01	19-20
# ::root	a	activate-01
# ::edge	activate-01	condition	standby	a	s2	
# ::edge	activate-01	ARG0	you	a	y	
# ::edge	activate-01	mode	imperative	a	0	
# ::edge	need-01	ARG0	device	n	d	
# ::edge	support-01	ARG0	device	s3	d	
# ::edge	support-01	ARG1	function-01	s3	f	
# ::edge	and	op1	need-01	a2	n	
# ::edge	need-01	ARG1	and	n	a2	
# ::edge	and	op1	function-01	a3	f	
# ::edge	need-01	ARG1	and	n	a3	
# ::edge	thing	mod	wake-up-02	t	w	
# ::edge	thing	ARG1-of	quick-02	t	q	
# ::edge	thing	ARG1-of	set-02	t	s	
# ::edge	enable-01	ARG1	thing	e	t	
# ::edge	and	op2	enable-01	a3	e	
# ::edge	enable-01	ARG0	device	e	d	
# ::edge	activate-01	rel	support-01	a	s3	
# ::edge	activate-01	rel	need-01	a	n	
# ::edge	activate-01	rel	voice-01	a	v	
# ::edge	activate-01	rel	assist-01	a	a4	
(a / activate-01
    :ARG0 (y / you)
    :condition (s2 / standby)
    :mode imperative
    :rel (s3 / support-01
        :ARG0 (d / device)
        :ARG1 (f / function-01))
    :rel (n / need-01
        :ARG0 d
        :ARG1 (a2 / and
            :op1 n)
        :ARG1 (a3 / and
            :op1 f
            :op2 (e / enable-01
                :ARG0 d
                :ARG1 (t / thing
                    :ARG1-of (q / quick-02)
                    :ARG1-of (s / set-02)
                    :mod (w / wake-up-02)))))
    :rel (v / voice-01)
    :rel (a4 / assist-01))

# ::tok Answer the second incoming call and switch calls.
# ::node	a2	answer-01	0-1
# ::node	y	you	0-1
# ::node	1	imperative	0-1
# ::node	2	imperative	0-1
# ::node	o	ordinal-entity	2-3
# ::node	0	2	2-3
# ::node	c3	come-in-07	3-4
# ::node	c	call-02	4-5
# ::node	a	and	5-6
# ::node	s	switch-01	6-7
# ::node	c2	call-02	7-8
# ::root	a	and
# ::edge	answer-01	ARG0	you	a2	y	
# ::edge	answer-01	mode	imperative	a2	1	
# ::edge	ordinal-entity	value	2	o	0	
# ::edge	call-02	ARG1-of	come-in-07	c	c3	
# ::edge	call-02	ord	ordinal-entity	c	o	
# ::edge	answer-01	ARG1	call-02	a2	c	
# ::edge	and	op1	answer-01	a	a2	
# ::edge	and	op2	switch-01	a	s	
# ::edge	switch-01	mode	imperative	s	2	
# ::edge	switch-01	ARG0	you	s	y	
# ::edge	switch-01	ARG1	call-02	s	c2	
(a / and
    :op1 (a2 / answer-01
        :ARG0 (y / you)
        :ARG1 (c / call-02
            :ARG1-of (c3 / come-in-07)
            :ord (o / ordinal-entity
                :value 2))
        :mode imperative)
    :op2 (s / switch-01
        :ARG0 y
        :ARG1 (c2 / call-02)
        :mode imperative))

# ::tok During a mobile phone call, when a new call comes in, clicking the multi-function button can hold the previous call and answer the second call; double-clicking the multi-function button can switch between the two calls.
# ::node	m	mobile-02	2-3
# ::node	p	phone	3-4
# ::node	n	new-01	7-8
# ::node	c	call-02	8-9
# ::node	c6	come-01	9-10
# ::node	c4	click-01	11-12
# ::node	m3	multi-sentence	13-14
# ::node	m2	multi-function	13-14
# ::node	b2	button	14-15
# ::node	p2	possible-01	15-16
# ::node	h	hold-01	16-17
# ::node	p4	previous	18-19
# ::node	c2	call-02	19-20
# ::node	a	and	20-21
# ::node	a2	answer-01	21-22
# ::node	o	ordinal-entity	23-24
# ::node	0	2	23-24
# ::node	c3	call-02	24-25
# ::node	c5	click-01	25-26
# ::node	p3	possible-01	29-30
# ::node	s	switch-01	30-31
# ::node	b	between	31-32
# ::root	m3	multi-sentence
# ::edge	phone	ARG1-of	mobile-02	p	m	
# ::edge	call-02	ARG1-of	new-01	c	n	
# ::edge	come-01	ARG1	call-02	c6	c	
# ::edge	button	mod	multi-function	b2	m2	
# ::edge	click-01	ARG1	button	c4	b2	
# ::edge	possible-01	ARG1	hold-01	p2	h	
# ::edge	hold-01	ARG0	click-01	h	c4	
# ::edge	call-02	mod	previous	c2	p4	
# ::edge	hold-01	ARG1	call-02	h	c2	
# ::edge	and	op1	possible-01	a	p2	
# ::edge	and	time	come-01	a	c6	
# ::edge	and	op2	answer-01	a	a2	
# ::edge	answer-01	ARG0	call-02	a2	c	
# ::edge	ordinal-entity	value	2	o	0	
# ::edge	call-02	ord	ordinal-entity	c3	o	
# ::edge	answer-01	ARG1	call-02	a2	c3	
# ::edge	click-01	ARG1	button	c5	b2	
# ::edge	and	op2	possible-01	a	p3	
# ::edge	possible-01	ARG1	switch-01	p3	s	
# ::edge	switch-01	ARG0	click-01	s	c5	
# ::edge	switch-01	ARG2	between	s	b	
# ::edge	between	op1	call-02	b	c2	
# ::edge	multi-sentence	rel	phone	m3	p	
# ::edge	multi-sentence	rel	and	m3	a	
(m3 / multi-sentence
    :rel (p / phone
        :ARG1-of (m / mobile-02))
    :rel (a / and
        :op1 (p2 / possible-01
            :ARG1 (h / hold-01
                :ARG0 (c4 / click-01
                    :ARG1 (b2 / button
                        :mod (m2 / multi-function)))
                :ARG1 (c2 / call-02
                    :mod (p4 / previous))))
        :op2 (a2 / answer-01
            :ARG0 (c / call-02
                :ARG1-of (n / new-01))
            :ARG1 (c3 / call-02
                :ord (o / ordinal-entity
                    :value 2)))
        :op2 (p3 / possible-01
            :ARG1 (s / switch-01
                :ARG0 (c5 / click-01
                    :ARG1 b2)
                :ARG2 (b / between
                    :op1 c2)))
        :time (c6 / come-01
            :ARG1 c)))

