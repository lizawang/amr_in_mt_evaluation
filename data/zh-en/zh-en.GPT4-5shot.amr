# ::edge	step-01	mod	final	s	f	
# ::edge	step-01	time	always	s	a	
# ::edge	step-01	ARG2	link-01	s	l	
# ::edge	or	op1	string-entity	o2	s2	
# ::edge	or	op2	string-entity	o2	s3	
# ::edge	string-entity	polarity	-	s3	0	
# ::edge	option	mod	or	o	o2	
# ::edge	or	op1	option	o3	o	
# ::edge	step-01	condition	or	s	o3	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	or	op2	prevent-01	o3	p	
# ::edge	complete-01	ARG1	process-02	c2	p2	
# ::edge	prevent-01	ARG1	complete-01	p	c2	
# ::edge	complete-01	polarity	-	c2	0	
(s / step-01
    :ARG2 (l / link-01)
    :condition (o3 / or
        :op1 (o / option
            :mod (o2 / or
                :op1 (s2 / string-entity)
                :op2 (s3 / string-entity
                    :polarity -)))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (c2 / complete-01
                :ARG1 (p2 / process-02)
                :polarity -)))
    :mod (f / final)
    :time (a / always))

