# ::edge	range-01	ARG1	byte	r2	b3	
# ::edge	byte	value	0x30	b3	2	
# ::edge	ordinal-entity	value	3	o2	7	
# ::edge	byte	ord	ordinal-entity	b4	o2	
# ::edge	ordinal-entity	value	4	o3	9	
# ::edge	byte	ord	ordinal-entity	b5	o3	
# ::edge	range-01	ARG1	byte	r3	b5	
# ::edge	byte	value	0	b3	0	
# ::edge	range-01	ARG2	0	r4	1	
# ::edge	range-01	ARG4	between	r2	b	
# ::edge	between	op1	0x30	b	2	
# ::edge	and	domain	that	a	t	
# ::edge	and	op2	range-01	a	r4	
# ::edge	and	op1	range-01	a	r2	
# ::edge	range-01	ARG1	and	r	a	
# ::edge	between	op2	value	b	v	
# ::edge	value	value	0x30	v	2	
# ::edge	value	unit	encode-01	v	e	
# ::edge	string-entity	value	0x81318139;	s2	4	
# ::edge	range-01	op3	string-entity	r3	s2	
# ::edge	string-entity	ARG1-of	range-01	s2	r4	
# ::edge	string-entity	value	and	s3	a	
# ::edge	range-01	ARG4	string-entity	r4	s3	
# ::edge	and	op5	string-entity	a	s4	
# ::edge	string-entity	value	freak	s2	11	
