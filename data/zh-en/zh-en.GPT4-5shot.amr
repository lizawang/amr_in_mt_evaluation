# ::edge	use-01	ARG2	represent-01	u	r3	
# ::edge	represent-01	ARG1	character,	r3	c	
# ::edge	string	ARG0-of	have-03	s	h	
# ::edge	ordinal-entity	value	1	o	6	
# ::edge	byte	ord	ordinal-entity	b3	o	
# ::edge	code	mod	byte	c2	b3	
# ::edge	code	ARG1-of	range-01	c2	r	
# ::edge	code	ARG1-of	range-01	c3	r2	
