# ::edge	name	op1	0x81	n	3	
# ::edge	range-01	ARG4	name	r2	n2	
# ::edge	name	op1	0xFE,	n2	4	
# ::edge	byte	mod	tail	b4	t	
# ::edge	byte	value	0x40	b4	0	
# ::edge	and	op2	code	a	c3	
# ::edge	and	op1	code	a	c2	
# ::edge	have-03	ARG1	and	h	a	
# ::edge	name	op1	0x7E	n3	1	
# ::edge	byte	name	name	b4	n3	
# ::edge	code	name	name	c3	n4	
# ::edge	name	op1	0x80	n4	2	
# ::edge	name	op2	0xFE.	n2	5	
# ::edge	use-01	rel	byte	u	b4	
# ::edge	use-01	rel	8	u	8	
(u / use-01
    :ARG0 (p / portion
        :mod (d / double-byte))
    :ARG1 (s / string
        :quant 2
        :ARG0-of (h / have-03
            :ARG1 (a / and
                :op1 (c2 / code
                    :ARG1-of (r / range-01
                        :ARG3 (n / name
                            :op1 "0x81"))
                    :mod (b3 / byte
                        :ord (o / ordinal-entity
                            :value 1)))
                :op2 (c3 / code
                    :name (n4 / name
                        :op1 "0x80")
                    :ARG1-of (r2 / range-01
                        :ARG4 (n2 / name
                            :op1 "0xFE,"
                            :op2 "0xFE.")))))
        :mod (b2 / bit
            :mod (b / binary)))
    :ARG2 (r3 / represent-01
        :ARG0 s
        :ARG1 (c / character,))
    :rel (b4 / byte
        :name (n3 / name
            :op1 "0x7E")
        :mod (t / tail)
        :value 0x40)
    :rel 8)

# ::tok The four-byte part uses the unused 0x30 - 0x39 from GB/T 11383 - 1989 as a suffix for the extension of the double-byte encoding, with the encoding range being 0x81308130 - 0xFE39FE39.
# ::node	f	four-byte	1-2
# ::node	p	part	2-3
# ::node	u	use-01	3-4
# ::node	u2	use-01	5-6
