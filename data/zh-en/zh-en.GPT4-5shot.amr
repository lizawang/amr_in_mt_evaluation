                    :op1 "GB/TI"
                    :op2 13000
                    :op3 "border")
                :mod 2)))
    :ARG1-of (r / relate-01
        :ARG2 (d4 / disc
            :mod (d3 / date-interval
                :op1 (d / date-entity
                    :quant "border"
                    :year 2003)
                :op2 (d2 / date-entity
                    :year 2008))))
    :location (d5 / document
        :mod (t / this))
    :part (c / chapter
        :name (n2 / name
            :op1 "Appendix"
            :op2 "D).")))

# ::tok 9.1 General Rule
