        :quant-of (c / character)))

# ::tok From 0xFD308130 to 0xFE39FE39, there are 25200 code points for user-defined areas.
# ::node	d3	date-interval	0-1
# ::node	d	date-entity	1-2
# ::node	5	30	1-2
# ::node	1	2	1-2
# ::node	2	2003	1-2
# ::node	0	0	1-2
# ::node	d2	date-entity	3-4
# ::node	3	2007	3-4
# ::node	4	25200	6-7
# ::node	c	code	7-8
# ::node	p2	point	8-9
# ::node	u	use-01	10-11
# ::node	p	person	10-11
# ::node	a	area	11-12
# ::root	p2	point
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-entity	day	30	d	5	
# ::edge	date-entity	month	2	d	1	
# ::edge	date-entity	year	2003	d	2	
# ::edge	date-entity	quant	0	d2	0	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	2007	d2	3	
# ::edge	point	mod	code	p2	c	
# ::edge	point	quant	25200	p2	4	
# ::edge	point	time	date-interval	p2	d3	
# ::edge	use-01	ARG0	person	u	p	
# ::edge	area	ARG1-of	use-01	a	u	
# ::edge	point	beneficiary	area	p2	a	
(p2 / point
    :quant 25200
    :beneficiary (a / area
        :ARG1-of (u / use-01
            :ARG0 (p / person)))
    :mod (c / code)
    :time (d3 / date-interval
        :op1 (d / date-entity
            :day 30
            :month 2
            :year 2003)
        :op2 (d2 / date-entity
            :quant 0
            :year 2007)))

# ::tok The other unoccupied four-byte code positions are reserved for future file extension use.
# ::node	o2	other	1-2
# ::node	o	occupy-01	2-3
# ::node	s	string-entity	3-4
# ::node	1	4	3-4
# ::node	c	code	4-5
# ::node	p	position	5-6
# ::node	r	reserve-01	7-8
# ::node	f2	future	9-10
# ::node	0	-	9-10
# ::node	f	file	10-11
# ::node	e	extend-01	11-12
# ::node	u	use-01	12-13
# ::root	r	reserve-01
# ::edge	string-entity	value	4	s	1	
# ::edge	code	mod	string-entity	c	s	
# ::edge	position	mod	code	p	c	
# ::edge	position	ARG1-of	occupy-01	p	o	
# ::edge	position	mod	other	p	o2	
# ::edge	reserve-01	ARG1	position	r	p	
# ::edge	occupy-01	polarity	-	o	0	
# ::edge	extend-01	ARG1	file	e	f	
# ::edge	use-01	ARG1	extend-01	u	e	
# ::edge	use-01	time	future	u	f2	
# ::edge	reserve-01	ARG2	use-01	r	u	
(r / reserve-01
    :ARG1 (p / position
        :ARG1-of (o / occupy-01
            :polarity -)
        :mod (c / code
            :mod (s / string-entity
                :value 4))
        :mod (o2 / other))
    :ARG2 (u / use-01
        :ARG1 (e / extend-01
            :ARG1 (f / file))
        :time (f2 / future)))

