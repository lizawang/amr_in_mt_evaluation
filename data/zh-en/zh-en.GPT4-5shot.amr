# ::edge	include-01	ARG1-of	typical-02	i	t2	
# ::edge	include-01	ARG2	this	i	t	
# ::edge	multi-sentence	snt2	include-01	m	i	
# ::edge	multi-sentence	rel	before	m	b	
(m / multi-sentence
    :rel (b / before)
    :snt1 (a / amr-empty)
    :snt2 (a2 / appear-01
        :ARG1 (p / pass-05
            :ARG1 (f / file
                :mod (o / other)
                :prep-with (n / name
                    :time (s / subsequent)))
            :ARG2 (l2 / linker.))
        :location (l / line,
            :mod (c / command))
        :mod (u / usual)
        :polarity -)
    :snt2 (i / include-01
