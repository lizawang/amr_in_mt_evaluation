(o / order-03
    :li 6.1
    :ARG1 (a / arrange-01
        :ARG1 (c / character))
    :location (p / part.
        :mod (b / brush-01
            :ARG0-of (w / word-01))))

# ::tok The single character memory section is arranged according to the corresponding character order in GB/I 11383 - 1989.
# ::node	s2	single-02	1-2
# ::node	c	character	2-3
# ::node	m	memory	3-4
