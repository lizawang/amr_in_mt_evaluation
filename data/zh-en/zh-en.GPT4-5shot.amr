(p2 / possible-01
    :ARG1 (s / see-01
        :ARG1 (a2 / and
            :op1 (s2 / structure
                :mod (o / overall))
            :op2 (a / allocate-01
                :ARG1 (r / range
                    :ARG2-of (p / position-01
                        :ARG1 (c / code)))))
        :location (a3 / and
            :op1 (f / figure
                :mod 1)
            :op2 (f2 / figure)
            :op3 (t / table
                :mod 1.))))

# ::tok The arrangement order of 6 characters.
# ::node	a	arrange-01	1-2
