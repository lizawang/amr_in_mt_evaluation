# ::edge	go-06	ARG1	publication	g	p5	
# ::edge	name	op3	Network.	n	3	
(g / go-06
    :ARG0 (b / batch
        :consist-of (p4 / product
            :ARG0-of (m / manage-01
                :ARG1 (w / wealth)
                :ARG1 (p / pension))
            :ARG1-of (p3 / personal-02))
        :ord (o / ordinal-entity
            :value 1))
    :ARG1 (p5 / publication
        :name (n / name
            :op1 "China"
            :op2 "News"
            :op3 "Network."))
    :prep-with (p2 / period
        :duration (t / temporal-quantity
            :quant 360
            :unit (d / day))
        :duration-of (h / hold-01)))

# ::tok The first batch of personal pension wealth management products goes on sale.
# ::node	o	ordinal-entity	0-1
# ::node	0	1	1-2
# ::node	b	batch	2-3
# ::node	p2	personal-02	4-5
# ::node	p	pension	5-6
