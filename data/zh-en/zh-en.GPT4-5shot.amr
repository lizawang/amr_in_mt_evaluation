# ::edge	manage-01	ARG1	wealth	m	w	
# ::edge	manage-01	ARG1	pension	m	p	
# ::edge	product	ARG0-of	manage-01	p3	m	
# ::edge	product	ARG1-of	personal-02	p3	p2	
