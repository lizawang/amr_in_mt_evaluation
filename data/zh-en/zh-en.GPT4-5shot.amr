# ::edge	name	op3	border	n	7	
# ::edge	disc	mod	date-interval	d4	d3	
# ::edge	relate-01	ARG2	disc	r	d4	
# ::edge	name	op1	GB/TI	n	6	
# ::edge	name	op2	13000	n	0	
# ::edge	code	mod	product	c2	p2	
