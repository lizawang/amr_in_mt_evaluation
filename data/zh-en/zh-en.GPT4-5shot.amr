(a / and
    :op1 (c2 / consider-01
        :ARG0 (c / company
            :name (n / name
                :op1 "GCC"))
        :ARG1 (f / file
            :ARG1-of (p / process-01)
            :ARG1-of (r / resemble-01
                :ARG2 (t2 / thing
                    :name (n3 / name
                        :op1 "C-style")))))
    :op2 (s / set-up-03
        :ARG0 c
