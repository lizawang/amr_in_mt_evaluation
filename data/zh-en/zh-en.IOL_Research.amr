# ::edge	byte	ARG1-of	double-01	b3	d	
# ::edge	area	mod	5	a2	3	
# ::edge	and	op2	area	a	a2	
# ::edge	and	op1	byte	a	b2	
# ::edge	bit	mod	code	b	c	
# ::edge	bit	quant	192	b	2	
# ::edge	area	mod	bit	a2	b	
# ::edge	and	rel	name	a	n	
# ::edge	and	rel	byte	a	b3	
(a / and
    :op1 (b2 / byte
        :ord (o / ordinal-entity
            :value 1))
    :op2 (a2 / area
        :mod 5
        :mod (b / bit
            :quant 192
            :mod (c / code)))
    :rel (n / name
        :op1 "0xA8~0xA9")
    :rel (b3 / byte
        :ARG1-of (d / double-01)))

