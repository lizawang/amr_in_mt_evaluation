# ::edge	show-01	ARG0	and	s	a2	
# ::edge	and	op3	table	a2	t	
# ::edge	table	mod	1.	t	2	
(s / show-01
    :ARG0 (a2 / and
        :op1 (f / figure
            :mod 1)
        :op2 (f2 / figure
            :mod 1)
        :op3 (t / table
            :mod 1.))
    :ARG1 (a / and
        :mod (o / overall)
        :op1 (s2 / structure)
        :op2 (a3 / assign-01
            :ARG1 (r / range-01
                :ARG2 (p / point
                    :mod (c / code))))))

# ::tok 6 Order of characters
