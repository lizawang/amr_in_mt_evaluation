(o / order-03
    :li 6.2
    :ARG1 (c / character
        :quant (s / some)
        :location (c2 / city
            :quant 2)))

# ::tok The order of the characters in the lower part of the double word shall be in accordance with Appendix A.
# ::node	o2	order-03	1-2
