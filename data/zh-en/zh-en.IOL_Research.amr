(o / order-03
    :li 6.1
    :ARG1 (c / character
        :quant (s / some))
    :location (b / brush
        :instrument-of (w / word)))

# ::tok The characters in the monogram are arranged in the order of the corresponding characters in GB/I 11383-1989.
# ::node	c	character	1-2
# ::node	m	monogram	4-5
# ::node	a	arrange-01	6-7
# ::node	o	order-03	9-10
# ::node	c3	correspond-02	12-13
# ::node	c2	character	13-14
# ::node	n	name	15-16
# ::node	2	GB/I	15-16
# ::node	d3	date-interval	16-17
# ::node	d	date-entity	16-17
# ::node	d2	date-entity	16-17
# ::node	0	1979	16-17
# ::node	1	1990	16-17
