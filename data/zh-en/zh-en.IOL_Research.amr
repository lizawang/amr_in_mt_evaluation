# ::edge	source	ARG1-of	differ-02	s4	d	
# ::edge	character	source	source	c2	s4	
# ::edge	assign-01	ARG2	character	a3	c2	
# ::edge	position.	mod	code	p	c4	
# ::edge	position.	ARG1-of	share-01	p	s3	
# ::edge	assign-01	ARG1	position.	a3	p	
# ::edge	assign-01	rel	assign-01	a3	a2	
# ::edge	assign-01	rel	unique-01	a3	u	
(a3 / assign-01
    :ARG1 (p / position.
        :ARG1-of (s3 / share-01)
        :mod (c4 / code))
    :ARG2 (c2 / character
        :source (s4 / source
            :ARG1-of (d / differ-02)))
    :rel (a2 / assign-01
        :ARG1 (g / globe
            :ARG1-of (s2 / separate-02)
            :mod (c3 / code))
        :ARG2 (c / character
            :mod (g2 / glyph
                :ARG1-of (s / same-01)
                :mod (a / abstract))))
    :rel (u / unique-01))

# ::tok The encoded Chinese characters are called CJK Unified Ideographs, where CJK stands for China, Japan, and South Korea.
# ::node	e	encode-01	1-2
# ::node	c3	country	2-3
# ::node	n	name	2-3
# ::node	0	China	2-3
