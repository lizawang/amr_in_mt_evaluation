(r / refer-01
    :purpose (i / information
        :mod (m / more)
        :topic (e / exercise-01
            :mod (s2 / strict)
            :mod (t / this)))
    :ARG0 (y / you)
    :ARG1 (n / "network:"
        :mod (s / sell-01)
        :mod (u / url-entity
            :value "www.President.gov.ua"))
    :mode imperative
    :polite +)

