# ::edge	and	op2	location	a	l2	
# ::edge	and	op1	graphic	a	g	
# ::edge	and	op3	function-01	a	f	
# ::edge	label	mod	ideograph	l	i	
# ::edge	function-01	ARG0	label	f	l	
# ::edge	graphic	poss	label	g	l	
# ::edge	obligate-01	ARG2	comply-01	o	c3	
# ::edge	comply-01	ARG0	and	c3	a	
# ::edge	comply-01	ARG1	thing	c3	t	
# ::edge	thing	ARG1-of	provide-01	t	p	
# ::edge	provide-01	ARG0	chapter	p	c	
# ::edge	chapter	name	name	c	n	
# ::edge	name	op1	Appendix	n	0	
# ::edge	name	op2	B.	n	1	
(o / obligate-01
    :ARG2 (c3 / comply-01
        :ARG0 (a / and
            :op1 (g / graphic
                :poss (l / label
                    :mod (i / ideograph)))
            :op2 (l2 / location
                :mod (c2 / code))
            :op3 (f / function-01
                :ARG0 l))
        :ARG1 (t / thing
            :ARG1-of (p / provide-01
                :ARG0 (c / chapter
                    :name (n / name
                        :op1 "Appendix"
                        :op2 "B."))))))

