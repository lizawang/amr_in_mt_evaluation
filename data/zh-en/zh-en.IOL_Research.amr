(s / step-01
    :ARG4 (c3 / connect-01)
    :condition (u / use-01
        :ARG1 (o / option
            :mod (o2 / or
                :op1 (s2 / string-entity)
                :op2 (s3 / string-entity
                    :value "or")))
        :concession (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02)))
        :polarity -)
    :mod (l / last)
