# ::edge	accord-02	ARG2	chapter	a2	c	
# ::edge	chapter	mod	A.	c	a	
(o / obligate-01
    :ARG2 (a2 / accord-02
        :ARG1 (o2 / order-03
            :ARG1 (c2 / character
                :location (p / part
                    :ARG1-of (l / low-04)
                    :part-of (w / word
                        :mod (d / double)))))
        :ARG2 (c / chapter
            :mod (a / A.))))

# ::tok 6.3 The order of some characters in the four-character brush
# ::node	1	6.3	0-1
# ::node	o	order-03	2-3
# ::node	s	some	4-5
# ::node	c	character	5-6
# ::node	0	4	8-9
# ::node	b	brush	9-10
# ::root	o	order-03
# ::edge	order-03	li	6.3	o	1	
# ::edge	character	quant	some	c	s	
