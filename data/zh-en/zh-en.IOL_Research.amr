# ::edge	name	op1	South	n4	4	
# ::edge	name	op2	Korea.	n4	3	
# ::edge	call-01	rel	name	c	n2	
# ::edge	call-01	rel	stand-08	c	s	
(c / call-01
    :ARG1 (c2 / character
        :ARG1-of (e / encode-01)
        :mod (c3 / country
            :name (n / name
                :op1 "China")))
    :rel (n2 / name
        :op1 "Unified"
        :op2 "Ideographs,"
        :op3 "Ideographs,")
    :rel (s / stand-08
        :ARG1 (a / and
            :op1 (c4 / country
                :name (n3 / name
                    :op1 "Japan,"))
            :op2 c4
            :op3 (c5 / country
                :name (n4 / name
                    :op1 "South"
                    :op2 "Korea.")))))

