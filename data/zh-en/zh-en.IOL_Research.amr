# ::node	0	-	24-25
# ::node	s3	sign-01	26-27
# ::node	a	always	27-28
# ::root	c2	contrast-01
# ::edge	type	mod	integer	t	i	
# ::edge	type	mod	basic	t	b	
# ::edge	sign-01	ARG1-of	cause-01	s	c	
# ::edge	number	ARG1-of	sign-01	n	s	
# ::edge	type	example	number	t	n	
# ::edge	contrast-01	ARG1	cause-01	c2	c	
# ::edge	sign-01	polarity	-	s3	0	
# ::edge	sign-01	condition	option	s3	o	
# ::edge	contrast-01	ARG2	sign-01	c2	s3	
# ::edge	sign-01	ARG1	field	s3	f2	
# ::edge	sign-01	time	always	s3	a	
# ::edge	contrast-01	rel	type	c2	t	
# ::edge	contrast-01	rel	field	c2	f	
# ::edge	contrast-01	rel	sign-01	c2	s2	
(c2 / contrast-01
    :ARG1 (c / cause-01)
    :ARG2 (s3 / sign-01
        :ARG1 (f2 / field)
        :condition (o / option)
        :polarity -
        :time (a / always))
    :rel (t / type
        :example (n / number
            :ARG1-of (s / sign-01
                :ARG1-of c))
        :mod (i / integer)
        :mod (b / basic))
    :rel (f / field)
    :rel (s2 / sign-01))

