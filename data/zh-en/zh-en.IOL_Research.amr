# ::edge	encode-01	ARG1	character	e	c	
# ::edge	character	ARG1-of	range-01	c	r	
# ::edge	range-01	ARG4	string-entity	r	s2	
# ::edge	string-entity	value	3	s2	2	
# ::edge	string-entity	value	2	s2	1	
# ::edge	encode-01	ARG1	character	e2	c3	
# ::edge	string-entity	value	3	s3	3	
# ::edge	character	ord	string-entity	c4	s3	
# ::edge	encode-01	ARG1	character	e3	c4	
# ::edge	and	op2	encode-01	a	e3	
# ::edge	and	op1	encode-01	a	e	
# ::edge	ordinal-entity	value	4	o2	5	
# ::edge	character	ord	ordinal-entity	c5	o2	
# ::edge	encode-01	ARG1	character	e4	c5	
# ::edge	and	op3	encode-01	a	e4	
# ::edge	encode-01	location	range-01	e4	r2	
# ::edge	range-01	ARG4	string-entity	r2	s4	
# ::edge	string-entity	value	3	s4	3	
# ::edge	that	domain	and	t	a	
# ::edge	string-entity	value	Oo2douolag0c	s5	6	
# ::edge	that	rel	encode-01	t	e2	
# ::edge	that	rel	string-entity	t	s5	
(t / that
    :domain (a / and
        :op1 (e / encode-01
            :ARG1 (c / character
                :ARG1-of (r / range-01
                    :ARG4 (s2 / string-entity
                        :value 3
                        :value 2))
                :ord (o / ordinal-entity
                    :value 1)
                :part-of (c2 / character
                    :mod (s / string-entity
                        :value 4))))
        :op2 (e3 / encode-01
            :ARG1 (c4 / character
                :ord (s3 / string-entity
                    :value 3)))
        :op3 (e4 / encode-01
            :ARG1 (c5 / character
                :ord (o2 / ordinal-entity
                    :value 4))
            :location (r2 / range-01
                :ARG4 (s4 / string-entity
                    :value 3))))
    :rel (e2 / encode-01
        :ARG1 (c3 / character))
    :rel (s5 / string-entity
        :value "Oo2douolag0c"))

# ::tok The overall structure and code point range assignment are shown in Figure 1 and Table 1.
# ::node	o	overall	1-2
# ::node	s2	structure	2-3
# ::node	a	and	3-4
# ::node	c	code	4-5
# ::node	p	point	5-6
# ::node	r	range-01	6-7
# ::node	a3	assign-01	7-8
# ::node	s	show-01	9-10
# ::node	f	figure	11-12
# ::node	f2	figure	11-12
