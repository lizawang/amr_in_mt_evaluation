# ::edge	connect-01	ARG1	form	c	f2	
# ::edge	form	mod	string-entity	f2	s2	
# ::edge	string-entity	value	connect-01	s3	c	
# ::edge	file	mod	string-entity	f	s3	
# ::edge	and	rel	file	a	f	
(a / and
    :op1 (c2 / consider-01
        :ARG0 (p / person
            :name (n / name
                :op1 "Gingrich")))
    :op2 (s / set-02
        :ARG0 p
        :ARG1 (c / connect-01
            :ARG1 (f2 / form
                :mod (s2 / string-entity
                    :value "c"))))
    :rel (f / file
        :ARG1-of (p2 / process-01)
        :mod (s3 / string-entity
            :value c)))

