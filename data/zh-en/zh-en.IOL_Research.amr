# ::node	1	1	12-13
# ::node	a2	and	13-14
# ::node	t	table	14-15
# ::node	2	1.	15-16
# ::root	s	show-01
# ::edge	and	op1	structure	a	s2	
# ::edge	and	mod	overall	a	o	
# ::edge	point	mod	code	p	c	
# ::edge	range-01	ARG2	point	r	p	
# ::edge	assign-01	ARG1	range-01	a3	r	
# ::edge	and	op2	assign-01	a	a3	
# ::edge	show-01	ARG1	and	s	a	
# ::edge	figure	mod	1	f	0	
# ::edge	figure	mod	1	f2	1	
# ::edge	and	op2	figure	a2	f2	
