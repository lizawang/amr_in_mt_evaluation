# ::edge	number	ARG1-of	precede-01	n2	p2	
# ::edge	precede-01	ARG2	string-entity	p2	s	
(a / and
    :op1 (u / use-01
        :ARG1 (d / decimal)
        :ARG2 (n / number
            :ARG1-of (p / precede-01
                :ARG2 (s / string-entity
                    :value 0x)
                :location (t / text,))))
    :op2 (u2 / use-01
        :ARG1 d
        :ARG2 (n2 / number
            :ARG1-of (p2 / precede-01
                :ARG2 s
                :polarity -))))

# ::tok All codes in the appendix are represented in hexadecimal, and all other numbers are represented in decimal.
# ::node	a	all	0-1
# ::node	c	code	1-2
# ::node	a4	appendix	4-5
# ::node	r	represent-01	6-7
# ::node	h	hexadecimal,	8-9
# ::node	a3	and	9-10
# ::node	a2	all	10-11
# ::node	o	other	11-12
# ::node	n	number	12-13
# ::node	r2	represent-01	14-15
# ::node	d	decimal.	16-17
# ::root	a3	and
# ::edge	code	mod	all	c	a	
# ::edge	code	location	appendix	c	a4	
# ::edge	represent-01	ARG1	code	r	c	
# ::edge	represent-01	ARG2	hexadecimal,	r	h	
# ::edge	and	op1	represent-01	a3	r	
# ::edge	number	mod	other	n	o	
# ::edge	number	mod	all	n	a2	
# ::edge	represent-01	ARG1	number	r2	n	
# ::edge	and	op2	represent-01	a3	r2	
# ::edge	represent-01	ARG2	decimal.	r2	d	
(a3 / and
    :op1 (r / represent-01
        :ARG1 (c / code
            :location (a4 / appendix)
            :mod (a / all))
        :ARG2 (h / hexadecimal,))
    :op2 (r2 / represent-01
        :ARG1 (n / number
            :mod (o / other)
            :mod (a2 / all))
        :ARG2 (d / decimal.)))

# ::tok The single-byte part uses the GB/T 11383-1989 encoding structure, so that the 0x00~0x7F code points are used.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	u	use-01	3-4
# ::node	p3	product	5-6
# ::node	n	name	5-6
# ::node	n2	name	5-6
# ::node	2	GB/T	5-6
# ::node	d2	date-interval	6-7
# ::node	d	date-entity	6-7
# ::node	1	11383-1989	6-7
# ::node	e	encode-01	7-8
# ::node	0	0x00~0x7F	12-13
# ::node	c	code	13-14
# ::node	p2	point	14-15
# ::node	u2	use-01	16-17
# ::root	u	use-01
# ::edge	part	mod	single-byte	p	s	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	2	
# ::edge	date-interval	op1	product	d2	p3	
# ::edge	date-interval	op2	date-entity	d2	d	
# ::edge	date-entity	year	11383-1989	d	1	
# ::edge	point	mod	encode-01	p2	e	
# ::edge	point	mod	date-interval	p2	d2	
# ::edge	point	name	name	p2	n2	
# ::edge	use-01	ARG1	point	u2	p2	
# ::edge	use-01	purpose	use-01	u	u2	
# ::edge	use-01	ARG0	part	u2	p	
# ::edge	use-01	rel	code	u	c	
# ::edge	use-01	rel	0x00~0x7F	u	0	
(u / use-01
    :purpose (u2 / use-01
        :ARG0 (p / part
            :mod (s / single-byte))
        :ARG1 (p2 / point
            :name (n2 / name)
            :mod (e / encode-01)
            :mod (d2 / date-interval
                :op1 (p3 / product
                    :name (n / name
                        :op1 "GB/T"))
                :op2 (d / date-entity
                    :year 11383-1989))))
    :ARG0 p
    :rel (c / code)
    :rel "0x00~0x7F")

# ::tok The two-character tribute part uses two eight-bit binary bit strings to represent a character, with the first byte code point from 0x81-0xFE and the last byte code points from 0x40-0x7E and 0x80-0xFE, respectively.
# ::node	t2	two-character	1-2
# ::node	t	tribute	2-3
# ::node	p	part	3-4
# ::node	u	use-01	4-5
# ::node	5	2	5-6
# ::node	8	8	6-7
# ::node	b	binary	7-8
# ::node	b2	bit	8-9
# ::node	s	string	9-10
# ::node	r	represent-01	11-12
# ::node	c	character,	13-14
# ::node	o	ordinal-entity	16-17
# ::node	4	1	16-17
# ::node	b3	byte	17-18
# ::node	b4	byte	17-18
# ::node	c2	code	18-19
# ::node	c3	code	18-19
# ::node	p2	point	19-20
# ::node	p3	point	19-20
# ::node	n	name	21-22
# ::node	d2	degree	21-22
# ::node	6	2	21-22
# ::node	0	0	21-22
# ::node	1	0	21-22
# ::node	l	last	24-25
# ::node	p4	point	27-28
# ::node	p5	point-01	27-28
# ::node	d3	distance-quantity	29-30
# ::node	p6	position	29-30
# ::node	d	date-entity	29-30
# ::node	7	2	29-30
# ::node	2	0	29-30
# ::node	3	0	29-30
# ::node	a	and	30-31
# ::root	u	use-01
# ::edge	tribute	mod	two-character	t	t2	
# ::edge	part	mod	tribute	p	t	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	bit	mod	binary	b2	b	
# ::edge	string	mod	bit	s	b2	
# ::edge	string	quant	2	s	5	
# ::edge	use-01	ARG1	string	u	s	
# ::edge	represent-01	ARG0	string	r	s	
# ::edge	use-01	ARG2	represent-01	u	r	
# ::edge	represent-01	ARG1	character,	r	c	
# ::edge	ordinal-entity	value	1	o	4	
# ::edge	byte	ord	ordinal-entity	b3	o	
# ::edge	code	mod	byte	c2	b3	
# ::edge	code	mod	byte	c3	b4	
# ::edge	point	mod	code	p2	c2	
# ::edge	point	ARG3-of	degree	p2	d2	
# ::edge	degree	value	2	d2	6	
# ::edge	degree	value	0	d2	0	
# ::edge	point	mod	last	p3	l	
# ::edge	point	mod	code	p4	c2	
# ::edge	point	ARG1	code	p4	c3	
# ::edge	point-01	ARG1	point	p5	p3	
# ::edge	distance-quantity	quant	point	d3	p2	
# ::edge	point	source	distance-quantity	p2	d3	
# ::edge	distance-quantity	ord	ordinal-entity	d3	o	
# ::edge	point	source	position	p4	p6	
# ::edge	position	quant	0	p6	1	
# ::edge	point-01	source	date-entity	p5	d	
# ::edge	date-entity	day	0	d	1	
# ::edge	position	day	2	p6	7	
# ::edge	date-entity	month	0	d	2	
# ::edge	date-entity	quant	0	d	3	
# ::edge	and	op2	point-01	a	p5	
# ::edge	and	op1	point	a	p2	
# ::edge	string	accompanier	and	s	a	
# ::edge	use-01	rel	point	u	p4	
# ::edge	use-01	rel	name	u	n	
# ::edge	use-01	rel	8	u	8	
(u / use-01
    :ARG0 (p / part
        :mod (t / tribute
            :mod (t2 / two-character)))
    :ARG1 (s / string
        :quant 2
        :accompanier (a / and
            :op1 (p2 / point
                :ARG3-of (d2 / degree
                    :value 2
                    :value 0)
                :mod (c2 / code
                    :mod (b3 / byte
                        :ord (o / ordinal-entity
                            :value 1)))
                :source (d3 / distance-quantity
                    :quant p2
                    :ord o))
            :op2 (p5 / point-01
                :ARG1 (p3 / point
                    :mod (l / last))
                :source (d / date-entity
                    :quant 0
                    :day 0
                    :month 0)))
        :mod (b2 / bit
            :mod (b / binary)))
    :ARG2 (r / represent-01
        :ARG0 s
        :ARG1 (c / character,))
    :rel (p4 / point
        :ARG1 (c3 / code
            :mod (b4 / byte))
        :mod c2
        :source (p6 / position
            :quant 0
            :day 2))
    :rel (n / name)
    :rel 8)

# ::tok The four-byte part uses 0x30-0x39, which was not used in GB/WP 11383-1989, as a suffix to expand the two-byte encoding to 0x81308130-0xFE39FE39.
# ::node	f	four-byte	1-2
# ::node	p	part	2-3
# ::node	u	use-01	3-4
# ::node	v	value-interval	4-5
# ::node	8	30	4-5
# ::node	5	3	4-5
# ::node	0	-	7-8
# ::node	u2	use-01	8-9
# ::node	p2	product	10-11
# ::node	n	name	10-11
# ::node	9	GB/WP	10-11
# ::node	d3	date-interval	11-12
# ::node	d	date-entity	11-12
# ::node	d2	date-entity	11-12
# ::node	1	15	11-12
# ::node	6	3	11-12
# ::node	3	2008	11-12
# ::node	2	19	11-12
# ::node	7	3	11-12
# ::node	4	2008	11-12
# ::node	s	suffix	14-15
# ::node	e2	expand-01	16-17
# ::node	t	two-byte	18-19
# ::node	e	encode-01	19-20
# ::root	u	use-01
# ::edge	part	mod	four-byte	p	f	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	use-01	ARG1	value-interval	u	v	
# ::edge	value-interval	op1	30	v	8	
# ::edge	value-interval	op2	3	v	5	
# ::edge	use-01	polarity	-	u2	0	
# ::edge	value-interval	ARG1-of	use-01	v	u2	
# ::edge	use-01	time	product	u2	p2	
# ::edge	product	name	name	p2	n	
# ::edge	name	op1	GB/WP	n	9	
# ::edge	product	time	date-interval	p2	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	15	d	1	
# ::edge	date-entity	month	3	d	6	
# ::edge	date-entity	year	2008	d	3	
# ::edge	date-entity	day	19	d2	2	
# ::edge	date-entity	month	3	d2	7	
# ::edge	date-entity	year	2008	d2	4	
# ::edge	use-01	ARG2	suffix	u	s	
# ::edge	use-01	purpose	expand-01	u	e2	
# ::edge	expand-01	ARG0	part	e2	p	
# ::edge	encode-01	mod	two-byte	e	t	
# ::edge	expand-01	ARG1	encode-01	e2	e	
(u / use-01
    :purpose (e2 / expand-01
        :ARG0 (p / part
            :mod (f / four-byte))
        :ARG1 (e / encode-01
            :mod (t / two-byte)))
    :ARG0 p
    :ARG1 (v / value-interval
        :ARG1-of (u2 / use-01
            :polarity -
            :time (p2 / product
                :name (n / name
                    :op1 "GB/WP")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :day 15
                        :month 3
                        :year 2008)
                    :op2 (d2 / date-entity
                        :day 19
                        :month 3
                        :year 2008))))
        :op1 30
        :op2 3)
    :ARG2 (s / suffix))

# ::tok The first character of a four-byte character is encoded in the range 0x81-0xFE; the second character is encoded in the range 0x30-0x39; the third character is encoded in the range 0x81-0xFE; and the fourth character is encoded in the range 0x30-0x39. That is: 0x81308130-0x81308139; 0x81308230-0x81308239 0x8130FEFE30-0x8130FE39; 0x81318130-0x813139; Oo2douolag0c "0URo23061393 0xFE39FE30-0xFE39FE39.
