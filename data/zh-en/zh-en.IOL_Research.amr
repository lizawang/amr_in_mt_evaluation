(z / zone
    :ARG1-of (p2 / person
        :ARG0-of (u / use-01))
    :domain (p3 / point
        :quant 25000
        :ARG1-of (r / range-01
            :ARG3 (p / percentage-entity
                :value 2
                :value 0))
        :mod (c / code)
        :mod (t / total)))

