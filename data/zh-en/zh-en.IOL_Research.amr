# ::edge	character	part-of	monogram	c	m	
# ::edge	arrange-01	ARG1	character	a	c	
# ::edge	arrange-01	manner	order-03	a	o	
# ::edge	character	ARG1-of	correspond-02	c2	c3	
# ::edge	order-03	ARG1	character	o	c2	
# ::edge	name	op1	GB/I	n	2	
# ::edge	character	time	date-interval	c2	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	1979	d	0	
# ::edge	date-entity	year	1990	d2	1	
# ::edge	arrange-01	rel	name	a	n	
(a / arrange-01
    :ARG1 (c / character
        :part-of (m / monogram))
    :manner (o / order-03
        :ARG1 (c2 / character
            :ARG1-of (c3 / correspond-02)
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :year 1979)
                :op2 (d2 / date-entity
                    :year 1990))))
    :rel (n / name
        :op1 "GB/I"))

# ::tok 6.2 The order of some characters in a two-character city
# ::node	1	6.2	0-1
