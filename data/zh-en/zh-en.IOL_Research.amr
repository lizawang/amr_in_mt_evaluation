(o / obligate-01
    :ARG2 (p2 / provide-01
        :ARG0 (p / product
            :ARG1-of (c2 / conform-01
                :ARG2 (l / level
                    :ARG1-of (c4 / correspond-02)
                    :mod (i / implement-01)))
            :mod (s2 / software
                :mod (s3 / system)))
        :ARG1 (a2 / and
