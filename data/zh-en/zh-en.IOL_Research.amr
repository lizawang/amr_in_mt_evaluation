# ::edge	contain-01	rel	name	c5	n	
(c5 / contain-01
    :ARG0 (p / part
        :mod (d4 / double-byte))
    :ARG1 (a2 / and
        :op1 (c2 / character
            :name (n3 / name
                :op1 "GB/T"
                :op2 "13000,")
            :mod (g2 / graphic))
        :op2 (c3 / character
            :ARG2-of (u / unify-01)
            :mod (c6 / country
                :name (n2 / name
                    :op1 "China")))
        :op3 (c4 / character
            :quant (s / some)))
    :rel (c / character
        :mod (g / graphic)
        :mod (a / all)
        :time (d3 / date-interval
            :op1 (d / date-entity
                :year 12
                :year 2000)
            :op2 (d2 / date-entity)))
    :rel (n / name
        :op1 "CJK"))

# ::tok Characters in the double-byte portion are as specified in Appendix A.
