(h / have-condition-91
    :ARG1 (u / use-01
        :ARG1 (o / option
            :mod (t3 / this))
        :ARG2 (d2 / define-01
            :ARG1 (o3 / or
                :op1 (f / field
                    :ARG1-of (s / sign-01))
                :op2 (f2 / field
                    :ARG1-of (s2 / sign-01
                        :polarity -)))))
    :ARG2 (d / declare-01
        :ARG1 (o2 / or
