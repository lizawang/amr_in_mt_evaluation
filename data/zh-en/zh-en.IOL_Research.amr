# ::edge	connect-01	ARG1	language	c	l	
# ::edge	and	rel	system	a	s2	
(a / and
    :op1 (c2 / consider-01
        :ARG0 (p2 / product
            :name (n / name
                :op1 "g++"))
        :ARG1 (f2 / file
            :domain (f / file
                :ARG1-of (p / process-01))
            :mod (l / language
                :name (n2 / name
                    :op1 "c++"))))
