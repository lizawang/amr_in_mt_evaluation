(e / encode-01
    :ARG1 (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c3 / country
                    :name (n2 / name
                        :op1 "China,"))
                :op2 (c4 / country
                    :name (n3 / name
                        :op1 "Japan,"))
                :op3 (c5 / country
                    :name (n4 / name
                        :op1 "Enguo,"))
                :op4 (a2 / and
                    :mod (o / other)
                    :op1 (c6 / country)
                    :op2 (r / region))))
        :mod (c2 / country
            :name (n / name
                :op1 "China")))
    :ARG3-of (u / unify-01)
    :domain (s / string-entity
        :value "GB/T"
        :value 13000)
    :rel (i / Vietnam))

# ::tok Characters with unique abstract glyphs are assigned a separate code position; characters with the same abstract glyph from different sources are assigned a common code position.
