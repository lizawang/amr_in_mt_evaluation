# ::node	t	that	41-42
# ::node	6	Oo2douolag0c	47-48
# ::root	t	that
# ::edge	ordinal-entity	value	1	o	0	
# ::edge	character	ord	ordinal-entity	c	o	
# ::edge	string-entity	value	4	s	4	
# ::edge	character	mod	string-entity	c2	s	
