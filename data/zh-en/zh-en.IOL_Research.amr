                :ARG1-of s)
            :op2 (t2 / thing
                :ARG0-of (m / modify-01)))
        :ARG1-of (e / explicit-03
            :polarity -))
    :rel -
    :rel -)

# ::tok By default, bitfields are signed, because the basic integer types they inherit, such as int, are signed numbers; however, if the `-traditional' option is specified, bitfields are always unsigned.
# ::node	f	field	2-3
