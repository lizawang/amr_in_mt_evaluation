# ::node	c	command	9-10
# ::node	l	line.	10-11
# ::node	o	other	11-12
# ::node	s	suffix	12-13
# ::node	f	file	13-14
# ::node	p	pass-05	15-16
# ::node	l2	linker.	18-19
# ::node	u2	usual	19-20
# ::node	i	include-01	20-21
# ::root	f2	file;
# ::edge	amr-unintelligible	value	1	a	1	
# ::edge	file;	ARG0-of	process-01	f2	p2	
# ::edge	file;	mod	amr-unintelligible	f2	a	
# ::edge	appear-01	polarity	-	a2	0	
# ::edge	appear-01	mod	usual	a2	u	
# ::edge	file;	ARG1-of	appear-01	f2	a2	
# ::edge	line.	mod	command	l	c	
# ::edge	appear-01	location	line.	a2	l	
# ::edge	file	mod	suffix	f	s	
# ::edge	file	mod	other	f	o	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	file;	domain	pass-05	f2	p	
# ::edge	pass-05	ARG2	linker.	p	l2	
# ::edge	include-01	frequency	usual	i	u2	
# ::edge	file	ARG2-of	include-01	f	i	
(f2 / file;
    :ARG0-of (p2 / process-01)
    :ARG1-of (a2 / appear-01
        :location (l / line.
            :mod (c / command))
        :mod (u / usual)
        :polarity -)
    :domain (p / pass-05
        :ARG1 (f / file
            :ARG2-of (i / include-01
                :frequency (u2 / usual))
            :mod (s / suffix)
            :mod (o / other))
        :ARG2 (l2 / linker.))
    :mod (a / amr-unintelligible
        :value 1))

