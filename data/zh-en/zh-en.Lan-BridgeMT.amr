(s / say-01
    :ARG0 (p6 / publication
        :name (n / name
            :op1 "China"
            :op2 "News"
            :op3 "Network"))
    :ARG1 (p4 / possible-01
        :ARG1 (t / temporal-quantity
            :quant 360
            :domain (p2 / period
