# ::node	f	follow-04	15-16
# ::node	w	way:	16-17
# ::root	a	adjust-01
# ::edge	possible-01	polarity	-	p	1	
# ::edge	and	op1	connect-01	a2	c	
# ::edge	possible-01	ARG1	and	p	a2	
# ::edge	and	op2	use-01	a2	u	
# ::edge	adjust-01	polite	+	a	0	
