(a / and
    :domain (r / range-01
        :ARG1 (b / byte
            :ord (o / ordinal-entity
                :value 1)
            :part-of (c / character
                :quant 4))
        :ARG3 (e / encode-01))
    :op1 (s / string-entity
        :value b
        :value 0x81
        :value 0x81318230)
    :op2 (t / that)
    :rel (r2 / range-01
        :ARG1 (b2 / byte
            :value 0x30))
    :rel (b3 / byte
        :ord (o2 / ordinal-entity
            :value 3))
    :rel (r3 / range-01
        :ARG1 b2
        :ARG3 (d / distance-quantity
            :poss (i / i)
            :value 0x30
            :value 18)
        :ARG4 (b4 / byte
            :ord (o3 / ordinal-entity
                :value 4))
        :ARG4 (s2 / string-entity
            :value 8
            :value 15542288))
    :rel 2
    :rel (h / hyperlink-91))

