        :ARG1 (c / character)))

# ::tok The characters in the single-byte part are arranged in the order of the corresponding characters in GB/I 11383-1989.
# ::node	c	character	1-2
# ::node	s	single-byte	4-5
# ::node	p	part	5-6
# ::node	a	arrange-01	7-8
# ::node	o	order-03	10-11
