# ::edge	name	op3	Korea.	n3	4	
# ::edge	call-01	rel	name	c	n2	
# ::edge	call-01	rel	stand-08	c	s	
(c / call-01
    :ARG1 (c2 / character
        :ARG1-of (e / encourage-01)
        :mod (c3 / country
            :name (n / name
                :op1 "China")))
    :rel (n2 / name
        :op1 "Unified"
        :op2 "Ideographs,"
        :op3 "Ideographs,"
        :op4 "CJK")
    :rel (s / stand-08
        :ARG1 (a / and
            :op1 (c4 / country
                :name (n3 / name
                    :op1 "Japan,"
                    :op3 "Korea."))
            :op2 (c5 / country
                :name n3))))

# ::tok 4.4 Four-byte part
