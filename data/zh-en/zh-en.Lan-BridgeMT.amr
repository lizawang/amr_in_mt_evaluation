# ::node	1	C.	7-8
# ::node	f2	file	8-9
# ::node	a	and	9-10
# ::node	s	set-02	10-11
# ::node	r	resemble-01	11-12
# ::node	r2	resemble-01	11-12
# ::node	t	thing	11-12
# ::node	l	link-01	12-13
# ::root	a	and
# ::edge	company	name	name	c	n	
# ::edge	format	name	name	f3	n2	
# ::edge	name	op1	10000	n	0	
# ::edge	consider-01	ARG0	company	c2	c	
# ::edge	file	ARG1-of	process-01	f	p	
# ::edge	consider-01	ARG1	file	c2	f	
# ::edge	format	name	name	f4	n3	
# ::edge	string-entity	value	C.	s2	1	
# ::edge	file	mod	format	f2	f4	
# ::edge	consider-01	ARG2	file	c2	f2	
# ::edge	and	op1	consider-01	a	c2	
# ::edge	and	op2	set-02	a	s	
# ::edge	set-02	ARG0	company	s	c	
# ::edge	resemble-01	ARG2	string-entity	r	s2	
# ::edge	file	ARG1-of	resemble-01	f	r	
# ::edge	resemble-01	ARG2	thing	r2	t	
# ::edge	thing	mod	format	t	f4	
# ::edge	link-01	ARG1-of	resemble-01	l	r2	
# ::edge	set-02	ARG1	link-01	s	l	
# ::edge	and	rel	format	a	f3	
(a / and
    :op1 (c2 / consider-01
        :ARG0 (c / company
            :name (n / name
                :op1 10000))
        :ARG1 (f / file
            :ARG1-of (p / process-01)
            :ARG1-of (r / resemble-01
                :ARG2 (s2 / string-entity
                    :value "C.")))
        :ARG2 (f2 / file
            :mod (f4 / format
                :name (n3 / name))))
    :op2 (s / set-02
        :ARG0 c
        :ARG1 (l / link-01
            :ARG1-of (r2 / resemble-01
                :ARG2 (t / thing
                    :mod f4))))
    :rel (f3 / format
        :name (n2 / name)))

# ::tok g++ considers preprocessed files (.i) to be c++ files and sets c++ style links.
# ::node	p2	product	0-1
