# ::root	a	and
# ::edge	model	ARG1-of	low-04	m	l3	
# ::edge	model	mod	this	m	t	
# ::edge	model	source	company	m	c	
# ::edge	company	name	name	c	n	
# ::edge	name	op1	Sony	n	0	
# ::edge	have-03	mod	still	h	s3	
# ::edge	have-03	ARG0	model	h	m	
# ::edge	sense-01	degree	full	s2	f	
# ::edge	have-03	ARG1	sense-01	h	s2	
# ::edge	sense-01	ARG1	design,	s2	d	
# ::edge	and	op1	have-03	a	h	
# ::edge	and	op2	have-03	a	h2	
# ::edge	have-03	ARG0	model	h2	m	
# ::edge	screen,	mod	large	s	l	
# ::edge	have-03	ARG1	screen,	h2	s	
# ::edge	life,	mod	battery	l2	b	
# ::edge	life,	ARG1-of	excellent-02	l2	e2	
# ::edge	screen,	op3	life,	s	l2	
# ::edge	suitable-04	degree	very	s4	v	
# ::edge	and	op4	suitable-04	a	s4	
