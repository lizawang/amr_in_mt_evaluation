# ::node	d3	date-interval	9-10
# ::node	d	date-entity	9-10
# ::node	d2	date-entity	9-10
# ::node	1	13	9-10
# ::node	2	2	9-10
# ::node	3	2008	9-10
# ::node	u2	use-01	10-11
# ::node	c	code	12-13
# ::node	p2	position	13-14
# ::node	v	value-interval	14-15
