(r / recommend-01
    :ARG1 (c4 / comply-01
        :ARG0 (a2 / and
            :op2 (p / position-02
                :ARG1 (c2 / character
                    :ARG0-of (d / describe-01
                        :ARG1 (i / ideology)))
                :mod (c3 / code))
            :op3 (f / function-01
                :ARG0 c2))
        :ARG1 (c / chapter
            :mod (a / B.))))

# ::tok Note: GB/T 13000 unifies the encoding of Chinese characters used in China, Japan, South Korea, Vietnam and other countries and regions.
# ::node	p	product	1-2
