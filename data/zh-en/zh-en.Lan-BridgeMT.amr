# ::node	a2	all	9-10
# ::node	o2	other	10-11
# ::node	n	number	11-12
# ::node	h2	have-mod-91	12-13
# ::node	d	decimal.	14-15
# ::root	a3	and
# ::edge	object	mod	all	o	a	
# ::edge	have-mod-91	ARG1	object	h	o	
# ::edge	have-mod-91	ARG2	hexadecimal,	h	h3	
# ::edge	and	op1	have-mod-91	a3	h	
# ::edge	and	location	appendix,	a3	a4	
# ::edge	number	mod	other	n	o2	
# ::edge	number	mod	all	n	a2	
# ::edge	have-mod-91	ARG1	number	h2	n	
# ::edge	and	op2	have-mod-91	a3	h2	
# ::edge	have-mod-91	ARG2	decimal.	h2	d	
(a3 / and
    :location (a4 / appendix,)
    :op1 (h / have-mod-91
        :ARG1 (o / object
            :mod (a / all))
        :ARG2 (h3 / hexadecimal,))
    :op2 (h2 / have-mod-91
        :ARG1 (n / number
            :mod (o2 / other)
            :mod (a2 / all))
        :ARG2 (d / decimal.)))

# ::tok The single-byte part uses the encoding structure of GB/T 11383-1989, using the code positions 0x00~0x7F.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	u	use-01	3-4
# ::node	e	encode-01	5-6
