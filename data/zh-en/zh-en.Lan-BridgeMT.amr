(e2 / earthquake
    :quant (o2 / over
        :op1 (s / seismic-quantity
            :quant 9))
    :ARG1-of (r / record-01)
    :domain (e / earthquake
        :mod (t / this))
    :location (c / country
        :name (n / name
            :op1 "Japan"))
    :ord (o / ordinal-entity
        :value 1))

