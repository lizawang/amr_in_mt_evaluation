(e / earthquake
    :ARG1-of (h / have-degree-91
        :ARG2 (d / destroy-01
            :ARG0 e)
        :ARG3 (m / most)
        :ARG5 (w / world))
    :time (b / before
        :duration (t / temporal-quantity
            :quant 60
            :unit (y / year))
        :op1 (n / now)))

