# ::edge	program;	ARG0-of	source-02	p2	s	
# ::edge	string-entity	part-of	program;	s2	p2	
# ::edge	process-01	time	before	p	b	
# ::edge	before	op1	assemble-01	b	a	
# ::edge	string-entity	rel	process-01	s2	p	
(s2 / string-entity
    :part-of (p2 / program;
        :ARG0-of (s / source-02))
    :rel (p / process-01
        :time (b / before
            :op1 (a / assemble-01)))
    :value "C.")

