# ::edge	person	ARG0-of	use-01	p	u	
# ::edge	area	ARG1-of	person	a	p	
# ::edge	reserve-01	ARG2	area	r	a	
(r / reserve-01
    :ARG1 (p2 / point
        :quant 25200
        :mod (c / code)
        :mod (t / total))
    :ARG2 (a / area
        :ARG1-of (p / person
            :ARG0-of (u / use-01)))
    :time (d3 / date-interval
        :op1 (d / date-entity
            :day 30
            :month 2
            :year 2008)
        :op2 (d2 / date-entity
            :quant 0
            :year 2007)))

