(s / switch-01
    :ARG0 (y / you)
    :ARG2 (l / listen-01
        :instrument (p / phone
            :ARG1-of (m / mobile-02)))
    :manner (c3 / click-01
        :ARG0 y)
    :rel (r / reject-01
        :ARG0 y
        :ARG1 (c2 / call-02)
        :mode imperative
        :time (c4 / come-01
            :ARG1 (c / call-02))))

