# ::edge	use-01	ARG0	elderly	u	e	
# ::edge	suitable-04	ARG2	use-01	s4	u	
(a / and
    :op1 (h / have-03
        :ARG0 (m / model
            :ARG1-of (l3 / low-04)
            :mod (t / this)
            :source (c / company
                :name (n / name
                    :op1 "Sony")))
        :ARG1 (s2 / sense-01
            :ARG1 (d / design,)
            :degree (f / full))
        :mod (s3 / still))
    :op2 (h2 / have-03
        :ARG0 m
        :ARG1 (s / screen,
            :mod (l / large)
            :op3 (l2 / life,
                :ARG1-of (e2 / excellent-02)
                :mod (b / battery))))
    :op4 (s4 / suitable-04
        :ARG1 m
        :ARG2 (u / use-01
            :ARG0 (e / elderly))
        :degree (v / very)))

