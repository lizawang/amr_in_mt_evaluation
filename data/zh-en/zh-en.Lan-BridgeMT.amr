# ::root	a	and
# ::edge	range-01	ARG3	encode-01	r	e	
# ::edge	ordinal-entity	value	1	o	4	
# ::edge	byte	ord	ordinal-entity	b	o	
# ::edge	range-01	ARG1	byte	r	b	
# ::edge	character	quant	4	c	9	
# ::edge	byte	part-of	character	b	c	
