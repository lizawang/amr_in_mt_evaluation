# ::edge	character	mod	graphic	c2	g2	
# ::edge	character	quant	some	c2	s	
# ::edge	and	op3	character	a2	c2	
(i / include-01
    :ARG1 (a2 / and
        :op1 (c / character
            :location (p2 / publication
                :name (n / name
                    :op1 "GB/T")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :year 13
                        :year 2004)
                    :op2 (d2 / date-entity
                        :year 13000)))
            :mod (g / graphic)
            :mod (a / all))
        :op2 (c3 / company
            :name (n2 / name
                :op1 "CJK"
                :op2 "Unified"
                :op3 "Ideographs")
            :prep-in (p3 / publication
                :name (n3 / name
                    :op1 "GB/T")))
        :op3 (c2 / character
            :quant (s / some)
            :mod (g2 / graphic)))
    :ARG2 (p / part
        :mod (d4 / double-byte)))

# ::tok The characters in the double-byte part are according to Appendix A.
