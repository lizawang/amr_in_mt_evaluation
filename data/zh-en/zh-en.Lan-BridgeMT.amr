(a / activate-01
    :ARG0 (y / you)
    :ARG1 (a4 / assist-01
        :ARG0-of (v / voice-01))
    :mode imperative
    :rel (a2 / and
        :op1 (n / need-01
            :ARG0 (d / device)
            :ARG1 (a3 / and
                :op1 (s2 / support-01
                    :ARG0 d
