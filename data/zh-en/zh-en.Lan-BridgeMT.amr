# ::edge	position	mod	code	p	c	
# ::edge	position	quant	192	p	2	
# ::edge	Double-byte	mod	position	o	p	
# ::edge	Double-byte	rel	byte	o	b	
# ::edge	Double-byte	rel	name	o	n	
(o / Double-byte
    :mod (o2 / ordinal-entity
        :value 1)
    :mod 5
    :mod (p / position
        :quant 192
        :mod (c / code))
    :rel (b / byte
        :ord o2)
    :rel (n / name
        :op1 "0xA8~0xA9"))

