# ::edge	structure	poss	product	s2	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	5	
# ::edge	product	time	date-interval	p3	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	13	d	1	
# ::edge	date-entity	month	2	d	2	
# ::edge	date-entity	year	2008	d	3	
# ::edge	use-01	ARG2-of	use-01	u	u2	
# ::edge	position	mod	code	p2	c	
# ::edge	use-01	ARG1	position	u2	p2	
# ::edge	position	mod	value-interval	p2	v	
# ::edge	value-interval	op1	7	v	4	
# ::edge	value-interval	op2	0	v	0	
(u / use-01
    :ARG0 (p / part
        :mod (s / single-byte))
    :ARG1 (s2 / structure
        :mod (e / encode-01)
        :poss (p3 / product
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 13
                    :month 2
                    :year 2008)
                :op2 (d2 / date-entity))))
    :ARG2-of (u2 / use-01
        :ARG1 (p2 / position
            :mod (c / code)
            :mod (v / value-interval
                :op1 7
                :op2 0))))

# ::tok The double-byte part uses two eight-bit binary bit strings to represent a character, with the first byte code positions from 0x81 to 0xFE, and the second byte code positions are 0x40 to 0x7E and 0x80 to 0xFE.
