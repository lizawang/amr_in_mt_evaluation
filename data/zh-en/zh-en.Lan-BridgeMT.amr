# ::edge	letter	mod	code	l	c3	
# ::edge	letter	ARG1-of	separate-02	l	s2	
# ::edge	assign-01	ARG1	letter	a2	l	
# ::edge	character	mod	country	c2	c5	
# ::edge	character	ARG1-of	unique-01	c2	u	
# ::edge	character	ARG0-of	have-03	c2	h	
# ::edge	have-03	ARG1	character	h	c	
# ::edge	thug	mod	abstract	t	a	
# ::edge	thug	ARG1-of	unique-01	t	u	
# ::edge	have-03	ARG1	thug	h	t	
# ::edge	source	ARG1-of	differ-02	s4	d	
# ::edge	character	source	source	c2	s4	
# ::edge	assign-01	ARG1	character	a3	c2	
# ::edge	position-01	ARG1	code	p	c4	
# ::edge	position-01	ARG1-of	share-01	p	s3	
# ::edge	assign-01	ARG2	position-01	a3	p	
# ::edge	position-01	ARG2	character	p	c2	
# ::edge	assign-01	rel	assign-01	a3	a2	
# ::edge	assign-01	rel	same-01	a3	s	
(a3 / assign-01
    :ARG1 (c2 / character
        :ARG0-of (h / have-03
            :ARG1 (c / character
                :mod (c5 / country
                    :name (n / name
                        :op1 "China")))
            :ARG1 (t / thug
                :ARG1-of (u / unique-01)
                :mod (a / abstract)))
        :ARG1-of u
        :mod c5
        :source (s4 / source
            :ARG1-of (d / differ-02)))
    :ARG2 (p / position-01
        :ARG1 (c4 / code)
        :ARG1-of (s3 / share-01)
        :ARG2 c2)
    :rel (a2 / assign-01
        :ARG1 (l / letter
            :ARG1-of (s2 / separate-02)
            :mod (c3 / code)))
    :rel (s / same-01))

# ::tok Encoded Chinese characters are called CJK Unified Ideographs, where CJK stands for China, Japan, and Korea.
