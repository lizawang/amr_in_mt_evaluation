# ::edge	or	op1	string-entity	o3	s2	
# ::edge	or	op2	string-entity	o3	s3	
# ::edge	string-entity	polarity	-	s3	0	
# ::edge	option	mod	or	o2	o3	
# ::edge	use-01	ARG1	option	u	o2	
# ::edge	(or	op1	use-01	o	u	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	(or	op2	prevent-01	o	p	
# ::edge	process-02	ARG1-of	complete-02	p2	c2	
# ::edge	prevent-01	ARG1	process-02	p	p2	
# ::edge	thing	mod	last	t	l	
# ::edge	thing	time	always	t	a	
# ::edge	thing	domain	link-01	t	l2	
# ::edge	thing	condition	(or	t	o	
# ::edge	thing	ARG4-of	step-01	t	s	
(t / thing
    :ARG4-of (s / step-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (o2 / option
                :mod (o3 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :domain (l2 / link-01)
    :mod (l / last)
    :time (a / always))

# ::tok During the linking phase, all .e files corresponding to the source program, -1 library files, unrecognizable file names (including specified .o H tag files and .a library files) are passed to the linker options (OPTIONS) in the order of the command line.
# ::node	l3	link-01	2-3
# ::node	p2	phase,	3-4
# ::node	a	all	4-5
# ::node	f	file	6-7
# ::node	c2	correspond-02	7-8
