# ::edge	have-mod-91	ARG1	number	h3	n2	
# ::edge	have-mod-91	ARG2	decimal.	h3	d	
(a / and
    :location (t / text,
        :mod (m / main))
    :op1 (h2 / have-mod-91
        :ARG1 (n / number
            :ARG1-of (p / prefer-01
                :ARG2 (s / string-entity
                    :value 0x)))
        :ARG2 (h4 / hexadecimal,))
    :op2 (h3 / have-mod-91
        :ARG1 (n2 / number
            :ARG0-of (h / have-03
                :ARG1 s
                :polarity -))
        :ARG2 (d / decimal.)))

# ::tok In the appendix, all encodings are in hexadecimal, and all other numbers are in decimal.
# ::node	a4	appendix,	2-3
# ::node	a	all	3-4
# ::node	o	object	4-5
# ::node	h	have-mod-91	6-7
# ::node	h3	hexadecimal,	7-8
