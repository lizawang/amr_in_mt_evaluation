# ::edge	connect-01	ARG1	headset	c	h	
# ::edge	way:	ARG1-of	follow-04	w	f	
# ::edge	adjust-01	manner	way:	a	w	
(a / adjust-01
    :ARG0 (y / you)
    :ARG1 (h / headset)
    :condition (p / possible-01
        :ARG1 (a2 / and
            :op1 (c / connect-01
                :ARG1 h)
            :op2 (u / use-01
                :ARG1 h))
        :polarity -)
    :manner (w / "way:"
        :ARG1-of (f / follow-04))
    :mode imperative
    :polite +)

