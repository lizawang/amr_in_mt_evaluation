# ::edge	name	op1	Vietnam	n5	6	
# ::edge	country	name	name	c5	n5	
# ::edge	and	op2	region	a2	r	
(u / unify-01
    :ARG0 (p / product
        :name (n / name
            :op1 "GB/T"
            :op2 13000))
    :ARG1 (e / encode-01
        :ARG1 (c / character
            :ARG1-of (u2 / use-01
                :location (a / and
                    :op1 (c3 / country
                        :name (n3 / name
                            :op1 "China,"))
                    :op2 (c4 / country
                        :name (n4 / name
                            :op1 "South"
                            :op2 "Korea,"))
                    :op3 (c5 / country
                        :name (n5 / name
                            :op1 "Vietnam"))
                    :op4 (a2 / and
                        :mod (o / other)
                        :op1 (c6 / country)
                        :op2 (r / region))))
            :mod (c2 / country
                :name (n2 / name
                    :op1 "China")))))

# ::tok Chinese characters with unique abstract glyphs are assigned separate code positions; Chinese characters with the same abstract glyphs from different sources are assigned shared code positions.
# ::node	c5	country	0-1
# ::node	n	name	0-1
# ::node	0	China	0-1
# ::node	c	character	1-2
# ::node	u	unique-01	3-4
