# ::edge	name	op2	Double-byte	n2	3	
# ::edge	name	op3	3	n2	0	
# ::edge	code	name	name	c	n2	
# ::edge	code	mod	6080	c2	1	
# ::edge	code	name	name	c2	n3	
# ::edge	name	op2	6080	n3	1	
# ::edge	name	op1	6080	n3	1	
# ::edge	code	mod	6080	c3	1	
# ::edge	position-01	ARG1	code	p2	c3	
# ::edge	position-01	ARG2	area:	p2	a2	
# ::edge	position	mod	code	p	c3	
# ::edge	area:	op3	position	a2	p	
# ::edge	position-01	rel	shit	p2	s	
# ::edge	position-01	rel	code	p2	c	
# ::edge	position-01	rel	code	p2	c2	
# ::edge	position-01	rel	6080	p2	2	
# ::edge	position-01	rel	and	p2	a	
(p2 / position-01
    :ARG1 (c3 / code
        :mod 6080)
    :ARG2 (a2 / "area:"
        :op3 (p / position
            :mod c3))
    :rel (s / shit
        :name (n / name
            :op2 "WA"))
    :rel (c / code
        :name (n2 / name
            :op1 "RS"
            :op2 "Double-byte"
            :op3 3))
    :rel (c2 / code
        :name (n3 / name
            :op1 6080
            :op2 6080)
        :mod 6080)
    :rel 6080
    :rel (a / and))

# ::tok First byte 0xA8~0xA9 Double-byte 5 area: 192 code positions
# ::node	o2	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8~0xA9	2-3
