# ::tok In the main text, numbers prefixed with 0x are in hexadecimal, and those without 0x are in decimal.
# ::node	m	main	2-3
# ::node	t	text,	3-4
# ::node	n	number	4-5
# ::node	n2	number	4-5
# ::node	p	prefer-01	5-6
