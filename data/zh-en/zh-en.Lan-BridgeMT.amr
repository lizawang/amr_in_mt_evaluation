# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	13	d	0	
# ::edge	date-entity	year	2004	d	2	
# ::edge	name	op1	CJK	n2	3	
# ::edge	name	op2	Unified	n2	7	
# ::edge	company	name	name	c3	n2	
# ::edge	name	op3	Ideographs	n2	6	
# ::edge	company	prep-in	publication	c3	p3	
# ::edge	publication	name	name	p3	n3	
# ::edge	name	op1	GB/T	n3	5	
# ::edge	date-entity	year	13000	d2	1	
# ::edge	and	op2	company	a2	c3	
# ::edge	and	op1	character	a2	c	
