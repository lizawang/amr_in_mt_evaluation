# ::edge	before	op2	assemble-01	b	a	
# ::edge	program;	rel	process-01	p2	p	
(p2 / program;
    :name (n / name
        :op1 ".C"
        :op2 "C++")
    :mod (s / source)
    :rel (p / process-01
        :op1 (t / thing
            :name n)
        :time (b / before
            :op2 (a / assemble-01))))

