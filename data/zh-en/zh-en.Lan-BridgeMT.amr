# ::edge	indicate-01	ARG1	and	i	a	
# ::edge	operate-01	time	subsequent	o	s2	
# ::edge	and	op2	operate-01	a	o	
(i / indicate-01
    :ARG0 (s3 / suffix
        :poss (f / file
            :mod (s / source)))
    :ARG1 (a / and
        :op1 (t / type
            :mod (l / language))
        :op2 (o / operate-01
            :time (s2 / subsequent))))

# ::tok .c C source program; preprocessing, compilation, assembly
