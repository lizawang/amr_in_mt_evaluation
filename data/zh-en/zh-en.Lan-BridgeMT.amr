# ::node	0	Alaska	0-1
# ::node	e	earthquake	1-2
# ::node	d	date-entity	2-3
# ::node	a	(1964)	2-3
# ::root	e	earthquake
# ::edge	state	name	name	s	n	
# ::edge	name	op1	Alaska	n	0	
# ::edge	earthquake	location	state	e	s	
# ::edge	earthquake	time	date-entity	e	d	
# ::edge	date-entity	year	(1964)	d	a	
(e / earthquake
    :location (s / state
        :name (n / name
            :op1 "Alaska"))
    :time (d / date-entity
        :year (a / "(1964)")))

# ::tok March 27, 1964, was a Friday and also Good Friday.
# ::node	2	3	0-1
# ::node	1	27,	1-2
# ::node	d	date-entity	2-3
# ::node	0	1964,	2-3
# ::node	f	friday	5-6
# ::node	a2	and	6-7
# ::node	a	also	7-8
# ::node	g	good-02	8-9
# ::node	d2	date-entity	9-10
# ::node	f2	friday	9-10
# ::root	a2	and
# ::edge	date-entity	day	27,	d	1	
# ::edge	date-entity	month	3	d	2	
# ::edge	date-entity	year	1964,	d	0	
# ::edge	date-entity	weekday	friday	d	f	
# ::edge	and	op1	date-entity	a2	d	
# ::edge	date-entity	ARG1-of	good-02	d2	g	
# ::edge	date-entity	mod	also	d2	a	
# ::edge	and	op2	date-entity	a2	d2	
# ::edge	date-entity	weekday	friday	d2	f2	
(a2 / and
    :op1 (d / date-entity
        :day 27,
        :month 3
        :weekday (f / friday)
        :year 1964,)
    :op2 (d2 / date-entity
        :ARG1-of (g / good-02)
        :mod (a / also)
        :weekday (f2 / friday)))

# ::tok On this day, the largest earthquake in North American history occurred in Alaska, with a moment magnitude of 9.2.
# ::node	t	this	1-2
# ::node	d	day,	2-3
# ::node	h	have-degree-91	4-5
# ::node	l	large	4-5
# ::node	m2	most	4-5
# ::node	e	earthquake	5-6
# ::node	c	continent	7-8
# ::node	n	name	7-8
# ::node	2	North	7-8
# ::node	1	America	8-9
# ::node	h2	history	9-10
# ::node	m	moment	15-16
# ::node	s	seismic-quantity	18-19
# ::node	0	9.2.	18-19
# ::root	e	earthquake
# ::edge	day,	mod	this	d	t	
# ::edge	have-degree-91	ARG2	large	h	l	
# ::edge	have-degree-91	ARG3	most	h	m2	
# ::edge	earthquake	ARG1-of	have-degree-91	e	h	
# ::edge	earthquake	time	day,	e	d	
# ::edge	continent	name	name	c	n	
# ::edge	name	op1	North	n	2	
# ::edge	name	op2	America	n	1	
# ::edge	history	mod	continent	h2	c	
# ::edge	have-degree-91	ARG5	history	h	h2	
# ::edge	earthquake	mod	moment	e	m	
# ::edge	earthquake	quant	seismic-quantity	e	s	
# ::edge	seismic-quantity	quant	9.2.	s	0	
(e / earthquake
    :quant (s / seismic-quantity
        :quant 9.2.)
    :ARG1-of (h / have-degree-91
        :ARG2 (l / large)
        :ARG3 (m2 / most)
        :ARG5 (h2 / history
            :mod (c / continent
                :name (n / name
                    :op1 "North"
                    :op2 "America"))))
    :mod (m / moment)
    :time (d / day,
        :mod (t / this)))

# ::tok Until 2006, the Alaska earthquake was still the third largest earthquake on record.
# ::node	u	until	0-1
# ::node	s	state	3-4
# ::node	n	name	3-4
# ::node	1	Alaska	3-4
# ::node	e	earthquake	4-5
# ::node	s2	still	6-7
# ::node	o	ordinal-entity	8-9
# ::node	0	3	8-9
# ::node	h	have-degree-91	9-10
# ::node	l	large	9-10
# ::node	m	most	9-10
# ::node	r	record-01	12-13
# ::root	h	have-degree-91
# ::edge	state	name	name	s	n	
# ::edge	name	op1	Alaska	n	1	
# ::edge	earthquake	location	state	e	s	
# ::edge	ordinal-entity	value	3	o	0	
# ::edge	have-degree-91	mod	still	h	s2	
# ::edge	have-degree-91	ARG1	earthquake	h	e	
# ::edge	have-degree-91	time	until	h	u	
# ::edge	have-degree-91	ARG2	large	h	l	
# ::edge	have-degree-91	ARG3	most	h	m	
# ::edge	most	ord	ordinal-entity	m	o	
# ::edge	earthquake	ARG1-of	record-01	e	r	
(h / have-degree-91
    :ARG1 (e / earthquake
        :ARG1-of (r / record-01)
        :location (s / state
            :name (n / name
                :op1 "Alaska")))
    :ARG2 (l / large)
    :ARG3 (m / most
        :ord (o / ordinal-entity
            :value 3))
    :mod (s2 / still)
    :time (u / until))

# ::tok When the earthquake occurred, a fault between the Pacific Plate and the North American Plate ruptured near Prince William Sound and College Fjord.
