# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	1939	d	0	
# ::edge	date-entity	year	1989	d2	1	
(a / arrange-01
    :ARG1 (c / character
        :location (p / part
            :mod (s / single-byte)))
    :manner (o / order-03
        :ARG1 (c2 / character
            :ARG1-of (c3 / correspond-02
                :mod (p2 / product
                    :name (n / name
                        :op1 "GB/I")
                    :time (d3 / date-interval
                        :op1 (d / date-entity
                            :year 1939)
                        :op2 (d2 / date-entity
                            :year 1989)))))))

# ::tok 6.2 Double-byte part character arrangement order
