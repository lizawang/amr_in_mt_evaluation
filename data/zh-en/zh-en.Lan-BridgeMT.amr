# ::edge	batch	consist-of	product	b	p3	
# ::edge	product	ARG1-of	sell-01	p3	s	
(b / batch
    :consist-of (p3 / product
        :ARG0-of (m / manage-01
            :ARG1 (w / wealth
                :mod (p / pension)))
        :ARG1-of (p2 / personal-02)
        :ARG1-of (s / sell-01))
    :ord (o / ordinal-entity
        :value 1))

