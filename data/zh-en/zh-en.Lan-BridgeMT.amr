(c3 / click-01
    :purpose (a / and
        :op1 (h / hold-01
            :ARG0 (y / you)
            :ARG1 (c2 / call-02
                :mod (p2 / previous)))
        :op2 (a2 / answer-01
            :ARG0 y))
    :ARG0 y
    :ARG1 (k / key
        :mod (m2 / multifunction))
    :rel (c / call-02
        :ARG1-of (c5 / come-in-07)
        :ARG1-of (n / new-01))
    :rel (p / phone
        :ARG1-of (m / mobile-02))
    :rel (o / ordinal-entity
        :value 2)
    :rel (c4 / click-01
        :purpose (s / switch-01
            :ARG0 y
            :ARG2 (b / between
                :op1 c2
                :op2 c2))
        :ARG0 y
        :ARG1 (k2 / key
            :mod m2)))

