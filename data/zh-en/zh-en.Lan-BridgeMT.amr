# ::edge	period	duration	temporal-quantity	p	t	
# ::edge	temporal-quantity	unit	day	t	d	
(a / available-02
    :ARG2 (p2 / product
        :quant 7
        :prep-with (p / period
            :ARG1-of (h / have-degree-91
                :ARG2 (s / short-07
                    :ARG1 p)
                :ARG3 (m / most))
            :duration (t / temporal-quantity
                :quant 360
                :mod (o / only)
                :unit (d / day))
            :duration-of (h2 / hold-01))
        :source (i / institution
            :mod (h3 / home))))

