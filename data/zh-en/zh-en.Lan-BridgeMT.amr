# ::tok If the headset cannot be connected and used normally, please reset the headset in the following way:
# ::node	p	possible-01	3-4
# ::node	1	-	3-4
# ::node	c	connect-01	5-6
# ::node	a2	and	6-7
# ::node	u	use-01	7-8
