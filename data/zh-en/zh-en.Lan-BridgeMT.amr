# ::node	a	and	11-12
# ::node	h	have-03	13-14
# ::node	0	-	13-14
# ::node	h3	have-mod-91	16-17
# ::node	d	decimal.	17-18
# ::root	a	and
# ::edge	text,	mod	main	t	m	
# ::edge	number	ARG1-of	prefer-01	n	p	
# ::edge	prefer-01	ARG2	string-entity	p	s	
# ::edge	string-entity	value	0x	s	1	
