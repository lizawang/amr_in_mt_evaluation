(p2 / possible-01
    :ARG1 (c / connect-01
        :ARG1 (e / earring)
        :ARG2 (d / device
            :ARG1-of (p / pair-01)
            :mod (l / last))
        :condition (t / turn-on-13
            :ARG1 e
            :condition (n / need-01
                :ARG1 (t2 / turn-on-13
                    :ARG1 e)))
        :manner (a2 / automatic))
    :rel (o / ordinal-entity
        :value 1)
    :time (a / after))

