# ::edge	thing	ARG1-of	default-01	t	d	
# ::edge	control-01	ARG1	thing	c2	t	
# ::edge	thing	ARG1-of	set-02	t	s	
(c / contrast-01
    :ARG1 (i / identify-01
        :ARG0 (s3 / suffix)
        :ARG1 (l / language
            :poss (f / file,
                :mod (s2 / source))))
    :ARG2 (c2 / control-01
        :ARG0 s3
        :ARG1 (t / thing
            :ARG1-of (d / default-01)
            :ARG1-of (s / set-02))))

# ::tok gcc considers preprocessed files (.i) to be c files and sets c-style links,
# ::node	c	company	0-1
# ::node	n	name	0-1
# ::node	f3	format	0-1
# ::node	n2	name	0-1
# ::node	0	10000	0-1
# ::node	c2	consider-01	1-2
# ::node	p	process-01	2-3
# ::node	f	file	3-4
# ::node	s2	string-entity	7-8
# ::node	f4	format	7-8
