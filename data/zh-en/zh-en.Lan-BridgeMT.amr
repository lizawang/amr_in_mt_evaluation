(u / use-01
    :ARG0 (p / part
        :mod (d2 / double-byte))
    :ARG1 (s / string
        :quant 2
        :accompanier (a / and
            :op1 (p3 / position-01
                :ARG1 (c2 / code
                    :mod (b3 / byte
                        :ord (o / ordinal-entity
                            :value 1)))
                :ARG2 (r / range-01
                    :ARG1 0x81
                    :op2 (d / distance-quantity))
                :ARG2 (r2 / relative-position
