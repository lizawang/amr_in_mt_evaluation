(b2 / breach-01
    :ARG1 (f / fault
        :mod (b / between
            :op2 (o / ocean
                :name (n2 / name
                    :op1 "North"
                    :op2 "American"
                    :op3 "Plate"))))
    :ARG1-of (n5 / near-02
        :ARG2 (a / and
            :op1 (o2 / ocean
                :name (n3 / name
                    :op1 "Prince"
                    :op2 "William"
                    :op3 "Sound"))
            :op2 (i / island
                :name (n4 / name
                    :op1 "College"
                    :op2 "Fjord."))))
    :rel (c / "continent"
        :name (n / name
            :op1 "Pacific"
            :op1 c
            :op2 "Plate"))
    :time (e / earthquake))

