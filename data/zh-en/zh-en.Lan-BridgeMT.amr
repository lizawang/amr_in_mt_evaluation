(c / cause-01
    :ARG1 (c2 / complete-01
        :ARG0 (p / phone
            :name (n / name
                :op1 "Z2")
            :mod (t / this)
            :poss (i / i))
        :ARG1 (m / mission-01
            :ARG0 p)
        :mod (a / also)))

