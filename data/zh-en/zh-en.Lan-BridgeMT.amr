# ::node	d	date-entity	17-18
# ::node	d2	date-entity	17-18
# ::node	0	1939	17-18
# ::node	1	1989	17-18
# ::root	a	arrange-01
# ::edge	part	mod	single-byte	p	s	
# ::edge	character	location	part	c	p	
# ::edge	arrange-01	ARG1	character	a	c	
# ::edge	arrange-01	manner	order-03	a	o	
