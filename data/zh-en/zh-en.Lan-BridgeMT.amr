(a / and
    :op1 (d / die-01
        :ARG1 (p / person
            :quant 9)
        :ARG1-of (d3 / direct-02))
    :op2 (d2 / die-01
        :ARG0 (t2 / tsunami
            :ARG1-of (t / trigger-01
                :ARG0 (e / earthquake.)))
        :ARG1 (p2 / person
            :quant 130
            :mod (o / other))))

