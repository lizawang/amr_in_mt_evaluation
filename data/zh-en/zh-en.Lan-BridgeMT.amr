# ::edge	name	op1	c++	n2	0	
# ::edge	file	mod	product	f2	p3	
# ::edge	consider-01	ARG2	file	c	f2	
# ::edge	and	op1	consider-01	a	c	
# ::edge	and	op2	set-02	a	s	
# ::edge	set-02	ARG0	product	s	p2	
# ::edge	style	mod	product	s2	p3	
# ::edge	link-01	mod	style	l	s2	
# ::edge	set-02	ARG1	link-01	s	l	
(a / and
    :op1 (c / consider-01
        :ARG0 (p2 / product
            :name (n / name
                :op1 "g++"))
        :ARG1 (f / file
            :ARG1-of (p / process-01))
        :ARG2 (f2 / file
            :mod (p3 / product
                :name (n2 / name
                    :op1 "c++"))))
    :op2 (s / set-02
        :ARG0 p2
        :ARG1 (l / link-01
            :mod (s2 / style
                :mod p3))))

# ::tok The suffix of the source file indicates the type of language and subsequent operations:
