                        :op1 (p2 / percentage-entity
                            :value b3
                            :value 0x40
                            :value 0)
                        :op2 (p4 / position-01
                            :ARG1 (c3 / code
                                :mod (b4 / byte))
                            :ARG2 (r4 / relative-position
                                :value 0)))
                    :op1 p2))
            :op2 p4)
        :mod (b2 / bit
            :mod (b / binary)))
    :ARG2 (r5 / represent-01
        :ARG0 s
        :ARG1 (c / character,))
    :rel (o2 / ordinal-entity
        :value 2)
    :rel (p5 / position-01
        :ARG1 c3)
    :rel (n / name)
    :rel 8
    :rel (s2 / string-entity))

