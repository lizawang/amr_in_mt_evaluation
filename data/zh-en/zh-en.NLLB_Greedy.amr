# ::edge	thing	condition	use-01	t	u	
# ::edge	use-01	polarity	-	u	0	
# ::edge	err-01	ARG1	compile-01	e2	c	
# ::edge	prevent-01	ARG0	err-01	p	e2	
# ::edge	use-01	condition	prevent-01	u	p	
# ::edge	process-02	mod	entire	p2	e	
# ::edge	prevent-01	ARG1	process-02	p	p2	
(t / thing
    :condition (u / use-01
        :ARG1 (o / option
            :mod (o2 / or
                :op1 (s / string-entity)
                :op2 (s2 / string-entity
                    :value "or")))
        :condition (p / prevent-01
            :ARG0 (e2 / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :mod (e / entire)))
        :polarity -)
    :domain (c2 / connect-01)
    :mod (l / last)
    :time (a / always))

# ::tok At the connection stage, all corresponding.e files, -1 library files, unidentified file names ((including the specified.o H flag files and.a library files) are passed to the connector options in order from the command line
# ::node	c2	connect-01	2-3
# ::node	s	stage,	3-4
# ::node	a	all	4-5
# ::node	e	exemplify-01	5-6
# ::node	0	-	7-8
# ::node	l	library	8-9
# ::node	i	identify-01	10-11
# ::node	f	file	11-12
# ::node	n	name	12-13
# ::node	i2	include-91	13-14
# ::node	n2	name	15-16
# ::node	1	H	16-17
# ::node	f4	flag	17-18
# ::node	f2	file	18-19
# ::node	f3	file	18-19
# ::node	l2	library	20-21
# ::node	p	pass-05	23-24
# ::node	c3	connect-01	26-27
# ::node	o	option	27-28
# ::node	o2	order-03	29-30
# ::node	c	command	32-33
# ::node	l3	line	33-34
# ::root	p	pass-05
# ::edge	stage,	mod	connect-01	s	c2	
# ::edge	identify-01	polarity	-	i	0	
# ::edge	name	mod	file	n	f	
# ::edge	name	ARG1-of	identify-01	n	i	
# ::edge	name	ARG2-of	include-91	n	i2	
# ::edge	name	op1	H	n2	1	
# ::edge	flag	name	name	f4	n2	
# ::edge	include-91	ARG1	file	i2	f2	
# ::edge	file	mod	name	f2	n	
# ::edge	file	mod	all	f2	a	
# ::edge	file	mod	flag	f3	f4	
# ::edge	include-91	ARG1	file	i2	f3	
# ::edge	file	mod	library	f3	l2	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	pass-05	time	stage,	p	s	
# ::edge	option	mod	connect-01	o	c3	
# ::edge	pass-05	ARG2	option	p	o	
# ::edge	pass-05	ARG1-of	order-03	p	o2	
# ::edge	line	mod	command	l3	c	
# ::edge	pass-05	source	line	p	l3	
# ::edge	pass-05	rel	include-91	p	i2	
# ::edge	pass-05	rel	exemplify-01	p	e	
# ::edge	pass-05	rel	library	p	l	
(p / pass-05
    :ARG1 (f / file)
    :ARG1-of (o2 / order-03)
    :ARG2 (o / option
        :mod (c3 / connect-01))
    :rel (i2 / include-91
        :ARG1 (f2 / file
            :mod (n / name
                :ARG1-of (i / identify-01
                    :polarity -)
                :ARG2-of i2
                :mod f)
            :mod (a / all))
        :ARG1 (f3 / file
            :mod (f4 / flag
                :name (n2 / name
                    :op1 "H"))
            :mod (l2 / library)))
    :rel (e / exemplify-01)
    :rel (l / library)
    :source (l3 / line
        :mod (c / command))
    :time (s / stage,
        :mod (c2 / connect-01)))

# ::tok The option must be given separately: de'is completely different from `-d-r '.
# ::node	o2	option	1-2
# ::node	o	obligate-01	2-3
# ::node	g	give-01	4-5
# ::node	c	complete-02	7-8
# ::node	d	differ-02	8-9
# ::node	s	string-entity	10-11
# ::node	0	and	10-11
# ::root	o	obligate-01
# ::edge	obligate-01	ARG2	give-01	o	g	
# ::edge	give-01	ARG1	option	g	o2	
# ::edge	differ-02	ARG1-of	complete-02	d	c	
# ::edge	option	ARG1-of	differ-02	o2	d	
# ::edge	differ-02	ARG2	string-entity	d	s	
# ::edge	string-entity	value	and	s	0	
(o / obligate-01
    :ARG2 (g / give-01
        :ARG1 (o2 / option
            :ARG1-of (d / differ-02
                :ARG1-of (c / complete-02)
                :ARG2 (s / string-entity
                    :value "and")))))

# ::tok Most ` -=E: and `-W' options have two opposite formats: -fname and -fno-name (or -Wname and -Wno-name).
# ::node	m	most	0-1
# ::node	s	string-entity	2-3
# ::node	0	2	2-3
# ::node	s2	string-entity	4-5
# ::node	o2	option	5-6
# ::node	o3	option	5-6
# ::node	h	have-03	6-7
# ::node	1	2	7-8
# ::node	o	opposite-01	8-9
# ::node	a	and	11-12
# ::node	s3	string-entity	12-13
# ::node	s4	string-entity	12-13
# ::node	s5	string-entity	12-13
# ::node	a2	and	15-16
# ::node	n	name	16-17
# ::node	n2	name	16-17
# ::root	h	have-03
# ::edge	string-entity	value	2	s	0	
# ::edge	option	mod	string-entity	o2	s2	
# ::edge	option	quant	most	o2	m	
# ::edge	option	mod	string-entity	o3	s2	
# ::edge	have-03	ARG0	option	h	o2	
# ::edge	and	ARG1-of	opposite-01	a	o	
# ::edge	and	quant	2	a	1	
# ::edge	have-03	ARG1	and	h	a	
# ::edge	and	op2	option	a	o3	
# ::edge	and	op1	string-entity	a	s	
# ::edge	and	op1	string-entity	a	s3	
# ::edge	and	op2	string-entity	a	s4	
# ::edge	and	op3	string-entity	a	s5	
# ::edge	and	op1	string-entity	a2	s5	
# ::edge	option	name	name	o3	n	
# ::edge	string-entity	name	name	s5	n2	
# ::edge	have-03	rel	and	h	a2	
(h / have-03
    :ARG0 (o2 / option
        :quant (m / most)
        :mod (s2 / string-entity))
    :ARG1 (a / and
        :quant 2
        :ARG1-of (o / opposite-01)
        :op1 (s / string-entity
            :value 2)
        :op1 (s3 / string-entity)
        :op2 (o3 / option
            :name (n / name)
            :mod s2)
        :op2 (s4 / string-entity)
        :op3 (s5 / string-entity
            :name (n2 / name)))
    :rel (a2 / and
        :op1 s5))

# ::tok The format is not the default, but is listed here.
# ::node	f	format	1-2
# ::node	0	-	3-4
# ::node	h	have-concession-91	6-7
# ::node	l	list-01	8-9
# ::node	h2	here.	9-10
# ::root	h	have-concession-91
# ::edge	have-concession-91	ARG1	list-01	h	l	
# ::edge	list-01	polarity	-	l	0	
# ::edge	list-01	ARG1	format	l	f	
# ::edge	list-01	location	here.	l	h2	
(h / have-concession-91
    :ARG1 (l / list-01
        :ARG1 (f / format)
        :location (h2 / here.)
        :polarity -))

# ::tok Below is a summary of all the options, grouped by type, with explanations in later chapters.
# ::node	h	here	0-1
# ::node	t	thing	2-3
# ::node	s	summarize-01	3-4
# ::node	a2	all	5-6
# ::node	g	group-01	8-9
# ::node	t2	thing	10-11
# ::node	e	explain-01	12-13
# ::node	a	after	14-15
# ::node	c	chapter	15-16
# ::root	t	thing
# ::edge	thing	location	here	t	h	
# ::edge	thing	ARG2-of	summarize-01	t	s	
# ::edge	thing	ARG1-of	group-01	t2	g	
# ::edge	thing	mod	all	t2	a2	
# ::edge	summarize-01	ARG1	thing	s	t2	
# ::edge	thing	ARG1-of	explain-01	t	e	
# ::edge	chapter	time	after	c	a	
# ::edge	explain-01	location	chapter	e	c	
(t / thing
    :ARG1-of (e / explain-01
        :location (c / chapter
            :time (a / after)))
    :ARG2-of (s / summarize-01
        :ARG1 (t2 / thing
            :ARG1-of (g / group-01)
            :mod (a2 / all)))
    :location (h / here))

# ::tok Code generation option
# ::node	c	code	0-1
# ::node	g	generate-01	1-2
# ::node	o	option	2-3
# ::root	o	option
# ::edge	generate-01	ARG1	code	g	c	
# ::edge	option	mod	generate-01	o	g	
(o / option
    :mod (g / generate-01
        :ARG1 (c / code)))

# ::tok Overall option
# ::node	o2	overall	0-1
# ::node	o	option	1-2
# ::root	o	option
# ::edge	option	mod	overall	o	o2	
(o / option
    :mod (o2 / overall))

# ::tok Specify that the language of the file to be entered afterwards is language (rather than the default option from the file name suffix).
# ::node	s	specify-01	0-1
# ::node	y	you	0-1
# ::node	0	imperative	0-1
# ::node	l	language	3-4
# ::node	f	file	6-7
# ::node	e	enter-01	9-10
# ::node	a	afterwards	10-11
# ::node	d	default-01	16-17
# ::node	o	option	17-18
# ::node	i	instead-of-91	17-18
# ::node	n	name	21-22
# ::node	s2	suffix).	22-23
# ::root	s	specify-01
# ::edge	specify-01	ARG0	you	s	y	
# ::edge	specify-01	mode	imperative	s	0	
# ::edge	specify-01	ARG1	language	s	l	
# ::edge	language	poss	file	l	f	
# ::edge	file	ARG1-of	enter-01	f	e	
# ::edge	enter-01	time	afterwards	e	a	
# ::edge	option	ARG1-of	default-01	o	d	
# ::edge	option	ARG2-of	instead-of-91	o	i	
# ::edge	suffix).	mod	name	s2	n	
# ::edge	option	source	suffix).	o	s2	
# ::edge	specify-01	rel	option	s	o	
(s / specify-01
    :ARG0 (y / you)
    :ARG1 (l / language
        :poss (f / file
            :ARG1-of (e / enter-01
                :time (a / afterwards))))
    :mode imperative
    :rel (o / option
        :ARG1-of (d / default-01)
        :ARG2-of (i / instead-of-91)
        :source (s2 / "suffix)."
            :mod (n / name))))

# ::tok This option applies to all subsequent input files until the next `-x' option is encountered.
# ::node	t	this	0-1
# ::node	o	option	1-2
# ::node	a2	apply-02	2-3
# ::node	a	all	4-5
# ::node	s	subsequent	5-6
# ::node	i	input	6-7
# ::node	f	file	7-8
# ::node	u	until	8-9
# ::node	n2	next	10-11
# ::node	n	name	11-12
# ::node	0	`-x'	11-12
# ::node	o2	option	12-13
# ::node	e	encounter-01	14-15
# ::root	a2	apply-02
# ::edge	option	mod	this	o	t	
# ::edge	apply-02	ARG1	option	a2	o	
# ::edge	file	mod	input	f	i	
# ::edge	file	time	subsequent	f	s	
# ::edge	file	mod	all	f	a	
# ::edge	apply-02	ARG2	file	a2	f	
# ::edge	apply-02	time	until	a2	u	
# ::edge	name	op1	`-x'	n	0	
# ::edge	option	name	name	o2	n	
# ::edge	option	mod	next	o2	n2	
# ::edge	encounter-01	ARG1	option	e	o2	
# ::edge	until	op1	encounter-01	u	e	
(a2 / apply-02
    :ARG1 (o / option
        :mod (t / this))
    :ARG2 (f / file
        :mod (i / input)
        :mod (a / all)
        :time (s / subsequent))
    :time (u / until
        :op1 (e / encounter-01
            :ARG1 (o2 / option
                :name (n / name
                    :op1 "`-x'")
                :mod (n2 / next)))))

# ::tok Turn off any language explicit, so the file is processed according to the file name suffix (RE AS E ` -x' option).
# ::node	t	turn-off-07	0-1
# ::node	y	you	0-1
# ::node	1	imperative	0-1
# ::node	a	any	2-3
# ::node	l	language	3-4
# ::node	e	explicit-03	4-5
# ::node	c	cause-01	5-6
# ::node	f	file	7-8
# ::node	p	process-01	9-10
# ::node	c2	conform-01	10-11
# ::node	n	name	14-15
# ::node	s2	suffix	15-16
# ::node	s	string-entity	18-19
# ::node	0	E	18-19
# ::root	t	turn-off-07
# ::edge	turn-off-07	ARG0	you	t	y	
# ::edge	turn-off-07	mode	imperative	t	1	
# ::edge	language	mod	any	l	a	
# ::edge	turn-off-07	ARG1	language	t	l	
# ::edge	language	ARG1-of	explicit-03	l	e	
# ::edge	turn-off-07	ARG0-of	cause-01	t	c	
# ::edge	process-01	ARG1	file	p	f	
# ::edge	cause-01	ARG1	process-01	c	p	
# ::edge	process-01	ARG1-of	conform-01	p	c2	
# ::edge	name	mod	file	n	f	
# ::edge	suffix	mod	name	s2	n	
# ::edge	conform-01	ARG2	suffix	c2	s2	
# ::edge	suffix	prep-as	string-entity	s2	s	
# ::edge	string-entity	value	E	s	0	
(t / turn-off-07
    :ARG0 (y / you)
    :ARG0-of (c / cause-01
        :ARG1 (p / process-01
            :ARG1 (f / file)
            :ARG1-of (c2 / conform-01
                :ARG2 (s2 / suffix
                    :mod (n / name
                        :mod f)
                    :prep-as (s / string-entity
                        :value "E")))))
    :ARG1 (l / language
        :ARG1-of (e / explicit-03)
        :mod (a / any))
    :mode imperative)

# ::tok If only a portion of the four stages (Preprocess, Compile, Compile, Connect) is operated, the ` -x' option (or Ah after the filename) can be used to tell geo where to start, and the `~-c', `-s', or `-E' option to tell geo where to end. Note that some combinations of options (e.g., `-x cpp-output -E') {i gee MEF =c compile or compile source files, ETER. In the absence of ERA ATI, GCC is used by `.o' to replace the source file name with the post-level `.ec filename. Other options can be used to choose the name.
