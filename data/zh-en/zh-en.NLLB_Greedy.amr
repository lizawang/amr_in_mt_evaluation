(c / call-01
    :ARG1 (c2 / character
        :ARG1-of (e / encode-01))
    :rel (n / name
        :op1 "Unified"
        :op2 "Ideographs,"
        :op3 "Ideographs,")
    :rel (s / stand-08
        :ARG1 (s2 / string-entity)
        :ARG4 (a / and
            :op1 s2
            :op2 (c3 / country
                :name (n3 / name
                    :op1 "Japan,"))
            :op3 (c4 / country
                :name (n2 / name
                    :op1 "Korea.")))))

