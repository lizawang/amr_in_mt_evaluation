        :name (n / name
            :op1 "State"
            :op2 "Council"))
    :ARG1 (d3 / designate-01
        :purpose (i / increase-01
            :ARG1 (a2 / and
                :op1 (e / educate-01
                    :mod (p2 / public))
                :op2 (r / realize-01
                    :ARG0 p2
                    :op2 (m / mitigate-01
                        :ARG1 (d4 / disaster)))))
        :ARG1 (d2 / date-entity
            :day 12
            :month 5)
        :ARG2 (e2 / event
            :name (n2 / name
                :op1 "National"
                :op2 "Day"
                :op3 "for"
                :op4 "Disaster"
                :op5 "Prevention"
                :op6 (a / "and"
                    :op1 (p / prevent-01
                        :ARG1 d4))
                :op7 "Mitigation,")))
    :time (d / date-entity
        :month 3))

# ::tok Since then, many Chinese governments and primary and secondary schools have held earthquake drills on this day every year.
