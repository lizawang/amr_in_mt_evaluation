# ::node	1	2	0-1
# ::node	b2	byte	1-2
# ::node	h	high-02	2-3
# ::node	b	bit	3-4
# ::node	n	name	4-5
# ::node	2	GBCT	4-5
# ::node	0	13000	5-6
# ::node	c	code	6-7
# ::node	l	location	7-8
# ::root	l	location
# ::edge	ordinal-entity	value	2	o	1	
# ::edge	byte	ord	ordinal-entity	b2	o	
# ::edge	bit	ARG1-of	high-02	b	h	
# ::edge	byte	mod	bit	b2	b	
# ::edge	name	op1	GBCT	n	2	
# ::edge	name	op2	13000	n	0	
# ::edge	location	mod	code	l	c	
# ::edge	location	name	name	l	n	
# ::edge	location	mod	byte	l	b2	
(l / location
    :name (n / name
        :op1 "GBCT"
        :op2 13000)
    :mod (c / code)
    :mod (b2 / byte
        :mod (b / bit
            :ARG1-of (h / high-02))
        :ord (o / ordinal-entity
            :value 2)))

