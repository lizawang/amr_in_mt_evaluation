    :ARG0 (j / jurisdiction
        :quant (m / most)
        :ARG0-of (l / legalize-01
            :ARG1 (u / use-01
                :ARG1 (c / cannabis)
                :polarity -)))
    :ARG1 (i / increase-01
        :ARG1 (u2 / use-01
            :ARG1 c)))

