(h / hold-04
    :ARG0 (a / and
        :quant (m / many)
        :op1 (g2 / government-organization
            :ARG0-of (g / govern-01
                :ARG1 (c / country
                    :name (n / name
                        :op1 "China"))))
        :op2 (a2 / and
            :op1 (s / school
                :mod (p / primary))
            :op2 (s2 / school
                :mod (s3 / secondary))))
    :ARG1 (d2 / drill-02
        :ARG2 (e / earthquake))
