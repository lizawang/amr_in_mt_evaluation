    :op1 (p2 / publish-01
        :ARG1 (b / book
            :mod (e / edition
                :ord (o / ordinal-entity
                    :value 1)))
        :time (d / date-entity
            :mod e))
    :op2 (m / move-01
        :ARG1 b
        :ARG2 (p / place.
            :mod (t / this))
        :time (a / after
            :op1 p2)))

