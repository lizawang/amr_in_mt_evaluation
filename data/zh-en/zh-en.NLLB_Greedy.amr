# ::edge	represent-01	ARG1	number	r2	n3	
(c / contrast-01
    :ARG1 (r / represent-01
        :ARG1 (n2 / number
            :ARG0-of (h / have-03
                :ARG1 (s / string-entity
                    :value 0x))
            :mod (a / all))
        :ARG2 (s2 / system,
            :mod (d / decimal))
        :medium (l / language
            :name (n / name
                :op1 "English")))
    :ARG2 (r2 / represent-01
        :ARG1 (n3 / number
            :ARG0-of (h2 / have-03
                :ARG1 0x
                :polarity -))))

