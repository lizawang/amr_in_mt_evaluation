# ::edge	country-region	name	name	c6	n2	
# ::edge	name	op1	China	n2	1	
# ::edge	character	mod	uniform	c	u	
# ::edge	code	beneficiary	character	c2	c	
# ::edge	character	ARG1-of	use-01	c	u2	
# ::edge	country	name	name	c3	n3	
# ::edge	name	op1	China,	n3	2	
# ::edge	and	op1	country	a	c3	
# ::edge	use-01	location	and	u2	a	
# ::edge	name	op1	People's	n4	4	
# ::edge	country	name	name	c4	n4	
# ::edge	and	op2	country	a	c4	
# ::edge	name	op2	Republic	n4	5	
