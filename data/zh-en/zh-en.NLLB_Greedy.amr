# ::edge	and	op3	country	a	c5	
# ::edge	country	name	name	c5	n5	
# ::edge	name	op1	Vietnam.	n5	7	
(c2 / code
    :beneficiary (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c3 / country
                    :name (n3 / name
                        :op1 "China,"))
                :op2 (c4 / country
                    :name (n4 / name
                        :op1 "People's"
                        :op2 "Republic"
                        :op3 "of"
                        :op4 "China,"))
                :op3 (c5 / country
                    :name (n5 / name
                        :op1 "Vietnam."))))
        :mod (u / uniform))
    :mod u
    :mod (c6 / country-region
        :name (n / name
            :op1 "Tibet"
            :op2 13000)
        :name (n2 / name
            :op1 "China")))

# ::tok Characters with unique abstract characters are assigned a separate code position; characters with the same abstract characters from different sources are assigned a common code position.
