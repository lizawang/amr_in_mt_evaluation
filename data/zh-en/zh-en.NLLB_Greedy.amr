# ::node	a2	and	17-18
# ::node	f	function-01	18-19
# ::node	d2	describe-01	19-20
# ::node	d3	describe-01	19-20
# ::root	a	and
# ::edge	appendix	mod	this	a3	t	
# ::edge	contain-01	ARG0	appendix	c2	a3	
# ::edge	variable	mod	semantics	v	s	
# ::edge	variable	quant	13	v	0	
# ::edge	contain-01	ARG1	variable	c2	v	
# ::edge	variable	ARG0-of	describe-01	v	d	
# ::edge	variable	ARG1-of	specify-01	v	s2	
# ::edge	specify-01	ARG0	publication	s2	p	
# ::edge	publication	name	name	p	n	
# ::edge	name	op1	GB/TI	n	2	
# ::edge	name	op2	13000	n	1	
# ::edge	and	op1	contain-01	a	c2	
# ::edge	and	op2	give-01	a	g	
# ::edge	give-01	ARG0	appendix	g	a3	
# ::edge	give-01	ARG1	graphic	g	g2	
# ::edge	graphic	poss	variable	g2	v	
# ::edge	location	mod	code	l	c	
# ::edge	and	op1	location	a2	l	
# ::edge	describe-01	ARG1	and	d2	a2	
# ::edge	graphic	ARG0-of	describe-01	g2	d2	
# ::edge	describe-01	ARG1	function-01	d3	f	
# ::edge	and	op2	describe-01	a2	d3	
(a / and
    :op1 (c2 / contain-01
        :ARG0 (a3 / appendix
            :mod (t / this))
        :ARG1 (v / variable
            :quant 13
            :ARG0-of (d / describe-01)
            :ARG1-of (s2 / specify-01
                :ARG0 (p / publication
                    :name (n / name
                        :op1 "GB/TI"
                        :op2 13000)))
            :mod (s / semantics)))
    :op2 (g / give-01
        :ARG0 a3
        :ARG1 (g2 / graphic
            :ARG0-of (d2 / describe-01
                :ARG1 (a2 / and
                    :op1 (l / location
                        :mod (c / code))
                    :op2 (d3 / describe-01
                        :ARG1 (f / function-01))))
            :poss v)))

