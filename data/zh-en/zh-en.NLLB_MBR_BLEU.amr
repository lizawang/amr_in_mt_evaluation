# ::edge	have-03	ARG1	string-entity	h	s2	
# ::edge	string-entity	value	0x	s2	2	
(a2 / and
    :op1 (r / represent-01
        :ARG1 (d / digit
            :ARG1-of (p / precede-01
                :ARG2 (s / string-entity
                    :value 0x))
            :mod (a / all))
        :location (s3 / system,
            :mod (h2 / hexadecimal)))
    :op2 (h / have-03
        :ARG0 (d2 / digit
            :mod a)
        :ARG1 (s2 / string-entity
            :value 0x)
        :location s3
        :polarity -))

