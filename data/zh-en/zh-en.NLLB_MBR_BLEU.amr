(h / hold-01
    :ARG0 (y / you)
    :ARG1 (k / key
        :mod (m / multifunction))
    :duration (a / about
        :op1 (t / temporal-quantity
            :quant 5
            :unit (s / second)))
    :duration (l / light
        :ARG1-of (r / red-02)
        :duration (t2 / temporal-quantity
            :quant 2
            :unit (s2 / second)))
    :mode imperative)

# ::tok It's about 5 seconds.
