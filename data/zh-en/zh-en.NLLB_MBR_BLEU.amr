# ::edge	set-02	ARG1-of	quick-02	s	q	
# ::edge	and	op2	set-02	a	s	
# ::edge	and	op1	device	a	d	
# ::edge	require-01	ARG1	and	r	a	
(t2 / turn-on-13
    :ARG0 (y / you)
    :ARG1 (t / thing
        :ARG0-of (a2 / assist-01
            :mod (v / voice))
        :ARG0-of (r / require-01
            :ARG1 (d / device
                :ARG0-of (s2 / support-01
                    :ARG1 v))
            :ARG1 (a / and
                :op1 d
                :op2 (s / set-02
                    :ARG1 (w / wake-up-02)
                    :ARG1-of (q / quick-02)))))
    :mode imperative)

# ::tok Pick up a second call and switch calls
# ::node	p	pick-up-04	0-1
# ::node	y	you	0-1
# ::node	1	imperative	0-1
# ::node	2	imperative	0-1
# ::node	o	ordinal-entity	3-4
# ::node	0	2	3-4
# ::node	c	call-02	4-5
# ::node	a	and	5-6
# ::node	s	switch-01	6-7
# ::node	c2	call-02	7-8
# ::root	a	and
# ::edge	pick-up-04	ARG0	you	p	y	
# ::edge	pick-up-04	mode	imperative	p	1	
# ::edge	ordinal-entity	value	2	o	0	
# ::edge	call-02	ord	ordinal-entity	c	o	
# ::edge	pick-up-04	ARG1	call-02	p	c	
# ::edge	and	op1	pick-up-04	a	p	
# ::edge	and	op2	switch-01	a	s	
# ::edge	switch-01	mode	imperative	s	2	
# ::edge	switch-01	ARG0	you	s	y	
# ::edge	switch-01	ARG1	call-02	s	c2	
(a / and
    :op1 (p / pick-up-04
        :ARG0 (y / you)
        :ARG1 (c / call-02
            :ord (o / ordinal-entity
                :value 2))
        :mode imperative)
    :op2 (s / switch-01
        :ARG0 y
        :ARG1 (c2 / call-02)
        :mode imperative))

# ::tok When a new call is made, a button can be pressed to hold the previous call and pick up the second call. A button can be pressed twice to switch between two calls.
# ::node	n	new-01	2-3
# ::node	c	call-02	3-4
# ::node	b2	button	7-8
# ::node	p2	possible-01	8-9
# ::node	p4	press-01	10-11
# ::node	h	hold-01	12-13
# ::node	p6	previous	14-15
# ::node	c2	call-02	15-16
# ::node	a	and	16-17
# ::node	p	pick-up-04	17-18
# ::node	o	ordinal-entity	20-21
# ::node	0	2	20-21
# ::node	c3	call-02	21-22
# ::node	b3	button	23-24
# ::node	p3	possible-01	24-25
# ::node	p5	press-01	26-27
# ::node	1	2	27-28
# ::node	s	switch-01	29-30
