# ::edge	feel-01	ARG0	you	f	y	
# ::edge	possible-01	condition	feel-01	p	f	
# ::edge	cause-01	ARG1	possible-01	c	p	
# ::edge	possible-01	ARG1	remove-01	p	r	
# ::edge	remove-01	ARG0	you	r	y	
# ::edge	remove-01	ARG1	earsail,	r	e	
# ::edge	remove-01	ARG2	headphone	r	h	
(c / cause-01
    :ARG0 (e2 / equip-01
        :ARG1 (h / headphone)
        :ARG2 (e / earsail,
            :mod (l / loophole
                :ARG2 (s / string-entity))))
    :ARG1 (p / possible-01
        :ARG1 (r / remove-01
            :ARG0 (y / you)
            :ARG1 e
            :ARG2 h)
        :condition (f / feel-01
            :ARG0 y)))

