# ::tok A total of 1058400 bytes from 0x90308130 to 0xE339FE39 correspond to the 16 auxiliary planes of GB/T 13000, ordered by characters in the order of the bytes in the corresponding 16 auxiliary planes of GB/I 13000.
# ::node	t2	total-01	1-2
# ::node	0	1058400	3-4
# ::node	b	byte	4-5
# ::node	r	range-01	5-6
# ::node	t	temporal-quantity	6-7
# ::node	d3	date-interval	6-7
# ::node	d	date-entity	6-7
# ::node	7	30	6-7
# ::node	6	3	6-7
# ::node	5	2008	6-7
# ::node	n	name	6-7
# ::node	d2	date-entity	8-9
# ::node	4	2007	8-9
# ::node	c2	correspond-02	9-10
# ::node	2	16	12-13
# ::node	a	auxiliary	13-14
# ::node	p	plane	14-15
# ::node	p3	product	16-17
# ::node	n2	name	16-17
# ::node	8	GB/T	16-17
# ::node	1	13000,	17-18
# ::node	o	order-02	18-19
# ::node	c	character	20-21
# ::node	o2	order-03	23-24
# ::node	b2	byte	26-27
# ::node	c3	correspond-02	29-30
# ::node	3	16	30-31
# ::node	a2	auxiliary	31-32
# ::node	p2	plane	32-33
# ::root	c2	correspond-02
# ::edge	byte	quant	1058400	b	0	
# ::edge	byte	ARG2-of	total-01	b	t2	
# ::edge	byte	ARG1-of	range-01	b	r	
# ::edge	range-01	ARG3	temporal-quantity	r	t	
# ::edge	temporal-quantity	mod	date-interval	t	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-entity	day	30	d	7	
# ::edge	date-entity	month	3	d	6	
# ::edge	date-entity	year	2008	d	5	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	2007	d2	4	
# ::edge	correspond-02	ARG1	byte	c2	b	
# ::edge	plane	mod	auxiliary	p	a	
# ::edge	plane	quant	16	p	2	
# ::edge	correspond-02	ARG2	plane	c2	p	
# ::edge	plane	part-of	product	p	p3	
# ::edge	product	name	name	p3	n2	
# ::edge	name	op1	GB/T	n2	8	
# ::edge	name	op2	13000,	n2	1	
# ::edge	byte	ARG1-of	order-02	b	o	
# ::edge	order-02	ARG0	character	o	c	
# ::edge	character	ARG1-of	order-03	c	o2	
# ::edge	order-03	ARG2	byte	o2	b2	
# ::edge	correspond-02	ARG2	product	c3	p3	
# ::edge	plane	mod	auxiliary	p2	a2	
# ::edge	plane	quant	16	p2	3	
# ::edge	plane	ARG1-of	correspond-02	p2	c3	
# ::edge	byte	part-of	plane	b2	p2	
# ::edge	correspond-02	rel	name	c2	n	
(c2 / correspond-02
    :ARG1 (b / byte
        :quant 1058400
        :ARG1-of (r / range-01
            :ARG3 (t / temporal-quantity
                :mod (d3 / date-interval
                    :op1 (d / date-entity
                        :day 30
                        :month 3
                        :year 2008)
                    :op2 (d2 / date-entity
                        :year 2007))))
        :ARG1-of (o / order-02
            :ARG0 (c / character
                :ARG1-of (o2 / order-03
                    :ARG2 (b2 / byte
                        :part-of (p2 / plane
                            :quant 16
                            :ARG1-of (c3 / correspond-02
                                :ARG2 (p3 / product
                                    :name (n2 / name
                                        :op1 "GB/T"
                                        :op2 "13000,")))
                            :mod (a2 / auxiliary))))))
        :ARG2-of (t2 / total-01))
    :ARG2 (p / plane
        :quant 16
        :mod (a / auxiliary)
        :part-of p3)
    :rel (n / name))

# ::tok The order of the four-byte part should be in accordance with Appendix C.
# ::node	o	order-03	1-2
# ::node	s	string-entity	4-5
# ::node	0	4	4-5
# ::node	p	part	5-6
# ::node	r	recommend-01	6-7
# ::node	a	accord-02	9-10
# ::node	c	chapter	11-12
# ::node	e	et-cetera	12-13
# ::root	r	recommend-01
# ::edge	string-entity	value	4	s	0	
# ::edge	part	mod	string-entity	p	s	
# ::edge	order-03	ARG1	part	o	p	
# ::edge	recommend-01	ARG1	accord-02	r	a	
# ::edge	accord-02	ARG1	order-03	a	o	
# ::edge	accord-02	ARG2	chapter	a	c	
# ::edge	chapter	mod	et-cetera	c	e	
(r / recommend-01
    :ARG1 (a / accord-02
        :ARG1 (o / order-03
            :ARG1 (p / part
                :mod (s / string-entity
                    :value 4)))
        :ARG2 (c / chapter
            :mod (e / et-cetera))))

# ::tok 7 bytes allocated
# ::node	0	7	0-1
# ::node	d	distance-quantity	1-2
# ::node	b	byte	1-2
# ::node	a	allocate-01	2-3
# ::root	a	allocate-01
# ::edge	distance-quantity	quant	7	d	0	
# ::edge	distance-quantity	unit	byte	d	b	
# ::edge	allocate-01	ARG1	distance-quantity	a	d	
(a / allocate-01
    :ARG1 (d / distance-quantity
        :quant 7
        :unit (b / byte)))

# ::tok 1. Allocation of slots in the single market segment
# ::node	0	1	0-1
# ::node	a	allocate-01	1-2
# ::node	s3	slot	3-4
# ::node	s2	single-02	6-7
# ::node	m	market	7-8
# ::node	s	segment	8-9
# ::root	a	allocate-01
# ::edge	allocate-01	li	1	a	0	
# ::edge	allocate-01	ARG1	slot	a	s3	
# ::edge	market	ARG1-of	single-02	m	s2	
# ::edge	segment	mod	market	s	m	
# ::edge	allocate-01	ARG2	segment	a	s	
(a / allocate-01
    :li 1
    :ARG1 (s3 / slot)
    :ARG2 (s / segment
        :mod (m / market
            :ARG1-of (s2 / single-02))))

# ::tok The one-byte portion of a byte is allocated according to the rules of GB/T 11383 I 1989.
# ::node	o	one-byte	1-2
# ::node	p	portion	2-3
# ::node	b	byte	5-6
# ::node	a	allocate-01	7-8
# ::node	c	conform-01	8-9
# ::node	r	rule-01	11-12
# ::node	p2	publication	13-14
# ::node	n	name	13-14
# ::node	2	GB/T	13-14
# ::node	0	11383	14-15
# ::node	3	I	15-16
# ::node	1	1989.	16-17
# ::root	a	allocate-01
# ::edge	portion	mod	one-byte	p	o	
# ::edge	portion	part-of	byte	p	b	
# ::edge	allocate-01	ARG1	portion	a	p	
# ::edge	allocate-01	ARG1-of	conform-01	a	c	
# ::edge	conform-01	ARG2	rule-01	c	r	
# ::edge	rule-01	ARG0	publication	r	p2	
# ::edge	publication	name	name	p2	n	
# ::edge	name	op1	GB/T	n	2	
# ::edge	name	op2	11383	n	0	
# ::edge	name	op3	I	n	3	
# ::edge	name	op4	1989.	n	1	
(a / allocate-01
    :ARG1 (p / portion
        :mod (o / one-byte)
        :part-of (b / byte))
    :ARG1-of (c / conform-01
        :ARG2 (r / rule-01
            :ARG0 (p2 / publication
                :name (n / name
                    :op1 "GB/T"
                    :op2 11383
                    :op3 "I"
                    :op4 "1989.")))))

# ::tok The byte byte distribution is shown in Figure 2.
# ::node	b	byte	1-2
# ::node	b2	byte	2-3
# ::node	d	distribute-01	3-4
# ::node	s	show-01	5-6
# ::node	f	figure	7-8
# ::node	0	2.	8-9
# ::root	s	show-01
# ::edge	byte	consist-of	byte	b2	b	
# ::edge	distribute-01	ARG1	byte	d	b2	
# ::edge	show-01	ARG1	distribute-01	s	d	
# ::edge	show-01	ARG0	figure	s	f	
# ::edge	figure	mod	2.	f	0	
(s / show-01
    :ARG0 (f / figure
        :mod 2.)
    :ARG1 (d / distribute-01
        :ARG1 (b2 / byte
            :consist-of (b / byte))))

# ::tok 2. Allocation of bytes for the binomial part
# ::node	0	2	0-1
# ::node	a	allocate-01	1-2
# ::node	b2	byte	3-4
# ::node	b	binomial	6-7
# ::node	p	part	7-8
# ::root	a	allocate-01
# ::edge	allocate-01	li	2	a	0	
# ::edge	allocate-01	ARG1	byte	a	b2	
# ::edge	part	mod	binomial	p	b	
# ::edge	allocate-01	ARG2	part	a	p	
(a / allocate-01
    :li 2
    :ARG1 (b2 / byte)
    :ARG2 (p / part
        :mod (b / binomial)))

# ::tok The two-byte segment is divided into two segments: 0x8140 ~ 1 0xFE7E and 0x8180 ~ 1 0xFEFE, for a total of 23940 bits.
# ::node	t2	two-byte	1-2
# ::node	s	segment	2-3
# ::node	d4	divide-02	4-5
# ::node	5	2	6-7
# ::node	0	0x8140	8-9
# ::node	3	1	10-11
# ::node	d2	distance-quantity	11-12
# ::node	d	device	11-12
# ::node	i	include-01	11-12
# ::node	n	name	11-12
# ::node	2	0xFE7E	11-12
# ::node	a	and	12-13
# ::node	1	0x8180	13-14
# ::node	4	1	15-16
# ::node	d3	distance-quantity	16-17
# ::node	t	total-01	19-20
# ::node	6	23940	21-22
# ::node	b	bit	22-23
# ::root	d4	divide-02
# ::edge	segment	quant	two-byte	s	t2	
# ::edge	divide-02	ARG1	segment	d4	s	
# ::edge	distance-quantity	quant	0x8140	d2	0	
# ::edge	distance-quantity	unit	0x8140	d2	0	
# ::edge	device	quant	1	d	3	
# ::edge	device	ARG2-of	include-01	d	i	
# ::edge	device	name	name	d	n	
# ::edge	name	op1	0xFE7E	n	2	
# ::edge	and	op1	device	a	d	
# ::edge	and	quant	2	a	5	
# ::edge	divide-02	ARG2	and	d4	a	
# ::edge	distance-quantity	quant	0x8180	d3	1	
# ::edge	distance-quantity	unit	0x8180	d3	1	
# ::edge	and	op2	distance-quantity	a	d3	
# ::edge	and	ARG1-of	total-01	a	t	
# ::edge	bit	quant	23940	b	6	
# ::edge	total-01	ARG2	bit	t	b	
# ::edge	divide-02	rel	distance-quantity	d4	d2	
# ::edge	divide-02	rel	1	d4	4	
(d4 / divide-02
    :ARG1 (s / segment
        :quant (t2 / two-byte))
    :ARG2 (a / and
        :quant 2
        :ARG1-of (t / total-01
            :ARG2 (b / bit
                :quant 23940))
        :op1 (d / device
            :name (n / name
                :op1 "0xFE7E")
            :quant 1
            :ARG2-of (i / include-01))
        :op2 (d3 / distance-quantity
            :quant 0x8180
            :unit 0x8180))
    :rel (d2 / distance-quantity
        :quant 0x8140
        :unit 0x8140)
    :rel 1)

# ::tok The two-byte allocation is shown in Figure 3 and Table 2.
# ::node	t2	two-byte	1-2
# ::node	a	allocate-01	2-3
# ::node	s	show-01	4-5
