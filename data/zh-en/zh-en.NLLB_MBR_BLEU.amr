# ::edge	list-01	location	here	l	h	
# ::edge	option	ARG1-of	default-02	o	d	
# ::edge	option	polarity	-	o	0	
# ::edge	option	domain	format	o	f	
(o / option
    :ARG1-of (d / default-02)
    :domain (f / format
        :ARG1-of (l / list-01
            :location (h / here)))
    :polarity -)

# ::tok Below is a summary of all the options, grouped by type, with explanations in later chapters.
