# ::edge	device	ARG1-of	pair-01	d	p	
# ::edge	device	mod	last	d	l	
# ::edge	disconnect-01	ARG2	device	d2	d	
# ::edge	disconnect-01	ARG1-of	require-01	d2	r	
# ::edge	disconnect-01	rel	ordinal-entity	d2	o	
(d2 / disconnect-01
    :ARG0 (a / activate-01
        :ARG1 (c / cache))
    :ARG1-of (r / require-01)
    :ARG2 (d / device
        :ARG1-of (p / pair-01)
        :mod (l / last))
    :manner (a3 / automatic)
    :rel (o / ordinal-entity
        :value 1)
    :time (a2 / after))

# ::tok Please note:
