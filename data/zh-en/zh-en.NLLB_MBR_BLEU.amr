# ::edge	apply-02	ARG1	option	a2	o	
# ::edge	file	mod	input	f	i	
# ::edge	file	time	subsequent	f	s	
# ::edge	file	mod	all	f	a	
# ::edge	apply-02	ARG2	file	a2	f	
# ::edge	apply-02	time	until	a2	u	
# ::edge	name	op1	`-x'	n	0	
# ::edge	option	name	name	o2	n	
# ::edge	option	mod	next	o2	n2	
# ::edge	available-02	ARG2	option	a3	o2	
# ::edge	until	op1	available-02	u	a3	
(a2 / apply-02
    :ARG1 (o / option
        :mod (t / this))
    :ARG2 (f / file
        :mod (i / input)
        :mod (a / all)
        :time (s / subsequent))
    :time (u / until
        :op1 (a3 / available-02
            :ARG2 (o2 / option
                :name (n / name
                    :op1 "`-x'")
                :mod (n2 / next)))))

