# ::node	2	2	31-32
# ::node	c4	call-02	32-33
# ::root	p2	possible-01
# ::edge	call-02	ARG1-of	new-01	c	n	
# ::edge	possible-01	time	call-02	p2	c	
# ::edge	possible-01	ARG1	press-01	p2	p4	
# ::edge	press-01	ARG1	button	p4	b2	
# ::edge	call-02	mod	previous	c2	p6	
# ::edge	hold-01	ARG1	call-02	h	c2	
# ::edge	and	op1	hold-01	a	h	
# ::edge	press-01	purpose	and	p4	a	
# ::edge	and	op2	pick-up-04	a	p	
# ::edge	ordinal-entity	value	2	o	0	
# ::edge	call-02	ord	ordinal-entity	c3	o	
# ::edge	pick-up-04	ARG1	call-02	p	c3	
# ::edge	possible-01	ARG1	press-01	p3	p5	
# ::edge	press-01	ARG1	button	p5	b3	
# ::edge	press-01	frequency	2	p5	1	
# ::edge	press-01	purpose	switch-01	p5	s	
# ::edge	switch-01	ARG0	button	s	b3	
# ::edge	switch-01	ARG1	between	s	b	
# ::edge	call-02	quant	2	c4	2	
# ::edge	between	op1	call-02	b	c4	
# ::edge	possible-01	rel	possible-01	p2	p3	
(p2 / possible-01
    :ARG1 (p4 / press-01
        :purpose (a / and
            :op1 (h / hold-01
                :ARG1 (c2 / call-02
                    :mod (p6 / previous)))
            :op2 (p / pick-up-04
                :ARG1 (c3 / call-02
                    :ord (o / ordinal-entity
                        :value 2))))
        :ARG1 (b2 / button))
    :rel (p3 / possible-01
        :ARG1 (p5 / press-01
            :purpose (s / switch-01
                :ARG0 (b3 / button)
                :ARG1 (b / between
                    :op1 (c4 / call-02
                        :quant 2)))
            :ARG1 b3
            :frequency 2))
    :time (c / call-02
        :ARG1-of (n / new-01)))

