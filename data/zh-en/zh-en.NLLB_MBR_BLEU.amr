# ::edge	move-01	ARG2	out-06	m	o	
# ::edge	clock.	ARG0-of	charge-03	c2	c	
# ::edge	out-06	ARG2	clock.	o	c2	
(c3 / connect-01
    :ARG2 (m / move-01
        :ARG0 (p / pair)
        :ARG1 (m2 / music
            :quant 2
            :mod (e / Jew))
        :ARG2 (o / out-06
            :ARG2 (c2 / clock.
                :ARG0-of (c / charge-03))))
    :manner (a / automatic))

# ::tok The two jugs go off automatically, and the white light comes on.
# ::node	0	2	1-2
# ::node	t	tank	2-3
# ::node	g	go-off-16	3-4
# ::node	a	and	6-7
# ::node	w	white-03	8-9
# ::node	l	light	9-10
# ::node	o	on-01	11-12
