(o / obligate-01
    :ARG2 (g / give-01
        :ARG1 (o2 / option
            :ARG1-of (d / differ-02
                :ARG1-of (c / complete-02)
                :ARG2 (s / string-entity
                    :value "and")))))

# ::tok Most `-=E: and `-W' options have two opposite formats: -fname and -fno-name (or -Wname and -Wno-name).
# ::node	m	most	0-1
# ::node	s	string-entity	1-2
# ::node	0	2	1-2
# ::node	s2	string-entity	3-4
