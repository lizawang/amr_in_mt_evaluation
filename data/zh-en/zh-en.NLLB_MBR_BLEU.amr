    :ARG2 (o2 / operate-01
        :ARG0 (l2 / light
            :ARG1-of (w2 / white-03)
            :ARG1-of (l / left-20)
            :mod (e / earphone)))
    :mode imperative
    :rel (b / button
        :name (n / name
            :op1 "RedmIArDots2")
        :instrument-of (s / search-01
            :instrument (t / tooth
                :polarity -))))

# ::tok After the first connection, the cache activation will automatically reconnect to the last paired device (Bluetooth is required).
# ::node	a2	after	0-1
# ::node	o	ordinal-entity	2-3
# ::node	0	1	2-3
# ::node	c	cache	5-6
# ::node	a	activate-01	6-7
