# ::edge	store-01	time	before	s	b	
# ::edge	before	op1	use-01	b	u	
# ::edge	use-01	ARG1	product	u	p	
# ::edge	use-01	ARG0	you	u	y	
(a / and
    :op1 (r / read-01
        :ARG0 (y / you)
        :ARG1 (i / instruction)
        :ARG1-of (c / care-04)
        :mode imperative
        :polite +)
    :op2 (s / store-01
        :ARG0 y
        :ARG1 (p / product)
        :manner (p2 / proper)
        :mode imperative
        :polite +
        :time (b / before
            :op1 (u / use-01
                :ARG0 y
                :ARG1 p))))

# ::tok The headphone itself is equipped with a Z-shaped earsail, so if you feel uncomfortable, you can remove it from the headphones.
# ::node	h	headphone	1-2
# ::node	e2	equip-01	4-5
# ::node	s	string-entity	6-7
# ::node	l	loophole	7-8
