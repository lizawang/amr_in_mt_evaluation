(r / repeat-01
    :ARG0 (y / you)
    :ARG1 (s / step-01
        :location (a / above))
    :condition (c3 / connect-01)
    :mode imperative
    :rel (p / put-01
        :ARG0 y
        :ARG1 (h / headphones)
        :ARG2 (c / case.
            :ARG0-of (c2 / charge-03))
        :mod (b / back)
        :mode imperative))

