(k / know-02
    :ARG1 (c / character
        :ARG1-of (c2 / codify-01)
        :location-of (s / stand-08
            :ARG0 c
            :ARG1 (a / and
                :op1 (c3 / country
                    :name (n2 / name
                        :op1 "China,"))
                :op2 (c4 / country
                    :name (n3 / name
                        :op1 "Japan,"
                        :op2 "Korea.")))))
    :rel (n / name
        :op1 "CJK"
        :op2 "Unified"
        :op3 "Ideographs"))

