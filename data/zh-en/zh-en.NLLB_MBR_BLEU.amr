    :op1 (d2 / die-01
        :ARG1 (p / person
            :quant (s / some
                :op1 22000)))
    :op2 (o / or
        :op1 (d / destroy-01
            :ARG1 (b / building
                :quant (a / about
                    :op1 400000))
            :ARG1-of (c2 / complete-02))
        :op2 (c / collapse-01
            :ARG1 b)))

