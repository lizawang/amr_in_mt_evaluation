(p / pass-05
    :ARG1 (f / file
        :ARG1-of (i / identify-01
            :polarity -)
        :ARG2-of (i2 / include-91
            :ARG1 (f2 / file
                :name (n / name
                    :op2 "H"))
            :ARG1 (a2 / and.a
                :op1 f2
                :op2 (f3 / file
                    :name n
                    :ARG1-of (c4 / correspond-02
                        :ARG2 (p2 / "program)"
                            :mod (s / source)))
                    :mod (l2 / library))))
        :mod (a / all.e))
    :ARG1-of (o2 / order-03
        :ARG2 (l3 / line.
            :mod (c / command)))
    :ARG2 (o / option
        :mod (c3 / connect-01))
    :rel (n2 / name
        :op1 "specified.o")
    :rel (l / library)
    :time (s2 / stage,
        :mod (c2 / connect-01)))

# ::tok The option must be given separately: de'is completely different from `-d-r '.
