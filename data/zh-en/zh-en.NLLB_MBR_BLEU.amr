# ::edge	hold-01	manner	in-place	h4	i	
# ::edge	hold-01	prep-with	head	h4	h	
# ::edge	hold-01	manner	light-06	h4	l2	
(a / and
    :op1 (i2 / insert-01
        :ARG0 (y / you)
        :ARG1 (h3 / headset)
        :ARG2 (c / canal
            :mod (e / ear))
        :manner (l / light)
        :manner (s / slant-01
            :ARG1 (e2 / earlobe)
            :direction (d / downward,)))
    :op2 (h4 / hold-01
        :ARG0 y
        :ARG1 (m / music
            :name (n / name))
        :ARG2 (h2 / headphones)
        :manner (i / in-place
            :domain h4)
        :manner (l2 / light-06)
        :prep-with (h / head)))

# ::tok When you make a call, you can make the call better by putting the headphone microphone towards your mouth.
