(w / wait-01
    :ARG1 (y / you)
    :ARG1 (a / and
        :op1 (o / open-01
            :ARG0 y
            :ARG1 (d / device)
            :mode imperative)
        :op2 (c / click-01
            :ARG0 y
            :ARG1 (c2 / connect-01)
