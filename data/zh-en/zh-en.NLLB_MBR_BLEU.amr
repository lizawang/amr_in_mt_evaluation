                :ARG0-of (c / charge-03)))
        :op1 (e2 / enter-01
            :ARG0 h2)
        :op2 (p / possible-01
            :ARG1 (r2 / return-01
                :ARG1 h2
                :ARG4 m
                :manner (a3 / automatic)))))

