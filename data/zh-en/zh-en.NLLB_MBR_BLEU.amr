    :op1 (t3 / turn-02
        :ARG1 (l / light
            :ARG0-of (i / indicate-01
                :ARG1 (h / headphone))))
    :op2 (t2 / turn-01
        :ARG1 l)
    :op3 (t4 / turn-off-07
        :ARG1 (h2 / headset)
        :time (a / after
            :quant (t / temporal-quantity
                :quant 1
                :unit (m / minute.))))
    :time h2)

