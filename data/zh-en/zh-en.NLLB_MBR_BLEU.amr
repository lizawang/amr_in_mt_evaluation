# ::edge	interlink-01	ARG1	pocket	i	p	
# ::edge	and	manner	interlink-01	a	i	
# ::edge	interlink-01	mod	row.	i	r4	
(r2 / return-01
    :ARG1 (a / and
        :manner (i / interlink-01
            :ARG1 (p / pocket
                :ARG1-of (r3 / right-08))
            :ARG2 (p2 / pocket
                :ARG1-of (l / left-19))
            :mod (r4 / row.))
        :op1 (l2 / light
            :ARG1-of (r / red-02))
        :op2 (l3 / light
            :ARG1-of (w / white-03)))
    :time (t / then))

# ::tok Wait for the left/right earphone white light to blink. Open the device toothless search button "RedmIArDots2" and click "Final connection".
# ::node	w	wait-01	0-1
# ::node	y	you	0-1
# ::node	2	imperative	0-1
# ::node	l	left-20	3-4
# ::node	e	earphone	4-5
