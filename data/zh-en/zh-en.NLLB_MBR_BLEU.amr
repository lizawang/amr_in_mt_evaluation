(r / recover-01
    :ARG1 (c2 / country
        :ARG1-of (c / corrupt-01)
        :ARG1-of (p2 / populate-01)
        :mod (p / poor))
    :ARG2 (d / disaster.)
    :concession (a2 / and
        :mod (m / massive)
        :op1 (a / aid-01
            :ARG1 c2)
        :op2 (s / support-01
            :ARG0 c2))
    :polarity -
    :rel (i / international)
    :time (e / ever))

