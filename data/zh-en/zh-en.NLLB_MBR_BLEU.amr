# ::node	5	WA	4-5
# ::node	a	and	5-6
# ::node	p	product	6-7
# ::node	n2	name	6-7
# ::node	2	RS	6-7
# ::node	4	Twinings	7-8
# ::node	0	3	8-9
# ::root	a	and
# ::edge	distance-quantity	quant	6080	d	1	
# ::edge	distance-quantity	unit	yard	d	y	
# ::edge	ship	name	name	s	n	
# ::edge	name	op1	SS	n	3	
# ::edge	name	op2	WA	n	5	
# ::edge	and	op1	ship	a	s	
# ::edge	and	quant	distance-quantity	a	d	
# ::edge	and	op2	product	a	p	
# ::edge	product	name	name	p	n2	
# ::edge	name	op1	RS	n2	2	
# ::edge	name	op2	Twinings	n2	4	
# ::edge	and	op3	3	a	0	
(a / and
    :quant (d / distance-quantity
        :quant 6080
        :unit (y / yard))
    :op1 (s / ship
        :name (n / name
            :op1 "SS"
            :op2 "WA"))
    :op2 (p / product
        :name (n2 / name
            :op1 "RS"
            :op2 "Twinings"))
    :op3 3)

# ::tok The first byte 0xA8 to 0xA9 Two byte zone 5: 192 bytes
# ::node	o	ordinal-entity	1-2
# ::node	1	1	1-2
# ::node	b3	byte	2-3
# ::node	4	8	3-4
# ::node	b2	between	4-5
# ::node	n	name	5-6
# ::node	0	0xA9	5-6
# ::node	3	2	6-7
# ::node	b4	byte	7-8
# ::node	z	zone	8-9
# ::node	2	192	10-11
# ::node	d	distance-quantity	11-12
# ::node	v	value-interval	11-12
# ::node	d2	distance-quantity	11-12
# ::node	b	barrel	11-12
# ::root	z	zone
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	byte	ord	ordinal-entity	b3	o	
# ::edge	between	op1	byte	b2	b3	
# ::edge	name	op1	0xA9	n	0	
# ::edge	zone	mod	between	z	b2	
# ::edge	zone	quant	between	z	b2	
# ::edge	zone	domain	byte	z	b3	
# ::edge	distance-quantity	unit	byte	d	b4	
# ::edge	distance-quantity	quant	8	d	4	
# ::edge	byte	consist-of	distance-quantity	b3	d	
# ::edge	zone	mod	value-interval	z	v	
# ::edge	value-interval	op1	8	v	4	
# ::edge	value-interval	op2	distance-quantity	v	d2	
# ::edge	distance-quantity	quant	192	d2	2	
# ::edge	distance-quantity	unit	barrel	d2	b	
# ::edge	zone	rel	name	z	n	
# ::edge	zone	rel	2	z	3	
(z / zone
    :quant (b2 / between
        :op1 (b3 / byte
            :consist-of (d / distance-quantity
                :quant 8
                :unit (b4 / byte))
            :ord (o / ordinal-entity
                :value 1)))
    :domain b3
    :mod b2
    :mod (v / value-interval
        :op1 8
        :op2 (d2 / distance-quantity
            :quant 192
            :unit (b / barrel)))
    :rel (n / name
        :op1 "0xA9")
    :rel 2)

