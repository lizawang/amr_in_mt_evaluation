# ::edge	and	op2	position-01	a	p	
# ::edge	and	op3	function-01	a	f	
# ::edge	character	mod	semantics	c2	s	
# ::edge	describe-01	ARG1	character	d	c2	
# ::edge	thing	ARG0-of	describe-01	t	d	
# ::edge	function-01	ARG0	thing	f	t	
# ::edge	position-01	ARG1	thing	p	t	
# ::edge	obligate-01	ARG2	comply-01	o	c4	
# ::edge	comply-01	ARG0	and	c4	a	
# ::edge	comply-01	ARG1	thing	c4	t2	
# ::edge	thing	ARG1-of	provide-01	t2	p2	
# ::edge	provide-01	ARG0	chapter	p2	c	
# ::edge	chapter	name	name	c	n	
# ::edge	name	op1	Appendix	n	0	
# ::edge	name	op2	B.	n	1	
(o / obligate-01
    :ARG2 (c4 / comply-01
        :ARG0 (a / and
            :op2 (p / position-01
                :ARG1 (c3 / code)
                :ARG1 (t / thing
                    :ARG0-of (d / describe-01
                        :ARG1 (c2 / character
                            :mod (s / semantics)))))
            :op3 (f / function-01
                :ARG0 t))
        :ARG1 (t2 / thing
            :ARG1-of (p2 / provide-01
                :ARG0 (c / chapter
                    :name (n / name
                        :op1 "Appendix"
                        :op2 "B."))))))

