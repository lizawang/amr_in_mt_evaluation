(m2 / multi-sentence
    :rel (t / thing
        :ARG0-of (s4 / switch-01)
        :ARG1-of (s / single-02
            :ARG1-of (s2 / single-02
                :ARG1 (m / mode.))))
    :rel (r / retrieve-01
        :ARG1 (h2 / headset
            :mod (o / other)))
    :snt1 (c2 / connect-01
        :ARG1 (d / drone
            :mod (b2 / both))
