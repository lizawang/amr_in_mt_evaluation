(n5 / note-01
    :ARG0 (s / string-entity
        :ARG1 (c2 / code
            :beneficiary (a / and
                :example (a2 / and
                    :op1 (c5 / country
                        :name (n2 / name
                            :op1 "China,"))
                    :op2 (c6 / country
                        :name (n3 / name
                            :op1 "People's"
                            :op2 "Republic"
                            :op3 "of"
                            :op4 "China,"))
                    :op3 (c7 / country
                        :name (n4 / name
                            :op1 "Vietnam.")))
                :op1 (c4 / country)
                :op2 (r / region))
            :mod (c / character
                :mod (c3 / country
                    :name (n / name
                        :op1 "China")))
            :mod (u / uniform))
        :value 13000))

# ::tok The characters with unique abstract characters are assigned a unique code position; characters with the same abstract characters from different sources are assigned a shared code position.
