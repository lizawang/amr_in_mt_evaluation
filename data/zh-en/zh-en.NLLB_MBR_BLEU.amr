# ::edge	put-01	ARG2	mouth.	p2	m4	
# ::edge	you	part	mouth.	y	m4	
(p / possible-01
    :ARG1 (m / make-02
        :ARG0 (y / you
            :part (m4 / mouth.))
        :ARG1 (c / call-02
            :ARG0 y)
        :ARG1 (h / have-degree-91
            :ARG1 c
            :ARG2 (g / good-02
                :ARG1 c)
            :ARG3 (m3 / more))
        :manner (p2 / put-01
            :ARG0 y
            :ARG1 (m2 / microphone
                :mod (h2 / headphone))
            :ARG2 m4)))

# ::tok When converting a call, be sure to adjust the headset to expose the microphone.
