# ::edge	show-01	ARG0	and	s	a2	
# ::edge	and	op2	table	a2	t	
# ::edge	table	mod	2.	t	0	
(s / show-01
    :ARG0 (a2 / and
        :op1 (f / figure
            :mod 3)
        :op2 (t / table
            :mod 2.))
    :ARG1 (a / allocate-01
        :ARG1 (t2 / two-byte)))

