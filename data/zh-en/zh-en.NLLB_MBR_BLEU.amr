# ::edge	assign-01	rel	same-01	a3	s	
# ::edge	assign-01	rel	assign-01	a3	a2	
(a3 / assign-01
    :ARG1 (p / position.
        :ARG1-of (s2 / share-01)
        :mod (c5 / code))
    :ARG2 (c3 / character
        :source (s3 / source
            :ARG1-of (d / differ-02)))
    :rel (s / same-01
        :ARG1 (c2 / character
            :ARG1-of (u / unique-01)
            :mod (a / abstract)))
    :rel (a2 / assign-01
        :ARG1 (p2 / position;
            :ARG1-of (u2 / unique-01)
            :mod (c4 / code))
        :ARG2 (c / character
            :ARG0-of (h / have-03
                :ARG1 c2))))

