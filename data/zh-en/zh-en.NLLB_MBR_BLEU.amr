    :ARG0 (h / have-condition-91
        :ARG2 (o / open-01
            :ARG1 (a / account
                :mod (s / string-entity
                    :value "E"))
            :time (d / date-entity
                :ARG1 (m2 / move-01
                    :ARG1 (a2 / and
                        :location (p / page
