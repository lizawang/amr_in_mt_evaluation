# ::edge	input	mod	file	i	f	
# ::edge	language	poss	input	l	i	
# ::edge	choose-01	ARG1-of	default-02	c	d	
# ::edge	language	ARG1-of	choose-01	l	c	
# ::edge	name	mod	file	n	f	
# ::edge	suffix).	mod	name	s	n	
# ::edge	choose-01	ARG2	suffix).	c	s	
(c2 / clarify-10
    :ARG0 (y / you)
    :ARG1 (l / language
        :ARG1-of (c / choose-01
            :ARG1-of (d / default-02)
            :ARG2 (s / "suffix)."
                :mod (n / name
                    :mod (f / file))))
        :poss (i / input
            :mod f))
    :mode imperative)

# ::tok This option applies to all subsequent input files until the next `-x' option is available in.language
# ::node	t	this	0-1
# ::node	o	option	1-2
# ::node	a2	apply-02	2-3
# ::node	a	all	4-5
# ::node	s	subsequent	5-6
