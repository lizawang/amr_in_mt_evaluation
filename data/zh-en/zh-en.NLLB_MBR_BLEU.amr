                        :op3 (w / worth-01
                            :mod (n / net)))
                    :ARG2 (d2 / date-entity
                        :ARG1-of (m / mean-01)
                        :day 7.
                        :month 2
                        :time-of (t2 / trade-01))
                    :direction (f / forward))
