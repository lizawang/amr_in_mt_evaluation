# ::edge	light	ARG1-of	white-03	l	w	
# ::edge	on-01	ARG1	light	o	l	
# ::edge	and	op2	on-01	a	o	
(a / and
    :op1 (g / go-off-16
        :ARG1 (t / tank
            :quant 2))
    :op2 (o / on-01
        :ARG1 (l / light
            :ARG1-of (w / white-03))))

# ::tok Then the red and white light returns to the six, with the right and left pockets interlocking in a row.
# ::node	t	then	0-1
# ::node	r	red-02	2-3
# ::node	a	and	3-4
# ::node	w	white-03	4-5
# ::node	l2	light	5-6
# ::node	l3	light	5-6
# ::node	r2	return-01	6-7
# ::node	r3	right-08	12-13
# ::node	l	left-19	14-15
# ::node	p	pocket	15-16
# ::node	p2	pocket	15-16
# ::node	i	interlink-01	16-17
# ::node	r4	row.	19-20
# ::root	r2	return-01
# ::edge	and	op1	light	a	l2	
# ::edge	light	ARG1-of	red-02	l2	r	
# ::edge	light	ARG1-of	white-03	l3	w	
# ::edge	and	op2	light	a	l3	
# ::edge	return-01	ARG1	and	r2	a	
# ::edge	return-01	time	then	r2	t	
# ::edge	pocket	ARG1-of	right-08	p	r3	
# ::edge	pocket	ARG1-of	left-19	p2	l	
