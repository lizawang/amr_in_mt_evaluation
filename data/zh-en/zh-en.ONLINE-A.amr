# ::edge	adjust-01	ARG0	number	a	n	
# ::edge	product-of	op1	18	p2	1	
# ::edge	product-of	op2	number	p2	n2	
# ::edge	number	value	13000	n2	0	
# ::edge	code	mod	product-of	c	p2	
# ::edge	position-01	ARG1	code	p	c	
# ::edge	adjust-01	ARG1	position-01	a	p	
(a / adjust-01
    :ARG0 (n / number
        :value "D.1")
    :ARG1 (p / position-01
        :ARG1 (c / code
            :mod (p2 / product-of
                :op1 18
                :op2 (n2 / number
                    :value 13000)))))

# ::tok B 18030 - 2005 specifies 10 vertical punctuation points and 8 Chinese character widgets Temporary code locations in GB/I 13000, which are adjusted in this document, as shown in Table D.1.
# ::node	d3	date-interval	1-2
