# ::edge	area	domain	point	a	p2	
(a / area
    :ARG1-of (d4 / define-01)
    :domain (p2 / point
        :quant 25000
        :ARG1-of (r / range-01
            :ARG3 (p / percentage-entity
                :mod (d3 / date-interval
                    :op1 (d / date-entity
                        :day 30
                        :month 3
                        :year 2008)
                    :op1 (l2 / location
                        :quant d3)
                    :op2 (d2 / date-entity
                        :day 0
                        :month 3)))
            :op2 (l / level
                :name (n / name
                    :op1 "0xFE39FE39")
                :mod 0))
        :mod (c / code)
        :mod (t / total)
        :mod (s / service)))

