# ::node	o	omit-01	35-36
# ::root	a3	and
# ::edge	table	mod	this	t	t2	
# ::edge	give-01	ARG0	table	g	t	
# ::edge	and	op1	glyphs	a2	g3	
# ::edge	give-01	ARG1	and	g	a2	
# ::edge	and	op2	code	a2	c4	
# ::edge	country	name	name	c8	n	
# ::edge	name	op1	China	n	1	
# ::edge	character	mod	country	c	c8	
# ::edge	code	poss	character	c4	c	
# ::edge	character	mod	minority	c2	m	
# ::edge	character	mod	some	c2	s	
# ::edge	code	poss	character	c4	c2	
# ::edge	and	op1	give-01	a3	g	
# ::edge	give-01	mod	also	g2	a	
# ::edge	and	op2	give-01	a3	g2	
# ::edge	give-01	ARG0	table	g2	t	
# ::edge	string-entity	value	GB/TI	s2	2	
# ::edge	string-entity	value	13000	s2	0	
# ::edge	code	mod	string-entity	c5	s2	
# ::edge	give-01	ARG1	code	g2	c5	
# ::edge	code	ARG1-of	correspond-02	c5	c7	
# ::edge	correspond-02	ARG2	character	c7	c3	
# ::edge	give-01	ARG1-of	contrast-01	g2	c6	
# ::edge	part	mod	other	p	o2	
# ::edge	letter	poss	part	l	p	
# ::edge	omit-01	ARG1	letter	o	l	
# ::edge	contrast-01	ARG2	omit-01	c6	o	
# ::edge	omit-01	ARG0	table	o	t	
(a3 / and
    :op1 (g / give-01
        :ARG0 (t / table
            :mod (t2 / this))
        :ARG1 (a2 / and
            :op1 (g3 / glyphs)
            :op2 (c4 / code
                :poss (c / character
                    :mod (c8 / country
                        :name (n / name
                            :op1 "China")))
                :poss (c2 / character
                    :mod (m / minority)
                    :mod (s / some)))))
    :op2 (g2 / give-01
        :ARG0 t
        :ARG1 (c5 / code
            :ARG1-of (c7 / correspond-02
                :ARG2 (c3 / character))
            :mod (s2 / string-entity
                :value "GB/TI"
                :value 13000))
        :ARG1-of (c6 / contrast-01
            :ARG2 (o / omit-01
                :ARG0 t
                :ARG1 (l / letter
                    :poss (p / part
                        :mod (o2 / other)))))
        :mod (a / also)))

