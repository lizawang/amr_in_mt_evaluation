(c5 / contain-01
    :ARG0 (p / part
        :mod (d4 / double-byte))
    :ARG1 (a2 / and
        :op1 (c / character
            :location (p2 / publication
                :name (n / name
                    :op1 "GB/T")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :month 12
                        :year 2002)
                    :op2 (d2 / date-entity)))
            :mod (g / graphic)
            :mod (a / all))
        :op2 (c2 / character
            :name (n2 / name
                :op1 "CJK")
            :ARG2-of (u / unify-01
                :ARG1 (c3 / character
                    :location (p3 / publication
                        :name (n4 / name
                            :op1 "GB/T"
                            :op2 13000))
                    :mod (c6 / country
                        :name (n3 / name
                            :op1 "China"))
                    :mod (g2 / graphic)))
            :mod c6)
        :op3 (c4 / character
            :quant (s / some))))

