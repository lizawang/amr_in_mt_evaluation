            :mod (b / brush))))

# ::tok The characters of the word part are arranged in the order of the corresponding characters in GB/I 11383 to 1989.
# ::node	c	character	1-2
# ::node	s	string-entity	3-4
# ::node	3	part	5-6
# ::node	a	arrange-01	7-8
# ::node	o	order-03	10-11
# ::node	c3	correspond-02	13-14
# ::node	c2	character	14-15
# ::node	n	name	16-17
# ::node	2	GB/I	16-17
# ::node	0	11383	17-18
# ::node	d3	date-interval	19-20
# ::node	d	date-entity	19-20
# ::node	d2	date-entity	19-20
# ::node	1	1989.	19-20
# ::root	a	arrange-01
# ::edge	character	mod	string-entity	c	s	
# ::edge	string-entity	value	part	s	3	
# ::edge	arrange-01	ARG1	character	a	c	
