# ::tok In the text, where a number is preceded by 0x, hexadecimal is used, and non-marked 0x is decimal.
# ::node	n	number	5-6
# ::node	p	precede-01	7-8
# ::node	s	string-entity	9-10
# ::node	h	hexadecimal	10-11
# ::node	a	and	13-14
# ::node	m	mark-02	14-15
# ::node	0	-	14-15
# ::node	1	0x	15-16
# ::node	d	decimal.	17-18
# ::node	d2	decimal.	17-18
# ::root	a	and
# ::edge	precede-01	ARG1	number	p	n	
# ::edge	precede-01	ARG2	string-entity	p	s	
# ::edge	and	op1	hexadecimal	a	h	
# ::edge	and	location	precede-01	a	p	
# ::edge	mark-02	polarity	-	m	0	
# ::edge	string-entity	value	0x	s	1	
# ::edge	and	op2	decimal.	a	d	
# ::edge	decimal.	op1	hexadecimal	d	h	
# ::edge	decimal.	ARG1-of	mark-02	d2	m	
# ::edge	and	op3	decimal.	a	d2	
(a / and
    :location (p / precede-01
        :ARG1 (n / number)
        :ARG2 (s / string-entity
            :value 0x))
    :op1 (h / hexadecimal)
    :op2 (d / decimal.
        :op1 h)
    :op3 (d2 / decimal.
        :ARG1-of (m / mark-02
            :polarity -)))

# ::tok All codes in the appendix are represented in hexadecimal, and other numbers are represented in decimal.
# ::node	a	all	0-1
# ::node	c	code	1-2
# ::node	a3	appendix	4-5
# ::node	r	represent-01	6-7
# ::node	h	hexadecimal,	8-9
# ::node	a2	and	9-10
