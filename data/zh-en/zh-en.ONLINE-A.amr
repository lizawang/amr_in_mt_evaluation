# ::edge	use-01	ARG1	date-interval	u	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	13	d	3	
# ::edge	date-entity	month	3	d	7	
# ::edge	date-entity	year	2008	d	5	
# ::edge	date-entity	year	2009	d2	6	
# ::edge	use-01	polarity	-	u2	0	
# ::edge	date-interval	ARG1-of	use-01	d3	u2	
# ::edge	use-01	ARG2	suffix	u	s	
# ::edge	thing	ARG0-of	encode-01	t	e	
# ::edge	thing	mod	double-byte	t	d4	
# ::edge	suffix	purpose	thing	s	t	
# ::edge	thing	ARG1-of	range-01	t	r	
# ::edge	range-01	ARG3	phone-number-entity	r	p	
# ::edge	phone-number-entity	year	2009	p	6	
# ::edge	range-01	ARG4	phone-number-entity	r	p2	
# ::edge	phone-number-entity	value	2002	p2	4	
# ::edge	phone-number-entity	value	0x81308130	p	2	
# ::edge	use-01	rel	0	u	1	
# ::edge	use-01	rel	3	u	8	
(u / use-01
    :ARG0 (p3 / portion
        :quant (f / four-byte))
    :ARG1 (d3 / date-interval
        :ARG1-of (u2 / use-01
            :polarity -)
        :op1 (d / date-entity
            :day 13
            :month 3
            :year 2008)
        :op2 (d2 / date-entity
            :year 2009))
    :ARG2 (s / suffix
        :purpose (t / thing
            :ARG0-of (e / encode-01)
            :ARG1-of (r / range-01
                :ARG3 (p / phone-number-entity
                    :value 0x81308130
                    :year 2009)
                :ARG4 (p2 / phone-number-entity
                    :value 2002))
            :mod (d4 / double-byte)))
    :rel 0
    :rel 3)

# ::tok The first word of a four-byte character encodes in the range of 0x81 to 0xFE; The second word encoding range is 0x30 to 0x39; The third byte encodes in the range of 0x81 to 0xFE; The fourth character city code ranges from 0x30 to 0x39. i.e. : 0x81308130 a 0x81308139; 0x81308230 0x81308239 0x8130FEFE30 0x8130FE39; 0x81318130 a 0x81318139 ; Oo2douolag0c "0URo23061393 0xFE39FE30 a 0xFE39FE39.
