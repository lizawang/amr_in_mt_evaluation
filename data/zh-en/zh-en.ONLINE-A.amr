# ::tok Unless the -cec, -s, or -E options are used (or a compilation error prevents the complete process), the connection is always the last step.
# ::node	s2	string-entity	2-3
# ::node	o3	or	4-5
# ::node	s3	string-entity	5-6
# ::node	0	-	5-6
# ::node	o2	option	6-7
# ::node	u	use-01	8-9
# ::node	o	(or	9-10
# ::node	c	compile-01	11-12
# ::node	e	err-01	12-13
# ::node	p	prevent-01	13-14
# ::node	c2	complete-02	15-16
# ::node	p2	process-02	16-17
# ::node	c3	connect-01	18-19
# ::node	a	always	20-21
# ::node	o4	ordinal-entity	22-23
# ::node	1	-1	22-23
# ::node	s	step-01	23-24
