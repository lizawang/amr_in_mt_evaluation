# ::edge	tribute	mod	double-character	t	d3	
# ::edge	part	mod	tribute	p	t	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	bit	mod	binary	b2	b	
# ::edge	bit	quant	8	b2	7	
# ::edge	bit	quant	2	b2	6	
# ::edge	use-01	ARG1	bit	u	b2	
# ::edge	represent-01	ARG2	bit	r	b2	
# ::edge	use-01	ARG2	represent-01	u	r	
# ::edge	represent-01	ARG0	part	r	p	
# ::edge	represent-01	ARG1	character,	r	c	
# ::edge	ordinal-entity	value	1	o	5	
# ::edge	byte	ord	ordinal-entity	b3	o	
# ::edge	code	mod	byte	c2	b3	
# ::edge	point-01	ARG0	code	p4	c2	
# ::edge	point-01	ARG2	date-interval	p4	d	
# ::edge	date-interval	op1	0x81	d	3	
# ::edge	and	op1	point-01	a	p4	
# ::edge	represent-01	accompanier	and	r	a	
# ::edge	code	mod	last	c3	l	
# ::edge	and	op2	point-01	a	p5	
# ::edge	point-01	ARG1	code	p5	c3	
# ::edge	date-interval	op1	percentage-entity	d	p2	
# ::edge	point-01	ARG2	date-interval	p5	d2	
# ::edge	date-interval	op2	percentage-entity	d2	p3	
# ::edge	percentage-entity	value	0x40	p2	1	
# ::edge	percentage-entity	polarity	-	p3	0	
# ::edge	name	op1	0x7E	n2	2	
# ::edge	location	name	name	l2	n	
# ::edge	date-interval	op1	location	d2	l2	
# ::edge	number	quant-of	date-interval	n4	d2	
# ::edge	date-interval	op2	number	d2	n4	
# ::edge	date-interval	op3	string-entity	d2	s	
# ::edge	string-entity	value	0xFE.	s	4	
# ::edge	use-01	rel	name	u	n2	
# ::edge	use-01	rel	byte	u	b4	
# ::edge	use-01	rel	name	u	n3	
(u / use-01
    :ARG0 (p / part
        :mod (t / tribute
            :mod (d3 / double-character)))
    :ARG1 (b2 / bit
        :quant 8
        :quant 2
        :mod (b / binary))
    :ARG2 (r / represent-01
        :ARG0 p
        :ARG1 (c / character,)
        :ARG2 b2
        :accompanier (a / and
            :op1 (p4 / point-01
                :ARG0 (c2 / code
                    :mod (b3 / byte
                        :ord (o / ordinal-entity
                            :value 1)))
                :ARG2 (d / date-interval
                    :op1 0x81
                    :op1 (p2 / percentage-entity
                        :value 0x40)))
            :op2 (p5 / point-01
                :ARG1 (c3 / code
                    :mod (l / last))
                :ARG2 (d2 / date-interval
                    :op1 (l2 / location
                        :name (n / name))
                    :op2 (p3 / percentage-entity
                        :polarity -)
                    :op2 (n4 / number
                        :quant-of d2)
                    :op3 (s / string-entity
                        :value 0xFE.)))))
    :rel (n2 / name
        :op1 "0x7E")
    :rel (b4 / byte)
    :rel (n3 / name))

# ::tok The four-byte portion uses GB/11383-1989 0x30-0x39, which is not used in 1989, as a suffix for double-byte encoding encoding, which ranges from 0x81308130 to 0xFE39FE39.
# ::node	f	four-byte	1-2
# ::node	p3	portion	2-3
# ::node	u	use-01	3-4
# ::node	d3	date-interval	4-5
# ::node	d	date-entity	4-5
