(a2 / and
    :op1 (r / represent-01
        :ARG1 (c / code
            :location (a3 / appendix)
            :mod (a / all))
        :ARG2 (h / hexadecimal,))
    :op2 (r2 / represent-01
        :ARG1 (n / number
            :mod (o / other))
        :ARG2 (d / decimal.)))

# ::tok The single-byte part adopts the coding structure of GB/T 11383 to 1989, and uses 0x00~0x7F code points.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	a	adopt-01	3-4
# ::node	c2	code-01	5-6
# ::node	s3	structure	6-7
# ::node	p3	product	8-9
# ::node	n	name	8-9
# ::node	3	GB/T	8-9
# ::node	1	11383	9-10
# ::node	d2	date-interval	10-11
# ::node	d	date-entity	11-12
# ::node	2	1989,	11-12
# ::node	a2	and	12-13
# ::node	u	use-01	13-14
# ::node	s2	string-entity	14-15
# ::node	0	0	14-15
# ::node	c	code	15-16
# ::node	p2	point	16-17
# ::root	a2	and
# ::edge	part	mod	single-byte	p	s	
# ::edge	adopt-01	ARG0	part	a	p	
# ::edge	structure	mod	code-01	s3	c2	
# ::edge	adopt-01	ARG1	structure	a	s3	
# ::edge	structure	poss	product	s3	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	3	
# ::edge	name	op2	11383	n	1	
# ::edge	product	time	date-interval	p3	d2	
# ::edge	date-interval	op1	date-entity	d2	d	
# ::edge	date-entity	year	1989,	d	2	
# ::edge	and	op1	adopt-01	a2	a	
# ::edge	and	op2	use-01	a2	u	
# ::edge	use-01	ARG0	part	u	p	
# ::edge	string-entity	value	0	s2	0	
# ::edge	point	mod	code	p2	c	
# ::edge	point	quant	string-entity	p2	s2	
# ::edge	use-01	ARG1	point	u	p2	
(a2 / and
    :op1 (a / adopt-01
        :ARG0 (p / part
            :mod (s / single-byte))
        :ARG1 (s3 / structure
            :mod (c2 / code-01)
            :poss (p3 / product
                :name (n / name
                    :op1 "GB/T"
                    :op2 11383)
                :time (d2 / date-interval
                    :op1 (d / date-entity
                        :year 1989,)))))
    :op2 (u / use-01
        :ARG0 p
        :ARG1 (p2 / point
            :quant (s2 / string-entity
                :value 0)
            :mod (c / code))))

# ::tok The double-character tribute part uses two eight-bit binary bits to represent a character, with the first byte code points from 0x81 to 0xFE, and the last byte code points from 0x40 to 0x7E and 0x80 to 0xFE.
# ::node	d3	double-character	1-2
# ::node	t	tribute	2-3
# ::node	p	part	3-4
