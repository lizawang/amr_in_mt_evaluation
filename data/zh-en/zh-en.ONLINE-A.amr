# ::node	f3	function-01	3-4
# ::node	d	describe-01	4-5
# ::node	s	string-entity	9-10
# ::node	1	13000	10-11
# ::node	t	this	12-13
# ::node	f	file	13-14
# ::node	r	resemble-01	15-16
# ::node	c2	contrast-01	16-17
# ::node	0	-	17-18
# ::node	e	equal-01	18-19
# ::node	a	and	19-20
# ::node	u	use-01	21-22
# ::node	e2	express-01	23-24
# ::node	f2	foreign	24-25
# ::node	w	word	25-26
# ::node	c	certain	28-29
# ::node	w2	word	29-30
# ::root	a	and
# ::edge	function-01	ARG1	point	f3	p	
# ::edge	describe-01	ARG1	function-01	d	f3	
# ::edge	describe-01	ARG2	string-entity	d	s	
# ::edge	string-entity	value	13000	s	1	
# ::edge	file	mod	this	f	t	
# ::edge	describe-01	location	file	d	f	
# ::edge	resemble-01	ARG1	function-01	r	f3	
# ::edge	contrast-01	ARG1	resemble-01	c2	r	
# ::edge	equal-01	polarity	-	e	0	
# ::edge	contrast-01	ARG2	equal-01	c2	e	
# ::edge	equal-01	ARG1	describe-01	e	d	
# ::edge	and	op1	contrast-01	a	c2	
# ::edge	and	op2	use-01	a	u	
# ::edge	use-01	ARG1	describe-01	u	d	
# ::edge	use-01	ARG2	express-01	u	e2	
# ::edge	express-01	ARG0	function-01	e2	f3	
# ::edge	word	mod	foreign	w	f2	
# ::edge	express-01	ARG1	word	e2	w	
# ::edge	word	mod	certain	w2	c	
# ::edge	express-01	manner	word	e2	w2	
(a / and
    :op1 (c2 / contrast-01
        :ARG1 (r / resemble-01
            :ARG1 (f3 / function-01
                :ARG1 (p / point)))
        :ARG2 (e / equal-01
            :ARG1 (d / describe-01
                :ARG1 f3
                :ARG2 (s / string-entity
                    :value 13000)
                :location (f / file
                    :mod (t / this)))
            :polarity -))
    :op2 (u / use-01
        :ARG1 d
        :ARG2 (e2 / express-01
            :ARG0 f3
            :ARG1 (w / word
                :mod (f2 / foreign))
            :manner (w2 / word
                :mod (c / certain)))))

