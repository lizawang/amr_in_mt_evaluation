# ::node	d2	date-interval	1-2
# ::node	0	12	1-2
# ::node	d	date-entity	3-4
# ::node	1	1980	3-4
# ::node	c	character	7-8
# ::node	e	encode-01	8-9
# ::node	c4	country	10-11
# ::node	n2	name	10-11
# ::node	2	China	10-11
# ::node	c2	character	11-12
# ::node	i	information	13-14
# ::node	e2	exchange-01	14-15
# ::node	b	basic	15-16
# ::node	s	set	16-17
# ::root	s	set
# ::edge	company	name	name	c3	n	
# ::edge	name	op1	GB/T	n	3	
# ::edge	date-interval	op2	date-entity	d2	d	
# ::edge	date-entity	year	1980	d	1	
# ::edge	country	name	name	c4	n2	
# ::edge	name	op1	China	n2	2	
# ::edge	character	mod	country	c2	c4	
# ::edge	encode-01	ARG2	character	e	c2	
# ::edge	exchange-01	ARG1	information	e2	i	
# ::edge	encode-01	purpose	exchange-01	e	e2	
# ::edge	set	mod	basic	s	b	
# ::edge	set	consist-of	character	s	c	
# ::edge	set	time	date-interval	s	d2	
# ::edge	set	mod	company	s	c3	
# ::edge	set	rel	encode-01	s	e	
# ::edge	set	rel	12	s	0	
(s / set
    :consist-of (c / character)
    :mod (b / basic)
    :mod (c3 / company
        :name (n / name
            :op1 "GB/T"))
    :rel (e / encode-01
        :purpose (e2 / exchange-01
            :ARG1 (i / information))
        :ARG2 (c2 / character
            :mod (c4 / country
                :name (n2 / name
                    :op1 "China"))))
    :rel 12
    :time (d2 / date-interval
        :op2 (d / date-entity
            :year 1980)))

