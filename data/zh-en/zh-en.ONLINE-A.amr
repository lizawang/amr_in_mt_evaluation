    :ARG0 (y / you)
    :ARG1 (a / and
        :ARG1-of (s2 / size-01)
        :domain y
        :op1 (s3 / small)
        :op2 (s4 / small.))
    :ARG1-of (c / cause-01
        :ARG0 (f / feel-01
            :ARG0 y))
    :condition f
    :rel (e2 / equip-01
        :ARG1 (h / headset))
    :rel (s / size-01)
    :rel (e / ear))

