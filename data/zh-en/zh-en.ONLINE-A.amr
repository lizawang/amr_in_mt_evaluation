# ::edge	point	ARG1-of	reserve-01	p	r2	
# ::edge	extend-01	ARG1	file	e	f	
# ::edge	extend-01	time	future	e	f2	
# ::edge	reserve-01	ARG2	extend-01	r2	e	
(a / area
    :ARG1-of (r / reserve-01)
    :domain (p / point
        :quant 4
        :ARG1-of (o / occupy-01
            :polarity -)
        :ARG1-of (r2 / reserve-01
            :ARG2 (e / extend-01
                :ARG1 (f / file)
                :time (f2 / future)))
        :mod (c / code)
        :mod (o2 / other)))

