# ::edge	date-entity	year	18030	d	3	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	2005	d2	4	
# ::edge	specify-01	time	date-interval	s2	d3	
# ::edge	exclamation-mark	mod	vertical	e	v	
# ::edge	point	mod	exclamation-mark	p	e	
# ::edge	point	quant	10	p	1	
# ::edge	and	op1	point	a2	p	
# ::edge	specify-01	ARG1	and	s2	a2	
# ::edge	country	name	name	c3	n	
# ::edge	name	op1	China	n	7	
# ::edge	character	mod	country	c	c3	
# ::edge	widget	mod	character	w	c	
# ::edge	widget	quant	8	w	6	
# ::edge	and	op2	widget	a2	w	
# ::edge	code	mod	temporary	c2	t2	
# ::edge	location	mod	code	l	c2	
# ::edge	and	location	location	a2	l	
# ::edge	location	location	product	l	p2	
# ::edge	product	name	name	p2	n2	
# ::edge	name	op1	GB/I	n2	8	
# ::edge	name	op2	13000,	n2	2	
