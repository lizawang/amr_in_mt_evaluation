# ::edge	process-01	time	before	p	b	
# ::edge	before	op1	assemble-01	b	a2	
# ::edge	program;	rel	process-01	p2	p	
(p2 / program;
    :name (n / name
        :op1 "C")
    :mod (s / source)
    :mod (a / amr-empty)
    :rel (p / process-01
        :time (b / before
            :op1 (a2 / assemble-01))))

