    :op1 (t2 / tuck-01
        :ARG0 (y / you)
        :ARG1 (t / tent
            :mod (e / ear))
        :ARG2 (d / down)
        :direction (r / relative-position
            :direction (n / northwest))
        :location (c / canal
            :mod e))
    :op2 (s / shake-01
        :purpose (m / make-18
            :ARG0 y
            :ARG1 (h / home.))
        :ARG0 y
        :ARG1 (s2 / speaker
            :ARG2-of (a / amplify-01))
