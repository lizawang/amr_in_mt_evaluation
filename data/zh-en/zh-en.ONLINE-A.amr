(a / and
    :op1 (r / read-01
        :ARG0 (y / you)
        :ARG1 (m / manual
            :mod (t / this))
        :ARG1-of (c / care-04
            :ARG0 y)
        :mode imperative
        :polite +
        :time (b / before
            :op1 (u / use-01
                :ARG0 y
                :ARG1 (p / product))))
    :op2 (k / keep-01
        :ARG0 y
        :ARG1 p
        :manner (p2 / proper)
        :mode imperative
        :polite +))

