# ::edge	show-01	ARG0	table	s	t	
# ::edge	table	mod	1	t	0	
# ::edge	table	mod	3	t	5	
(s2 / specify-01
    :ARG1 (a2 / and
        :location (l / location
            :ARG1-of (a / adjust-01
                :ARG0 (d4 / document,
                    :mod (t3 / this)))
            :location (p2 / product
                :name (n2 / name
                    :op1 "GB/I"
                    :op2 "13000,"))
            :mod (c2 / code
                :mod (t2 / temporary)))
        :op1 (p / point
            :quant 10
            :mod (e / exclamation-mark
                :mod (v / vertical)))
        :op2 (w / widget
            :quant 8
            :mod (c / character
                :mod (c3 / country
                    :name (n / name
                        :op1 "China")))))
    :ARG1-of (s / show-01
        :ARG0 (t / table
            :mod 1
            :mod 3))
    :time (d3 / date-interval
        :op1 (d / date-entity
            :year 18030)
        :op2 (d2 / date-entity
            :year 2005)))

