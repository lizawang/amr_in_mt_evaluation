(e / encode-01
    :ARG1 (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c3 / country
                    :name (n3 / name
                        :op1 "China,"))
                :op2 (c4 / country
                    :name (n4 / name
                        :op1 "Japan,"))
                :op3 (c5 / country
                    :name (n5 / name
                        :op1 "Enguo,"))
                :op4 (a2 / and
                    :mod (o / other)
                    :op1 (c6 / country)
                    :op2 (r / region))))
        :mod (c2 / country
            :name (n2 / name
                :op1 "China")))
    :ARG1-of (u / unify-01)
    :domain (p / product
        :name (n / name
            :op1 "B"
            :op2 13000))
    :rel (i / Vietnam))

# ::tok Chinese characters with unique abstract glyphs, given a separate code position; Chinese characters with different origins and the same abstract glyph are given a common code location.
