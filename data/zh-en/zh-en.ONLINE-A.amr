# ::edge	and	op1	consider-01	a	c2	
# ::edge	and	op2	set-02	a	s	
# ::edge	set-02	ARG0	government-organization	s	g	
# ::edge	set-02	ARG1	connect-01	s	c	
# ::edge	set-02	manner	form	s	f3	
# ::edge	form	mod	string-entity	f3	s3	
(a / and
    :op1 (c2 / consider-01
        :ARG0 (g / government-organization
            :name (n / name
                :op1 "GCC"))
        :ARG1 (f2 / file
            :domain (f / file
                :ARG1-of (p / process-01))
            :mod (s2 / string-entity)))
    :op2 (s / set-02
        :ARG0 g
        :ARG1 (c / connect-01)
        :manner (f3 / form
            :mod (s3 / string-entity
                :value "C"))))

