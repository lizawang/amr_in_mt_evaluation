(a / adjust-01
    :ARG1 (a2 / and-or
        :ARG2-of (p / position-01
            :ARG1 (c3 / code)
            :mod (s / some))
        :op1 (l / letter)
        :op2 (l2 / location
            :ARG2-of (c4 / correspond-02
                :ARG1 l)))
    :ARG1-of (r / relative-05
        :ARG2 (t / thing
            :name (n2 / name
                :op1 "GB")
            :mod l
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :year 2003)
                :op2 (d2 / date-entity
                    :year 2005))))
