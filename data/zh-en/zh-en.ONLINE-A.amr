(c / call-01
    :ARG1 (c2 / character
        :name (n2 / name
            :op1 "Unified"
            :op2 "Ideographs,"
            :op3 "Ideographs,")
        :ARG1-of (e / encode-01)
        :location-of (s / stand-08
            :ARG0 c2
            :ARG1 (a / and
                :name (n4 / name
                    :op1 "Japan,"
                    :op2 "Korea.")
                :op1 (c4 / country
                    :name (n3 / name
                        :op1 "China,"))))
        :mod (c3 / country
            :name (n / name
                :op1 "China"))))

