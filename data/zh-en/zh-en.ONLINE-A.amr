# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	11383	d2	0	
# ::edge	date-entity	year	1989.	d	1	
# ::edge	arrange-01	rel	name	a	n	
(a / arrange-01
    :ARG1 (c / character
        :mod (s / string-entity
            :value "part"))
    :manner (o / order-03
        :ARG1 (c2 / character
            :ARG1-of (c3 / correspond-02
                :ARG2 s)
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :year 1989.)
                :op2 (d2 / date-entity
                    :year 11383))))
    :rel (n / name
        :op1 "GB/I"))

