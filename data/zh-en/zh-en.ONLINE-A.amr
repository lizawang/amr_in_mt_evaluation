    :op2 (s / set-02
        :ARG0 p2
        :ARG1 (c / connect-01
            :location p3)))

# ::tok The source file post-level name indicates the language type and later operations:
# ::node	s	source	1-2
# ::node	f	file	2-3
# ::node	a	after	3-4
# ::node	n	name	4-5
# ::node	i	indicate-01	5-6
# ::node	l	language	7-8
# ::node	t	type-03	8-9
# ::node	a3	and	9-10
# ::node	a2	after	10-11
# ::node	o	operate-01	11-12
# ::root	i	indicate-01
# ::edge	file	mod	source	f	s	
# ::edge	name	mod	after	n	a	
# ::edge	indicate-01	ARG0	name	i	n	
# ::edge	type-03	ARG2	language	t	l	
# ::edge	and	op1	type-03	a3	t	
# ::edge	indicate-01	ARG1	and	i	a3	
# ::edge	after	op1	after	a2	a	
# ::edge	operate-01	time	after	o	a2	
# ::edge	and	op2	operate-01	a3	o	
# ::edge	indicate-01	rel	file	i	f	
(i / indicate-01
    :ARG0 (n / name
        :mod (a / after))
    :ARG1 (a3 / and
        :op1 (t / type-03
            :ARG2 (l / language))
        :op2 (o / operate-01
            :time (a2 / after
                :op1 a)))
    :rel (f / file
        :mod (s / source)))

