# ::tok First byte 0xA8~0xA9 DWORD 5 : 192 code bits
# ::node	o	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b2	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8~0xA9	2-3
# ::node	l	language	3-4
# ::node	4	DWORD	3-4
# ::node	3	5	4-5
# ::node	m	multi-sentence	5-6
# ::node	e	equal-01	5-6
# ::node	2	192	6-7
# ::node	c	code	7-8
# ::node	b	bit	8-9
# ::root	m	multi-sentence
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	byte	ord	ordinal-entity	b2	o	
# ::edge	name	op1	0xA8~0xA9	n	0	
# ::edge	language	name	name	l	n	
# ::edge	name	op2	DWORD	n	4	
# ::edge	name	op3	5	n	3	
# ::edge	multi-sentence	snt1	language	m	l	
# ::edge	language	snt2	equal-01	l	e	
# ::edge	bit	mod	code	b	c	
# ::edge	bit	quant	192	b	2	
# ::edge	equal-01	ARG1	bit	e	b	
# ::edge	multi-sentence	rel	byte	m	b2	
(m / multi-sentence
    :rel (b2 / byte
        :ord (o / ordinal-entity
            :value 1))
    :snt1 (l / language
        :name (n / name
            :op1 "0xA8~0xA9"
            :op2 "DWORD"
            :op3 5)
        :snt2 (e / equal-01
            :ARG1 (b / bit
                :quant 192
                :mod (c / code)))))

