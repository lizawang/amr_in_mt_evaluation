(g2 / give-01
    :ARG1 (c / character
        :mod (c5 / country
            :name (n / name
                :op1 "China")))
    :ARG2 (a2 / and
        :op1 (c2 / character
            :ARG1-of (u / unique-01)
            :ARG1-of (o / originate-01
                :ARG1-of (d / differ-02))
            :mod c5)
        :op2 (g3 / glyph
            :ARG1-of (s / same-01)
            :ARG1-of u
            :mod (a / abstract)))
    :ARG3 (l / location.
        :ARG1-of (s3 / share-01)
        :mod (c4 / code))
    :rel (g / give-01
        :ARG1 (p / position;
            :ARG1-of (s2 / separate-02)
            :mod (c3 / code))
        :ARG2 c))

