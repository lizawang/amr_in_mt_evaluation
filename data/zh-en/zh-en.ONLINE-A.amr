# ::edge	or	op1	string-entity	o3	s2	
# ::edge	or	op2	string-entity	o3	s3	
# ::edge	string-entity	polarity	-	s3	0	
# ::edge	option	mod	or	o2	o3	
# ::edge	use-01	ARG1	option	u	o2	
# ::edge	(or	op1	use-01	o	u	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	(or	op2	prevent-01	o	p	
# ::edge	process-02	ARG1-of	complete-02	p2	c2	
# ::edge	prevent-01	ARG1	process-02	p	p2	
# ::edge	ordinal-entity	value	-1	o4	1	
# ::edge	step-01	ord	ordinal-entity	s	o4	
# ::edge	step-01	time	always	s	a	
# ::edge	step-01	ARG2	connect-01	s	c3	
# ::edge	step-01	condition	(or	s	o	
(s / step-01
    :ARG2 (c3 / connect-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (o2 / option
                :mod (o3 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :ord (o4 / ordinal-entity
        :value -1)
    :time (a / always))

# ::tok During the connection phase, all .e files corresponding to the source program, -1 library files, unrecognized file names (including the specified .o H standard file and .a library file) are passed to the connector options (OPTIONS) in the order in the command line
# ::node	c2	connect-01	2-3
# ::node	p2	phase,	3-4
# ::node	a	all	4-5
# ::node	f	file	6-7
# ::node	c4	correspond-02	7-8
# ::node	s	source	10-11
# ::node	p3	program,	11-12
# ::node	0	-	12-13
# ::node	l	library	13-14
# ::node	r	recognize-02	15-16
# ::node	f2	file	16-17
# ::node	n	name	17-18
# ::node	s2	specify-01	20-21
# ::node	n2	name	21-22
# ::node	2	no	21-22
# ::node	1	H	22-23
# ::node	s3	standard-02	23-24
# ::node	f3	file	24-25
# ::node	a2	and	25-26
# ::node	p	pass-05	30-31
# ::node	c3	connect-01	33-34
# ::node	o	option	34-35
# ::node	o2	order-03	38-39
# ::node	c	command-02	41-42
# ::node	l2	line	42-43
# ::root	p	pass-05
# ::edge	phase,	mod	connect-01	p2	c2	
# ::edge	file	mod	all	f	a	
# ::edge	file	ARG1-of	correspond-02	f	c4	
# ::edge	program,	mod	source	p3	s	
# ::edge	correspond-02	ARG2	program,	c4	p3	
# ::edge	recognize-02	polarity	-	r	0	
# ::edge	name	mod	file	n	f2	
# ::edge	name	ARG1-of	recognize-02	n	r	
# ::edge	name	op1	no	n2	2	
# ::edge	name	op2	H	n2	1	
# ::edge	file	ARG1-of	standard-02	f3	s3	
# ::edge	file	name	name	f3	n2	
# ::edge	and	op1	file	a2	f3	
# ::edge	and	ARG1-of	specify-01	a2	s2	
# ::edge	name	op2	and	n	a2	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	pass-05	time	phase,	p	p2	
# ::edge	option	mod	connect-01	o	c3	
# ::edge	pass-05	ARG2	option	p	o	
# ::edge	pass-05	ARG1-of	order-03	p	o2	
# ::edge	line	mod	command-02	l2	c	
# ::edge	order-03	location	line	o2	l2	
# ::edge	pass-05	rel	name	p	n	
# ::edge	pass-05	rel	library	p	l	
(p / pass-05
    :ARG1 (f / file
        :ARG1-of (c4 / correspond-02
            :ARG2 (p3 / program,
                :mod (s / source)))
        :mod (a / all))
    :ARG1-of (o2 / order-03
        :location (l2 / line
            :mod (c / command-02)))
    :ARG2 (o / option
        :mod (c3 / connect-01))
    :rel (n / name
        :ARG1-of (r / recognize-02
            :polarity -)
        :mod (f2 / file)
        :op2 (a2 / and
            :ARG1-of (s2 / specify-01)
            :op1 (f3 / file
                :name (n2 / name
                    :op1 "no"
                    :op2 "H")
                :ARG1-of (s3 / standard-02))))
    :rel (l / library)
    :time (p2 / phase,
        :mod (c2 / connect-01)))

# ::tok The options must be given discretely : de ' is completely different from '-d -r '.
# ::node	o2	option	1-2
# ::node	o	obligate-01	2-3
# ::node	g	give-01	4-5
