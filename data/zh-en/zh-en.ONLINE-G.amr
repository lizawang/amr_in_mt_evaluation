        :ARG1 (p2 / position;
            :ARG1-of (s2 / separate-02)
            :mod (c3 / code))
        :ARG2 (c / character
            :ARG0-of (h / have-03
                :ARG1 (t / thug
                    :ARG1-of (u / unique-01)
                    :mod a))
            :mod c5)))

# ::tok The encoded Chinese characters are called CJK Unified Chinese characters CCJK Unified Ideographs, where CJK represents China, Japan, and South Korea.
