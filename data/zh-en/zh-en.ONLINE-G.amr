# ::edge	book	name	name	b2	n4	
# ::edge	name	op1	GB/T	n4	7	
# ::edge	name	op2	13000,	n4	2	
# ::edge	and	op1	character	a2	c2	
# ::edge	contain-01	ARG1	and	c4	a2	
# ::edge	character	mod	graphic	c3	g2	
# ::edge	character	quant	some	c3	s	
# ::edge	and	op2	character	a2	c3	
# ::edge	contain-01	rel	character	c4	c	
(c4 / contain-01
    :ARG0 (p / part
        :mod (d4 / double-byte))
    :ARG1 (a2 / and
        :op1 (c2 / character
            :name (n2 / name
                :op1 "CJK")
            :ARG2-of (u / unify-01)
            :location (b2 / book
                :name (n4 / name
                    :op1 "GB/T"
                    :op2 "13000,"))
            :mod (c5 / country
                :name (n3 / name
                    :op1 "China")))
        :op2 (c3 / character
            :quant (s / some)
            :mod (g2 / graphic)))
    :rel (c / character
        :location (b / book
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 13
                    :month 12
                    :year 2002)
                :op2 (d2 / date-entity)))
        :mod (g / graphic)
        :mod (a / all)))

# ::tok The characters of the double-byte part are in accordance with the provisions of Appendix A.
# ::node	c2	character	1-2
# ::node	d	double-byte	4-5
# ::node	p	part	5-6
# ::node	a	accord-02	8-9
# ::node	p2	provision	11-12
# ::node	c	chapter	13-14
# ::node	n	name	13-14
# ::node	1	Appendix	13-14
# ::node	0	A.	14-15
# ::root	a	accord-02
# ::edge	part	mod	double-byte	p	d	
# ::edge	character	part-of	part	c2	p	
# ::edge	accord-02	ARG1	character	a	c2	
# ::edge	accord-02	ARG2	provision	a	p2	
# ::edge	provision	part-of	chapter	p2	c	
# ::edge	chapter	name	name	c	n	
# ::edge	name	op1	Appendix	n	1	
# ::edge	name	op2	A.	n	0	
(a / accord-02
    :ARG1 (c2 / character
        :part-of (p / part
            :mod (d / double-byte)))
    :ARG2 (p2 / provision
        :part-of (c / chapter
            :name (n / name
                :op1 "Appendix"
                :op2 "A."))))

