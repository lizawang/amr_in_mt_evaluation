# ::edge	record-01	ARG1	earthquake	r	e	
(e2 / earthquake
    :quant (m / more-than
        :op1 (s / seismic-quantity
            :quant 9))
    :domain (e / earthquake
        :mod (t / this))
    :location (c / country
        :name (n / name
            :op1 "Japan"))
    :ord (o2 / ordinal-entity
        :value 1)
    :time (s2 / since
        :op1 (a / and
            :op1 (o / observe-01
                :ARG1 e)
            :op2 (r / record-01
                :ARG1 e))))

