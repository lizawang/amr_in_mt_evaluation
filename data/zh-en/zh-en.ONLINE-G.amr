(c3 / contrast-01
    :ARG1 (r / resemble-01
        :ARG1 (d / describe-01
            :ARG1 (f2 / function-01
                :ARG1 (c2 / code))
            :ARG2 (p / publication
                :name (n / name
                    :op1 "GB/T"
                    :op2 13000)
                :part-of (d2 / document
                    :mod (t / this)))))
    :ARG2 (s / same-01
