# ::edge	contrast-01	rel	option	c2	o	
(c2 / contrast-01
    :ARG1 (s / sign-01
        :ARG1 (f / field
            :mod (b2 / bit))
        :ARG1-of (c / cause-01))
    :ARG2 (s3 / sign-01
        :ARG1 f
        :polarity -
        :time (a / always))
    :rel (s2 / sign-01
        :ARG1 (n / number
            :domain (t / type
                :ARG0 s2
                :mod (i / integer)
                :mod (b / basic))))
    :rel (o / option))

