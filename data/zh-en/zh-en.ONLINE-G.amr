            :op1 "specified.o"
            :op2 "H")
        :mod f
        :mod (t / thing
            :ARG2-of c))
    :rel (l2 / library)
    :rel (s2 / standard-02)
    :rel (l / library)
    :time (p2 / phase,
        :mod (c2 / connect-01)))

