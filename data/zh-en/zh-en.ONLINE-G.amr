(r / recommend-01
    :ARG1 (c4 / comply-01
        :ARG0 (a / and
            :op1 (g / graphic)
            :op2 (l / location
                :mod (c3 / code))
            :op3 (f / function-01
                :ARG0 (v / variable
                    :ARG0-of (d / describe-01
                        :ARG1 (c2 / character))
                    :mod c2)))
        :ARG1 (t / thing
            :ARG1-of (p / provide-01
                :ARG0 (c / chapter
                    :name (n / name
                        :op1 "Appendix"
                        :op2 "B.")))))
    :ARG1-of (i2 / include-91)
    :rel (i / ideology))

