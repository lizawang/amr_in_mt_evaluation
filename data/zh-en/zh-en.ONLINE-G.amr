    :ARG1 (p3 / position
        :mod (c3 / code)
        :mod (t3 / this))
    :ARG1-of (s2 / show-01
        :ARG0 (t / table
            :location (p5 / publication
                :name (n3 / name
                    :op1 (a / 18030
                        :name n3)
                    :op3 2005))))
    :ARG1-of (s3 / show-01
        :ARG0 t)
    :rel (s4 / specify-01
        :ARG1 (p2 / position
            :location (p4 / product
                :name (n2 / name
                    :op1 "GB/I"
                    :op2 "13000."))
            :mod (c2 / code)
            :mod (t2 / temporary)
