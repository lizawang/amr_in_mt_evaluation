# ::edge	name	op2	Korea.	n4	4	
# ::edge	call-01	rel	name	c	n2	
(c / call-01
    :ARG1 (c2 / character
        :ARG1-of (e / encode-01)
        :mod (c4 / country
            :name (n / name
                :op1 "China")))
    :ARG2 (c3 / character
        :domain c2
        :location-of (r / represent-01
            :ARG0 c2
            :ARG1 (a / and
                :op1 (c5 / country
                    :name (n3 / name
                        :op1 "Japan,"))
                :op2 (c6 / country
                    :name (n4 / name
                        :op1 "South"
                        :op2 "Korea.")))))
    :rel (n2 / name
        :op1 "CCJK"
        :op2 "Unified"
        :op3 "Ideographs,"))

