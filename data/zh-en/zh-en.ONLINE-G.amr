# ::edge	and	op2	region	a2	r	
# ::edge	encode-01	rel	Vietnam	e	i	
(e / encode-01
    :ARG0 (p / product
        :name (n / name
            :op2 13000))
    :ARG1 (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c3 / country
                    :name (n3 / name
                        :op1 "China,"))
                :op2 (c4 / country
                    :name (n4 / name
                        :op1 "Enguo,"))
                :op3 (a2 / and
                    :mod (o / other)
                    :op1 (c5 / country)
                    :op2 (r / region))))
        :mod (c2 / country
            :name (n2 / name
                :op1 "China")))
    :manner (u / uniform-02)
    :rel (i / Vietnam))

