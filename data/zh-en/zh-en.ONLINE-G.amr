    :op1 (a2 / affect-01
        :ARG0 (a3 / and
            :op1 (e / earthquake)
            :op2 (t / tsunami))
        :ARG1 (p / plant
            :location (f / facility
                :name (n / name
                    :op1 "Fukushima"
                    :op2 "Daiichi"))
            :mod (p2 / power
                :mod (n2 / nucleus))))
    :op2 (a / accident
        :mod (l / leak-01)))

