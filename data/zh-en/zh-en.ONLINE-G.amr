# ::edge	total-01	ARG2	monetary-quantity	t	m2	
# ::edge	monetary-quantity	quant	23	m2	3	
# ::edge	divide-02	rel	value-interval	d	v	
(d / divide-02
    :ARG1 (a2 / arrange-01
        :ARG0 (p / part
            :mod (d2 / double-byte))
        :ARG1 (p2 / point
            :mod (c / code)))
    :ARG2 (a / and
        :quant 2
        :ARG1-of (t / total-01
            :ARG2 (m2 / monetary-quantity
                :quant 23)))
    :rel (v / value-interval
        :op1 (l / line
            :name (n / name
                :op1 "0xFE7E"))
        :op2 (m / member
            :mod v
            :mod (v2 / variable
                :name (n2 / name
                    :op1 "0x8180")))))

