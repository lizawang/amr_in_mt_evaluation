# ::edge	code	mod	byte	c	b2	
# ::edge	position	mod	code	p	c	
# ::edge	position	part-of	bit	p	b	
(p / position
    :mod (c / code
        :mod (b2 / byte
            :ord (o / ordinal-entity
                :value 2)
            :value 13000))
    :part-of (b / bit
        :ARG1-of (h / high-02)))

