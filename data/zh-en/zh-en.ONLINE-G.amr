(a / area
    :ARG1-of (d4 / define-01)
    :domain (p2 / point
        :quant 25000
        :ARG1-of (r / range-01
            :ARG3 (p / percentage-entity
                :mod (d3 / date-interval
                    :op1 (d / date-entity
                        :day 30
                        :month 3
                        :year 2008)
