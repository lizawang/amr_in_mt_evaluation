# ::edge	step-01	time	always	s	a	
# ::edge	step-01	ARG2	connect-01	s	c3	
# ::edge	step-01	condition	(or	s	o	
(s / step-01
    :ARG2 (c3 / connect-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (d / "disc"
                :name (n / name
                    :op1 d)
                :op2 (o2 / option
                    :name (n2 / name
                        :op1 "or-E")))
            :polarity -)
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :ord (o3 / ordinal-entity
        :value -1)
    :time (a / always))

