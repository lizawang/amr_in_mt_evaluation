        :ARG2 (b / borrow-01
            :purpose (e / express-01
                :ARG0 i
                :ARG1 (w2 / word.
                    :mod (f / foreign)))
            :ARG0 i
            :ARG1 (w / word
                :mod (c / certain)))))

