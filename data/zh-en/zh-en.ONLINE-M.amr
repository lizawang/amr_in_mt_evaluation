# ::edge	quick-02	ARG1	set-02	q	s	
# ::edge	turn-on-13	rel	assist-01	t2	a2	
(t2 / turn-on-13
    :ARG0 (y / you)
    :ARG1 (t3 / turn-on-13
        :ARG0 y
        :ARG1 (t / thing
            :ARG0-of (w / wake-up-02
                :ARG1-of (q / quick-02
                    :ARG1 (s / set-02
                        :ARG1 t)))))
    :mode imperative
    :rel (a2 / assist-01
        :ARG0-of (r / require-01
            :ARG1 (d / device)
            :ARG1 (a / and
                :op1 (s2 / support-01
                    :ARG0 d
                    :ARG1 (v / voice))))))

# ::tok Answer the second call and switch the call.
