# ::node	h	headset	13-14
# ::node	s	slash	14-15
# ::node	m	mobile-02	15-16
# ::node	p3	phone	16-17
# ::node	l2	listen-01	18-19
# ::node	p	person	20-21
# ::node	n	name	20-21
# ::node	0	Jane	20-21
# ::node	d	double	21-22
# ::node	t	tap	22-23
# ::root	s2	switch-01
