# ::edge	show-01	ARG0	and	s	a2	
# ::edge	and	op3	table	a2	t	
# ::edge	table	mod	2.	t	1	
(s / show-01
    :ARG0 (a2 / and
        :op1 (f / figure
            :mod 3)
        :op2 (f2 / figure)
        :op3 (t / table
            :mod 2.))
    :ARG1 (a / allocate-01
        :ARG1 (b / bit
            :quant 2
            :mod (c / code))))

