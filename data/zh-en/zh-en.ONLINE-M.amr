# ::edge	value-interval	op2	7	v	1	
# ::edge	and	op1	value-interval	a	v	
# ::edge	divide-02	ARG2	and	d	a	
# ::edge	and	ARG1-of	total-01	a	t	
# ::edge	bit	mod	code	b2	c	
# ::edge	bit	quant	23940	b2	0	
# ::edge	total-01	ARG2	bit	t	b2	
# ::edge	bit	ARG2-of	and	b2	a	
# ::edge	bit	quant	8	b3	3	
# ::edge	and	op3	bit	a	b3	
(d / divide-02
    :ARG1 (b / bit
        :ARG1-of (a2 / arrange-01
            :topic (p / part
                :mod (t2 / two-byte))))
    :ARG2 (a / and
        :ARG1-of (t / total-01
            :ARG2 (b2 / bit
                :quant 23940
                :ARG2-of a
                :mod (c / code)))
        :op1 (v / value-interval
            :op1 8
            :op2 7)
        :op3 (b3 / bit
            :quant 8)))

# ::tok The two-byte code bit allocation is shown in Figure 3 and Table 2.
# ::node	0	2	1-2
# ::node	c	code	2-3
