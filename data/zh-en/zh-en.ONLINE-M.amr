# ::edge	contrast-01	ARG2	and	c	a	
# ::edge	string-entity	value	period	s3	1	
# ::edge	street	mod	string-entity	s2	s3	
# ::edge	number	ARG1-of	symbolize-01	n	s4	
# ::edge	number	domain	street	n	s2	
# ::edge	and	op2	number	a	n	
# ::edge	number	domain	street	n2	s2	
# ::edge	and	op3	number	a	n2	
# ::edge	number	mode	expressive	n	e	
# ::edge	expressive	polarity	-	e	0	
# ::edge	number	ARG0-of	depend-01	n2	d	
# ::edge	machine	ARG1-of	target-01	m	t	
# ::edge	depend-01	ARG1	machine	d	m	
# ::edge	machine	ARG0-of	write-01	m	w2	
# ::edge	write-01	ARG1	program).	w2	p2	
# ::edge	contrast-01	rel	simple-02	c	s	
# ::edge	contrast-01	rel	only	c	o	
(c / contrast-01
    :ARG2 (a / and
        :op1 (w / write-01
            :ARG1 (p / program
                :quant (m2 / many)))
        :op2 (n / number
            :ARG1-of (s4 / symbolize-01)
            :domain (s2 / street
                :mod (s3 / string-entity
                    :value "period"))
            :mode (e / expressive
                :polarity -))
        :op3 (n2 / number
            :ARG0-of (d / depend-01
                :ARG1 (m / machine
                    :ARG0-of (w2 / write-01
                        :ARG1 (p2 / "program)."))
                    :ARG1-of (t / target-01)))
            :domain s2))
    :rel (s / simple-02)
    :rel (o / only))

# ::tok This option, and its antithesis, makes such a program work at the corresponding default value.
# ::node	t	this	0-1
# ::node	o	option,	1-2
# ::node	a	and	2-3
# ::node	a2	antithesis,	4-5
# ::node	m	make-02	5-6
# ::node	s	such	6-7
# ::node	p	program	8-9
# ::node	w	work-09	9-10
# ::node	c	correspond-02	12-13
# ::node	d	default-01	13-14
# ::node	v	value.	14-15
# ::root	m	make-02
# ::edge	option,	mod	this	o	t	
# ::edge	and	op1	option,	a	o	
# ::edge	and	op2	antithesis,	a	a2	
# ::edge	antithesis,	poss	option,	a2	o	
# ::edge	make-02	ARG0	and	m	a	
# ::edge	program	mod	such	p	s	
# ::edge	work-09	ARG1	program	w	p	
# ::edge	make-02	ARG1	work-09	m	w	
# ::edge	value.	ARG2-of	default-01	v	d	
# ::edge	value.	ARG1-of	correspond-02	v	c	
# ::edge	work-09	manner	value.	w	v	
(m / make-02
    :ARG0 (a / and
        :op1 (o / option,
            :mod (t / this))
        :op2 (a2 / antithesis,
            :poss o))
    :ARG1 (w / work-09
        :ARG1 (p / program
            :mod (s / such))
        :manner (v / value.
            :ARG1-of (c / correspond-02)
            :ARG2-of (d / default-01))))

# ::tok The type of char should always be explicitly defined as signed char or unsigned char, even if it behaves exactly the same as one of them.
