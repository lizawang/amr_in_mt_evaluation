# ::edge	connect-01	ARG1	headset	c	h	
# ::edge	and	op1	connect-01	a2	c	
# ::edge	and	op2	use-01	a2	u	
# ::edge	use-01	polarity	-	u	2	
# ::edge	use-01	ARG1	headset	u	h	
# ::edge	use-01	ARG0	you	u	y	
# ::edge	refer-01	polite	+	r	0	
# ::edge	refer-01	mode	imperative	r	3	
# ::edge	refer-01	ARG0	you	r	y	
# ::edge	refer-01	condition	and	r	a2	
# ::edge	method	manner-of	adjust-01	m	a	
# ::edge	method	ARG1-of	follow-01	m	f	
# ::edge	refer-01	ARG1	method	r	m	
(r / refer-01
    :ARG0 (y / you)
    :ARG1 (m / method
        :ARG1-of (f / follow-01)
        :manner-of (a / adjust-01))
    :condition (a2 / and
        :op1 (c / connect-01
            :ARG1 (h / headset)
            :manner (p / proper
                :polarity -))
        :op2 (u / use-01
            :ARG0 y
            :ARG1 h
            :polarity -))
    :mode imperative
    :polite +)

