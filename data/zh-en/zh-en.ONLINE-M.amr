# ::edge	type	mod	char	t	c	
# ::edge	define-01	ARG1-of	explicit-03	d	e3	
# ::edge	define-01	time	always	d	a	
# ::edge	recommend-01	ARG1	define-01	r	d	
# ::edge	define-01	ARG1	type	d	t	
# ::edge	char	ARG1-of	sign-01	c2	s2	
# ::edge	or	op1	char	o2	c2	
# ::edge	define-01	ARG2	or	d	o2	
# ::edge	char,	ARG1-of	sign-01	c3	s3	
# ::edge	or	op2	char,	o2	c3	
# ::edge	sign-01	polarity	-	s3	0	
# ::edge	define-01	concession	even-if	d	e	
# ::edge	even-if	op1	behave-01	e	b	
# ::edge	behave-01	ARG0	char	b	c	
# ::edge	same-01	mod	exact	s	e2	
# ::edge	behave-01	ARG1	same-01	b	s	
# ::edge	same-01	ARG1	char	s	c	
# ::edge	same-01	ARG2	one	s	o	
# ::edge	one	ARG1-of	include-91	o	i	
# ::edge	include-91	ARG2	char	i	c	
(r / recommend-01
    :ARG1 (d / define-01
        :ARG1 (t / type
            :mod (c / char))
        :ARG1-of (e3 / explicit-03)
        :ARG2 (o2 / or
            :op1 (c2 / char
                :ARG1-of (s2 / sign-01))
            :op2 (c3 / char,
                :ARG1-of (s3 / sign-01
                    :polarity -)))
        :concession (e / even-if
            :op1 (b / behave-01
                :ARG0 c
                :ARG1 (s / same-01
                    :ARG1 c
                    :ARG2 (o / one
                        :ARG1-of (i / include-91
                            :ARG2 c))
                    :mod (e2 / exact))))
        :time (a / always)))

# ::tok If the 'signed' or 'unsigned' modifier is not explicitly declared, these options are used to define a bitfield or unsigned bitfield.
# ::node	o2	or	3-4
# ::node	m	modifier	5-6
# ::node	m2	modifier	5-6
# ::node	0	-	7-8
# ::node	1	-	7-8
