            :op4 3)))

# ::tok First byte 0xA8~0xA9 Double byte 5 zone: 192 bits
# ::node	o	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b2	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8~0xA9	2-3
# ::node	d	double-01	3-4
# ::node	b3	byte	4-5
# ::node	3	5	5-6
