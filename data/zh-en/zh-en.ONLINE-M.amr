# ::edge	bit	quant	192	b	2	
# ::edge	zone:	quant	bit	z	b	
# ::edge	zone:	rel	byte	z	b2	
# ::edge	zone:	rel	name	z	n	
(z / "zone:"
    :quant (b / bit
        :quant 192)
    :domain (b3 / byte
        :ARG1-of (d / double-01))
    :mod 5
    :rel (b2 / byte
        :ord (o / ordinal-entity
            :value 1))
    :rel (n / name
        :op1 "0xA8~0xA9"))

