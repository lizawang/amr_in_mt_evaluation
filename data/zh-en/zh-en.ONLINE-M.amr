        :op1 (c / call-02)
        :op2 (h / hang-up-03
            :ARG1 (p2 / phone)
            :ARG1 (a2 / and
                :duration-of (r / release-01)
                :op1 h
                :op2 (p / pause-01)
                :op3 (p7 / press-01
                    :ARG1-of (l / long-03)
                    :time (a / about
                        :op1 (t / temporal-quantity
                            :quant 1
                            :unit (s / second)))))))
    :rel (s2 / slash
        :op1 (p3 / play-11)
        :op2 p))

# ::tok When calling, when refusing to listen to the phone call, switch to the headset / mobile phone to listen to Jane double tap
# ::node	r	refuse-01	3-4
# ::node	l	listen-01	5-6
