# ::edge	show-01	ARG1	allocate-01	s	a	
# ::edge	show-01	ARG0	figure	s	f	
# ::edge	figure	mod	2.	f	0	
(s / show-01
    :ARG0 (f / figure
        :mod 2.)
    :ARG1 (a / allocate-01
        :ARG1 (b / bit
            :ARG1-of (s2 / single-02)
            :part-of (c / code))))

# ::tok Allocation of code points in the two-word part
# ::node	a	allocate-01	0-1
# ::node	c	code	2-3
# ::node	p2	point	3-4
# ::node	0	2	6-7
# ::node	p	part	7-8
# ::root	a	allocate-01
