(p / product
    :name (n / name
        :op1 13000)
    :beneficiary (a / and
        :op1 (c2 / country
            :name (n2 / name
                :op1 "Enku,"))
        :op2 (c3 / country
            :mod (o / other))
        :op3 (c4 / "country"
            :mod (o2 / other))
        :op4 (r / region
            :mod o2))
    :rel (c / country
        :name (n3 / name
            :op1 c4))
    :rel (i / Vietnam))

