# ::node	d	declare-02	9-10
# ::node	t	this	10-11
# ::node	o	option	11-12
# ::node	u	use-01	13-14
# ::node	d2	define-01	15-16
# ::node	b	bitfield	17-18
# ::node	b2	bitfield	17-18
# ::node	o3	or	18-19
# ::node	s	sign-01	19-20
# ::node	s2	sign-01	19-20
# ::node	b3	bitfield.	20-21
# ::root	u	use-01
# ::edge	or	op1	modifier	o2	m	
# ::edge	or	op2	modifier	o2	m2	
# ::edge	explicit-03	polarity	-	e	1	
# ::edge	declare-02	ARG1-of	explicit-03	d	e	
# ::edge	declare-02	polarity	or	d	o2	
# ::edge	declare-02	ARG1	or	d	o2	
# ::edge	option	mod	this	o	t	
# ::edge	use-01	ARG1	option	u	o	
# ::edge	use-01	condition	declare-02	u	d	
# ::edge	use-01	ARG2	define-01	u	d2	
# ::edge	or	op2	bitfield	o3	b2	
# ::edge	or	op1	bitfield	o3	b	
# ::edge	define-01	ARG1	or	d2	o3	
# ::edge	modifier	ARG1-of	sign-01	m2	s	
# ::edge	sign-01	polarity	-	s	0	
# ::edge	sign-01	polarity	bitfield	s2	b2	
# ::edge	bitfield.	ARG1-of	sign-01	b3	s2	
# ::edge	bitfield	mod	bitfield.	b2	b3	
(u / use-01
    :ARG1 (o / option
        :mod (t / this))
    :ARG2 (d2 / define-01
        :ARG1 (o3 / or
            :op1 (b / bitfield)
            :op2 (b2 / bitfield
                :mod (b3 / bitfield.
                    :ARG1-of (s2 / sign-01
                        :polarity b2)))))
    :condition (d / declare-02
        :ARG1 (o2 / or
            :op1 (m / modifier)
            :op2 (m2 / modifier
                :ARG1-of (s / sign-01
                    :polarity -)))
        :ARG1-of (e / explicit-03
            :polarity -)
        :polarity o2))

# ::tok By default, bitfields are symbolic because the basic integer types they inherit, such as int, are symbolic, however, if the '-traditional' option is specified, bitfields are always unsigned.
