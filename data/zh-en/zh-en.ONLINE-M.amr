(l / light.
    :ARG0-of (i / indicate-01)
    :mod (h / headline))

# ::tok Single-ear / dual-ear free switch; two headphones are successfully connected to the dual-pin connection; put either headphone back on the charging box off, the other headphone into single-ear mode, re-remove to automatically restore dual-ear mode.
# ::node	s	single-02	0-1
# ::node	s2	slash	1-2
# ::node	d	dual-ear	2-3
# ::node	f	free-04	3-4
# ::node	s4	switch;	4-5
# ::node	0	2	5-6
# ::node	m2	music	6-7
# ::node	m3	music	6-7
# ::node	s3	succeed-01	8-9
# ::node	c2	connect-01	9-10
# ::node	d3	dual-pin	12-13
# ::node	c3	connect-01	13-14
# ::node	p	put-01	14-15
# ::node	p2	put-01	14-15
# ::node	e	either	15-16
# ::node	b	back	17-18
# ::node	c	charge-03	20-21
# ::node	b2	box	21-22
# ::node	a	and	22-23
# ::node	p3	put-01	22-23
# ::node	o	other	24-25
# ::node	r	remove-01	29-30
# ::node	a2	automatic	31-32
# ::node	r2	restore-02	32-33
# ::node	d2	dual-ear	33-34
# ::node	m	mode.	34-35
# ::root	s4	switch;
# ::edge	slash	op1	single-02	s2	s	
# ::edge	slash	op2	dual-ear	s2	d	
# ::edge	free-04	ARG2	slash	f	s2	
# ::edge	switch;	ARG1-of	free-04	s4	f	
# ::edge	music	quant	slash	m2	s2	
# ::edge	connect-01	ARG1-of	succeed-01	c2	s3	
# ::edge	connect-01	ARG1	music	c2	m2	
# ::edge	switch;	domain	connect-01	s4	c2	
# ::edge	connect-01	ARG2	dual-pin	c3	d3	
# ::edge	connect-01	ARG2	connect-01	c2	c3	
# ::edge	put-01	ARG1	music	p2	m3	
# ::edge	music	mod	either	m3	e	
# ::edge	put-01	mod	back	p	b	
# ::edge	box	mod	charge-03	b2	c	
# ::edge	put-01	ARG2	box	p	b2	
# ::edge	and	op2	put-01	a	p2	
# ::edge	and	op1	put-01	a	p	
# ::edge	and	op3	put-01	a	p3	
# ::edge	music	mod	other	m3	o	
# ::edge	and	op4	remove-01	a	r	
# ::edge	remove-01	ARG1	music	r	m3	
# ::edge	restore-02	manner	automatic	r2	a2	
# ::edge	remove-01	purpose	restore-02	r	r2	
# ::edge	mode.	mod	dual-ear	m	d2	
# ::edge	restore-02	ARG1	mode.	r2	m	
# ::edge	switch;	rel	and	s4	a	
# ::edge	switch;	rel	2	s4	0	
(s4 / switch;
    :ARG1-of (f / free-04
        :ARG2 (s2 / slash
            :op1 (s / single-02)
            :op2 (d / dual-ear)))
    :domain (c2 / connect-01
        :ARG1 (m2 / music
            :quant s2)
        :ARG1-of (s3 / succeed-01)
        :ARG2 (c3 / connect-01
            :ARG2 (d3 / dual-pin)))
    :rel (a / and
        :op1 (p / put-01
            :ARG2 (b2 / box
                :mod (c / charge-03))
            :mod (b / back))
        :op2 (p2 / put-01
            :ARG1 (m3 / music
                :mod (e / either)
                :mod (o / other)))
        :op3 (p3 / put-01)
        :op4 (r / remove-01
            :purpose (r2 / restore-02
                :ARG1 (m / mode.
                    :mod (d2 / dual-ear))
                :manner (a2 / automatic))
            :ARG1 m3))
    :rel 2)

# ::tok Manual connection: When the headset is off, turn the two headphones on manually. The white light turns on, then the red and white light flashes, the left and right headset automatically in series, the left / right headset white light flashes slowly, open the device Bluetooth search connection.
