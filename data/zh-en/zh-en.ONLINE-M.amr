# ::edge	use-01	ARG2	plane	u	p	
# ::edge	plane	ARG1-of	correspond-02	p	c4	
# ::edge	correspond-02	ARG2	thing	c4	t	
# ::edge	thing	name	name	t	n	
# ::edge	name	op2	13000,	n	2	
# ::edge	and	op1	use-01	a	u	
# ::edge	order-03	ARG1	character	o	c	
# ::edge	arrange-01	ARG1	order-03	a2	o	
