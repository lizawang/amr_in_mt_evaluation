                        :ARG1-of (m2 / mark-02
                            :ARG1-of (m / mark-02))))
                :mod (f / file))
            :ARG1-of (o2 / order-03
                :ARG2 (l2 / line.
                    :mod (c / command-02)))
            :ARG2 (o / option
                :mod (c3 / connect-01)))))

