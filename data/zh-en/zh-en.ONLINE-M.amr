# ::edge	zone	domain	bit	z	b	
(z / zone
    :ARG1-of (d / define-01)
    :domain (b / bit
        :quant 25000
        :ARG1-of (r / range-01
            :ARG3 (p / phone-number-entity
                :quant 0
                :value 2)
            :ARG4 (s / string-entity
                :value 0
                :value 0))
        :mod (c / code)
        :mod (t / total)))

