(s / step-01
    :ARG2 (c3 / connect-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (o2 / option
                :mod (o3 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :ord (o4 / ordinal-entity
