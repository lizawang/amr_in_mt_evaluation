# ::edge	name	op1	Jane	n	0	
# ::edge	tap	mod	double	t	d	
# ::edge	call-02	mod	tap	c	t	
(s2 / switch-01
    :purpose (l2 / listen-01
        :ARG0 (y / you)
        :ARG1 (c / call-02
            :ARG0 (p / person
                :name (n / name
                    :op1 "Jane"))
            :medium (p2 / phone)
            :mod (t / tap
                :mod (d / double))))
    :ARG0 y
    :ARG2 (s / slash
        :op1 (h / headset)
        :op2 (p3 / phone
            :ARG1-of (m / mobile-02)))
    :time (r / refuse-01
        :ARG0 y
        :ARG1 (l / listen-01
            :ARG1 c)))

