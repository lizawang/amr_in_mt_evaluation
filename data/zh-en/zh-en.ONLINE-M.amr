(s / see-01
    :purpose (a / allocate-01
        :ARG1 (b / bit
            :mod (c / code
                :mod (h / human)))
        :ARG1-of (s2 / specify-01
            :ARG0 (t / table)
            :polarity -)
        :ARG2 (s3 / string-entity
            :value 4))
    :ARG0 (y / you)
    :ARG1 6.3.
    :mode imperative)

