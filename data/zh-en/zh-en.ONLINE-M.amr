(a / allocate-01
    :ARG1 (c / code)
    :part-of (m / market
        :mod (w / word)))

# ::tok The code bits of the single-byte portion are allocated according to the rules of GB/T 11383 and 1989.
# ::node	c	code	1-2
# ::node	b	bit	2-3
# ::node	s	single-byte	5-6
# ::node	p	portion	6-7
# ::node	a2	allocate-01	8-9
# ::node	a	accord-02	9-10
# ::node	r	rule-01	12-13
# ::node	r2	rule-01	12-13
# ::node	l	law	14-15
# ::node	n	name	14-15
# ::node	2	GB/T	14-15
# ::node	0	11383	15-16
# ::node	a3	and	16-17
# ::node	d	date-entity	17-18
# ::node	1	1989.	17-18
# ::root	a2	allocate-01
# ::edge	bit	mod	code	b	c	
# ::edge	portion	mod	single-byte	p	s	
# ::edge	bit	part-of	portion	b	p	
# ::edge	allocate-01	ARG1	bit	a2	b	
# ::edge	allocate-01	ARG1-of	accord-02	a2	a	
# ::edge	rule-01	ARG0	law	r	l	
# ::edge	law	name	name	l	n	
# ::edge	name	op1	GB/T	n	2	
# ::edge	name	op2	11383	n	0	
# ::edge	and	op2	rule-01	a3	r2	
# ::edge	and	op1	rule-01	a3	r	
# ::edge	accord-02	ARG2	and	a	a3	
# ::edge	rule-01	time	date-entity	r2	d	
# ::edge	date-entity	year	1989.	d	1	
(a2 / allocate-01
    :ARG1 (b / bit
        :mod (c / code)
        :part-of (p / portion
            :mod (s / single-byte)))
    :ARG1-of (a / accord-02
        :ARG2 (a3 / and
            :op1 (r / rule-01
                :ARG0 (l / law
                    :name (n / name
                        :op1 "GB/T"
                        :op2 11383)))
            :op2 (r2 / rule-01
                :time (d / date-entity
                    :year 1989.)))))

# ::tok The single-byte code bit allocation is shown in Figure 2.
# ::node	s2	single-02	1-2
# ::node	c	code	2-3
# ::node	b	bit	3-4
# ::node	a	allocate-01	4-5
