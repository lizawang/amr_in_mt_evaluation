# ::edge	accord-02	ARG1	order-03	a	o2	
# ::edge	accord-02	ARG2	chapter	a	c	
# ::edge	chapter	mod	et-cetera	c	e	
(o / obligate-01
    :ARG2 (a / accord-02
        :ARG1 (o2 / order-03
            :ARG1 (c2 / character
                :mod (p / part
                    :quant (s / string-entity
                        :value 4))))
        :ARG2 (c / chapter
            :mod (e / et-cetera))))

