# ::edge	switch-01	ARG0	you	s	y	
# ::edge	switch-01	ARG1	call-02	s	c2	
(a / and
    :op1 (a2 / answer-01
        :ARG0 (y / you)
        :ARG1 (c / call-02
            :ord (o / ordinal-entity
                :value 2))
        :mode imperative)
    :op2 (s / switch-01
        :ARG0 y
        :ARG1 (c2 / call-02)
        :mode imperative))

