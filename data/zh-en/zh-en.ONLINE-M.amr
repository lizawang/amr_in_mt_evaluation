                    :name (n / name
                        :op1 "C")))
            :op2 (t2 / thing
                :name (n4 / name
                    :op1 "MERE")
                :ARG0-of (c2 / compile-01)
                :mod (l2 / language
                    :name (n2 / name
                        :op1 "C++")))))
