# ::edge	name	op4	Multilingual	n	9	
# ::edge	plane	name	name	p	n	
# ::edge	name	op5	Plane	n	10	
# ::edge	character	mod	plane	c	p	
# ::edge	character	mod	all	c	a	
# ::edge	correspond-02	ARG2	character	c4	c	
# ::edge	include-01	polarity	-	i	0	
# ::edge	character	ARG1-of	include-01	c	i	
# ::edge	portion,	mod	two-byte	p2	t2	
# ::edge	include-01	ARG2	portion,	i	p2	
# ::edge	bit	ARG1-of	arrange-01	b	a2	
# ::edge	arrange-01	manner	order-03	a2	o	
# ::edge	correspond-02	ARG2	character	c5	c	
# ::edge	character	ARG1-of	correspond-02	c2	c5	
# ::edge	order-03	ARG1	character	o	c2	
(t / total-01
    :ARG2 (b / bit
        :quant 50400
        :ARG1-of (r / range-01
            :ARG3 (d / date-entity
                :day 30
                :month 3
                :year 2008)
            :ARG4 (d2 / date-entity
                :year 2008))
        :ARG1-of (c4 / correspond-02
            :ARG2 (c / character
                :ARG1-of (i / include-01
                    :ARG2 (p2 / portion,
                        :mod (t2 / two-byte))
                    :polarity -)
                :mod (p / plane
                    :name (n / name
                        :op1 "GB/T"
                        :op2 13000
                        :op3 "Basic"
                        :op4 "Multilingual"
                        :op5 "Plane"))
                :mod (a / all)))
        :ARG1-of (a2 / arrange-01
            :manner (o / order-03
                :ARG1 (c2 / character
                    :ARG1-of (c5 / correspond-02
                        :ARG2 c))))
        :mod (c3 / code)))

# ::tok A total of 1058400 code bits from 0x90308130 to 0xE339FE39 are used for the 16 auxiliary planes corresponding to GB/T 13000, and the character order is arranged exactly in the order of the corresponding code bits of the 16 auxiliary planes of GB/I 13000.
