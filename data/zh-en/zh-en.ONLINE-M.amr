# ::edge	correspond-02	part-of	plane	c5	p3	
# ::edge	name	op1	13000.	n	3	
# ::edge	and	rel	name	a	n2	
(a / and
    :op1 (u / use-01
        :ARG1 (b / bit
            :quant 1058400
            :ARG1-of (r / range-01
                :ARG3 (m / monetary-quantity
                    :mod (d3 / date-interval
                        :op1 (d / date-entity
                            :day 30
                            :month 3
                            :year 2008)
                        :op2 (d2 / date-entity
                            :ARG3-of (h / hyperlink-91)
                            :day 1
                            :month 2
                            :year 2007
                            :year 2003))))
            :ARG2-of (t2 / total-01)
            :mod (c2 / code))
        :ARG2 (p / plane
            :quant 16
            :ARG1-of (c4 / correspond-02
                :ARG2 (t / thing
                    :name (n / name
                        :op1 "13000."
                        :op2 "13000,")
                    :part (p2 / plane
                        :quant 16
                        :mod (a4 / auxiliary))))
            :mod (a3 / auxiliary)))
    :op2 (a2 / arrange-01
        :ARG1 (o / order-03
            :ARG1 (c / character))
        :manner (o2 / order-03
            :ARG1 (b2 / bit
                :ARG1-of (c5 / correspond-02
                    :part-of (p3 / plane
                        :quant 16
                        :mod a4))
                :mod (c3 / code)
                :part-of p2))
        :mod (e / exact))
    :rel (n2 / name))

