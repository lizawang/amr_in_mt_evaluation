# ::node	m	machine	1-2
# ::node	h	have-03	2-3
# ::node	d	default-02	5-6
# ::node	s3	string-entity	6-7
# ::node	t	type.	7-8
# ::node	i	it	8-9
# ::node	p	possible-01	9-10
# ::node	s	sign-01	13-14
# ::node	c	char	14-15
# ::node	o	or	15-16
# ::node	s2	sign-01	17-18
# ::node	c2	char.	18-19
# ::root	p	possible-01
# ::edge	machine	mod	each	m	e	
# ::edge	have-03	ARG0	machine	h	m	
# ::edge	type.	mod	string-entity	t	s3	
# ::edge	type.	ARG1-of	default-02	t	d	
# ::edge	have-03	ARG1	type.	h	t	
# ::edge	type.	poss	machine	t	m	
# ::edge	char	ARG1-of	sign-01	c	s	
# ::edge	or	op1	char	o	c	
# ::edge	possible-01	ARG1	or	p	o	
# ::edge	or	domain	it	o	i	
# ::edge	char.	ARG1-of	sign-01	c2	s2	
# ::edge	or	op2	char.	o	c2	
# ::edge	possible-01	rel	have-03	p	h	
(p / possible-01
    :ARG1 (o / or
        :domain (i / it)
        :op1 (c / char
            :ARG1-of (s / sign-01))
        :op2 (c2 / char.
            :ARG1-of (s2 / sign-01)))
    :rel (h / have-03
        :ARG0 (m / machine
            :mod (e / each))
        :ARG1 (t / type.
            :ARG1-of (d / default-02)
            :mod (s3 / string-entity)
            :poss m)))

# ::tok Ideally, when relying on the symbolic nature of the data, a portable program should always use signed char or unsigned chaz.
# ::node	i	ideal	0-1
# ::node	r2	rely-01	2-3
# ::node	s3	symbolize-01	5-6
# ::node	n	nature	6-7
# ::node	p	portable	11-12
# ::node	p2	program	12-13
# ::node	r	recommend-01	13-14
# ::node	a	always	14-15
# ::node	u	use-01	15-16
# ::node	s	sign-01	16-17
# ::node	c	char	17-18
# ::node	o	or	18-19
# ::node	s2	sign-01	19-20
# ::node	0	-	19-20
# ::node	c2	chaz.	20-21
# ::root	r	recommend-01
# ::edge	nature	ARG1-of	symbolize-01	n	s3	
# ::edge	rely-01	ARG1	nature	r2	n	
# ::edge	program	mod	portable	p2	p	
# ::edge	rely-01	ARG0	program	r2	p2	
# ::edge	recommend-01	time	rely-01	r	r2	
# ::edge	recommend-01	mod	ideal	r	i	
# ::edge	use-01	time	always	u	a	
# ::edge	recommend-01	ARG1	use-01	r	u	
# ::edge	use-01	ARG0	program	u	p2	
# ::edge	char	ARG1-of	sign-01	c	s	
# ::edge	or	op1	char	o	c	
# ::edge	use-01	ARG1	or	u	o	
# ::edge	sign-01	polarity	-	s2	0	
# ::edge	chaz.	ARG1-of	sign-01	c2	s2	
# ::edge	or	op2	chaz.	o	c2	
(r / recommend-01
    :ARG1 (u / use-01
        :ARG0 (p2 / program
            :mod (p / portable))
        :ARG1 (o / or
            :op1 (c / char
                :ARG1-of (s / sign-01))
            :op2 (c2 / chaz.
                :ARG1-of (s2 / sign-01
                    :polarity -)))
        :time (a / always))
    :mod (i / ideal)
    :time (r2 / rely-01
        :ARG0 p2
        :ARG1 (n / nature
            :ARG1-of (s3 / symbolize-01))))

# ::tok But many programs have been written with only simple char, and the period street is a symbolic number (or unsymbolic number, depending on the target machine that wrote the program).
