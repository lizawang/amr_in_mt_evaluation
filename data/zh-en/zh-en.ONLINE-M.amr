# ::edge	allocate-01	ARG1	point	a	p2	
# ::edge	part	quant	2	p	0	
# ::edge	allocate-01	location	part	a	p	
(a / allocate-01
    :ARG1 (p2 / point
        :mod (c / code))
    :location (p / part
        :quant 2))

# ::tok The bit arrangement of the two-byte part is divided into 0x8140~1 0xFE7E and 0x8180 and 0xFEFE, for a total of 23940 code bits.
# ::node	b	bit	1-2
# ::node	a2	arrange-01	2-3
# ::node	t2	two-byte	5-6
# ::node	p	part	6-7
# ::node	d	divide-02	8-9
# ::node	v	value-interval	10-11
# ::node	2	8	10-11
# ::node	1	7	11-12
# ::node	a	and	12-13
# ::node	3	8	13-14
# ::node	t	total-01	18-19
# ::node	0	23940	20-21
# ::node	c	code	21-22
# ::node	b2	bit	22-23
# ::node	b3	bit	22-23
# ::root	d	divide-02
# ::edge	bit	ARG1-of	arrange-01	b	a2	
# ::edge	part	mod	two-byte	p	t2	
# ::edge	arrange-01	topic	part	a2	p	
# ::edge	divide-02	ARG1	bit	d	b	
