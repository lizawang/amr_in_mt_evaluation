        :purpose (a / and
            :op1 (h / hold-01
                :ARG0 (y / you)
                :ARG1 (c2 / call-02
                    :mod (p2 / previous)))
            :op2 (a2 / answer-01
                :ARG0 y))
        :ARG0 y
        :ARG1 (k / key))
    :rel (o / ordinal-entity
        :value 2)
