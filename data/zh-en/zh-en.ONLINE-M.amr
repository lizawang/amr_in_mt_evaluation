# ::edge	contrast-01	ARG1	symbolize-01	c2	s3	
# ::edge	sign-01	time	always	s	a	
# ::edge	sign-01	polarity	-	s	0	
# ::edge	sign-01	condition	contrast-01	s	c2	
# ::edge	contrast-01	ARG2	sign-01	c2	s	
# ::edge	sign-01	ARG1	field	s	f2	
# ::edge	option	ARG2-of	sign-01	o	s2	
# ::edge	contrast-01	rel	option	c2	o	
# ::edge	contrast-01	rel	type	c2	t	
(c2 / contrast-01
    :ARG1 (s3 / symbolize-01
        :ARG1 (f / field)
        :ARG1-of (c / cause-01))
    :ARG2 (s / sign-01
        :ARG1 (f2 / field)
        :condition c2
        :polarity -
        :time (a / always))
    :rel (o / option
        :ARG2-of (s2 / sign-01))
    :rel (t / type
        :mod (i / integer)
        :mod (b / basic)))

