(s / show-01
    :ARG0 (t / table
        :mod 3.)
    :ARG1 (a / allocate-01
        :ARG1 (c / code
            :quant (s2 / string-entity
                :value 4)
            :mod (h / human))))

# ::tok For four-byte human code bit allocations not specified in Table 3, see 6.3.
