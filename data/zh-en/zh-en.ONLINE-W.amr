# ::edge	program;	time	before	p2	b	
# ::edge	before	op1	process-01	b	p	
# ::edge	before	op2	assemble-01	b	a	
(p2 / program;
    :name (n / name
        :op1 "CXX"
        :op2 "C++")
    :mod (s / source)
    :time (b / before
        :op1 (p / process-01)
        :op2 (a / assemble-01)))

# ::tok .m Objective-C source program; preprocessing, compilation, assembly
# ::node	n	name	0-1
# ::node	1	official	0-1
# ::node	0	Objective-C	1-2
# ::node	s	source	2-3
# ::node	p2	program;	3-4
# ::node	p	process-01	4-5
# ::node	b	before	4-5
# ::node	a	assemble-01	6-7
# ::root	p2	program;
