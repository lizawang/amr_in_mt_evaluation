# ::edge	have-mod-91	ARG1	number	h2	n2	
# ::edge	have-mod-91	ARG2	decimal.	h2	d	
(a / and
    :location (n / number
        :ARG1-of (p / precede-01
            :ARG2 (s / string-entity
                :value 0x))
        :mod (a2 / any))
    :op1 (h / have-mod-91
        :ARG1 n
        :ARG2 (h3 / hexadecimal,))
    :op2 (h2 / have-mod-91
        :ARG1 (n2 / number
            :ARG1-of (p2 / precede-01
                :ARG2 s
                :polarity -)
            :mod (a3 / any))
