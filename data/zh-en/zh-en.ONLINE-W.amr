(s / suffer-01
    :ARG0 (p / plant
        :location (f / facility
            :name (n / name
                :op1 "Fukushima"
                :op2 "Daiichi"))
        :mod (p2 / power
            :mod (n2 / nucleus)))
    :ARG1 (l / leak-01
        :ARG1-of (c / cause-01
            :ARG0 (a / and
                :op1 (e / earthquake)
                :op2 (t / tsunami.)))))

# ::tok The accident was categorized as the most serious level 7 on the International Nuclear Event Scale (INES).
# ::node	a	accident	1-2
# ::node	c	categorize-01	3-4
# ::node	h	have-degree-91	6-7
# ::node	m	most	6-7
