(m / measure-01
    :ARG1 (a3 / amount
        :mod (t2 / trace))
    :ARG2-of (r2 / result-01
        :ARG1 (a / accident,
            :mod (n4 / nucleus)
            :mod (f / facility
                :name (n / name
                    :op1 "Fukushima")))
        :ARG2 (s3 / substance
            :quant a3
            :ARG2-of (i / include-01
                :ARG1 (a4 / and
                    :ARG1-of (h / have-half-life-01
                        :ARG2 (t / temporal-quantity
                            :quant 30))
                    :op1 (s / small-molecule
                        :name (n2 / name
                            :op1 "iodine"))
                    :op2 (s2 / small-molecule
                        :name (n3 / name
                            :op1 "cesium"))))
            :mod (r / radioactive)))
    :location (a2 / all-over
        :op1 (w / world.)))

# ::tok A large number of radioisotopes were released into the Pacific Ocean as a result of the nuclear accident.
