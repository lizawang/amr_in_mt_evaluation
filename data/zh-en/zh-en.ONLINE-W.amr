# ::edge	file	ARG1-of	process-01	f	p	
# ::edge	and	op1	file	a	f	
# ::edge	and	op2	assemble-02	a	a2	
(a / and
    :op1 (f / file
        :ARG1-of (p / process-01
            :ARG0 .i))
    :op2 (a2 / assemble-02))

# ::tok .ii Preprocessed c++ files; compile, assembly
# ::node	p	process-01	1-2
# ::node	l	language	2-3
# ::node	n	name	2-3
# ::node	0	c++	2-3
# ::node	f	file	3-4
# ::node	a	and	4-5
# ::node	a2	assemble-02	5-6
