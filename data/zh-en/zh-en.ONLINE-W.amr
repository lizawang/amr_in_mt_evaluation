# ::edge	categorize-01	ARG2	level	c	l	
# ::edge	level	quant	seismic-quantity	l	s2	
# ::edge	seismic-quantity	quant	7	s2	0	
# ::edge	level	scale	scale	l	s	
# ::edge	name	op4	Scale	n	4	
# ::edge	scale	name	name	s	n	
# ::edge	name	op3	Event	n	1	
# ::edge	name	op2	Nuclear	n	3	
# ::edge	name	op1	International	n	2	
(c / categorize-01
    :ARG1 (a / accident)
    :ARG2 (l / level
        :quant (s2 / seismic-quantity
            :quant 7)
        :ARG1-of (h / have-degree-91
            :ARG2 (s3 / serious-02
                :ARG1 l)
            :ARG3 (m / most))
        :scale (s / scale
            :name (n / name
                :op1 "International"
                :op2 "Nuclear"
                :op3 "Event"
                :op4 "Scale"))))

