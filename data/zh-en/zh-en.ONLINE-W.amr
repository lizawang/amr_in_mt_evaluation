(o / obligate-01
    :ARG2 (p2 / provide-01
        :ARG0 (p / product
            :ARG1-of (c2 / conform-01
                :ARG2 (l / level
                    :ARG1-of (c3 / correspond-02)
                    :mod (r2 / realize-02)))
            :mod (s / software
                :mod (s2 / system)))
        :ARG1 (a2 / and
            :ARG1-of (r / range-01)
            :op1 (f / function-01
                :mod (i / input))
            :op2 (f2 / function-01
                :ARG0 (c / character
                    :mod (a / all))
                :mod (o2 / output)))))

