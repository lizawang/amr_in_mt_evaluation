# ::edge	area	consist-of	byte	a2	b2	
# ::edge	area	domain	and	a2	a	
# ::edge	and	op2	byte	a	b3	
# ::edge	and	op1	byte	a	b2	
# ::edge	bit	mod	code	b	c	
# ::edge	bit	quant	192	b	2	
# ::edge	and	op2	bit	a	b	
# ::edge	area	rel	name	a2	n	
(a2 / area
    :consist-of (b2 / byte
        :ord (o / ordinal-entity
            :value 1))
    :domain (a / and
        :op1 b2
        :op2 (b3 / byte
            :ARG1-of (d / double-01)
            :mod 5)
        :op2 (b / bit
            :quant 192
            :mod (c / code)))
    :mod b3
    :rel (n / name
        :op1 "0xA8~0xA9"))

