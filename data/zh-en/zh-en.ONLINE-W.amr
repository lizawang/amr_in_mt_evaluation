# ::edge	name	op2	Objective-C	n	0	
# ::edge	program;	mod	source	p2	s	
# ::edge	program;	name	name	p2	n	
# ::edge	process-01	time	before	p	b	
# ::edge	before	op1	assemble-01	b	a	
# ::edge	program;	rel	process-01	p2	p	
(p2 / program;
    :name (n / name
        :op1 "official"
        :op2 "Objective-C")
    :mod (s / source)
    :rel (p / process-01
        :time (b / before
            :op1 (a / assemble-01))))

# ::tok .i Preprocessed c-file; compilation, assembly
# ::node	0	.i	0-1
# ::node	p	process-01	1-2
# ::node	f	file	2-3
# ::node	a	and	3-4
# ::node	a2	assemble-02	4-5
