                :op2 18030
                :op3 "I")
            :ARG1-of (c4 / correspond-02
                :ARG2 p2)))
    :location (d / document
        :mod (t / this))
    :part-of (c / chapter
        :mod (p5 / publication
            :name (n3 / name
                :op1 "D).")))
    :rel (g / governor
