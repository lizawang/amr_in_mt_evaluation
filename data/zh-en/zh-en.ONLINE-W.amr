        :manner (h / hexadecimal,))
    :op2 (e2 / express-01
        :ARG1 (n / number
            :mod (o / other)
            :mod (a2 / all))
        :ARG2 (d / decimal.)))

# ::tok The single-byte part adopts the coding structure of GB/T 11383-1989, using 0x00~0x7F code bits.
# ::node	s	single-byte	1-2
# ::node	p	part	2-3
# ::node	a	adopt-01	3-4
# ::node	c2	code-01	5-6
