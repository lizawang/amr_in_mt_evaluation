    :ARG1 (s / sign-01
        :ARG1 (f / field)
        :ARG1-of (c / cause-01))
    :ARG2 (s2 / sign-01
        :ARG1 (f2 / field)
        :example (s3 / sign-01)
        :polarity -
        :time (a / always))
    :rel (t / type
        :ARG1-of (i / inherit-01
            :ARG0 f)
        :example (i2 / int,)
        :mod (i3 / integer)
        :mod (b / basic))
