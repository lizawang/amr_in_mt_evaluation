(a / and
    :location (z / zone
        :mod (d / distance-quantity
            :quant 6080
            :unit (y / yard)))
    :op1 (s / ship
        :name (n / name
            :op1 "SS"
            :op2 "WA"))
    :op2 (l / location
        :name (n2 / name
            :op1 "RS"
            :op2 "Twinning"
            :op3 "Section,")))

# ::tok First byte 0xA8~0xA9 Double byte 5 area : 192 code bits
# ::node	o	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b2	byte	1-2
# ::node	n	name	2-3
# ::node	0	0xA8~0xA9	2-3
# ::node	d	double-01	3-4
# ::node	b3	byte	4-5
# ::node	3	5	5-6
# ::node	a2	area	6-7
# ::node	a	and	7-8
# ::node	2	192	8-9
# ::node	c	code	9-10
# ::node	b	bit	10-11
# ::root	a2	area
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	byte	ord	ordinal-entity	b2	o	
# ::edge	name	op1	0xA8~0xA9	n	0	
# ::edge	byte	ARG1-of	double-01	b3	d	
# ::edge	byte	mod	5	b3	3	
