# ::edge	consider-01	ARG0	product	c	p3	
# ::edge	file	ARG1-of	process-01	f	p2	
# ::edge	consider-01	ARG1	file	c	f	
# ::edge	product	name	name	p4	n2	
# ::edge	name	op1	c++	n2	0	
# ::edge	file	mod	product	f2	p4	
# ::edge	consider-01	ARG2	file	c	f2	
# ::edge	and	op1	consider-01	a	c	
# ::edge	and	op2	set-up-03	a	s	
# ::edge	set-up-03	ARG0	product	s	p3	
# ::edge	set-up-03	ARG1	join-01	s	j	
# ::edge	join-01	ARG1-of	possible-01	j	p	
(a / and
    :op1 (c / consider-01
        :ARG0 (p3 / product
            :name (n / name
                :op1 "g++"))
        :ARG1 (f / file
            :ARG1-of (p2 / process-01))
        :ARG2 (f2 / file
            :mod (p4 / product
                :name (n2 / name
                    :op1 "c++"))))
    :op2 (s / set-up-03
        :ARG0 p3
        :ARG1 (j / join-01
            :ARG1-of (p / possible-01))))

# ::tok The source file's post-level name indicates the language type and the post-processing.
# ::node	s	source	1-2
# ::node	f	file's	2-3
# ::node	p	post-level	3-4
# ::node	n	name	4-5
# ::node	i	indicate-01	5-6
# ::node	l	language	7-8
# ::node	t	type-03	8-9
# ::node	a	and	9-10
# ::node	p2	process-01	11-12
# ::root	i	indicate-01
# ::edge	file's	mod	source	f	s	
# ::edge	name	mod	post-level	n	p	
# ::edge	name	poss	file's	n	f	
# ::edge	indicate-01	ARG0	name	i	n	
# ::edge	type-03	ARG2	language	t	l	
# ::edge	and	op1	type-03	a	t	
# ::edge	indicate-01	ARG1	and	i	a	
# ::edge	and	op2	process-01	a	p2	
(i / indicate-01
    :ARG0 (n / name
        :mod (p / post-level)
        :poss (f / file's
            :mod (s / source)))
    :ARG1 (a / and
        :op1 (t / type-03
            :ARG2 (l / language))
        :op2 (p2 / process-01)))

# ::tok .c C source program; preprocessing, compilation, assembly
# ::node	s2	string-entity	0-1
# ::node	0	C.	0-1
# ::node	s	source-02	2-3
# ::node	p2	program;	3-4
# ::node	p	process-01	4-5
# ::node	b	before	4-5
# ::node	a	assemble-01	6-7
# ::root	s2	string-entity
# ::edge	string-entity	value	C.	s2	0	
# ::edge	program;	ARG0-of	source-02	p2	s	
# ::edge	string-entity	part-of	program;	s2	p2	
# ::edge	process-01	time	before	p	b	
# ::edge	before	op1	assemble-01	b	a	
# ::edge	string-entity	rel	process-01	s2	p	
(s2 / string-entity
    :part-of (p2 / program;
        :ARG0-of (s / source-02))
    :rel (p / process-01
        :time (b / before
            :op1 (a / assemble-01)))
    :value "C.")

# ::tok .C C++ source programs; preprocessing, compilation, assembly
# ::node	n	name	0-1
# ::node	0	.C	0-1
# ::node	l	language	1-2
# ::node	1	C++	1-2
# ::node	s	source-02	2-3
# ::node	p3	program	3-4
# ::node	p	process-01	4-5
# ::node	a	and	5-6
# ::node	p2	process-01	5-6
# ::node	a2	assemble-01	6-7
# ::root	p3	program
# ::edge	name	op1	.C	n	0	
# ::edge	language	name	name	l	n	
# ::edge	name	op2	C++	n	1	
# ::edge	program	ARG0-of	source-02	p3	s	
# ::edge	program	mod	language	p3	l	
# ::edge	and	op1	process-01	a	p	
# ::edge	program	domain	and	p3	a	
# ::edge	and	op2	process-01	a	p2	
# ::edge	and	op3	assemble-01	a	a2	
(p3 / program
    :ARG0-of (s / source-02)
    :domain (a / and
        :op1 (p / process-01)
        :op2 (p2 / process-01)
        :op3 (a2 / assemble-01))
    :mod (l / language
        :name (n / name
            :op1 ".C"
            :op2 "C++")))

# ::tok .cc C++ source program; preprocessing, compilation, assembly
# ::node	n	name	0-1
# ::node	m	more	0-1
# ::node	0	2005	0-1
# ::node	1	C++	1-2
# ::node	s	source	2-3
# ::node	p2	program;	3-4
# ::node	p	process-01	4-5
# ::node	b	before	4-5
# ::node	t	thing	5-6
# ::node	a	assemble-01	6-7
# ::root	p2	program;
# ::edge	name	op1	2005	n	0	
# ::edge	name	op2	C++	n	1	
# ::edge	program;	mod	source	p2	s	
# ::edge	program;	name	name	p2	n	
# ::edge	process-01	time	before	p	b	
# ::edge	thing	ARG1-of	process-01	t	p	
# ::edge	program;	domain	thing	p2	t	
# ::edge	before	op1	assemble-01	b	a	
# ::edge	program;	rel	more	p2	m	
(p2 / program;
    :name (n / name
        :op1 2005
        :op2 "C++")
    :domain (t / thing
        :ARG1-of (p / process-01
            :time (b / before
                :op1 (a / assemble-01))))
    :mod (s / source)
    :rel (m / more))

# ::tok . CXX C++ source program; preprocessing, compilation, assembly
# ::node	n	name	1-2
