(p / program
    :name (n / name
        :op1 "Assembly")
    :ARG0-of (s / source-02
        :ARG1 (l / language)))

# ::tok Assembly language source programs; preprocessing, assembly
# ::node	a	assemble-02	0-1
# ::node	l	language	0-1
# ::node	n	name	0-1
# ::node	0	Assembly	0-1
# ::node	l2	language	1-2
# ::node	s	source-02	2-3
# ::node	p	program	3-4
# ::node	b	before	4-5
# ::node	a2	assemble-02	5-6
# ::root	p	program
# ::edge	language	name	name	l	n	
# ::edge	name	op1	Assembly	n	0	
# ::edge	language	mod	language	l2	l	
# ::edge	source-02	mod	language	s	l2	
# ::edge	program	ARG0-of	source-02	p	s	
# ::edge	assemble-02	time	before	a2	b	
# ::edge	program	mod	assemble-02	p	a2	
# ::edge	program	rel	assemble-02	p	a	
(p / program
    :ARG0-of (s / source-02
        :mod (l2 / language
            :mod (l / language
                :name (n / name
                    :op1 "Assembly"))))
    :mod (a2 / assemble-02
        :time (b / before))
    :rel (a / assemble-02))

# ::tok .h preprocessor files; files that do not normally appear on the command line with other postnames are passed to the Linker. Typically these include.
# ::node	a	amr-empty	0-1
# ::node	b	before	1-2
# ::node	f	file	3-4
# ::node	0	-	6-7
# ::node	n2	normal-02	7-8
# ::node	a2	appear-01	8-9
# ::node	c	command	11-12
# ::node	l	line	12-13
# ::node	o	other	14-15
# ::node	t	thing	15-16
# ::node	p2	post-01	15-16
# ::node	n	name	15-16
# ::node	p	pass-05	17-18
# ::node	p3	product	20-21
# ::node	1	Linker.	20-21
# ::node	t3	typical-02	21-22
# ::node	t2	this	22-23
# ::node	i	include-01	23-24
# ::root	p	pass-05
# ::edge	before	op1	amr-empty	b	a	
# ::edge	appear-01	ARG1-of	normal-02	a2	n2	
# ::edge	appear-01	polarity	-	a2	0	
# ::edge	file	ARG1-of	appear-01	f	a2	
# ::edge	line	mod	command	l	c	
# ::edge	appear-01	location	line	a2	l	
# ::edge	thing	mod	other	t	o	
# ::edge	file	accompanier	thing	f	t	
# ::edge	thing	ARG2-of	post-01	t	p2	
# ::edge	pass-05	ARG1	file	p	f	
# ::edge	pass-05	ARG2	product	p	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	Linker.	n	1	
# ::edge	include-01	ARG1	this	i	t2	
# ::edge	include-01	ARG1-of	typical-02	i	t3	
# ::edge	file	ARG2-of	include-01	f	i	
# ::edge	pass-05	rel	before	p	b	
(p / pass-05
    :ARG1 (f / file
        :ARG1-of (a2 / appear-01
            :ARG1-of (n2 / normal-02)
            :location (l / line
                :mod (c / command))
            :polarity -)
        :ARG2-of (i / include-01
            :ARG1 (t2 / this)
            :ARG1-of (t3 / typical-02))
        :accompanier (t / thing
            :ARG2-of (p2 / post-01)
            :mod (o / other)))
    :ARG2 (p3 / product
        :name (n / name
            :op1 "Linker."))
    :rel (b / before
        :op1 (a / amr-empty)))

# ::tok .0 Object file
# ::node	o	object	1-2
# ::node	f	file	2-3
# ::root	f	file
# ::edge	file	mod	object	f	o	
(f / file
    :mod (o / object))

# ::tok .a Archive file
# ::node	i	internet	1-2
# ::node	f	file	2-3
# ::root	f	file
# ::edge	file	mod	internet	f	i	
(f / file
    :mod (i / internet))

# ::tok Unless the -cec, -s, or -E option is used (or a compilation error prevents the complete process), linking is always the last step.
# ::node	s2	string-entity	2-3
# ::node	o3	or	4-5
# ::node	s3	string-entity	5-6
# ::node	0	-	5-6
# ::node	o2	option	6-7
# ::node	u	use-01	8-9
# ::node	o	(or	9-10
# ::node	c	compile-01	11-12
# ::node	e	err-01	12-13
# ::node	p	prevent-01	13-14
# ::node	c2	complete-02	15-16
# ::node	p2	process-02	16-17
# ::node	l	link-01	17-18
# ::node	a	always	19-20
# ::node	o4	ordinal-entity	21-22
# ::node	1	-1	21-22
# ::node	s	step-01	22-23
# ::root	s	step-01
# ::edge	or	op1	string-entity	o3	s2	
# ::edge	or	op2	string-entity	o3	s3	
# ::edge	string-entity	polarity	-	s3	0	
# ::edge	option	mod	or	o2	o3	
# ::edge	use-01	ARG1	option	u	o2	
# ::edge	(or	op1	use-01	o	u	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	(or	op2	prevent-01	o	p	
# ::edge	process-02	ARG1-of	complete-02	p2	c2	
# ::edge	prevent-01	ARG1	process-02	p	p2	
# ::edge	ordinal-entity	value	-1	o4	1	
# ::edge	step-01	ord	ordinal-entity	s	o4	
# ::edge	step-01	time	always	s	a	
# ::edge	step-01	ARG2	link-01	s	l	
# ::edge	step-01	condition	(or	s	o	
(s / step-01
    :ARG2 (l / link-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (o2 / option
                :mod (o3 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :ord (o4 / ordinal-entity
        :value -1)
    :time (a / always))

# ::tok During the linking phase, all .e files corresponding to the source program, -1 library files, and unrecognizable filenames (including specified .o H files and .a library files) are passed to the connector options in the order they appear on the command line.
# ::node	l4	link-01	2-3
# ::node	p2	phase,	3-4
# ::node	a	all	4-5
# ::node	f	file	6-7
# ::node	c3	correspond-02	7-8
# ::node	s	source	10-11
# ::node	p3	program,	11-12
# ::node	n	name	12-13
# ::node	0	-	12-13
# ::node	l	library	13-14
# ::node	a2	and	15-16
# ::node	r	recognize-02	16-17
# ::node	n4	number	17-18
# ::node	n3	name-01	17-18
# ::node	s2	specify-01	19-20
# ::node	n2	name	20-21
# ::node	1	H	21-22
# ::node	f2	file	22-23
# ::node	a3	and	23-24
# ::node	l2	library	25-26
# ::node	f3	file	26-27
# ::node	p	pass-05	28-29
# ::node	c2	connect-01	31-32
# ::node	o	option	32-33
# ::node	o2	order-03	35-36
# ::node	a4	appear-01	37-38
# ::node	c	command	40-41
# ::node	l3	line.	41-42
# ::root	p	pass-05
# ::edge	phase,	mod	link-01	p2	l4	
# ::edge	file	mod	all	f	a	
# ::edge	file	ARG1-of	correspond-02	f	c3	
# ::edge	program,	mod	source	p3	s	
# ::edge	correspond-02	ARG2	program,	c3	p3	
# ::edge	and	op1	file	a2	f	
# ::edge	recognize-02	polarity	-	r	0	
# ::edge	number	ARG1-of	recognize-02	n4	r	
# ::edge	and	op2	number	a2	n4	
# ::edge	number	ARG2-of	name-01	n4	n3	
# ::edge	name	op1	H	n2	1	
# ::edge	file	name	name	f2	n2	
# ::edge	file	ARG1-of	specify-01	f2	s2	
# ::edge	and	op1	file	a3	f2	
# ::edge	name-01	ARG1	and	n3	a3	
# ::edge	file	mod	library	f3	l2	
# ::edge	and	op2	file	a3	f3	
# ::edge	pass-05	ARG1	and	p	a2	
# ::edge	pass-05	time	phase,	p	p2	
# ::edge	option	mod	connect-01	o	c2	
# ::edge	pass-05	ARG2	option	p	o	
# ::edge	pass-05	manner	order-03	p	o2	
# ::edge	order-03	ARG2	appear-01	o2	a4	
# ::edge	appear-01	ARG1	and	a4	a2	
# ::edge	line.	mod	command	l3	c	
# ::edge	appear-01	location	line.	a4	l3	
# ::edge	pass-05	rel	name	p	n	
# ::edge	pass-05	rel	library	p	l	
(p / pass-05
    :ARG1 (a2 / and
        :op1 (f / file
            :ARG1-of (c3 / correspond-02
                :ARG2 (p3 / program,
                    :mod (s / source)))
            :mod (a / all))
        :op2 (n4 / number
            :ARG1-of (r / recognize-02
                :polarity -)
            :ARG2-of (n3 / name-01
                :ARG1 (a3 / and
                    :op1 (f2 / file
                        :name (n2 / name
                            :op1 "H")
                        :ARG1-of (s2 / specify-01))
                    :op2 (f3 / file
                        :mod (l2 / library))))))
    :ARG2 (o / option
        :mod (c2 / connect-01))
    :manner (o2 / order-03
        :ARG2 (a4 / appear-01
            :ARG1 a2
            :location (l3 / line.
                :mod (c / command))))
    :rel (n / name)
    :rel (l / library)
    :time (p2 / phase,
        :mod (l4 / link-01)))

# ::tok The options must be given separately : de ' is completely different from `-d -r '.
# ::node	o2	option	1-2
# ::node	o	obligate-01	2-3
# ::node	g	give-01	4-5
# ::node	s	separate-02	5-6
# ::node	s2	string-entity	7-8
# ::node	0	de	7-8
# ::node	c	complete-02	10-11
# ::node	d	differ-02	11-12
# ::node	s3	string-entity	13-14
# ::node	1	de	14-15
# ::root	o	obligate-01
# ::edge	obligate-01	ARG2	give-01	o	g	
# ::edge	give-01	ARG1	option	g	o2	
# ::edge	give-01	manner	separate-02	g	s	
# ::edge	string-entity	value	de	s2	0	
# ::edge	differ-02	ARG1-of	complete-02	d	c	
# ::edge	differ-02	ARG1	string-entity	d	s2	
# ::edge	string-entity	example	differ-02	s2	d	
# ::edge	differ-02	ARG2	string-entity	d	s3	
# ::edge	string-entity	value	de	s3	1	
# ::edge	obligate-01	rel	string-entity	o	s2	
(o / obligate-01
    :ARG2 (g / give-01
        :ARG1 (o2 / option)
        :manner (s / separate-02))
    :rel (s2 / string-entity
        :example (d / differ-02
            :ARG1 s2
            :ARG1-of (c / complete-02)
            :ARG2 (s3 / string-entity
                :value "de"))
        :value "de"))

# ::tok Most ` -=E :and `-W' options have two opposite formats : -fname and -fno-name (or -Wname and -Wno- name).
# ::node	m	most	0-1
# ::node	n	name	2-3
# ::node	1	2	2-3
# ::node	2	2	2-3
# ::node	a	and	3-4
# ::node	o2	option	5-6
# ::node	o3	option	5-6
# ::node	h	have-03	6-7
# ::node	o	opposite-01	8-9
# ::node	f	format	9-10
# ::node	s	string-entity	11-12
# ::node	3	2	11-12
# ::node	f2	format	12-13
# ::node	s2	string-entity	13-14
# ::node	s3	string-entity	13-14
# ::node	a2	and	16-17
# ::node	s4	string-entity	17-18
# ::node	0	-	17-18
# ::root	h	have-03
# ::edge	and	op1	2	a	1	
# ::edge	and	op2	option	a	o2	
# ::edge	option	quant	name	o2	n	
# ::edge	and	op2	option	a	o3	
# ::edge	option	quant	2	o3	1	
# ::edge	have-03	ARG0	option	h	o2	
# ::edge	format	ARG1-of	opposite-01	f	o	
# ::edge	have-03	ARG1	format	h	f	
# ::edge	and	op1	string-entity	a	s	
# ::edge	format	domain	2	f2	3	
