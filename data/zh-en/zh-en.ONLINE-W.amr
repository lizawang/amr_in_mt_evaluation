# ::edge	name	op1	GB/T	n	5	
# ::edge	product	time	date-interval	p2	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	13	d	2	
# ::edge	date-entity	month	2	d	3	
# ::edge	date-entity	year	2003	d	4	
# ::edge	adopt-01	ARG2-of	use-01	a	u	
# ::edge	value-interval	op1	0	v	0	
# ::edge	value-interval	op2	0	v	1	
# ::edge	bit	mod	code	b	c	
# ::edge	bit	quant	value-interval	b	v	
# ::edge	use-01	ARG1	bit	u	b	
(a / adopt-01
    :ARG0 (p / part
        :mod (s / single-byte))
    :ARG1 (s2 / structure
        :mod (c2 / code-01)
        :poss (p2 / product
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 13
                    :month 2
                    :year 2003)
                :op2 (d2 / date-entity))))
    :ARG2-of (u / use-01
        :ARG1 (b / bit
            :quant (v / value-interval
                :op1 0
                :op2 0)
            :mod (c / code))))

