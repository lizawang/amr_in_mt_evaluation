# ::edge	file	ARG1-of	process-01	f	p	
# ::edge	and	op2	file	a	f	
# ::edge	and	op3	assemble-02	a	a2	
(a / and
    :op2 (f / file
        :ARG1-of (p / process-01)
        :mod (l / language
            :name (n / name
                :op1 "c++")))
    :op3 (a2 / assemble-02))

# ::tok .s Assembly language source programs; assembly
# ::node	n	name	1-2
# ::node	0	Assembly	1-2
# ::node	l	language	2-3
# ::node	s	source-02	3-4
# ::node	p	program	4-5
# ::root	p	program
