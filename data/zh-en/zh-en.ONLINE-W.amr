                :location (p2 / product
                    :name (n / name
                        :op1 "GB/I")
                    :time (d3 / date-interval
                        :op1 (d / date-entity
                            :year 2007)
                        :op2 (d2 / date-entity
                            :year 2009)))
                :polarity -)
            :op1 (s2 / string-entity
                :value 0x30)
            :op2 (s3 / string-entity
                :value 0x39,))
        :ARG2 (s4 / suffix))
    :op2 (r / range-01
        :ARG1 (e / encode-01
