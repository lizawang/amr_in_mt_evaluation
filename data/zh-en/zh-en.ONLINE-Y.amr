        :mod (c / code)
        :part-of (p / portion
            :mod (s / single-byte)))
    :ARG1-of (c2 / conform-01
        :ARG2 (r / rule
            :mod (l / law
                :name (n / name
                    :op1 "GB/T"
                    :op2 11383)
                :time (d / date-entity
                    :year 1989.)))))

