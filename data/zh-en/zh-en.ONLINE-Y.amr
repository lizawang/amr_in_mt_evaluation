# ::edge	product	name	name	p2	n	
# ::edge	name	op2	18030	n	1	
# ::edge	name	op3	I	n	5	
# ::edge	code	mod	some	c2	s	
# ::edge	location	mod	code	l2	c2	
# ::edge	letter	location	location	l	l2	
# ::edge	and-or	op1	letter	a2	l	
# ::edge	correspond-02	ARG2	product	c5	p2	
# ::edge	product	name	name	p3	n2	
# ::edge	name	op1	border	n	6	
# ::edge	name	op2	GB/TI	n2	4	
# ::edge	name	op3	13000	n2	0	
# ::edge	code	mod	product	c3	p3	
# ::edge	position	mod	code	p	c3	
# ::edge	position	ARG1-of	correspond-02	p	c5	
# ::edge	and-or	op2	position	a2	p	
# ::edge	adjust-01	ARG1	and-or	a	a2	
