    :rel (s4 / string-entity
        :value 0x7E
        :value 0
        :value 0)
    :rel (a2 / and
        :op1 (s3 / string-entity
            :value 0x81)
        :op2 (a / and
            :op1 (b3 / byte
                :mod s3
                :ord (o / ordinal-entity
                    :value 1))
            :op2 (b4 / byte
                :mod (l / last))))
