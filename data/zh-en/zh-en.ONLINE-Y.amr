# ::tok A total of 25200 code bits from 0xFD308130 to 0xFE39FE39 are user-defined zones.
# ::node	t	total	1-2
# ::node	4	25200	3-4
# ::node	c	code	4-5
# ::node	b	bit	5-6
# ::node	r	range-01	6-7
# ::node	p	phone-number-entity	7-8
# ::node	2	2	7-8
# ::node	0	0	7-8
# ::node	l	location	9-10
# ::node	n	name	9-10
# ::node	3	2	9-10
# ::node	1	0	9-10
# ::node	d	define-01	11-12
# ::node	z	zone	12-13
# ::root	z	zone
# ::edge	bit	mod	code	b	c	
# ::edge	bit	quant	25200	b	4	
# ::edge	bit	quant	total	b	t	
# ::edge	bit	ARG1-of	range-01	b	r	
# ::edge	range-01	ARG3	phone-number-entity	r	p	
# ::edge	phone-number-entity	value	2	p	2	
# ::edge	phone-number-entity	value	0	p	0	
# ::edge	range-01	ARG4	location	r	l	
# ::edge	location	name	name	l	n	
# ::edge	location	quant	2	l	3	
# ::edge	location	quant	0	l	1	
# ::edge	zone	ARG1-of	define-01	z	d	
# ::edge	zone	domain	bit	z	b	
(z / zone
    :ARG1-of (d / define-01)
    :domain (b / bit
        :quant 25200
        :quant (t / total)
        :ARG1-of (r / range-01
            :ARG3 (p / phone-number-entity
                :value 2
                :value 0)
            :ARG4 (l / location
                :name (n / name)
                :quant 2
                :quant 0))
        :mod (c / code)))

# ::tok Other unoccupied four-byte code bits are reserved, and leave marks are used for future file extensions.
# ::node	o2	other	0-1
# ::node	o	occupy-01	1-2
# ::node	s	string-entity	2-3
# ::node	1	4	2-3
# ::node	c	code	3-4
# ::node	b	bit	4-5
# ::node	0	-	4-5
# ::node	r	reserve-01	6-7
# ::node	a	and	7-8
# ::node	l	leave-12	8-9
# ::node	m	mark	9-10
# ::node	u	use-01	11-12
# ::node	f2	future	13-14
# ::node	f	file	14-15
# ::node	e	extend-01	15-16
# ::root	a	and
# ::edge	string-entity	value	4	s	1	
# ::edge	bit	mod	code	b	c	
# ::edge	bit	mod	string-entity	b	s	
# ::edge	bit	ARG1-of	occupy-01	b	o	
# ::edge	bit	mod	other	b	o2	
# ::edge	occupy-01	polarity	-	o	0	
# ::edge	reserve-01	ARG1	bit	r	b	
# ::edge	and	op1	reserve-01	a	r	
# ::edge	mark	ARG2-of	leave-12	m	l	
# ::edge	use-01	ARG1	mark	u	m	
# ::edge	and	op2	use-01	a	u	
# ::edge	extend-01	ARG1	file	e	f	
# ::edge	extend-01	time	future	e	f2	
# ::edge	use-01	ARG2	extend-01	u	e	
(a / and
    :op1 (r / reserve-01
        :ARG1 (b / bit
            :ARG1-of (o / occupy-01
                :polarity -)
            :mod (c / code)
            :mod (s / string-entity
                :value 4)
            :mod (o2 / other)))
    :op2 (u / use-01
        :ARG1 (m / mark
            :ARG2-of (l / leave-12))
        :ARG2 (e / extend-01
            :ARG1 (f / file)
            :time (f2 / future))))

