# ::node	a	and	11-12
# ::node	e	establish-01	12-13
# ::node	s2	string-entity	14-15
# ::node	c	connect-01	15-16
# ::root	a	and
# ::edge	person	name	name	p	n	
# ::edge	name	op1	gcc	n	1	
# ::edge	believe-01	ARG0	person	b	p	
# ::edge	file	ARG1-of	process-01	f	p2	
# ::edge	string-entity	value	c	s	0	
