# ::edge	and	op2	establish-01	a	e	
# ::edge	establish-01	ARG0	person	e	p	
# ::edge	connect-01	ARG2	string-entity	c	s2	
# ::edge	establish-01	ARG1	connect-01	e	c	
# ::edge	connect-01	ARG1	string-entity	c	s	
# ::edge	and	rel	file	a	f	
(a / and
    :op1 (b / believe-01
        :ARG0 (p / person
            :name (n / name
                :op1 "gcc")))
    :op2 (e / establish-01
        :ARG0 p
        :ARG1 (c / connect-01
            :ARG1 (s / string-entity
                :value "c")
            :ARG2 (s2 / string-entity)))
    :rel (f / file
        :ARG1-of (p2 / process-01)))

# ::tok g++ considers the preprocessed file (.i) to be a C++ file, and establishes a c++-style connection.
# ::node	p2	product	0-1
