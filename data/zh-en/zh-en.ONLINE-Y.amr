                :mod s)))
    :ARG2 (c2 / control-01
        :ARG0 (n / name
            :mod (l2 / last))
        :ARG1 (t / thing
            :name (n2 / name)
            :ARG1-of (d / default-01))))

# ::tok gcc believes that the preprocessed file (.i) is a c file, and establishes a c-form connection,
# ::node	p	person	0-1
# ::node	n	name	0-1
# ::node	1	gcc	0-1
# ::node	b	believe-01	1-2
# ::node	p2	process-01	4-5
