(c4 / connect-01
    :ARG2 (m / move-01
        :quant 10
        :ARG0 (y / you)
        :ARG1 (c / case
            :quant 2)
        :mode imperative
        :source (o / outside
            :part-of (c2 / case.
                :ARG0-of (c3 / charge-03))))
    :manner (a / automatic))

# ::tok The two elder surgeons automatically start, and the white light comes on.
