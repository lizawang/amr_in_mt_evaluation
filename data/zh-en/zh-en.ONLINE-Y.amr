# ::edge	chapter	name	name	c	n3	
# ::edge	name	op1	Appendix	n3	2	
# ::edge	name	op2	D).	n3	3	
(a / adjust-01
    :ARG1 (a2 / and-or
        :op1 (l / letter
            :location (l2 / location
                :mod (c2 / code
                    :mod (s / some))))
        :op2 (p / position
            :ARG1-of (c5 / correspond-02
                :ARG2 (p2 / product
                    :name (n / name
                        :op1 "border"
                        :op2 18030
                        :op3 "I")))
            :mod (c3 / code
                :mod (p3 / product
                    :name (n2 / name
                        :op2 "GB/TI"
                        :op3 13000)))))
    :ARG1-of (c4 / compare-01
        :ARG2 p2)
    :location (f / file
        :mod (t / this))
    :part-of (c / chapter
        :name (n3 / name
            :op1 "Appendix"
            :op2 "D).")))

