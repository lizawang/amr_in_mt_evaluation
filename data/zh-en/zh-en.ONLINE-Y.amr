(b2 / bit
    :quant 50400
    :ARG1-of (c3 / correspond-02
        :ARG2 (p2 / portion
            :mod (d4 / double-byte)
            :part-of (p3 / product
                :name (n / name
                    :op1 "GB/T"
                    :op2 13000))))
    :ARG1-of (a / arrange-01
        :manner (o / order-03
            :ARG1 (c / character
                :ARG1-of (c4 / correspond-02
                    :ARG2 (p / plane.
                        :mod (m / multilingual)
                        :mod (b / basic))))))
    :ARG2-of (t / total-01)
