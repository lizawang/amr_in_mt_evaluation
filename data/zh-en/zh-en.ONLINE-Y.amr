# ::edge	press-01	ARG1	button	p	b	
# ::edge	and	duration	about	a2	a	
# ::edge	about	op1	temporal-quantity	a	t	
# ::edge	temporal-quantity	quant	5	t	1	
# ::edge	temporal-quantity	unit	second	t	s	
# ::edge	light	ARG1-of	red-02	l	r	
# ::edge	on-01	ARG1	light	o	l	
