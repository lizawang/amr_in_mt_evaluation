(o / obligate-01
    :ARG2 (p2 / provide-01
        :ARG0 (p / product
            :ARG0-of (m / meet-01
                :ARG1 (l / level
                    :ARG1-of (c2 / correspond-02)
                    :mod (i / implement-01)))
            :mod (s / software
                :mod (s2 / system)))
        :ARG1 (a2 / and
            :op1 (f / function-01
                :mod (i2 / input))
            :op2 (f2 / function-01
                :mod (o2 / output)))
        :ARG2 (c / character
            :mod (a / all))))

