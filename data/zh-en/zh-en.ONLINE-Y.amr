# ::edge	and	rel	system	a2	s3	
(a2 / and
    :duration (a / about
        :op1 (t / temporal-quantity
            :quant 5
            :unit (s / second)))
    :op1 (p / press-01
        :ARG0 (y / you)
        :ARG1 (b / button
            :purpose (m / multi-sentence))
        :mode imperative)
    :op2 (h / hold-01
        :ARG0 y
        :ARG1 b
        :mode imperative)
    :rel (m2 / multi-sentence
        :snt2 (o / on-01
            :ARG1 (l / light
                :ARG1-of (r / red-02))
            :duration (t2 / temporal-quantity
                :quant 2
                :unit (s2 / second))))
    :rel (m3 / multi-sentence)
    :rel (s3 / system))

# ::tok Press for about 5 seconds
