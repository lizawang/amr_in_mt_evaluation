(i / include-01
    :ARG1 (a3 / and
        :op1 (c / character
            :location (a2 / and
                :op1 (p / publication
                    :name (n / name
                        :op1 "CJK"))
                :op2 (c2 / character
                    :ARG2-of (u / unify-01)
                    :mod (c4 / country
                        :name (n2 / name
                            :op1 "Chinese")))
                :op2 (p2 / publication
                    :name (n3 / name
                        :op1 "GB/T"
                        :op2 2312
                        :op2 "13000,")))
            :mod (g / graphic)
            :mod (a / all))
        :op2 (c3 / character
            :quant (s2 / some)
            :mod (g2 / graphic)))
    :ARG2 (s / section
        :mod (d / double-byte)))

