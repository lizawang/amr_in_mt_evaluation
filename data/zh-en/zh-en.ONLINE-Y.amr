# ::edge	name	op2	Vietnam,	n3	5	
# ::edge	and	op3	et-cetera	a2	e	
# ::edge	code	rel	name	c2	n3	
(c2 / code
    :ARG1-of (u / unify-01)
    :beneficiary (c / character
        :ARG1-of (u2 / use-01
            :location (a / and
                :op1 (c4 / country
                    :example (a2 / and
                        :op1 (c5 / country
                            :name (n2 / name
                                :op1 "China,"))
                        :op3 (e / et-cetera)))
                :op2 (r / region)))
        :mod (c3 / country
            :name (n / name
                :op1 "China")))
    :domain (s / string-entity
        :value "GB/T"
        :value 13000)
    :rel (n3 / name
        :op1 "Nguk,"
        :op2 "Vietnam,"))

