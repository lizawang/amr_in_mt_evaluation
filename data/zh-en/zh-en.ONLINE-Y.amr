            :ARG1-of (c4 / correspond-02
                :ARG2 (p3 / program,
                    :mod (s / source)))
            :mod (a / all))
        :op2 (n2 / name
            :ARG1-of (r / recognize-02
                :polarity -)
            :mod (f2 / file)
            :mod (l3 / library))
        :op3 (f3 / file
            :ARG1-of (l / label-01
                :ARG2 (s3 / system
                    :name (n / name)))))
    :ARG1-of (o2 / order-03
        :location (l4 / line
            :mod (c / command-02)))
    :ARG2 (o / option
        :mod (c3 / connect-01))
    :rel (l2 / library
        :mod (s2 / string-entity
            :op1 H))
    :time (p2 / phase,
        :mod (c2 / connect-01)))

# ::tok The options must be given separately: de 'is completely different from `-d -r'.
# ::node	o2	option	1-2
# ::node	o	obligate-01	2-3
# ::node	g	give-01	4-5
# ::node	0	de	6-7
# ::node	c	complete-02	8-9
