# ::edge	use-01	rel	product	u	p2	
(u / use-01
    :ARG0 (p / portion
        :part-of (s / single-byte))
    :ARG1 (u2 / use-01
        :ARG0 p
        :ARG1 (b / bit
            :quant (v / value-interval
                :op1 1
                :op2 2)
            :mod (c / code))
        :ARG2 (c2 / code-01
            :time (d / date-entity
                :year 1989)))
    :rel (p2 / product
        :name (n / name
            :op1 "GB/T"
            :op2 11383)))

