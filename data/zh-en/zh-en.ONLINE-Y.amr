# ::edge	thing	ARG4-of	step-01	t	s	
(t / thing
    :ARG4-of (s / step-01)
    :condition (o / "(or"
        :op1 (u / use-01
            :ARG1 (o2 / option
                :mod (o3 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :mod (f / full))))
    :domain (c2 / connect-01)
    :mod (l / last)
