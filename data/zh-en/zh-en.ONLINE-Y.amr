# ::edge	and	op1	consider-01	a	c2	
# ::edge	and	op2	establish-01	a	e	
# ::edge	establish-01	ARG0	product	e	p2	
# ::edge	thing	ARG1-of	resemble-01	t	r	
# ::edge	resemble-01	ARG2	product	r	p3	
# ::edge	connect-01	ARG1	thing	c	t	
# ::edge	establish-01	ARG1	connect-01	e	c	
(a / and
    :op1 (c2 / consider-01
        :ARG0 (p2 / product
            :name (n / name
                :op1 "PGPCoder"))
        :ARG1 (f2 / file,
            :domain (f / file
                :ARG1-of (p / process-01))
            :mod (p3 / product
                :name (n2 / name
                    :op1 "C++"))))
    :op2 (e / establish-01
        :ARG0 p2
        :ARG1 (c / connect-01
            :ARG1 (t / thing
                :ARG1-of (r / resemble-01
                    :ARG2 p3)))))

