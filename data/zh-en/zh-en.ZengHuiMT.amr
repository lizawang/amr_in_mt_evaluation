# ::edge	value-interval	op3	string-entity	v	s2	
# ::edge	string-entity	value	GB/T11383-1989.	s	2	
(c2 / contain-01
    :ARG0 (p / part)
    :ARG1 (c / character
        :quant 128
        :ARG1-of (r / range-01
            :ARG3 (v / value-interval
                :op1 0x00
                :op2 (s / string-entity
                    :value "GB/T11383-1989.")
                :op3 (s2 / string-entity)))
        :mod (a / all)))

