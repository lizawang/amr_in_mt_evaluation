(o2 / order-03
    :li 6
    :ARG1 (c / character)
    :rel (o / order-03
        :ARG1 c
        :location (p / part
            :mod (b / brush)
            :part-of (w / word
                :quant 1
                :ARG1-of (s / single-02)))))

