# ::node	a	and	4-5
# ::node	a2	assemble-01	6-7
# ::root	a	and
# ::edge	process-01	ARG0	i	p	i	
# ::edge	language	name	name	l	n2	
# ::edge	name	op1	C.	n2	0	
# ::edge	file;	mod	language	f	l	
# ::edge	file;	name	name	f	n	
# ::edge	process-01	ARG1	file;	p	f	
# ::edge	and	op1	process-01	a	p	
# ::edge	and	op2	assemble-01	a	a2	
# ::edge	assemble-01	ARG1	language	a2	l	
# ::edge	assemble-01	ARG0	i	a2	i	
(a / and
    :op1 (p / process-01
        :ARG0 (i / i)
        :ARG1 (f / file;
            :name (n / name)
            :mod (l / language
                :name (n2 / name
                    :op1 "C."))))
    :op2 (a2 / assemble-01
        :ARG0 i
        :ARG1 l))

# ::tok ii preprocessed c++ files; compile, assemble, assemble.
# ::node	a	and	0-1
# ::node	1	ii	0-1
# ::node	p	process-01	1-2
# ::node	l	language	2-3
# ::node	n	name	2-3
