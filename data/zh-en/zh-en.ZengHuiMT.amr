# ::node	b	bit	9-10
# ::node	b2	bit	9-10
# ::node	f	field	10-11
# ::node	f2	field	10-11
# ::node	o3	or	14-15
# ::node	t	thing	16-17
# ::node	m	modify-01	16-17
# ::node	0	-	18-19
# ::node	1	-	18-19
# ::node	e	explicit-03	19-20
# ::node	d	declare-02	20-21
# ::root	u	use-01
# ::edge	option	mod	this	o	t2	
# ::edge	use-01	ARG1	option	u	o	
# ::edge	use-01	ARG2	define-01	u	d2	
# ::edge	define-01	ARG0	option	d2	o	
# ::edge	define-01	ARG1	or	d2	o2	
# ::edge	field	mod	bit	f	b	
# ::edge	or	op1	field	o2	f	
# ::edge	field	ARG1-of	sign-01	f	s	
# ::edge	field	mod	bit	f2	b2	
# ::edge	field	ARG1-of	sign-01	f2	s2	
# ::edge	or	op2	field	o2	f2	
# ::edge	or	op1	thing	o3	t	
# ::edge	thing	mod	sign-01	t	s	
# ::edge	thing	ARG0-of	modify-01	t	m	
# ::edge	sign-01	polarity	-	s2	1	
# ::edge	declare-02	ARG1-of	explicit-03	d	e	
# ::edge	declare-02	polarity	-	d	0	
# ::edge	declare-02	ARG1	or	d	o3	
# ::edge	or	condition	declare-02	o2	d	
(u / use-01
    :ARG1 (o / option
        :mod (t2 / this))
    :ARG2 (d2 / define-01
        :ARG0 o
        :ARG1 (o2 / or
            :condition (d / declare-02
                :ARG1 (o3 / or
                    :op1 (t / thing
                        :ARG0-of (m / modify-01)
                        :mod (s / sign-01)))
                :ARG1-of (e / explicit-03)
                :polarity -)
            :op1 (f / field
                :ARG1-of s
                :mod (b / bit))
            :op2 (f2 / field
                :ARG1-of (s2 / sign-01
                    :polarity -)
                :mod (b2 / bit)))))

# ::tok By default, bit fields are signed because the basic integer types they inherit, such as int, are signed numbers, however, if the '-traditional' option is specified, bit fields are always unsigned numbers.
