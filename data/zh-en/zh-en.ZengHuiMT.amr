                        :ARG1 (a7 / audio,))
                    :op2 (p5 / press-01
                        :ARG0 y)
                    :op3 (h2 / hold-01
                        :ARG0 y
                        :duration (t2 / temporal-quantity
                            :quant 1
                            :unit (s / second))))))
        :instrument (a2 / and
            :mod (b / both)
            :op1 (e2 / earring
                :ARG1-of (l / left-19))
            :op2 (e / ear
                :ARG1-of (r2 / right-04))))
    :rel (a6 / answer-01
        :ARG0 y)
    :rel (c2 / come-in-07))

# ::tok When calling, when refusing to listen to the phone call, switch to the headset/mobile phone to listen to Jane double-click.
# ::node	r	refuse-01	3-4
# ::node	l	listen-01	5-6
# ::node	p2	phone	8-9
# ::node	c	call-02	9-10
# ::node	s	switch-01	10-11
# ::node	y	you	10-11
# ::node	h	headset/mobile	13-14
# ::node	p3	phone	14-15
# ::node	l2	listen-01	16-17
# ::node	p	person	18-19
# ::node	n	name	18-19
# ::node	0	Jane	18-19
# ::node	1	double-click.	19-20
# ::root	s	switch-01
# ::edge	refuse-01	ARG1	listen-01	r	l	
# ::edge	call-02	medium	phone	c	p2	
# ::edge	listen-01	ARG1	call-02	l	c	
# ::edge	switch-01	time	refuse-01	s	r	
# ::edge	switch-01	ARG0	you	s	y	
# ::edge	refuse-01	ARG0	you	r	y	
# ::edge	phone	mod	headset/mobile	p3	h	
# ::edge	switch-01	ARG2	phone	s	p3	
# ::edge	listen-01	ARG0	you	l2	y	
# ::edge	switch-01	purpose	listen-01	s	l2	
# ::edge	call-02	ARG1	person	c	p	
# ::edge	person	name	name	p	n	
# ::edge	name	op1	Jane	n	0	
# ::edge	name	op2	double-click.	n	1	
(s / switch-01
    :purpose (l2 / listen-01
        :ARG0 (y / you))
    :ARG0 y
    :ARG2 (p3 / phone
        :mod (h / "headset/mobile"))
    :time (r / refuse-01
        :ARG0 y
        :ARG1 (l / listen-01
            :ARG1 (c / call-02
                :ARG1 (p / person
                    :name (n / name
                        :op1 "Jane"
                        :op2 "double-click."))
                :medium (p2 / phone)))))

# ::tok During a call, start/turn off mute mode.
# ::node	c	call-02	2-3
# ::node	t	turn-off-07	3-4
# ::node	m2	mute	5-6
