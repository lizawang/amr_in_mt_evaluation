        :purpose (s / switch-01
            :ARG0 y
            :ARG2 (b / between
                :op1 (c3 / call-02
                    :quant 2)))
        :ARG0 y
        :ARG1 (k3 / key
            :mod (m3 / multi-sentence
                :snt1 k2))
        :mode imperative))

