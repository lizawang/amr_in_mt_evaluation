    :op1 (r / read-01
        :ARG0 (y / you)
        :ARG1 (b / book)
        :mode imperative)
    :op2 (s / sing-01
        :ARG0 y
        :ARG1 (s2 / string-entity
            :value "V10reae.")
        :mode imperative))

