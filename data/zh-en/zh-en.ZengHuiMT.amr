# ::node	o	operate-01	19-20
# ::root	i	indicate-01
# ::edge	thing	ARG2-of	name-01	t	n	
# ::edge	name-01	mod	post-level	n	p	
# ::edge	file	mod	source	f	s	
# ::edge	name-01	ARG1	file	n	f	
# ::edge	indicate-01	ARG0	thing	i	t	
# ::edge	type-03	ARG2	language	t2	l	
# ::edge	and	op1	type-03	a2	t2	
# ::edge	indicate-01	ARG1	and	i	a2	
# ::edge	and	op2	operate-01	a2	o	
# ::edge	operate-01	time	after	o	a	
# ::edge	operate-01	ARG1	language	o	l	
(i / indicate-01
    :ARG0 (t / thing
        :ARG2-of (n / name-01
            :ARG1 (f / file
                :mod (s / source))
            :mod (p / post-level)))
    :ARG1 (a2 / and
        :op1 (t2 / type-03
            :ARG2 (l / language))
        :op2 (o / operate-01
            :ARG1 l
            :time (a / after))))

# ::tok C source program; preprocessing, compilation, assembly.
# ::node	n	name	0-1
# ::node	0	C	0-1
# ::node	s	source-02	1-2
# ::node	p2	program;	2-3
# ::node	p	process-01	3-4
# ::node	a	and	4-5
# ::node	a2	assemble-01	5-6
# ::root	p2	program;
# ::edge	name	op1	C	n	0	
# ::edge	program;	ARG0-of	source-02	p2	s	
# ::edge	program;	name	name	p2	n	
# ::edge	and	op1	process-01	a	p	
# ::edge	program;	domain	and	p2	a	
# ::edge	and	op2	assemble-01	a	a2	
(p2 / program;
    :name (n / name
        :op1 "C")
    :ARG0-of (s / source-02)
    :domain (a / and
        :op1 (p / process-01)
        :op2 (a2 / assemble-01)))

# ::tok C++ source program; preprocessing, compilation, assembly.
# ::node	p2	product	0-1
# ::node	n	name	0-1
# ::node	0	C++	0-1
# ::node	s	source	1-2
# ::node	p3	program;	2-3
# ::node	p	process-01	3-4
# ::node	a	assemble-01	5-6
# ::root	p3	program;
# ::edge	product	name	name	p2	n	
# ::edge	name	op1	C++	n	0	
# ::edge	program;	mod	source	p3	s	
# ::edge	program;	domain	product	p3	p2	
# ::edge	program;	ARG2-of	process-01	p3	p	
# ::edge	program;	ARG2-of	assemble-01	p3	a	
(p3 / program;
    :ARG2-of (p / process-01)
    :ARG2-of (a / assemble-01)
    :domain (p2 / product
        :name (n / name
            :op1 "C++"))
    :mod (s / source))

# ::tok CC + + source program; Preprocessing, compilation, assembly.
# ::node	n	name	0-1
