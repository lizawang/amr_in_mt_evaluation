# ::tok Unless the -cec, -s, or -E options are used ( or a compilation error prevents the complete process), concatenation is always the last step.
# ::node	s2	string-entity	2-3
# ::node	o2	or	4-5
# ::node	s3	string-entity	5-6
# ::node	0	-	5-6
# ::node	o	option	6-7
# ::node	u	use-01	8-9
# ::node	o3	or	10-11
