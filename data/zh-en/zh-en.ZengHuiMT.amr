# ::node	l3	line	47-48
# ::node	m	mean-01	48-49
# ::root	m2	multi-sentence
# ::edge	phase,	mod	connect-01	p2	c2	
# ::edge	program	mod	source	p3	s	
# ::edge	correspond-02	ARG1	all	c4	a	
# ::edge	correspond-02	time	phase,	c4	p2	
# ::edge	other.	mod	each	o3	e	
# ::edge	correspond-02	ARG2	other.	c4	o3	
# ::edge	file	ARG1-of	correspond-02	f	c5	
# ::edge	file	name	name	f	n	
# ::edge	name	value	1	n2	1	
# ::edge	recognize-02	polarity	-	r	0	
# ::edge	number	ARG1-of	recognize-02	n4	r	
# ::edge	number	domain	file	n4	f	
# ::edge	correspond-02	ARG2	number	c4	n4	
# ::edge	number	ARG2-of	name-01	n4	n3	
# ::edge	number	ARG2-of	include-91	n4	i	
# ::edge	number	ARG1-of	recognize-02	n5	r	
# ::edge	include-91	ARG1	number	i	n5	
# ::edge	multi-sentence	snt1	correspond-02	m2	c4	
# ::edge	string-entity	value	H	s3	2	
# ::edge	tag-01	ARG2	string-entity	t	s3	
# ::edge	file	ARG1-of	tag-01	f2	t	
# ::edge	file	name	string-entity	f2	s3	
# ::edge	and	op1	file	a2	f2	
# ::edge	multi-sentence	snt2	and	m2	a2	
# ::edge	file	mod	library	f3	l2	
# ::edge	pass-05	ARG1	file	p	f3	
# ::edge	and	op2	pass-05	a2	p	
# ::edge	option	mod	connect-01	o	c3	
# ::edge	pass-05	ARG2	option	p	o	
# ::edge	pass-05	ARG1-of	order-03	p	o2	
# ::edge	line	mod	command	l3	c	
# ::edge	order-03	location	line	o2	l3	
# ::edge	option	ARG1-of	mean-01	o	m	
# ::edge	mean-01	ARG2	connect-01	m	c3	
# ::edge	multi-sentence	rel	program	m2	p3	
# ::edge	multi-sentence	rel	name	m2	n2	
# ::edge	multi-sentence	rel	library	m2	l	
# ::edge	multi-sentence	rel	specify-01	m2	s2	
(m2 / multi-sentence
    :rel (p3 / program
        :mod (s / source))
    :rel (n2 / name
        :value "1")
    :rel (l / library)
    :rel (s2 / specify-01)
    :snt1 (c4 / correspond-02
        :ARG1 (a / all)
        :ARG2 (o3 / other.
            :mod (e / each))
        :ARG2 (n4 / number
            :ARG1-of (r / recognize-02
                :polarity -)
            :ARG2-of (n3 / name-01)
            :ARG2-of (i / include-91
                :ARG1 (n5 / number
                    :ARG1-of r))
            :domain (f / file
                :name (n / name)
                :ARG1-of (c5 / correspond-02)))
        :time (p2 / phase,
            :mod (c2 / connect-01)))
    :snt2 (a2 / and
        :op1 (f2 / file
            :name (s3 / string-entity
                :value "H")
            :ARG1-of (t / tag-01
                :ARG2 s3))
        :op2 (p / pass-05
            :ARG1 (f3 / file
                :mod (l2 / library))
            :ARG1-of (o2 / order-03
                :location (l3 / line
                    :mod (c / command)))
            :ARG2 (o / option
                :ARG1-of (m / mean-01
                    :ARG2 (c3 / connect-01))
                :mod c3))))

# ::tok Options must be given separately: de 'is completely different from `-d -r' .
# ::node	o2	option	0-1
# ::node	o	obligate-01	1-2
# ::node	g	give-01	3-4
# ::node	c	complete-02	7-8
# ::node	d	differ-02	8-9
