(c / contrast-01
    :rel (u / use-01
        :ARG0 (p / program
            :quant (m2 / many))
        :ARG2 (a / and
            :op1 (w / write-01
                :ARG1 p
                :ARG3 u)
            :op2 (e / expect-01
                :ARG1 (o2 / or
                    :ARG0-of (d / depend-01
                        :ARG1 (m / machine
                            :ARG1-of (t / target-01)
                            :instrument-of (p2 / program)))
                    :domain (t2 / this)
                    :op1 (n / number
                        :ARG1-of (s / sign-01))
                    :op2 (n2 / number,
                        :ARG1-of (s2 / sign-01))))))
    :rel (o / only)
    :rel (s3 / simple-02)
    :rel (s4 / string-entity))

# ::tok This option, and its antisense option, make such programs work on the corresponding default values.
