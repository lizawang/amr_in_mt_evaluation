# ::edge	turn-on-13	ARG1	set-02	t2	s	
# ::edge	and	op2	turn-on-13	a	t2	
(m / multi-sentence
    :snt1 (t / turn-on-13
        :ARG0 (y / you)
        :ARG1 (a2 / assist-01
            :ARG1 (v / voice))
        :mode imperative)
    :snt2 (h / have-condition-91
        :ARG2 (a / and
            :op1 (s2 / support-01
                :ARG0 (d / device)
                :ARG1 v)
            :op2 (t2 / turn-on-13
                :ARG1 (s / set-02
                    :ARG1 (w / wake-up-02
                        :ARG1-of (q / quick-02)))))))

