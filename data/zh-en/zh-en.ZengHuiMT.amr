(r / recommend-01
    :ARG1 (d / define-01
        :ARG1 (t2 / type
            :mod (c / char))
        :ARG1-of (e3 / explicit-03)
        :ARG2 (o / or
            :op1 (s / sign-01))
        :concession (e / even-if
            :op1 (b / behave-01
                :ARG0 c
                :ARG1 (t / they
                    :ARG1-of (i / include-91)
                    :ARG2 c)
                :mod (e2 / exact)))
        :time (a / always))
    :rel (s2 / sign-01))

# ::tok These options are used to define signed or unsigned bit fields if the 'signed' or 'unsigned' modifiers are not explicitly declared.
# ::node	t2	this	0-1
# ::node	o	option	1-2
# ::node	u	use-01	3-4
# ::node	d2	define-01	5-6
# ::node	s	sign-01	6-7
# ::node	o2	or	7-8
