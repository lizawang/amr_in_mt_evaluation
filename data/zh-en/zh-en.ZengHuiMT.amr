# ::edge	contain-01	rel	GB/T13000	c4	a	
(c4 / contain-01
    :ARG0 (p / part
        :mod (d / double-byte))
    :ARG1 (a3 / and
        :op1 (c / character
            :mod (g / graphic)
            :mod (a2 / all))
        :op2 (u / unify-01
            :ARG1 (c2 / character
                :mod (c5 / country
                    :name (n2 / name
                        :op1 "China")))
            :prep-in (c3 / character
                :quant (s / some)
                :mod (g2 / graphic))))
    :rel (n / name
        :op1 "CJK")
    :rel (a / "GB/T13000"))

