(m / make-02
    :ARG0 (a / and
        :op1 (t / this)
        :op2 (o2 / option,
            :ARG0-of (o / oppose-01)
            :poss t))
    :ARG1 (w / work-09
        :ARG1 (p / program
            :mod (s / such))
        :ARG4 (v / value
            :ARG1-of (c / correspond-02)
            :ARG2-of (d / default-01))))

