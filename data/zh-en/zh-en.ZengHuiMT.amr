# ::node	e	err-01	13-14
# ::node	p	prevent-01	14-15
# ::node	c2	complete-02	16-17
# ::node	p2	process-02	17-18
# ::node	c3	concur-01	18-19
# ::node	a	always	20-21
# ::node	o4	ordinal-entity	22-23
# ::node	1	-1	22-23
# ::node	s	step-01	23-24
# ::root	s	step-01
# ::edge	or	op1	string-entity	o2	s2	
# ::edge	or	op2	string-entity	o2	s3	
# ::edge	string-entity	polarity	-	s3	0	
# ::edge	option	mod	or	o	o2	
# ::edge	use-01	ARG1	option	u	o	
# ::edge	or	op1	use-01	o3	u	
# ::edge	err-01	ARG1	compile-01	e	c	
# ::edge	prevent-01	ARG0	err-01	p	e	
# ::edge	or	op2	prevent-01	o3	p	
# ::edge	process-02	ARG1-of	complete-02	p2	c2	
# ::edge	prevent-01	ARG1	process-02	p	p2	
# ::edge	ordinal-entity	value	-1	o4	1	
# ::edge	step-01	ord	ordinal-entity	s	o4	
# ::edge	step-01	time	always	s	a	
# ::edge	step-01	ARG2	concur-01	s	c3	
# ::edge	step-01	condition	or	s	o3	
(s / step-01
    :ARG2 (c3 / concur-01)
    :condition (o3 / or
        :op1 (u / use-01
            :ARG1 (o / option
                :mod (o2 / or
                    :op1 (s2 / string-entity)
                    :op2 (s3 / string-entity
                        :polarity -))))
        :op2 (p / prevent-01
            :ARG0 (e / err-01
                :ARG1 (c / compile-01))
            :ARG1 (p2 / process-02
                :ARG1-of (c2 / complete-02))))
    :ord (o4 / ordinal-entity
        :value -1)
    :time (a / always))

# ::tok During the connection phase, all corresponding to the source program are corresponding to each other. e-file, -1 library file, unrecognizable filenames ( including specified filenames) . o H tag files and The a library file is passed to the connector options in the order on the command line ( OPTIONS) .
