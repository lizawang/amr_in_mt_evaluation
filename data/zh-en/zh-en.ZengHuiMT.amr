# ::edge	and	op3	process-01	a	p	
# ::edge	and	op4	assemble-01	a	a2	
# ::edge	and	rel	+	a	0	
(a / and
    :op1 (n / name)
    :op2 (s / source-02)
    :op3 (p / process-01)
    :op4 (a2 / assemble-01)
    :rel +)

