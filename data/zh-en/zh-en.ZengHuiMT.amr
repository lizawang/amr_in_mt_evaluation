# ::edge	thing	li	ii	t	1	
# ::edge	thing	domain	and	t	a2	
# ::edge	and	op2	language	a2	l2	
# ::edge	and	op1	assemble-01	a2	a3	
# ::edge	assemble-01	ARG1	thing	a3	t	
# ::edge	and	op2	assemble-01	a2	a4	
# ::edge	assemble-01	ARG1	language	a4	l2	
# ::edge	thing	rel	language	t	l	
# ::edge	thing	rel	and	t	a2	
# ::edge	thing	rel	and	t	a	
(t / thing
    :li ii
    :ARG1-of (p / process-01)
    :domain (a2 / and
        :op1 (a3 / assemble-01
            :ARG1 t)
        :op2 (l2 / language
            :name (n2 / name))
        :op2 (a4 / assemble-01
            :ARG1 l2))
    :rel (l / language
        :name (n / name
            :op1 "c++"))
    :rel a2
    :rel (a / and))

# ::tok s assembly language source program; assembly.
