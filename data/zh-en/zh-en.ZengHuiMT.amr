(m / multi-sentence
    :snt1 (p / program;
        :ARG0-of (s / source-02
            :ARG1 (l / language
                :name (n / name
                    :op1 "assemble-02"))))
    :snt2 p)

# ::tok Assembly language source program; Preprocessing, assembly, assembly.
