# ::node	t	thing	23-24
# ::node	i	include-91	23-24
# ::root	p	pass-05
# ::edge	name	op1	H	n	1	
# ::edge	language	name	name	l	n	
# ::edge	file	ARG0-of	process-01	f	p3	
# ::edge	person	mod	other	p2	o	
# ::edge	file	accompanier	person	f2	p2	
# ::edge	person	ARG0-of	descend-01	p2	d	
# ::edge	appear-01	ARG1-of	normal-02	a	n3	
# ::edge	appear-01	polarity	-	a	0	
# ::edge	file	ARG1-of	appear-01	f2	a	
# ::edge	line	mod	command	l2	c	
# ::edge	appear-01	location	line	a	l2	
# ::edge	pass-05	ARG1	file	p	f2	
# ::edge	pass-05	ARG2	product	p	p4	
# ::edge	product	name	name	p4	n2	
# ::edge	name	op1	Linker.	n2	2	
# ::edge	thing	mod	this	t	t2	
# ::edge	thing	ARG1-of	typical-02	t	t3	
# ::edge	pass-05	ARG0	thing	p	t	
# ::edge	thing	ARG2-of	include-91	t	i	
# ::edge	pass-05	rel	language	p	l	
# ::edge	pass-05	rel	file	p	f	
(p / pass-05
    :ARG0 (t / thing
        :ARG1-of (t3 / typical-02)
        :ARG2-of (i / include-91)
        :mod (t2 / this))
    :ARG1 (f2 / file
        :ARG1-of (a / appear-01
            :ARG1-of (n3 / normal-02)
            :location (l2 / line
                :mod (c / command))
            :polarity -)
        :accompanier (p2 / person
            :ARG0-of (d / descend-01)
            :mod (o / other)))
    :ARG2 (p4 / product
        :name (n2 / name
            :op1 "Linker."))
    :rel (l / language
        :name (n / name
            :op1 "H"))
    :rel (f / file
        :ARG0-of (p3 / process-01)))

