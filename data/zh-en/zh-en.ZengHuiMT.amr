(m2 / multi-sentence
    :rel (c / call-02
        :ARG1-of (n / new-01))
    :rel (p / phone
        :mod (m / mobile))
    :rel (c4 / click-01
        :purpose (a / and
            :op1 (k / keep-01
                :ARG0 (y / you)
                :ARG1 (c2 / call-02
                    :mod (p2 / previous)))
            :op2 (a2 / answer-01
                :ARG0 y))
        :ARG0 y
        :ARG1 (k2 / key)
        :mode imperative)
    :rel (o / ordinal-entity
        :value 2)
