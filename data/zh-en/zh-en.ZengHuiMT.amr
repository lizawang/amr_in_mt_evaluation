# ::tok i preprocessed c file; compile, assemble, assemble.
# ::node	i	i	0-1
# ::node	p	process-01	1-2
# ::node	n	name	2-3
# ::node	l	language	2-3
# ::node	n2	name	2-3
# ::node	0	C.	2-3
