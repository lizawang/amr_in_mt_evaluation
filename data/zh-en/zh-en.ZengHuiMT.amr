# ::edge	mode.	ARG0-of	call-02	m	c	
# ::edge	mode.	time	call-02	m	c	
# ::edge	mode.	rel	turn-off-07	m	t	
(m / mode.
    :ARG0-of (c / call-02)
    :mod (m2 / mute)
    :rel (t / turn-off-07
        :ARG1 m)
    :time c)

