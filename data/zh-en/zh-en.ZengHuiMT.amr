# ::edge	number	time	always	n2	a	
# ::edge	number	domain	option	n2	o	
# ::edge	contrast-01	ARG2	number	c2	n2	
(c2 / contrast-01
    :ARG1 (s / sign-01
        :ARG1 (f / field
            :mod (b2 / bit))
        :ARG1-of (c / cause-01
            :ARG0 (n / number
                :ARG1-of (s2 / sign-01)
                :domain (t / type
                    :mod (i / integer)
                    :mod (b / basic)))))
    :ARG2 (n2 / number
        :ARG1-of (s3 / sign-01
            :polarity -)
        :domain (o / option)
        :time (a / always)))

