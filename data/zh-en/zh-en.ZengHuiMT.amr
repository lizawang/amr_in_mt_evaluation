# ::edge	allocate-01	ARG1	point	a	p	
# ::edge	show-01	ARG1	structure	s	s3	
# ::edge	figure	mod	1	f	0	
# ::edge	and	op2	figure	a2	f2	
# ::edge	and	op1	figure	a2	f	
# ::edge	show-01	ARG0	table	s2	t	
# ::edge	show-01	source	publication	s2	p2	
# ::edge	publication	name	name	p2	n	
# ::edge	name	op1	Table	n	2	
# ::edge	name	op2	1,	n	1	
# ::edge	and	rel	range-01	a2	r	
# ::edge	and	rel	allocate-01	a2	a	
# ::edge	and	rel	show-01	a2	s	
# ::edge	and	rel	show-01	a2	s2	
(a2 / and
    :op1 (f / figure
        :mod 1)
    :op2 (f2 / figure)
    :rel (r / range-01
        :ARG2 (p / point
            :mod (c / code)))
    :rel (a / allocate-01
        :ARG1 p)
    :rel (s / show-01
        :ARG1 (s3 / structure
            :mod (o / overall)))
    :rel (s2 / show-01
        :ARG0 (t / table)
        :source (p2 / publication
            :name (n / name
                :op1 "Table"
                :op2 "1,"))))

