(p2 / program;
    :ARG0-of (s / source-02
        :ARG1 (l / language
            :mod (a / assemble-02)))
    :mod (p / process-01))

# ::tok H preprocessor files; files with other descendants that do not normally appear on the command line are passed to the Linker. Typically these include:
# ::node	n	name	0-1
