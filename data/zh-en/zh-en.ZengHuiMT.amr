# ::edge	possible-01	rel	answer-01	p3	a6	
# ::edge	possible-01	rel	come-in-07	p3	c2	
(p3 / possible-01
    :ARG1 (o / operate-01
        :ARG1 (f2 / function-01
            :ARG1-of (f / follow-04))
        :ARG1 (a3 / and
            :op1 (t / tap-02
                :ARG0 (y / you))
            :op2 (h / hang-up-03
                :ARG0 y
                :ARG1 (p / phone)
                :ARG1 (m / music
                    :mod (p2 / phone))
                :time (o2 / or
                    :op1 (c / call-02)))
            :op3 (a5 / and
                :purpose (r / release-01
                    :ARG0 y
                    :ARG1 m
                    :duration (a / about
                        :op1 (t3 / temporal-quantity
