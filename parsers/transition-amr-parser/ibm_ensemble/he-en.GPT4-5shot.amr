# ::edge	choose-01	ARG0	you	c2	y	
(a3 / and
    :op1 (c / change-01
        :ARG1 (t / thing
            :ARG2-of (p2 / price-01))
        :ARG1-of (c3 / conform-01
            :ARG2 (a2 / and
                :op1 (t3 / type
                    :mod (t2 / ticket
                        :ARG1-of (p3 / purchase-01
                            :ARG0 (y / you))))
                :op2 (d2 / destination)))
        :condition (w / want-01
            :ARG0 y
            :ARG1 (a / add-02
                :ARG0 y
                :ARG1 (l / luggage
                    :mod (m4 / more)))))
    :op2 (p / possible-01
        :ARG1 (r3 / reach-01
            :ARG0 t
            :ARG0-of (d / depend-01
                :ARG1 (w2 / weight
                    :poss (s5 / suitcase
                        :ARG1-of (c2 / choose-01
                            :ARG0 y))))
            :ARG1 (r / rate-entity-91
                :ARG1 (s / several
                    :op1 (m2 / monetary-quantity
                        :quant 100
                        :unit (s2 / shekel)))
                :ARG1-of (m / mean-01
                    :ARG2 (r2 / rate-entity-91
                        :ARG1 (b / between
                            :op1 150
                            :op2 280
                            :op2 (m3 / monetary-quantity
                                :quant 150
                                :unit (s3 / shekel)))
                        :ARG2 (d3 / direction)))
                :ARG2 (s4 / suitcase)))))

# ::tok In EasyJet company , they allow to bring a small bag of 45 * 36 * 20 size , provided it can fit under the seat .
