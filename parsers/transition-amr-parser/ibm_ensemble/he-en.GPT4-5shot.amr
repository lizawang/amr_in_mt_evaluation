# ::edge	fit-01	ARG1	bag	f	b	
# ::edge	fit-01	ARG2	under	f	u	
# ::edge	under	op1	seat	u	s	
(a / allow-01
    :ARG0 (c / company
        :name (n / name
            :op1 "EasyJet"))
    :ARG1 (b2 / bring-01
        :ARG1 (b / bag
            :consist-of (p2 / product-of
                :op1 45
                :op2 36
                :op3 20)
            :mod (s2 / small)))
    :condition (p / possible-01
        :ARG1 (f / fit-01
            :ARG1 b
            :ARG2 (u / under
                :op1 (s / seat)))))

