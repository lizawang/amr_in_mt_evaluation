# ::tok If the interest rate rises by half a percent - how much will the monthly payment on the mortgage cost ?
# ::node	h	have-condition-91	0-1
# ::node	i	interest	2-3
# ::node	r	rate	3-4
# ::node	r3	rise-01	4-5
# ::node	0	0.5	6-7
