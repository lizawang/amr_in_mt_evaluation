# ::node	m	month	14-15
# ::node	p	pay-01	15-16
# ::node	m2	mortgage-01	18-19
# ::node	c	cost-01	19-20
# ::node	a	amr-unknown	20-21
# ::root	h	have-condition-91
# ::edge	rate	mod	interest	r	i	
# ::edge	rise-01	ARG1	rate	r3	r	
# ::edge	have-condition-91	ARG2	rise-01	h	r3	
# ::edge	percentage-entity	value	0.5	p2	0	
# ::edge	rise-01	ARG2	percentage-entity	r3	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	quant	1	t	1	
# ::edge	temporal-quantity	unit	month	t	m	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	have-condition-91	ARG1	pay-01	h	p	
# ::edge	cost-01	ARG1	mortgage-01	c	m2	
# ::edge	pay-01	ARG1	cost-01	p	c	
# ::edge	pay-01	quant	amr-unknown	p	a	
(h / have-condition-91
    :ARG1 (p / pay-01
        :quant (a / amr-unknown)
        :ARG1 (c / cost-01
            :ARG1 (m2 / mortgage-01))
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :ARG2 (r3 / rise-01
        :ARG1 (r / rate
            :mod (i / interest))
        :ARG2 (p2 / percentage-entity
            :value 0.5)))

