    :ARG0 (g / go-01
        :ARG1 (r / rate
            :location (p / path
                :ARG0-of (c2 / comprise-01
                    :ARG1 (m2 / mortgage-01)
                    :ARG1-of (c3 / contrast-01
                        :ARG2 (p2 / path
                            :mod (p5 / prime)
                            :mod (j / just
