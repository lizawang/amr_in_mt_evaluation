# ::root	r	return-02
# ::edge	return-02	time	already	r	a	
# ::edge	return-02	ARG0	they	r	t2	
# ::edge	multiple	op1	1000000	m	0	
# ::edge	customer	quant	multiple	c	m	
# ::edge	return-02	ARG1	customer	r	c	
# ::edge	customer	ARG1-of	take-01	c	t	
# ::edge	take-01	ARG0	they	t	t2	
# ::edge	take-01	ARG3	imprison-01	t	i	
# ::edge	imprison-01	ARG1	customer	i	c	
# ::edge	imprison-01	ARG0	they	i	t2	
# ::edge	return-02	polarity	amr-unknown	r	a2	
(r / return-02
    :ARG0 (t2 / they)
    :ARG1 (c / customer
        :quant (m / multiple
            :op1 1000000)
        :ARG1-of (t / take-01
            :ARG0 t2
            :ARG3 (i / imprison-01
                :ARG0 t2
                :ARG1 c)))
    :polarity (a2 / amr-unknown)
    :time (a / already))

# ::tok EasyJet to Geneva round trip 70 euros .
# ::node	c2	company	0-1
# ::node	n	name	0-1
# ::node	1	EasyJet	0-1
# ::node	c	city	2-3
# ::node	n2	name	2-3
# ::node	2	Geneva	2-3
# ::node	r	round-trip-00	3-4
# ::node	0	70	5-6
# ::node	m	monetary-quantity	6-7
# ::node	e	euro	6-7
# ::root	m	monetary-quantity
# ::edge	company	name	name	c2	n	
# ::edge	name	op1	EasyJet	n	1	
# ::edge	city	name	name	c	n2	
# ::edge	name	op1	Geneva	n2	2	
# ::edge	round-trip-00	ARG4	city	r	c	
# ::edge	round-trip-00	ARG0	company	r	c2	
# ::edge	monetary-quantity	quant	70	m	0	
# ::edge	monetary-quantity	ARG4-of	round-trip-00	m	r	
# ::edge	monetary-quantity	unit	euro	m	e	
(m / monetary-quantity
    :quant 70
    :ARG4-of (r / round-trip-00
        :ARG0 (c2 / company
            :name (n / name
                :op1 "EasyJet"))
        :ARG4 (c / city
            :name (n2 / name
                :op1 "Geneva")))
    :unit (e / euro))

# ::tok One way EL AL $ 560 .
# ::node	o	one	0-1
# ::node	w	way	1-2
# ::node	c	company	2-3
# ::node	n	name	2-3
# ::node	2	EL	2-3
# ::node	1	AL	3-4
# ::node	m	monetary-quantity	4-5
# ::node	d	dollar	4-5
# ::node	0	560	5-6
# ::root	m	monetary-quantity
# ::edge	way	mod	one	w	o	
# ::edge	company	name	name	c	n	
# ::edge	name	op1	EL	n	2	
# ::edge	name	op2	AL	n	1	
# ::edge	monetary-quantity	mod	company	m	c	
# ::edge	monetary-quantity	manner	way	m	w	
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	monetary-quantity	quant	560	m	0	
(m / monetary-quantity
    :quant 560
    :manner (w / way
        :mod (o / one))
    :mod (c / company
        :name (n / name
            :op1 "EL"
            :op2 "AL"))
    :unit (d / dollar))

