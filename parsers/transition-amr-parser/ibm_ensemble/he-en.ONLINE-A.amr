    :op1 (s / send-01
        :ARG0 (m / message
            :quant (s2 / some))
        :ARG1 (p / person
            :ARG0-of (i2 / inform-01)
            :ARG1-of (r5 / return-01))
        :ARG2 (p3 / possible-01
            :ARG1 (r3 / release-01
                :ARG1 p
