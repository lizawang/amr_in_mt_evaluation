# ::edge	locate-01	location	boundary	l2	b2	
# ::edge	boundary	poss	authority	b2	a	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (e3 / examine-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG1 (a / authority
                        :mod (e / each))
                    :ARG2 (b3 / business
                        :ARG1-of (l2 / locate-01
                            :location (b2 / boundary
                                :poss a))))
                :poss a))
        :ARG1-of (e2 / examine-01
            :ARG0 a)))

