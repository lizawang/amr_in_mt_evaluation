# ::edge	rate-entity-91	ARG2	passenger	r	p	
# ::edge	passenger	ARG1-of	rate-entity-91	p	r2	
# ::edge	rate-entity-91	ARG2	way	r2	w	
(f / fare
    :domain (r / rate-entity-91
        :ARG1 (m / monetary-quantity
            :quant 90
            :unit (d / dollar
                :mod (c / country
                    :name (n / name
                        :op1 "US"))))
        :ARG2 (p / passenger
            :ARG1-of (r2 / rate-entity-91
                :ARG2 (w / way))))
    :location (a / airport))

# ::tok Turkish Airlines offers an 8 - kilogram trolley for flights to Turkey and continues with Endolojet to onward destinations .
