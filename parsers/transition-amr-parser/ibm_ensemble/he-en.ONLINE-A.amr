(a2 / and
    :op1 (c / cancel-01
        :ARG0 (a / airline)
        :ARG1 (f / fly-01))
    :op2 (o / offer-01
        :ARG0 a
        :ARG1 (v / voucher
            :ARG1-of (w / worth-01
                :polarity -)))
    :time (t / then))

