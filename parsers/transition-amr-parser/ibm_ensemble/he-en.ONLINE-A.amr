(c / cause-01
    :ARG1 (t / this)
    :rel (r / rate
        :location (t2 / track
            :ARG0-of (c2 / comprise-01
                :ARG1 (m / mortgage-01))
            :mod (o2 / other))
        :location (t3 / track
            :mod (p / prime)
