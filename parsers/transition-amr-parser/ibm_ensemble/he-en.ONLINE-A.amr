# ::edge	continue-01	destination	destination	c3	d	
(a / and
    :op1 (o / offer-01
        :ARG0 (c / company
            :name (n / name
                :op1 "Turkish"
                :op2 "Airlines"))
        :ARG1 (t / trolley
            :mod (m / mass-quantity
                :quant 8
                :unit (k / kilogram)))
        :ARG3 (f / fly-01
            :destination (c4 / country
                :name (n2 / name
                    :op1 "Turkey"))))
    :op2 (c3 / continue-01
        :ARG0 c
        :ARG1 (c2 / company
            :name (n3 / name
                :op1 "Endolojet"))
        :destination (d / destination
            :direction (o2 / onwards))))

