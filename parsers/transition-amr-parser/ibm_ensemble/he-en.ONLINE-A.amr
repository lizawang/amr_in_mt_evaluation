        :ARG0 (p2 / person
            :name (n / name
                :op1 "Shai"
                :op2 "Tsror")
            :ARG1-of (e / expert-01
                :ARG2 (m3 / mortgage-01)))))

# ::tok If the interest rate rises by half a percent , how much will the monthly mortgage payment increase ?
# ::node	i2	interest	2-3
# ::node	r	rate	3-4
# ::node	r3	rise-01	4-5
# ::node	0	0.5	6-7
# ::node	p2	percentage-entity	8-9
# ::node	r2	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	1	1	14-15
# ::node	m	month	14-15
# ::node	m2	mortgage-01	15-16
# ::node	p	pay-01	16-17
# ::node	i	increase-01	17-18
# ::node	a	amr-unknown	18-19
# ::root	i	increase-01
# ::edge	rate	mod	interest	r	i2	
# ::edge	rise-01	ARG1	rate	r3	r	
# ::edge	percentage-entity	value	0.5	p2	0	
# ::edge	rise-01	ARG2	percentage-entity	r3	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	quant	1	t	1	
# ::edge	temporal-quantity	unit	month	t	m	
# ::edge	pay-01	ARG3	mortgage-01	p	m2	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	increase-01	ARG1	pay-01	i	p	
# ::edge	increase-01	condition	rise-01	i	r3	
# ::edge	increase-01	ARG2	amr-unknown	i	a	
(i / increase-01
    :ARG1 (p / pay-01
        :ARG3 (m2 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :ARG2 (a / amr-unknown)
    :condition (r3 / rise-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG2 (p2 / percentage-entity
            :value 0.5)))

