# ::node	p	passenger	11-12
# ::node	r2	rate-entity-91	12-13
# ::node	w	way	13-14
# ::root	f	fare
# ::edge	fare	location	airport	f	a	
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	dollar	mod	country	d	c	
# ::edge	country	name	name	c	n	
# ::edge	name	op1	US	n	1	
