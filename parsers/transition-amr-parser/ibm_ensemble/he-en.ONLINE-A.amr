# ::edge	weigh-01	ARG3	up-to	w2	u	
# ::edge	mass-quantity	quant	20	m	0	
# ::edge	up-to	op1	mass-quantity	u	m	
# ::edge	mass-quantity	unit	kilogram	m	k	
# ::edge	cost-01	ARG1	suitcase	c	s	
# ::edge	cost-01	ARG2	monetary-quantity	c	m2	
# ::edge	monetary-quantity	unit	dollar	m2	d	
# ::edge	dollar	mod	country	d	c2	
# ::edge	country	name	name	c2	n	
# ::edge	name	op1	US	n	2	
# ::edge	monetary-quantity	quant	40	m2	1	
# ::edge	way	mod	each	w	e	
# ::edge	cost-01	path	way	c	w	
# ::edge	order-02	time	before	o	b	
# ::edge	cost-01	condition	order-02	c	o	
# ::edge	order-02	ARG1	suitcase	o	s	
(c / cost-01
    :ARG1 (s / suitcase
        :ARG1-of (w2 / weigh-01
            :ARG3 (u / up-to
                :op1 (m / mass-quantity
                    :quant 20
                    :unit (k / kilogram)))))
    :ARG2 (m2 / monetary-quantity
        :quant 40
        :unit (d / dollar
            :mod (c2 / country
                :name (n / name
                    :op1 "US"))))
    :condition (o / order-02
        :ARG1 s
        :time (b / before))
    :path (w / way
        :mod (e / each)))

# ::tok At the airport , the fare will be US$ 90 per passenger per way .
