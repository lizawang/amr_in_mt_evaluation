(a / and
    :op1 (b / buy-01
        :ARG0 (i / i)
        :ARG1 (p / person
            :ARG0-of (s / scam-01)
            :ARG0-of (c3 / control-01
                :ARG1 (c2 / company)
                :accompanier (p2 / person
                    :ARG0-of (h / have-rel-role-91
                        :ARG1 p
                        :ARG2 (s2 / son))))
            :mod (r / religion)
            :op2 (p3 / person
                :ARG0-of (c / cheat-03)
                :ARG0-of (s3 / stop-01
                    :polarity -)))
        :ARG3 (m / monetary-quantity
            :mod (e / even)
            :unit (d / dollar))
        :polarity -))

