# ::edge	business	location	area	b2	a	
# ::edge	area	poss	authority	a	a2	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (e2 / examine-01
            :ARG1 (l / level
                :degree-of (f / friendly-01
                    :ARG1 (a2 / authority
                        :mod (e / each))
                    :ARG2 (b2 / business
                        :location (a / area
                            :poss a2)))))
        :ARG1-of (t / test-01
            :location a2)))

