# ::edge	name	op3	Command	n	0	
# ::edge	application	mod	government-organization	a5	g	
# ::edge	report-01	medium	application	r	a5	
(a4 / and
    :condition (s / scenario
        :ARG1-of (t / true-01))
    :op1 (a / activate-01
        :ARG1 (a3 / alert-01
            :mod (a2 / additional)))
    :op2 (r / report-01
        :ARG1 (e / event
            :ARG1-of t)
        :medium (a5 / application
            :mod (g / government-organization
                :name (n / name
                    :op1 "Home"
                    :op2 "Front"
                    :op3 "Command")))))

