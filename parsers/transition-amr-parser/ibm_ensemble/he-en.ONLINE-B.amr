(i / increase-01
    :ARG1 (r2 / repay-01
        :frequency (r / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m3 / month))))
    :ARG2 (m2 / monetary-quantity
        :quant 125
        :unit (d2 / dollar))
    :condition (m4 / mortgage-01
        :ARG1-of (a / amount-01
            :ARG2 (m / monetary-quantity
                :quant 1200000
                :unit (d / dollar)))
        :ARG1-of (c / consist-01
            :ARG2 (t2 / track
                :mod (i2 / interest
                    :mod (p2 / prime)
                    :mod (p / percentage-entity
                        :value 40))))))

# ::tok How much has the average mortgage become more expensive since the beginning of the year ?
