# ::tok If the interest rate increases by half a percent - how much more expensive will the monthly payment on the mortgage be ?
# ::node	h	have-degree-91	0-1
# ::node	i2	interest	2-3
# ::node	r	rate	3-4
# ::node	i	increase-01	4-5
# ::node	0	0.5	6-7
# ::node	p2	percentage-entity	8-9
# ::node	m2	more	12-13
# ::node	e	expensive	13-14
# ::node	r2	rate-entity-91	16-17
# ::node	t	temporal-quantity	16-17
# ::node	1	1	16-17
# ::node	m	month	16-17
# ::node	p	pay-01	17-18
# ::node	m3	mortgage-01	20-21
# ::node	a	amr-unknown	22-23
# ::root	h	have-degree-91
# ::edge	rate	mod	interest	r	i2	
# ::edge	increase-01	ARG1	rate	i	r	
# ::edge	have-degree-91	condition	increase-01	h	i	
# ::edge	percentage-entity	value	0.5	p2	0	
# ::edge	increase-01	ARG2	percentage-entity	i	p2	
# ::edge	have-degree-91	ARG3	more	h	m2	
# ::edge	have-degree-91	ARG2	expensive	h	e	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	quant	1	t	1	
# ::edge	temporal-quantity	unit	month	t	m	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	have-degree-91	ARG1	pay-01	h	p	
# ::edge	pay-01	ARG3	mortgage-01	p	m3	
# ::edge	more	quant	amr-unknown	m2	a	
(h / have-degree-91
    :ARG1 (p / pay-01
        :ARG3 (m3 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :ARG2 (e / expensive)
    :ARG3 (m2 / more
        :quant (a / amr-unknown))
    :condition (i / increase-01
        :ARG1 (r / rate
            :mod (i2 / interest))
        :ARG2 (p2 / percentage-entity
            :value 0.5)))

