    :ARG0 (i / index)
    :ARG1 (a / authority)
    :ARG1-of (c2 / conform-01
        :ARG2 (n / number
            :quant-of (p / person
                :ARG0-of (i2 / inhabit-01))))
    :ARG1-of (c / cause-01
        :ARG0 (r / resemble-01
            :ARG1 (a2 / authority
                :ARG1-of (l / local-02)
                :consist-of (p2 / person
                    :quant (u / up-to
                        :op1 50000)
                    :ARG0-of (i3 / inhabit-01)))
            :ARG2 (a3 / authority
                :ARG1-of l
