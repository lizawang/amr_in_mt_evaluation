(b / become-01
    :quant (a / amr-unknown)
    :ARG1 (m2 / mortgage-01
        :ARG1-of (a2 / average-04))
    :ARG2 (e / expensive
        :ARG2-of (h / have-degree-91
            :ARG1 m2
            :ARG3 (m / more)))
    :time (s / since
        :op1 (b2 / begin-01
            :ARG1 (y / year))))

