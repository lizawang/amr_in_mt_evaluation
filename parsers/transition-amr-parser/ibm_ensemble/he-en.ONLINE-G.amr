# ::node	e3	examine-01	13-14
# ::node	l	level	15-16
# ::node	f2	friendly-01	18-19
# ::node	b2	business	24-25
# ::node	f	field	27-28
# ::root	b	base-02
# ::edge	base-02	ARG1	index	b	i	
# ::edge	parameter	quant	several	p	s	
# ::edge	base-02	ARG2	parameter	b	p	
# ::edge	parameter	ARG1-of	examine-01	p	e2	
# ::edge	authority	mod	each	a	e	
# ::edge	examine-01	ARG0	authority	e2	a	
# ::edge	parameter	ARG0-of	examine-01	p	e3	
# ::edge	examine-01	ARG1	level	e3	l	
# ::edge	level	degree-of	friendly-01	l	f2	
# ::edge	friendly-01	ARG1	authority	f2	a	
# ::edge	friendly-01	ARG2	business	f2	b2	
# ::edge	business	location	field	b2	f	
# ::edge	field	poss	authority	f	a	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (e3 / examine-01
            :ARG1 (l / level
                :degree-of (f2 / friendly-01
                    :ARG1 (a / authority
                        :mod (e / each))
                    :ARG2 (b2 / business
                        :location (f / field
                            :poss a)))))
        :ARG1-of (e2 / examine-01
            :ARG0 a)))

