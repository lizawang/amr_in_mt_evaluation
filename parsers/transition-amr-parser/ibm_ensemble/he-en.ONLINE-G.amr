    :op1 (u / update-01
        :ARG1 (i / index)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (y / year))))
    :op2 (w / weigh-01
        :ARG1 i
        :ARG3 (r / rate-01
            :quant 4
            :ARG1 (a5 / authority
                :ARG1-of (l / local-02)
                :mod (e / each))
            :ARG1-of (d / differ-02)
            :ARG2 (a4 / and
                :op1 (s / satisfy-01
                    :ARG1 (b / business))
