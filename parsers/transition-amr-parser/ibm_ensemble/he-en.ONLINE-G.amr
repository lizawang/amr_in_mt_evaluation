(d / divide-02
    :ARG0 (m / measure-02)
    :ARG1 (a / authority)
    :ARG1-of (c3 / conform-01
        :ARG2 (n / number
            :quant-of (p / person
                :ARG0-of (r / reside-01))))
    :ARG1-of (c / cause-01
        :ARG0 (c2 / comparable-03
            :ARG1 (a2 / authority
                :ARG1-of (l / local-02)
                :consist-of (p2 / person
                    :quant (u / up-to
                        :op1 50000)
                    :ARG0-of (r2 / reside-01)))
            :ARG2 (a3 / authority
                :ARG1-of (l2 / local-02)
                :consist-of (p3 / person
                    :quant (m2 / more-than
                        :op1 150000)
                    :ARG0-of (r3 / reside-01)))
            :polarity -))
    :ARG2 (g / group
        :quant 3
        :ARG1-of (s / size-01)))

# ::tok Tel Aviv surged this year
