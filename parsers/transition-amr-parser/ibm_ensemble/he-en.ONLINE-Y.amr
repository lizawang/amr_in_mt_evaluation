# ::edge	pay-01	ARG1	monetary-quantity	p	m2	
# ::edge	monetary-quantity	unit	dollar	m2	d	
# ::edge	monetary-quantity	quant	100	m2	0	
(p / pay-01
    :ARG0 (y / you)
    :ARG1 (m2 / monetary-quantity
        :quant 100
        :unit (d / dollar))
    :condition (w / want-01
        :ARG0 y
        :ARG1 (a / add-02
            :ARG0 y
            :ARG1 (s / suitcase
                :ARG1-of (w2 / weigh-01
                    :ARG3 (m / mass-quantity
                        :quant 23
                        :unit (p2 / pound)))
                :mod (l / large)))))

