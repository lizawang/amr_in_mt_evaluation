    :ARG1 (e / expensive
        :degree (a / amr-unknown)
        :domain (p / pay-01
            :ARG3 (m2 / mortgage-01)
            :frequency (r2 / rate-entity-91
                :ARG3 (t / temporal-quantity
                    :quant 1
                    :unit (m / month)))))
    :ARG2 (r3 / rise-01
        :ARG1 (r / rate
            :mod (i / interest))
        :ARG2 (p2 / percentage-entity
            :value 0.5)))

