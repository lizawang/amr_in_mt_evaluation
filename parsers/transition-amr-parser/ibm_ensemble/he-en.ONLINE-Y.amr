# ::edge	suitcase	mod	large	s	l	
# ::edge	add-02	ARG1	suitcase	a	s	
# ::edge	suitcase	ARG1-of	weigh-01	s	w2	
# ::edge	mass-quantity	quant	23	m	1	
# ::edge	weigh-01	ARG3	mass-quantity	w2	m	
# ::edge	mass-quantity	unit	pound	m	p2	
# ::edge	add-02	ARG0	you	a	y	
