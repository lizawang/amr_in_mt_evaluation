(o / offer-01
    :ARG0 (p / passenger)
    :ARG1 (a2 / and
        :op1 (l / luggage
            :quant (m / mass-quantity
                :quant 23
                :unit (p3 / pound)))
        :op2 (s / suitcase
            :mod (t / trolley)))
    :ARG3 (p2 / passenger)
    :ARG3 (a / and
        :op1 (c / city
            :name (n2 / name
                :op1 "New"
                :op2 "York"))
        :op2 (c2 / city
            :name (n3 / name
                :op1 "Miami")))
    :location (c3 / company
        :name (n / name
            :op1 "American"
            :op2 "Airlines")))

# ::tok If you want to add a large suitcase weighing 23 pounds you will pay $ 100 towards .
