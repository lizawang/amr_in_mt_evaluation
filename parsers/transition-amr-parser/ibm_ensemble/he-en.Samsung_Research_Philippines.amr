# ::node	0	Company	0-1
# ::node	c	company	1-2
# ::root	c	company
# ::edge	name	op1	Tinpot	n	1	
# ::edge	name	op2	Company	n	0	
# ::edge	company	name	name	c	n	
(c / company
    :name (n / name
        :op1 "Tinpot"
        :op2 "Company"))

