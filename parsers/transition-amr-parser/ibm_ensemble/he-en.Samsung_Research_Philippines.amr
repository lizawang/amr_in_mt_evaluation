(f / fly-01
    :ARG2 (a / and
        :op1 (v / vacation-01)
        :op2 (c / coronavirus)))

# ::tok To all the members of the Ghastly ... Ali !
# ::node	s	say-01	0-1
# ::node	a	all	1-2
# ::node	p	person	3-4
# ::node	h	have-org-role-91	3-4
# ::node	m	member	3-4
# ::node	f	family	6-7
# ::node	n	name	6-7
# ::node	1	Ghastly	6-7
# ::node	p2	person	8-9
# ::node	n2	name	8-9
# ::node	0	Ali	8-9
# ::root	s	say-01
# ::edge	person	mod	all	p	a	
# ::edge	say-01	ARG2	person	s	p	
# ::edge	person	ARG0-of	have-org-role-91	p	h	
# ::edge	have-org-role-91	ARG2	member	h	m	
# ::edge	have-org-role-91	ARG1	family	h	f	
# ::edge	family	name	name	f	n	
# ::edge	name	op1	Ghastly	n	1	
# ::edge	say-01	ARG1	person	s	p2	
# ::edge	person	name	name	p2	n2	
# ::edge	name	op1	Ali	n2	0	
(s / say-01
    :ARG1 (p2 / person
        :name (n2 / name
            :op1 "Ali"))
    :ARG2 (p / person
        :ARG0-of (h / have-org-role-91
            :ARG1 (f / family
                :name (n / name
                    :op1 "Ghastly"))
            :ARG2 (m / member))
        :mod (a / all)))

