(t2 / time
    :ARG1-of (c / cause-01
        :ARG0 (a / allow-01
            :ARG0 (i / it)
            :ARG1 (c2 / compare-01
                :ARG0 (a2 / authority
                    :mod (e / each))
                :ARG1 (p2 / perform-02
                    :ARG0 a2)
                :ARG2 (a3 / authority
                    :mod (o2 / other))
                :ARG3 (p / parameter
                    :mod (v / variety)))))
    :domain (t / this)
    :ord (o / ordinal-entity
        :value 5))

# ::tok The index is based on several parameters tested by each authority , which test the level of " friendliness " of the business in its field .
# ::node	i	index	1-2
# ::node	b	base-02	3-4
# ::node	s	several	5-6
# ::node	p	parameter	6-7
# ::node	t	test-01	7-8
# ::node	e	each	9-10
# ::node	a	authority	10-11
# ::node	t2	test-01	13-14
# ::node	l	level	15-16
# ::node	f2	friendly-01	18-19
# ::node	b2	business	22-23
# ::node	f	field	25-26
# ::root	b	base-02
# ::edge	base-02	ARG1	index	b	i	
# ::edge	parameter	quant	several	p	s	
# ::edge	base-02	ARG2	parameter	b	p	
# ::edge	parameter	ARG1-of	test-01	p	t	
# ::edge	authority	mod	each	a	e	
# ::edge	test-01	ARG0	authority	t	a	
# ::edge	parameter	ARG0-of	test-01	p	t2	
# ::edge	test-01	ARG1	level	t2	l	
# ::edge	level	degree-of	friendly-01	l	f2	
# ::edge	friendly-01	ARG1	business	f2	b2	
# ::edge	field	poss	business	f	b2	
# ::edge	business	location	field	b2	f	
(b / base-02
    :ARG1 (i / index)
    :ARG2 (p / parameter
        :quant (s / several)
        :ARG0-of (t2 / test-01
            :ARG1 (l / level
                :degree-of (f2 / friendly-01
                    :ARG1 (b2 / business
                        :location (f / field
                            :poss b2)))))
        :ARG1-of (t / test-01
            :ARG0 (a / authority
                :mod (e / each)))))

# ::tok The index divides municipalities into three size groups by number of residents , as a municipality of up to 50,000 does not resemble a municipality .
# ::node	i	index	1-2
# ::node	d	divide-02	2-3
# ::node	m	municipality	3-4
# ::node	1	3	5-6
# ::node	s	size	6-7
# ::node	g	group	7-8
# ::node	n	number	9-10
# ::node	p	person	11-12
# ::node	r2	reside-01	11-12
# ::node	c	cause-01	13-14
# ::node	m2	municipality	15-16
# ::node	u	up-to	17-18
# ::node	2	50000	19-20
# ::node	0	-	21-22
# ::node	r	resemble-01	22-23
# ::root	d	divide-02
# ::edge	divide-02	ARG0	index	d	i	
# ::edge	divide-02	ARG1	municipality	d	m	
# ::edge	group	mod	size	g	s	
# ::edge	group	quant	3	g	1	
# ::edge	divide-02	ARG2	group	d	g	
# ::edge	divide-02	ARG3	number	d	n	
# ::edge	number	quant-of	person	n	p	
# ::edge	person	ARG0-of	reside-01	p	r2	
# ::edge	divide-02	ARG1-of	cause-01	d	c	
# ::edge	municipality	quant	up-to	m2	u	
# ::edge	up-to	op1	50000	u	2	
# ::edge	resemble-01	polarity	-	r	0	
# ::edge	resemble-01	ARG1	municipality	r	m2	
# ::edge	cause-01	ARG0	resemble-01	c	r	
# ::edge	resemble-01	ARG2	municipality	r	m	
(d / divide-02
    :ARG0 (i / index)
    :ARG1 (m / municipality)
    :ARG1-of (c / cause-01
        :ARG0 (r / resemble-01
            :ARG1 (m2 / municipality
                :quant (u / up-to
                    :op1 50000))
            :ARG2 m
            :polarity -))
    :ARG2 (g / group
        :quant 3
        :mod (s / size))
    :ARG3 (n / number
        :quant-of (p / person
            :ARG0-of (r2 / reside-01))))

