        :ARG1-of (l / low-04)))

# ::tok No luggage , no seat selection , probably no taxes and no food .
# ::node	0	-	0-1
# ::node	l	luggage	1-2
# ::node	1	-	3-4
# ::node	s	seat	4-5
# ::node	s2	select-01	5-6
# ::node	p	probable	7-8
# ::node	2	-	8-9
# ::node	t	tax-01	9-10
# ::node	a	and	10-11
# ::node	3	-	11-12
# ::node	f	food	12-13
# ::root	a	and
# ::edge	luggage	polarity	-	l	0	
# ::edge	select-01	ARG1	seat	s2	s	
# ::edge	select-01	polarity	-	s2	1	
# ::edge	tax-01	polarity	-	t	2	
# ::edge	tax-01	mod	probable	t	p	
# ::edge	and	op3	tax-01	a	t	
# ::edge	and	op2	select-01	a	s2	
# ::edge	and	op1	luggage	a	l	
# ::edge	food	polarity	-	f	3	
# ::edge	and	op4	food	a	f	
(a / and
    :op1 (l / luggage
        :polarity -)
    :op2 (s2 / select-01
        :ARG1 (s / seat)
        :polarity -)
    :op3 (t / tax-01
        :mod (p / probable)
        :polarity -)
    :op4 (f / food
        :polarity -))

