    :op1 (u / update-01
        :ARG1 (i / index)
        :frequency (r2 / rate-entity-91
            :ARG1 1
            :ARG2 (t2 / temporal-quantity
                :quant 1
                :unit (y / year))))
    :op2 (w / weigh-01
        :ARG1 i
        :ARG3 (r / rank-01
            :quant 4
            :ARG0 (a4 / authority
                :ARG1-of (l / local-02)
                :mod (e / each))
            :ARG1-of (d / differ-02)
            :ARG1-of (m / mean-01
                :ARG2 (a3 / and
                    :op1 (s / satisfy-01
                        :ARG1 (b / business))
                    :op2 (a / access-01
                        :ARG1 (t3 / tender-01))
                    :op3 (t / tax-01))))))

