                    :ARG1-of (b2 / bear-02))
                :ARG1-of (e2 / express-01
                    :ARG0 (p / palsy
                        :mod (c3 / cerebrum))
                    :frequency (s / sometimes)
                    :mod (e / even))))
        :ARG2 (i / identify-01
            :ARG1 (d3 / distress-01
                :ARG1 (f2 / fetus))
            :time (p3 / prior
                :op1 (b / bear-02
