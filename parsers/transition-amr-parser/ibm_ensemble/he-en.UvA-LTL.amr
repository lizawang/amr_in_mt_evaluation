# ::node	p	possible-01	19-20
# ::node	f	fit-01	20-21
# ::node	u	under	21-22
# ::node	s	seat	23-24
# ::root	a	allow-01
# ::edge	company	name	name	c	n	
# ::edge	name	op1	EasyJet	n	3	
