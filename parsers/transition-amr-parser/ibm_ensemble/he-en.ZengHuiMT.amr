(a / and
    :op1 (p / person
        :ARG0-of (c / cheat-03)
        :ARG0-of (c4 / control-01
            :ARG1 (c3 / company))
        :accompanier (p2 / person
            :ARG0-of (h / have-rel-role-91
                :ARG1 p
                :ARG2 (s2 / son))
            :ARG1-of (s / screw-up-01))
