# ::edge	wing	part-of	plane	w	p2	
(p3 / put-01
    :ARG0 (p / person
        :ARG0-of (b / buy-01
            :ARG1 (t2 / ticket)
            :location (c / company
                :name (n / name
                    :op1 "Elel")))
        :mod (t / that))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing
        :part-of (p2 / plane)))

