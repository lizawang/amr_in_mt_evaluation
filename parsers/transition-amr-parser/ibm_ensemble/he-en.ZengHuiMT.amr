# ::edge	and	time	then	a	t	
# ::edge	and	op2	offer-01	a	o	
# ::edge	offer-01	ARG0	company	o	c2	
# ::edge	offer-01	ARG1	voucher	o	v	
# ::edge	worth-01	polarity	-	w	0	
# ::edge	voucher	ARG1-of	worth-01	v	w	
(a / and
    :op1 (c / cancel-01
        :ARG0 (c2 / company)
        :ARG1 (f / fly-01))
    :op2 (o / offer-01
        :ARG0 c2
        :ARG1 (v / voucher
            :ARG1-of (w / worth-01
                :polarity -)))
    :time (t / then))

