# ::edge	number	quant-of	citizen	n	c2	
# ::edge	divide-02	ARG1-of	cause-01	d2	c	
# ::edge	authority	ARG1-of	local-02	a2	l	
# ::edge	up-to	op1	50000	u	2	
# ::edge	person	quant	up-to	p	u	
# ::edge	authority	poss	person	a2	p	
# ::edge	person	ARG0-of	inhabit-01	p	i2	
