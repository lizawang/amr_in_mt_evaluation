# ::edge	examine-01	ARG1	level	e2	l	
# ::edge	level	degree-of	friendly-01	l	f	
# ::edge	friendly-01	ARG1	authority	f	a2	
# ::edge	friendly-01	ARG2	business	f	b2	
# ::edge	business	location	region	b2	r	
# ::edge	region	poss	authority	r	a2	
(a / and
    :op1 (b / base-02
        :ARG1 (i / index)
        :ARG2 (p / parameter
            :quant (s / several)
            :ARG1-of (t / test-01
                :location (a2 / authority
                    :mod (e / each)))))
    :op2 (e2 / examine-01
        :ARG0 i
        :ARG1 (l / level
            :degree-of (f / friendly-01
                :ARG1 a2
                :ARG2 (b2 / business
                    :location (r / region
                        :poss a2))))))

# ::tok The index divides the authorities into three size groups according to the number of citizens , since a local authority of up to 50 thousand inhabitants is different from a local authority of more than 150 thousand citizens .
