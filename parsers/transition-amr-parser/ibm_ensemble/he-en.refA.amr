# ::edge	and	op2	plan	a3	p2	
(c / cause-01
    :ARG0 (i / increase-01
        :ARG1 (r / rate
            :mod (i3 / interest))
        :location (p / plan
            :ARG0-of (c2 / comprise-01
                :ARG1 (a2 / and
                    :op1 (m / mortgage-01)
                    :op2 (t2 / track
                        :mod (p3 / prime)
                        :mod (j / just
                            :polarity -))
                    :poss (a3 / and
                        :op1 (t3 / track
                            :ARG1-of (l / link-01
                                :ARG2 (i2 / index)))
                        :op2 (p2 / plan
                            :mod (i4 / interest
                                :ARG1-of (f / fix-03))))))
            :mod (o / other))
        :mod (a / also))
    :ARG1 (t / this))

