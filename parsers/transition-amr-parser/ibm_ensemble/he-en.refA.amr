(d2 / divide-02
    :ARG0 (i / index)
    :ARG1 (a / authority)
    :ARG1-of (c4 / conform-01
        :ARG2 (n / number
            :quant-of (c2 / citizen)))
    :ARG1-of (c / cause-01
        :ARG0 (d / differ-02
            :ARG1 (a2 / authority
                :ARG1-of (l / local-02)
                :poss (p / person
                    :quant (u / up-to
                        :op1 50000)
                    :ARG0-of (i2 / inhabit-01)))
            :ARG2 (a3 / authority
                :ARG1-of l
                :consist-of (c3 / citizen
                    :quant (m / more-than
                        :op1 150000)))))
    :ARG2 (g / group
        :mod (s / size
            :quant 3)))

