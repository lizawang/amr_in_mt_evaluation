# ::edge	rate	mod	interest	r	i3	
# ::edge	increase-01	mod	also	i	a	
# ::edge	increase-01	ARG1	rate	i	r	
# ::edge	cause-01	ARG0	increase-01	c	i	
# ::edge	plan	mod	other	p	o	
# ::edge	increase-01	location	plan	i	p	
# ::edge	plan	ARG0-of	comprise-01	p	c2	
# ::edge	and	op1	mortgage-01	a2	m	
# ::edge	comprise-01	ARG1	and	c2	a2	
# ::edge	just	polarity	-	j	0	
# ::edge	track	mod	prime	t2	p3	
# ::edge	track	mod	just	t2	j	
# ::edge	and	op2	track	a2	t2	
