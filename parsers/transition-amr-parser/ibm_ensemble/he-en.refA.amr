# ::edge	divide-02	ARG1	authority	d2	a	
# ::edge	size	quant	3	s	1	
# ::edge	group	mod	size	g	s	
# ::edge	divide-02	ARG2	group	d2	g	
# ::edge	divide-02	ARG1-of	conform-01	d2	c4	
