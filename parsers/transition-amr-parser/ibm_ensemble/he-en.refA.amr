(c / check-01
    :ARG0 (w / we)
    :ARG1 (a / and
        :op1 (m / monetary-quantity
            :ARG1-of (h / have-quant-91
                :ARG3 (m2 / more))
            :ARG1-of (p / pay-01
                :ARG0 w))
        :op2 (t / thing
            :ARG1-of (d / do-02
                :ARG0 w
                :ARG1-of (r / recommend-01)
                :time (n2 / now
                    :mod (r2 / right)))))
    :ARG1-of (h2 / help-01
        :ARG0 (p2 / person
            :name (n / name
                :op1 "Shai"
                :op2 "Zror")
            :ARG1-of (e / expert-01
                :ARG2 (m3 / mortgage-01)))))

# ::tok If the interest rate increases by half a percent—how much more expensive will the monthly payment on the mortgage be ?
# ::node	h	have-degree-91	0-1
# ::node	i2	interest	2-3
# ::node	r	rate	3-4
# ::node	i	increase-01	4-5
# ::node	0	0.5	6-7
# ::node	m2	more	10-11
# ::node	e	expensive	11-12
# ::node	r2	rate-entity-91	14-15
# ::node	t	temporal-quantity	14-15
# ::node	1	1	14-15
# ::node	m	month	14-15
# ::node	p	pay-01	15-16
# ::node	m3	mortgage-01	18-19
# ::node	a	amr-unknown	20-21
# ::root	h	have-degree-91
# ::edge	rate	mod	interest	r	i2	
# ::edge	increase-01	ARG1	rate	i	r	
# ::edge	have-degree-91	condition	increase-01	h	i	
# ::edge	more	quant	0.5	m2	0	
# ::edge	have-degree-91	ARG3	more	h	m2	
# ::edge	have-degree-91	ARG2	expensive	h	e	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r2	t	
# ::edge	temporal-quantity	quant	1	t	1	
# ::edge	temporal-quantity	unit	month	t	m	
# ::edge	pay-01	frequency	rate-entity-91	p	r2	
# ::edge	have-degree-91	ARG1	pay-01	h	p	
# ::edge	pay-01	ARG3	mortgage-01	p	m3	
# ::edge	have-degree-91	polarity	amr-unknown	h	a	
(h / have-degree-91
    :ARG1 (p / pay-01
        :ARG3 (m3 / mortgage-01)
        :frequency (r2 / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m / month))))
    :ARG2 (e / expensive)
    :ARG3 (m2 / more
        :quant 0.5)
    :condition (i / increase-01
        :ARG1 (r / rate
            :mod (i2 / interest)))
    :polarity (a / amr-unknown))

# ::tok For a mortgage in the amount of 1.2 million NIS , which consists of a 40 % prime interest plan , the monthly repayment will increase by 125 NIS .
# ::node	m4	mortgage-01	2-3
# ::node	a	amount-01	5-6
# ::node	1	1200000	7-8
# ::node	m	monetary-quantity	9-10
# ::node	p3	pound	9-10
# ::node	c	consist-01	12-13
# ::node	3	40	15-16
# ::node	p	percentage-entity	16-17
# ::node	p5	prime	17-18
# ::node	i2	interest	18-19
# ::node	p2	plan	19-20
# ::node	r	rate-entity-91	22-23
# ::node	t	temporal-quantity	22-23
# ::node	0	1	22-23
# ::node	m3	month	22-23
# ::node	r2	repay-01	23-24
# ::node	i	increase-01	25-26
# ::node	2	125	27-28
# ::node	m2	monetary-quantity	28-29
# ::node	p4	pound	28-29
# ::root	i	increase-01
# ::edge	mortgage-01	ARG1-of	amount-01	m4	a	
# ::edge	monetary-quantity	quant	1200000	m	1	
# ::edge	amount-01	ARG2	monetary-quantity	a	m	
# ::edge	monetary-quantity	unit	pound	m	p3	
# ::edge	mortgage-01	ARG1-of	consist-01	m4	c	
# ::edge	percentage-entity	value	40	p	3	
# ::edge	interest	mod	prime	i2	p5	
# ::edge	plan	mod	interest	p2	i2	
# ::edge	plan	mod	percentage-entity	p2	p	
# ::edge	consist-01	ARG2	plan	c	p2	
# ::edge	rate-entity-91	ARG3	temporal-quantity	r	t	
# ::edge	temporal-quantity	quant	1	t	0	
# ::edge	temporal-quantity	unit	month	t	m3	
# ::edge	repay-01	frequency	rate-entity-91	r2	r	
# ::edge	increase-01	ARG1	repay-01	i	r2	
# ::edge	increase-01	condition	mortgage-01	i	m4	
# ::edge	monetary-quantity	quant	125	m2	2	
# ::edge	increase-01	ARG2	monetary-quantity	i	m2	
# ::edge	monetary-quantity	unit	pound	m2	p4	
(i / increase-01
    :ARG1 (r2 / repay-01
        :frequency (r / rate-entity-91
            :ARG3 (t / temporal-quantity
                :quant 1
                :unit (m3 / month))))
    :ARG2 (m2 / monetary-quantity
        :quant 125
        :unit (p4 / pound))
    :condition (m4 / mortgage-01
        :ARG1-of (a / amount-01
            :ARG2 (m / monetary-quantity
                :quant 1200000
                :unit (p3 / pound)))
        :ARG1-of (c / consist-01
            :ARG2 (p2 / plan
                :mod (i2 / interest
                    :mod (p5 / prime))
                :mod (p / percentage-entity
                    :value 40)))))

# ::tok By how much has the average mortgage become more expensive since the beginning of this year ?
# ::node	a2	average-04	5-6
# ::node	m2	mortgage-01	6-7
# ::node	b	become-01	7-8
# ::node	h	have-degree-91	8-9
# ::node	m	more	8-9
# ::node	e	expensive	9-10
# ::node	s	since	10-11
# ::node	b2	begin-01	12-13
# ::node	t	this	14-15
# ::node	y	year	15-16
# ::node	a	amr-unknown	16-17
# ::root	b	become-01
# ::edge	mortgage-01	ARG1-of	average-04	m2	a2	
# ::edge	become-01	ARG1	mortgage-01	b	m2	
# ::edge	have-degree-91	ARG1	mortgage-01	h	m2	
# ::edge	have-degree-91	ARG3	more	h	m	
# ::edge	expensive	ARG2-of	have-degree-91	e	h	
# ::edge	become-01	ARG2	expensive	b	e	
# ::edge	become-01	time	since	b	s	
# ::edge	since	op1	begin-01	s	b2	
# ::edge	year	mod	this	y	t	
# ::edge	begin-01	ARG1	year	b2	y	
# ::edge	become-01	quant	amr-unknown	b	a	
(b / become-01
    :quant (a / amr-unknown)
    :ARG1 (m2 / mortgage-01
        :ARG1-of (a2 / average-04))
    :ARG2 (e / expensive
        :ARG2-of (h / have-degree-91
            :ARG1 m2
            :ARG3 (m / more)))
    :time (s / since
        :op1 (b2 / begin-01
            :ARG1 (y / year
                :mod (t / this)))))

# ::tok Since the beginning of the year , there has been a significantly sharper increase .
# ::node	s3	since	0-1
# ::node	b	begin-01	2-3
# ::node	h	have-degree-91	3-4
# ::node	y	year	5-6
# ::node	m	more	10-11
