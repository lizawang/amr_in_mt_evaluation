# ::edge	increase-01	ARG1-of	have-degree-91	i	h	
# ::edge	increase-01	time	since	i	s3	
(i / increase-01
    :ARG1-of (h / have-degree-91
        :ARG2 (s / sharp-02
            :ARG1 i
            :ARG1-of (s2 / significant-02))
        :ARG3 (m / more))
    :time (s3 / since
        :op1 (b / begin-01
            :ARG1 (y / year))))

# ::tok This is due to the interest rates have also gone up on the other plans that comprise a mortgage ( and not just the prime track ) —of the index - linked track and the fixed interest plan .
