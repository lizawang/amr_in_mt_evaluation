# ::node	n2	name	8-9
# ::node	1	EasyJet	8-9
# ::node	c3	cost-01	9-10
# ::node	0	70	10-11
# ::node	m	monetary-quantity	11-12
# ::node	e	euro	11-12
# ::root	c3	cost-01
# ::edge	fly-01	destination	city	f	c	
# ::edge	city	name	name	c	n	
# ::edge	name	op1	Geneva	n	2	
# ::edge	fly-01	mod	round-trip	f	r	
# ::edge	fly-01	instrument	company	f	c2	
# ::edge	company	name	name	c2	n2	
# ::edge	name	op1	EasyJet	n2	1	
# ::edge	cost-01	ARG1	fly-01	c3	f	
# ::edge	monetary-quantity	quant	70	m	0	
# ::edge	cost-01	ARG2	monetary-quantity	c3	m	
# ::edge	monetary-quantity	unit	euro	m	e	
(c3 / cost-01
    :ARG1 (f / fly-01
        :destination (c / city
            :name (n / name
                :op1 "Geneva"))
        :instrument (c2 / company
            :name (n2 / name
                :op1 "EasyJet"))
        :mod (r / round-trip))
    :ARG2 (m / monetary-quantity
        :quant 70
        :unit (e / euro)))

