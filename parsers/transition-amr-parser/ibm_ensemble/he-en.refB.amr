# ::edge	end-01	time	high-02	e	h	
# ::edge	end-01	ARG1	isolate-01	e	i	
# ::edge	isolate-01	ARG2	return-01	i	r	
# ::edge	return-01	ARG3	abroad	r	a	
# ::edge	end-01	polarity	amr-unknown	e	a2	
(e / end-01
    :ARG1 (i / isolate-01
        :ARG2 (r / return-01
            :ARG3 (a / abroad)))
    :polarity (a2 / amr-unknown)
    :time (h / high-02
        :ARG1 (p / pandemic)))

