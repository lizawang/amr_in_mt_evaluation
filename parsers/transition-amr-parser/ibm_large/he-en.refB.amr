            :ARG0-of (p3 / purchase-01
                :ARG1 (t / ticket
                    :mod (b / basic))))
        :accompanier (i / item.
            :ARG1-of (p2 / personal-02)
            :mod (o / only))))

# ::tok If you want to add checked baggage beyond that, the price varies depending on the type of ticket you purchased and the destination, prices can reach several hundreds of shekels (150-290 per way) for suitcase, depending on the suitcase's weight.
