    :ARG0 (t / thing
        :ARG1-of (e / estimate-01
            :ARG0 (p3 / person)))
    :ARG1 (r2 / rate
        :ARG1-of (r / range-01
            :ARG3 (p / percentage-entity
                :value 0.25%)
            :ARG4 (p2 / percentage-entity
                :value 0.5%.))
        :mod (i / increase-01)))

