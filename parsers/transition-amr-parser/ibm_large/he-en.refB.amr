(s / stand-01
    :ARG1 (r / rate
        :mod (i3 / interest))
    :ARG2 (l / level
        :quant 1.25%,
        :ARG1-of (h2 / have-degree-91
            :ARG2 (h3 / high-02)
            :ARG3 (m / most)
            :time (b / before
                :duration (t / temporal-quantity
                    :quant 9
                    :unit (y / year))
                :op1 (n / now))))
    :condition (i / increase-01
        :ARG1 r
        :ARG2 (h / half)
        :mod (i2 / indeed)))

