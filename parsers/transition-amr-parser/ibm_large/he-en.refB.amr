# ::node	0	50	5-6
# ::root	c	cost-01
# ::edge	facility	name	name	f	n	
# ::edge	name	op1	El	n	2	
# ::edge	name	op2	Al,	n	1	
# ::edge	cost-01	ARG1	one-way	c	o	
# ::edge	cost-01	location	facility	c	f	
# ::edge	cost-01	ARG2	monetary-quantity	c	m	
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	monetary-quantity	quant	50	m	0	
(c / cost-01
    :ARG1 (o / one-way)
    :ARG2 (m / monetary-quantity
        :quant 50
        :unit (d / dollar))
    :location (f / facility
        :name (n / name
            :op1 "El"
            :op2 "Al,")))

# ::tok I won't buy even for $10 from that religious scammer who controls the company together with his idiotic son, non-stop scammers...
# ::node	i	i	0-1
# ::node	0	-	1-2
# ::node	b	buy-01	2-3
# ::node	e	even	3-4
# ::node	m	monetary-quantity	5-6
# ::node	d	dollar	5-6
# ::node	2	10	5-6
# ::node	r	religion	8-9
# ::node	p	person	9-10
# ::node	s	scam-01	9-10
# ::node	c2	control-01	11-12
# ::node	c	company	13-14
# ::node	i2	idiotic	17-18
# ::node	s3	stop-01	19-20
# ::node	1	-	19-20
# ::node	p2	person	20-21
# ::node	s2	scam-01	20-21
# ::root	b	buy-01
# ::edge	buy-01	polarity	-	b	0	
# ::edge	buy-01	ARG0	i	b	i	
# ::edge	buy-01	mod	even	b	e	
# ::edge	buy-01	ARG3	monetary-quantity	b	m	
# ::edge	monetary-quantity	unit	dollar	m	d	
# ::edge	monetary-quantity	quant	10	m	2	
# ::edge	person	mod	religion	p	r	
# ::edge	buy-01	ARG2	person	b	p	
# ::edge	person	ARG0-of	scam-01	p	s	
# ::edge	person	ARG0-of	control-01	p	c2	
# ::edge	control-01	ARG1	company	c2	c	
# ::edge	stop-01	polarity	-	s3	1	
# ::edge	person	ARG1-of	stop-01	p2	s3	
# ::edge	person	mod	idiotic	p2	i2	
# ::edge	person	accompanier	person	p	p2	
# ::edge	person	ARG0-of	scam-01	p2	s2	
(b / buy-01
    :ARG0 (i / i)
    :ARG2 (p / person
        :ARG0-of (s / scam-01)
        :ARG0-of (c2 / control-01
            :ARG1 (c / company))
        :accompanier (p2 / person
            :ARG0-of (s2 / scam-01)
            :ARG1-of (s3 / stop-01
                :polarity -)
            :mod (i2 / idiotic))
        :mod (r / religion))
    :ARG3 (m / monetary-quantity
        :quant 10
        :unit (d / dollar))
    :mod (e / even)
    :polarity -)

# ::tok And then the company will cancel the flights and offer worthless vouchers.
# ::node	a	and	0-1
# ::node	t	then	1-2
# ::node	c2	company	3-4
# ::node	c	cancel-01	5-6
# ::node	f	fly-01	7-8
# ::node	a2	and	8-9
# ::node	o	offer-01	9-10
# ::node	w	worth-02	10-11
# ::node	0	-	10-11
# ::node	v	voucher	11-12
# ::root	a	and
# ::edge	and	time	then	a	t	
# ::edge	cancel-01	ARG0	company	c	c2	
# ::edge	cancel-01	ARG1	fly-01	c	f	
# ::edge	and	op1	cancel-01	a2	c	
# ::edge	and	op2	and	a	a2	
# ::edge	and	op2	offer-01	a2	o	
# ::edge	offer-01	ARG0	company	o	c2	
# ::edge	worth-02	polarity	-	w	0	
# ::edge	voucher	ARG1-of	worth-02	v	w	
# ::edge	offer-01	ARG1	voucher	o	v	
(a / and
    :op2 (a2 / and
        :op1 (c / cancel-01
            :ARG0 (c2 / company)
            :ARG1 (f / fly-01))
        :op2 (o / offer-01
            :ARG0 c2
            :ARG1 (v / voucher
                :ARG1-of (w / worth-02
                    :polarity -))))
    :time (t / then))

# ::tok Because their implementation will come with an added price change.
