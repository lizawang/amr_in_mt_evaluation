# ::edge	monetary-quantity	quant	100	m2	0	
# ::edge	monetary-quantity	unit	pound	m2	p2	
# ::edge	between	op2	monetary-quantity	b2	m3	
# ::edge	reach-01	ARG0-of	depend-01	r2	d2	
# ::edge	depend-01	ARG1	weight.	d2	w2	
# ::edge	weight.	poss	baggage	w2	b	
(p / possible-01
    :ARG1 (r2 / reach-01
        :ARG0 (t2 / thing
            :ARG2-of (p4 / price-01))
        :ARG0-of (d2 / depend-01
            :ARG1 (w2 / weight.
                :poss (b / baggage
                    :ARG1-of (c / check-01))))
        :ARG1 (s / several
            :ARG1-of (r / rate-entity-91
                :ARG2 (b2 / between
                    :op1 (m2 / monetary-quantity
                        :quant 100
                        :unit (p2 / pound))
                    :op2 (m3 / monetary-quantity)))
            :op1 (m / monetary-quantity
                :quant 100
                :unit (s2 / she))))
    :condition (v / vary-01
        :ARG0-of (d / depend-01
            :ARG1 (a2 / and
                :op1 (t4 / type
                    :mod (t3 / ticket
                        :ARG1-of (p5 / purchase-01
                            :ARG0 (y / you))))))
        :ARG1 (t / thing
            :ARG2-of (p3 / price-01))
        :condition (w / want-01
            :ARG0 y
            :ARG1 (a / add-02
                :ARG0 y
                :ARG1 b
                :ARG4 (b3 / beyond)))))

# ::tok In EasyJet Airlines, you can bring a small bag with dimensions of 45*36*20 that can fit under the seat.
# ::node	c	company	1-2
# ::node	n	name	1-2
# ::node	2	EasyJet	1-2
# ::node	y	you	3-4
# ::node	p	possible-01	4-5
# ::node	b2	bring-01	5-6
# ::node	s2	small	7-8
# ::node	b	bag	8-9
# ::node	d	dimension	10-11
# ::node	r	ratio-of	12-13
# ::node	0	30	12-13
# ::node	1	40	12-13
# ::node	p2	possible-01	14-15
# ::node	f	fit-01	15-16
# ::node	u	under	16-17
# ::node	s	seat.	18-19
# ::root	p	possible-01
# ::edge	company	name	name	c	n	
# ::edge	name	op1	EasyJet	n	2	
# ::edge	possible-01	location	company	p	c	
# ::edge	possible-01	ARG1	bring-01	p	b2	
# ::edge	bring-01	ARG0	you	b2	y	
# ::edge	bag	mod	small	b	s2	
# ::edge	bring-01	ARG1	bag	b2	b	
# ::edge	bag	mod	dimension	b	d	
# ::edge	dimension	mod	ratio-of	d	r	
# ::edge	ratio-of	op1	30	r	0	
# ::edge	ratio-of	op2	40	r	1	
# ::edge	fit-01	ARG1-of	possible-01	f	p2	
# ::edge	bag	ARG1-of	fit-01	b	f	
# ::edge	fit-01	ARG2	under	f	u	
# ::edge	under	op1	seat.	u	s	
(p / possible-01
    :ARG1 (b2 / bring-01
        :ARG0 (y / you)
        :ARG1 (b / bag
            :ARG1-of (f / fit-01
                :ARG1-of (p2 / possible-01)
                :ARG2 (u / under
                    :op1 (s / seat.)))
            :mod (s2 / small)
            :mod (d / dimension
                :mod (r / ratio-of
                    :op1 30
                    :op2 40))))
    :location (c / company
        :name (n / name
            :op1 "EasyJet")))

