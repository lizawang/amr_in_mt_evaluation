    :ARG1 (p / prepare-01)
    :time (a / already)
    :time (d / date-entity
        :dayperiod (n / night)
        :time-of (a2 / and
            :op1 (r2 / return-01
                :ARG1 (i / i)
                :ARG3 (o / or
                    :op1 (s / show-04)
                    :op2 (w / workshop)))
            :op2 (c / cook-01
                :ARG0 i
                :ARG1 (e / everything
                    :ARG0-of (r / require-01
                        :ARG1 (c2 / cook-01
                            :ARG1-of (l / long-03)))
                    :example (a3 / and
                        :op1 (g / goulash,)
                        :op2 (r3 / roasts,)
                        :op3 (m / meat)))
                :time (u / until
                    :op1 (d2 / date-entity
                        :dayperiod (m2 / morning)
                        :time "3:00"))))
        :weekday (t / thursday)))

