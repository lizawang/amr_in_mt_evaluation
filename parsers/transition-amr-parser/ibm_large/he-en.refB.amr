# ::edge	implement-01	ARG1	they	i	t	
# ::edge	come-04	ARG1	implement-01	c3	i	
# ::edge	cause-01	ARG0	come-04	c	c3	
# ::edge	monetary-quantity	ARG1-of	add-02	m	a	
# ::edge	monetary-quantity	ARG2-of	price-01	m	p	
# ::edge	change-01	ARG1	monetary-quantity	c2	m	
# ::edge	come-04	ARG2	change-01	c3	c2	
(c / cause-01
    :ARG0 (c3 / come-04
        :ARG1 (i / implement-01
            :ARG1 (t / they))
        :ARG2 (c2 / change-01
            :ARG1 (m / monetary-quantity
                :ARG1-of (a / add-02)
                :ARG2-of (p / price-01)))))

# ::tok Those who purchase tickets with El Al put their money on the wing of the plane.
# ::node	p	person	0-1
# ::node	t	that	0-1
# ::node	p3	purchase-01	2-3
# ::node	t2	ticket	3-4
# ::node	c	company	5-6
# ::node	n	name	5-6
# ::node	1	El	5-6
# ::node	0	Al	6-7
# ::node	p4	put-01	7-8
# ::node	m	money	9-10
# ::node	w	wing	12-13
# ::node	p2	plane.	15-16
# ::root	p4	put-01
# ::edge	person	mod	that	p	t	
# ::edge	person	ARG0-of	purchase-01	p	p3	
# ::edge	purchase-01	ARG1	ticket	p3	t2	
# ::edge	purchase-01	accompanier	company	p3	c	
# ::edge	company	name	name	c	n	
# ::edge	name	op1	El	n	1	
# ::edge	name	op2	Al	n	0	
# ::edge	put-01	ARG0	person	p4	p	
# ::edge	put-01	ARG1	money	p4	m	
# ::edge	money	poss	person	m	p	
# ::edge	put-01	ARG2	wing	p4	w	
# ::edge	wing	part-of	plane.	w	p2	
(p4 / put-01
    :ARG0 (p / person
        :ARG0-of (p3 / purchase-01
            :ARG1 (t2 / ticket)
            :accompanier (c / company
                :name (n / name
                    :op1 "El"
                    :op2 "Al")))
        :mod (t / that))
    :ARG1 (m / money
        :poss p)
    :ARG2 (w / wing
        :part-of (p2 / plane.)))

