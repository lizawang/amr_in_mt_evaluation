# ::edge	see-01	mode	imperative	s	2	
# ::edge	figure	mod	3	f	1	
# ::edge	and	op2	figure	a2	f2	
# ::edge	and	op1	figure	a2	f	
# ::edge	see-01	ARG1	and	s	a2	
# ::edge	and	op3	table	a2	t	
# ::edge	table	mod	2.	t	0	
# ::edge	see-01	rel	code	s	c	
(s / see-01
    :purpose (a / allocate-01)
    :ARG0 (y / you)
    :ARG1 (a2 / and
        :op1 (f / figure
            :mod 3)
        :op2 (f2 / figure)
        :op3 (t / table
            :mod 2.))
    :mode imperative
    :rel (c / code
        :mod (d / double-byte)))

# ::tok Total: 23940 code points
# ::node	t	total-01	0-1
# ::node	0	23940	1-2
# ::node	c	code	2-3
# ::node	p	point	3-4
# ::root	t	total-01
# ::edge	point	mod	code	p	c	
# ::edge	point	quant	23940	p	0	
# ::edge	total-01	ARG2	point	t	p	
(t / total-01
    :ARG2 (p / point
        :quant 23940
        :mod (c / code)))

