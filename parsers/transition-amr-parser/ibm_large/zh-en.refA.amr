# ::edge	area	rel	name	a	n	
(a / area
    :location (r / relative-position
        :quant (d2 / distance-quantity
            :quant 192
            :unit (y / yard)))
    :mod (d3 / double-byte)
    :mod (b / byte
        :ord (o2 / ordinal-entity
            :value 1))
    :mod (d / distance-quantity
        :quant 192
        :unit b)
    :rel (o / ordinal-entity
        :value 1)
    :rel (n / name
        :op1 "0xA8~0xA9"))

