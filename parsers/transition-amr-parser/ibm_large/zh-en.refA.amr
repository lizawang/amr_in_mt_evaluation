(c / contrast-01
    :ARG1 (u / use-01
        :ARG0 (t / text)
        :ARG1 (n / notation
            :mod (h2 / hexadecimal))
        :ARG2 (n3 / numerical-quantity
            :ARG1-of (e / equal-01)
            :ARG1-of (m / mark-02
                :ARG2 (s / string-entity
                    :value 0x,))))
    :ARG2 (u2 / use-01
        :ARG1 (n2 / notation
            :mod (d / decimal))
        :ARG2 (v / value
            :ARG0-of (h / have-03
                :ARG1 (s2 / string-entity
                    :value 0x.)
                :polarity -))))

