# ::node	c	character	10-11
# ::node	o3	organize-01	11-12
# ::node	s	same-01	14-15
# ::node	o2	order-03	15-16
# ::node	d	double-byte	18-19
# ::node	o	one	20-21
# ::node	p	phone-number-entity	21-22
# ::node	2	2	21-22
# ::node	3	3	21-22
# ::node	u	url-entity	23-24
# ::node	0	0	23-24
# ::root	p2	point
# ::edge	point	mod	code	p2	c2	
# ::edge	point	quant	50400	p2	4	
# ::edge	point	part-of	product	p2	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	5	
# ::edge	name	op2	13000	n	1	
# ::edge	character	mod	single-byte	c	s2	
# ::edge	point	beneficiary	character	p2	c	
# ::edge	point	ARG1-of	organize-01	p2	o3	
# ::edge	order-03	ARG1-of	same-01	o2	s	
# ::edge	organize-01	manner	order-03	o3	o2	
# ::edge	one	mod	double-byte	o	d	
# ::edge	same-01	ARG2	one	s	o	
# ::edge	one	mod	phone-number-entity	o	p	
# ::edge	phone-number-entity	value	2	p	2	
# ::edge	phone-number-entity	quant	3	p	3	
# ::edge	one	mod	url-entity	o	u	
# ::edge	url-entity	value	3	u	3	
# ::edge	url-entity	value	0	u	0	
(p2 / point
    :quant 50400
    :ARG1-of (o3 / organize-01
        :manner (o2 / order-03
            :ARG1-of (s / same-01
                :ARG2 (o / one
                    :mod (d / double-byte)
                    :mod (p / phone-number-entity
                        :quant 3
                        :value 2)
                    :mod (u / url-entity
                        :value 3
                        :value 0)))))
    :beneficiary (c / character
        :mod (s2 / single-byte))
    :mod (c2 / code)
    :part-of (p3 / product
        :name (n / name
            :op1 "GB/T"
            :op2 13000)))

# ::tok The 16 auxiliary planes of GB/T 13000 are represented by a total of 1,058,400 code bits from 0x90308130 to 0xE339FE39, and the character arrangement order is exactly in line with the equivalent code bit order of the 16 auxiliary planes of GB/I 13000.
# ::node	1	16	1-2
# ::node	a3	auxiliary	2-3
# ::node	p	plane	3-4
# ::node	p3	product	5-6
# ::node	n	name	5-6
# ::node	7	GB/T	5-6
# ::node	0	13000	6-7
# ::node	r2	represent-01	8-9
# ::node	t	total	11-12
# ::node	6	8	13-14
# ::node	c2	code	14-15
# ::node	c3	code	14-15
# ::node	b	bit	15-16
# ::node	b2	bit	15-16
# ::node	r	range-01	16-17
# ::node	d3	date-interval	17-18
# ::node	d	date-entity	17-18
# ::node	5	30	17-18
# ::node	4	3	17-18
# ::node	3	2008	17-18
# ::node	d2	date-entity	19-20
# ::node	2	2007	19-20
# ::node	a	and	20-21
# ::node	c	character	22-23
# ::node	a2	arrange-01	23-24
# ::node	o2	order-03	24-25
# ::node	e2	exact	26-27
# ::node	i	in-line-04	28-29
# ::node	e	equal-01	31-32
# ::node	b3	bit	33-34
# ::node	o	order-02	34-35
# ::node	a4	auxiliary	38-39
# ::node	p2	plane	39-40
# ::root	a	and
# ::edge	plane	mod	auxiliary	p	a3	
# ::edge	plane	quant	16	p	1	
# ::edge	plane	part-of	product	p	p3	
# ::edge	product	name	name	p3	n	
# ::edge	name	op1	GB/T	n	7	
# ::edge	name	op2	13000	n	0	
# ::edge	represent-01	ARG1	plane	r2	p	
# ::edge	bit	mod	code	b	c2	
# ::edge	bit	quant	8	b	6	
# ::edge	bit	mod	total	b	t	
# ::edge	represent-01	ARG2	bit	r2	b	
# ::edge	bit	mod	code	b2	c3	
# ::edge	bit	ARG1-of	range-01	b2	r	
# ::edge	range-01	ARG3	date-interval	r	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-entity	day	30	d	5	
# ::edge	date-entity	month	3	d	4	
# ::edge	date-entity	year	2008	d	3	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	2007	d2	2	
# ::edge	and	op1	represent-01	a	r2	
# ::edge	arrange-01	ARG1	character	a2	c	
# ::edge	order-03	ARG1	arrange-01	o2	a2	
# ::edge	in-line-04	mod	exact	i	e2	
# ::edge	in-line-04	ARG1	order-03	i	o2	
# ::edge	and	op2	in-line-04	a	i	
# ::edge	bit	ARG1-of	equal-01	b3	e	
# ::edge	order-02	ARG1	bit	o	b3	
# ::edge	in-line-04	ARG2	order-02	i	o	
# ::edge	plane	mod	auxiliary	p2	a4	
# ::edge	order-02	ARG0	plane	o	p2	
# ::edge	plane	poss	product	p2	p3	
# ::edge	and	rel	bit	a	b2	
(a / and
    :op1 (r2 / represent-01
        :ARG1 (p / plane
            :quant 16
            :mod (a3 / auxiliary)
            :part-of (p3 / product
                :name (n / name
                    :op1 "GB/T"
                    :op2 13000)))
        :ARG2 (b / bit
            :quant 8
            :mod (c2 / code)
            :mod (t / total)))
    :op2 (i / in-line-04
        :ARG1 (o2 / order-03
            :ARG1 (a2 / arrange-01
                :ARG1 (c / character)))
        :ARG2 (o / order-02
            :ARG0 (p2 / plane
                :mod (a4 / auxiliary)
                :poss p3)
            :ARG1 (b3 / bit
                :ARG1-of (e / equal-01)))
        :mod (e2 / exact))
    :rel (b2 / bit
        :ARG1-of (r / range-01
            :ARG3 (d3 / date-interval
                :op1 (d / date-entity
                    :day 30
                    :month 3
                    :year 2008)
                :op2 (d2 / date-entity
                    :year 2007)))
        :mod (c3 / code)))

# ::tok The four-byte part's character order must adhere to Appendix C.
# ::node	s	string-entity	1-2
# ::node	0	4	1-2
# ::node	c2	character	3-4
# ::node	o2	order-03	4-5
# ::node	o	obligate-01	5-6
# ::node	a	adhere-02	6-7
# ::node	c	chapter	8-9
# ::node	e	et-cetera	9-10
# ::root	o	obligate-01
# ::edge	string-entity	value	4	s	0	
# ::edge	order-03	ARG2	character	o2	c2	
# ::edge	order-03	ARG3	string-entity	o2	s	
# ::edge	obligate-01	ARG2	adhere-02	o	a	
# ::edge	adhere-02	ARG0	order-03	a	o2	
# ::edge	adhere-02	ARG1	chapter	a	c	
# ::edge	chapter	mod	et-cetera	c	e	
(o / obligate-01
    :ARG2 (a / adhere-02
        :ARG0 (o2 / order-03
            :ARG2 (c2 / character)
            :ARG3 (s / string-entity
                :value 4))
        :ARG1 (c / chapter
            :mod (e / et-cetera))))

# ::tok 7 Code point allocation
# ::node	0	7	0-1
# ::node	c	code	1-2
# ::node	p	point	2-3
# ::node	a	allocate-01	3-4
# ::root	a	allocate-01
# ::edge	point	mod	code	p	c	
# ::edge	allocate-01	ARG1	point	a	p	
# ::edge	allocate-01	li	7	a	0	
(a / allocate-01
    :li 7
    :ARG1 (p / point
        :mod (c / code)))

# ::tok 1. The single-character city part's code point allocation
# ::node	0	1	0-1
# ::node	s	single-02	2-3
# ::node	c	city	3-4
# ::node	p	part's	4-5
# ::node	c2	code	5-6
# ::node	p2	point	6-7
# ::node	a	allocate-01	7-8
