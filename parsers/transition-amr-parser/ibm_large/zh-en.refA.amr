# ::edge	part's	part-of	city	p	c	
# ::edge	part's	ARG1-of	single-02	p	s	
# ::edge	point	mod	code	p2	c2	
# ::edge	allocate-01	ARG1	point	a	p2	
# ::edge	allocate-01	ARG2	part's	a	p	
# ::edge	allocate-01	li	1	a	0	
(a / allocate-01
    :li 1
    :ARG1 (p2 / point
        :mod (c2 / code))
    :ARG2 (p / part's
        :ARG1-of (s / single-02)
        :part-of (c / city)))

# ::tok According to the guidelines in GB/T 11383-1989, the code points for the single-byte component are assigned.
# ::node	s	say-01	0-1
# ::node	g	guideline	3-4
# ::node	b	book	5-6
# ::node	n	name	5-6
# ::node	4	GB/T	5-6
# ::node	d3	date-interval	6-7
# ::node	d	date-entity	6-7
# ::node	d2	date-entity	6-7
# ::node	0	13	6-7
# ::node	1	2	6-7
# ::node	2	2003	6-7
# ::node	3	2008	6-7
# ::node	c	code	8-9
# ::node	p	point	9-10
# ::node	s2	single-byte	12-13
# ::node	c2	component	13-14
# ::node	a	assign-01	15-16
# ::root	s	say-01
# ::edge	say-01	ARG0	guideline	s	g	
# ::edge	guideline	part-of	book	g	b	
# ::edge	book	name	name	b	n	
# ::edge	name	op1	GB/T	n	4	
# ::edge	book	time	date-interval	b	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	13	d	0	
# ::edge	date-entity	month	2	d	1	
# ::edge	date-entity	year	2003	d	2	
# ::edge	date-entity	year	2008	d2	3	
# ::edge	point	mod	code	p	c	
# ::edge	component	mod	single-byte	c2	s2	
# ::edge	point	beneficiary	component	p	c2	
# ::edge	assign-01	ARG1	point	a	p	
# ::edge	say-01	ARG1	assign-01	s	a	
(s / say-01
    :ARG0 (g / guideline
        :part-of (b / book
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 13
                    :month 2
                    :year 2003)
                :op2 (d2 / date-entity
                    :year 2008))))
    :ARG1 (a / assign-01
        :ARG1 (p / point
            :beneficiary (c2 / component
                :mod (s2 / single-byte))
            :mod (c / code))))

# ::tok The distribution of single-byte code points is shown in Figure 2.
# ::node	d	distribute-01	1-2
# ::node	s2	single-02	3-4
# ::node	c	code	4-5
# ::node	p	point	5-6
# ::node	s	show-01	7-8
# ::node	f	figure	9-10
# ::node	0	2.	10-11
# ::root	s	show-01
# ::edge	code	ARG1-of	single-02	c	s2	
# ::edge	point	mod	code	p	c	
# ::edge	distribute-01	ARG1	point	d	p	
# ::edge	show-01	ARG1	distribute-01	s	d	
# ::edge	show-01	ARG0	figure	s	f	
# ::edge	figure	mod	2.	f	0	
(s / show-01
    :ARG0 (f / figure
        :mod 2.)
    :ARG1 (d / distribute-01
        :ARG1 (p / point
            :mod (c / code
                :ARG1-of (s2 / single-02)))))

# ::tok Code distribution for double word section.
# ::node	c	code	0-1
# ::node	d	distribute-01	1-2
# ::node	d2	double	3-4
# ::node	w	word	4-5
# ::node	s	section.	5-6
# ::root	d	distribute-01
# ::edge	distribute-01	ARG1	code	d	c	
# ::edge	word	mod	double	w	d2	
# ::edge	section.	mod	word	s	w	
# ::edge	distribute-01	ARG2	section.	d	s	
(d / distribute-01
    :ARG1 (c / code)
    :ARG2 (s / section.
        :mod (w / word
            :mod (d2 / double))))

# ::tok The double-byte part's code bit layout is split into two sections with a combined 23940 code bits each: 0x8140-0xFE7E and 0x8180-0xFEFE.
# ::node	d	double-byte	1-2
# ::node	c	code	3-4
# ::node	b	bit	4-5
# ::node	l	layout	5-6
# ::node	s2	split-01	7-8
# ::node	2	2	9-10
# ::node	s	section	10-11
# ::node	c3	combine-01	13-14
# ::node	3	23940	14-15
# ::node	c2	code	15-16
# ::node	b2	bit	16-17
# ::node	v	value-interval	18-19
# ::node	0	0	18-19
# ::node	4	8	18-19
# ::node	a	and	19-20
# ::node	1	0	20-21
# ::root	s2	split-01
# ::edge	bit	mod	code	b	c	
# ::edge	bit	mod	double-byte	b	d	
# ::edge	layout	mod	bit	l	b	
# ::edge	split-01	ARG1	layout	s2	l	
# ::edge	section	quant	2	s	2	
# ::edge	split-01	ARG2	section	s2	s	
# ::edge	bit	mod	code	b2	c2	
# ::edge	bit	quant	23940	b2	3	
# ::edge	bit	ARG1-of	combine-01	b2	c3	
# ::edge	section	prep-with	bit	s	b2	
# ::edge	combine-01	mod	value-interval	c3	v	
# ::edge	value-interval	op1	0	v	0	
# ::edge	value-interval	op2	8	v	4	
# ::edge	and	op1	combine-01	a	c3	
# ::edge	combine-01	ARG2	and	c3	a	
# ::edge	value-interval	op3	0	v	1	
(s2 / split-01
    :ARG1 (l / layout
        :mod (b / bit
            :mod (c / code)
            :mod (d / double-byte)))
    :ARG2 (s / section
        :quant 2
        :prep-with (b2 / bit
            :quant 23940
            :ARG1-of (c3 / combine-01
                :ARG2 (a / and
                    :op1 c3)
                :mod (v / value-interval
                    :op1 0
                    :op2 8
                    :op3 0))
            :mod (c2 / code))))

# ::tok For the allocation of double-byte code points, see Figure 3 and Table 2.
# ::node	a	allocate-01	2-3
# ::node	d	double-byte	4-5
