(c5 / contrast-01
    :ARG1 (g / give-01
        :ARG2 (c / character
            :ARG0-of (h / have-03
                :ARG1 (l / letter
                    :mod (a / abstract)
                    :mod (d / distinctive)))
            :mod (c7 / country
                :name (n / name
                    :op1 "China"))))
    :rel (c6 / contrast-01
        :ARG2 (g2 / give-01
            :ARG1 (p / position.
                :ARG1-of (r / resemble-01)
                :mod (c4 / code))
            :ARG2 (c2 / character
                :ARG1-of c6
                :mod (g3 / glyph
                    :ARG1-of (s / same-01
                        :ARG2 l))
                :source (s2 / source
                    :mod (v / various)))))
    :rel (c3 / code))

