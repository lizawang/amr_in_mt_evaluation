# ::edge	value	mod	other	v	o	
# ::edge	value	mod	all	v	a2	
# ::edge	use-01	ARG2	value	u	v	
(c2 / contrast-01
    :ARG1 (e / express-01
        :ARG1 (c / code
            :mod (a / all)
            :poss (a3 / appendix's))
        :manner (h / hexadecimal,))
    :ARG2 (u / use-01
        :ARG1 (d / decimal)
        :ARG2 (v / value
            :mod (o / other)
            :mod (a2 / all))))

# ::tok The single-byte portion uses the GB/T 11383-1989 encoding scheme and the code points 0x00–0x7F.
# ::node	s2	single-byte	1-2
# ::node	p2	portion	2-3
# ::node	u	use-01	3-4
# ::node	n	name	5-6
# ::node	6	GB/T	5-6
# ::node	d3	date-interval	6-7
# ::node	d	date-entity	6-7
# ::node	d2	date-entity	6-7
# ::node	2	1979	6-7
# ::node	1	17	6-7
# ::node	3	2	6-7
# ::node	4	2008	6-7
# ::node	e	encode-01	7-8
# ::node	s	scheme	8-9
# ::node	a	and	9-10
# ::node	c	code	11-12
# ::node	p	point	12-13
# ::node	v	value-interval	13-14
# ::node	5	7	13-14
# ::node	0	0	13-14
# ::root	u	use-01
# ::edge	portion	mod	single-byte	p2	s2	
# ::edge	use-01	ARG0	portion	u	p2	
# ::edge	name	op1	GB/T	n	6	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	1979	d	2	
# ::edge	date-entity	day	17	d2	1	
# ::edge	date-entity	month	2	d	3	
# ::edge	date-entity	year	2008	d2	4	
# ::edge	scheme	mod	encode-01	s	e	
# ::edge	scheme	time	date-interval	s	d3	
# ::edge	scheme	name	name	s	n	
# ::edge	and	op1	scheme	a	s	
# ::edge	use-01	ARG1	and	u	a	
# ::edge	point	mod	code	p	c	
# ::edge	and	op2	point	a	p	
# ::edge	point	mod	value-interval	p	v	
# ::edge	value-interval	op1	7	v	5	
# ::edge	value-interval	op2	0	v	0	
(u / use-01
    :ARG0 (p2 / portion
        :mod (s2 / single-byte))
    :ARG1 (a / and
        :op1 (s / scheme
            :name (n / name
                :op1 "GB/T")
            :mod (e / encode-01)
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :month 2
                    :year 1979)
                :op2 (d2 / date-entity
                    :day 17
                    :year 2008)))
        :op2 (p / point
            :mod (c / code)
            :mod (v / value-interval
                :op1 7
                :op2 0))))

# ::tok 1st byte: 0x81-0xFE, last byte: 0x40-0x7E, 0x80-0xFE double-word component uses two 8-bit binary strings for each letter.
# ::node	o	ordinal-entity	0-1
# ::node	1	1	0-1
# ::node	b2	byte:	1-2
# ::node	l	last	3-4
# ::node	v	value-interval	5-6
# ::node	3	3	5-6
# ::node	0	0	5-6
# ::node	d	double-word	7-8
# ::node	c	component	8-9
# ::node	c2	component	8-9
# ::node	u	use-01	9-10
# ::node	2	2	10-11
# ::node	4	8-bit	11-12
# ::node	b	binary	12-13
# ::node	s	string-entity	13-14
# ::node	s2	string-entity	13-14
# ::node	e	each	15-16
# ::node	l2	letter.	16-17
# ::root	u	use-01
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	byte:	ord	ordinal-entity	b2	o	
# ::edge	value-interval	op1	3	v	3	
# ::edge	value-interval	op2	0	v	0	
# ::edge	component	mod	double-word	c2	d	
# ::edge	use-01	ARG0	component	u	c	
# ::edge	string-entity	mod	binary	s	b	
# ::edge	string-entity	quant	2	s	2	
# ::edge	use-01	ARG1	string-entity	u	s	
# ::edge	string-entity	mod	component	s2	c	
# ::edge	string-entity	quant	2	s2	2	
# ::edge	use-01	ARG2	string-entity	u	s2	
# ::edge	letter.	mod	each	l2	e	
# ::edge	use-01	beneficiary	letter.	u	l2	
# ::edge	use-01	rel	byte:	u	b2	
# ::edge	use-01	rel	value-interval	u	v	
# ::edge	use-01	rel	component	u	c2	
# ::edge	use-01	rel	last	u	l	
# ::edge	use-01	rel	8-bit	u	4	
(u / use-01
    :ARG0 (c / component)
    :ARG1 (s / string-entity
        :quant 2
        :mod (b / binary))
    :ARG2 (s2 / string-entity
        :quant 2
        :mod c)
    :beneficiary (l2 / letter.
        :mod (e / each))
    :rel (b2 / "byte:"
        :ord (o / ordinal-entity
            :value 1))
    :rel (v / value-interval
        :op1 3
        :op2 0)
    :rel (c2 / component
        :mod (d / double-word))
    :rel (l / last)
    :rel 8-bit)

# ::tok The coding range for the four-byte component is 0x81308130-0xFE39FE39, while the suffix used to expand the double-byte code is 0x30-0x39, which was not utilized in GB/Work 11383-1989.
# ::node	p	program-01	1-2
# ::node	r	range-01	2-3
# ::node	f	four-byte	5-6
# ::node	c2	component	6-7
# ::node	m	monetary-quantity	8-9
# ::node	s	string-entity	8-9
# ::node	2	0x81308130-0xFE39FE39,	8-9
# ::node	1	0	8-9
# ::node	c3	contrast-01	9-10
# ::node	s2	suffix	11-12
# ::node	u	use-01	12-13
# ::node	e	expand-01	14-15
# ::node	d4	double-byte	16-17
# ::node	c	code	17-18
# ::node	0	-	22-23
# ::node	u2	utilize-01	23-24
# ::node	w	work-01	25-26
# ::node	w2	work-01	25-26
# ::node	d3	date-interval	26-27
# ::node	d	date-entity	26-27
# ::node	d2	date-entity	26-27
# ::node	3	15	26-27
# ::node	7	9	26-27
# ::node	5	2003	26-27
# ::node	4	16	26-27
# ::node	8	9	26-27
# ::node	6	2003	26-27
# ::root	c3	contrast-01
# ::edge	range-01	ARG4	program-01	r	p	
# ::edge	component	mod	four-byte	c2	f	
# ::edge	program-01	ARG1	component	p	c2	
# ::edge	range-01	ARG3	monetary-quantity	r	m	
# ::edge	monetary-quantity	value	0x81308130-0xFE39FE39,	m	2	
# ::edge	string-entity	value	0	s	1	
# ::edge	contrast-01	ARG1	range-01	c3	r	
# ::edge	contrast-01	ARG2	suffix	c3	s2	
# ::edge	suffix	quant	string-entity	s2	s	
# ::edge	suffix	ARG1-of	use-01	s2	u	
# ::edge	use-01	ARG2	expand-01	u	e	
# ::edge	code	mod	double-byte	c	d4	
# ::edge	expand-01	ARG1	code	e	c	
# ::edge	utilize-01	polarity	-	u2	0	
# ::edge	suffix	ARG1-of	utilize-01	s2	u2	
# ::edge	utilize-01	time	work-01	u2	w	
# ::edge	work-01	time	date-interval	w	d3	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	day	15	d	3	
# ::edge	date-entity	month	9	d	7	
# ::edge	date-entity	year	2003	d	5	
# ::edge	date-entity	day	16	d2	4	
# ::edge	date-entity	month	9	d2	8	
# ::edge	date-entity	year	2003	d2	6	
# ::edge	contrast-01	rel	work-01	c3	w2	
(c3 / contrast-01
    :ARG1 (r / range-01
        :ARG3 (m / monetary-quantity
            :value 0x81308130-0xFE39FE39,)
        :ARG4 (p / program-01
            :ARG1 (c2 / component
                :mod (f / four-byte))))
    :ARG2 (s2 / suffix
        :quant (s / string-entity
            :value 0)
        :ARG1-of (u / use-01
            :ARG2 (e / expand-01
                :ARG1 (c / code
                    :mod (d4 / double-byte))))
        :ARG1-of (u2 / utilize-01
            :polarity -
            :time (w / work-01
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :day 15
                        :month 9
                        :year 2003)
                    :op2 (d2 / date-entity
                        :day 16
                        :month 9
                        :year 2003)))))
    :rel (w2 / work-01))

# ::tok The first character of a four-byte character has an encoding range of 0x81-0xFE; the second character's range is 0x30-0x39; the third byte's range is 0x81-0xFE; and the fourth character's range is 0x30 A 0x39. Right now: 0x81308130-0x81308139; 0x81308230-0x81308239 0x8130FEFE30-0x8130FE39; 0x81318130-0x81318139; Oo2douolag0c "0URo23061393 0xFE39FE30-0xFE39FE39.
# ::node	o	ordinal-entity	1-2
# ::node	1	1	1-2
# ::node	c	character	2-3
# ::node	s	string-entity	5-6
# ::node	5	4	5-6
# ::node	c2	character	6-7
# ::node	h	have-03	7-8
# ::node	e	encode-01	9-10
# ::node	r	range-01	10-11
# ::node	s2	string-entity	12-13
# ::node	2	2	12-13
# ::node	o2	ordinal-entity	14-15
# ::node	3	2	14-15
# ::node	c3	character's	15-16
# ::node	r2	range-01	16-17
# ::node	s3	string-entity	18-19
# ::node	o3	ordinal-entity	20-21
# ::node	4	3	20-21
# ::node	b	byte's	21-22
# ::node	r3	range-01	22-23
# ::node	a	and	25-26
# ::node	o4	ordinal-entity	27-28
# ::node	6	4	27-28
# ::node	c4	character's	28-29
# ::node	r4	range-01	29-30
# ::node	r5	range-01	29-30
# ::node	s4	string-entity	31-32
# ::node	0	0x30	31-32
# ::node	r6	right	34-35
# ::node	n	now:	35-36
# ::node	7	Catholic	40-41
# ::root	a	and
# ::edge	ordinal-entity	value	1	o	1	
# ::edge	character	ord	ordinal-entity	c	o	
# ::edge	string-entity	value	4	s	5	
# ::edge	character	ord	string-entity	c2	s	
# ::edge	character	part-of	character	c	c2	
# ::edge	have-03	ARG0	character	h	c	
# ::edge	encode-01	ARG1	character	e	c	
# ::edge	range-01	ARG4	encode-01	r	e	
# ::edge	have-03	ARG1	range-01	h	r	
# ::edge	range-01	ARG3	string-entity	r	s2	
# ::edge	string-entity	value	2	s2	2	
# ::edge	ordinal-entity	value	2	o2	3	
# ::edge	character's	ord	ordinal-entity	c3	o2	
# ::edge	range-01	ARG1	character's	r2	c3	
# ::edge	range-01	ARG4	string-entity	r2	s3	
# ::edge	ordinal-entity	value	3	o3	4	
# ::edge	byte's	ord	ordinal-entity	b	o3	
# ::edge	range-01	ARG1	byte's	r3	b	
# ::edge	and	op2	range-01	a	r3	
# ::edge	and	op1	have-03	a	h	
# ::edge	ordinal-entity	value	4	o4	6	
# ::edge	character's	ord	ordinal-entity	c4	o4	
# ::edge	range-01	ARG1	character's	r4	c4	
# ::edge	and	op3	range-01	a	r4	
# ::edge	range-01	ARG1	character's	r5	c4	
# ::edge	and	op4	range-01	a	r5	
# ::edge	range-01	ARG2	string-entity	r5	s4	
# ::edge	string-entity	value	0x30	s4	0	
# ::edge	now:	mod	right	n	r6	
# ::edge	and	time	now:	a	n	
# ::edge	string-entity	value	Catholic	s4	7	
# ::edge	and	rel	range-01	a	r2	
(a / and
    :op1 (h / have-03
        :ARG0 (c / character
            :ord (o / ordinal-entity
                :value 1)
            :part-of (c2 / character
                :ord (s / string-entity
                    :value 4)))
        :ARG1 (r / range-01
            :ARG3 (s2 / string-entity
                :value 2)
            :ARG4 (e / encode-01
                :ARG1 c)))
    :op2 (r3 / range-01
        :ARG1 (b / byte's
            :ord (o3 / ordinal-entity
                :value 3)))
    :op3 (r4 / range-01
        :ARG1 (c4 / character's
            :ord (o4 / ordinal-entity
                :value 4)))
    :op4 (r5 / range-01
        :ARG1 c4
        :ARG2 (s4 / string-entity
            :value 0x30
            :value "Catholic"))
    :rel (r2 / range-01
        :ARG1 (c3 / character's
            :ord (o2 / ordinal-entity
                :value 2))
        :ARG4 (s3 / string-entity))
    :time (n / "now:"
        :mod (r6 / right)))

# ::tok Figure 1 and Table 1 display the general organization and allocation of code point ranges.
# ::node	f	figure	0-1
# ::node	0	1	1-2
# ::node	a2	and	2-3
# ::node	t	table	3-4
# ::node	1	1	4-5
# ::node	d	display-01	5-6
# ::node	g	general-02	7-8
# ::node	o	organize-01	8-9
# ::node	a3	and	9-10
# ::node	a	allocate-01	10-11
# ::node	c	code	12-13
# ::node	p	point	13-14
# ::node	r	range-01	14-15
# ::root	d	display-01
# ::edge	figure	mod	1	f	0	
# ::edge	and	op1	figure	a2	f	
# ::edge	and	op2	table	a2	t	
# ::edge	table	mod	1	t	1	
# ::edge	display-01	ARG0	and	d	a2	
# ::edge	organize-01	ARG1-of	general-02	o	g	
# ::edge	and	op1	organize-01	a3	o	
# ::edge	display-01	ARG1	and	d	a3	
# ::edge	and	op2	allocate-01	a3	a	
# ::edge	point	mod	code	p	c	
# ::edge	range-01	ARG1	point	r	p	
# ::edge	allocate-01	ARG1	range-01	a	r	
(d / display-01
    :ARG0 (a2 / and
        :op1 (f / figure
            :mod 1)
        :op2 (t / table
            :mod 1))
    :ARG1 (a3 / and
        :op1 (o / organize-01
            :ARG1-of (g / general-02))
        :op2 (a / allocate-01
            :ARG1 (r / range-01
                :ARG1 (p / point
                    :mod (c / code))))))

# ::tok 6 character character sort order
# ::node	0	6	0-1
# ::node	c	character	1-2
# ::node	c2	character	2-3
# ::node	s	sort	3-4
# ::node	o	order	4-5
# ::root	o	order
# ::edge	character	consist-of	character	c2	c	
# ::edge	order	mod	sort	o	s	
# ::edge	order	mod	character	o	c2	
# ::edge	order	quant	6	o	0	
(o / order
    :quant 6
    :mod (s / sort)
    :mod (c2 / character
        :consist-of (c / character)))

# ::tok 6.1 Character placement in single-character brushes: certain characters' order
# ::node	0	6.1	0-1
# ::node	c2	character	1-2
# ::node	p2	place-01	2-3
# ::node	s	single-02	4-5
# ::node	p	picture	5-6
# ::node	c	certain	6-7
# ::node	c3	character	7-8
# ::node	o	order-03	8-9
# ::root	p2	place-01
# ::edge	place-01	ARG1	character	p2	c2	
# ::edge	place-01	li	6.1	p2	0	
# ::edge	picture	ARG1-of	single-02	p	s	
# ::edge	place-01	location	picture	p2	p	
# ::edge	character	mod	certain	c3	c	
# ::edge	order-03	ARG1	character	o	c3	
# ::edge	picture	ARG2-of	order-03	p	o	
(p2 / place-01
    :li 6.1
    :ARG1 (c2 / character)
    :location (p / picture
        :ARG1-of (s / single-02)
        :ARG2-of (o / order-03
            :ARG1 (c3 / character
                :mod (c / certain)))))

# ::tok Certain characters in single-character remarks are organized in the same sequence as their GB/I 11383-1989 counterparts.
# ::node	c	certain	0-1
# ::node	c2	character	1-2
# ::node	s4	single-character	3-4
# ::node	r	remark-01	4-5
# ::node	o	organize-01	6-7
# ::node	s	same-01	9-10
# ::node	s2	sequence	10-11
# ::node	s3	sequence	10-11
# ::node	n	name	13-14
# ::node	2	GB/I	13-14
# ::node	d3	date-interval	14-15
# ::node	d	date-entity	14-15
# ::node	d2	date-entity	14-15
# ::node	0	1979	14-15
# ::node	1	1990	14-15
# ::node	c3	counterpart	15-16
# ::root	o	organize-01
# ::edge	character	mod	certain	c2	c	
# ::edge	remark-01	mod	single-character	r	s4	
# ::edge	character	part-of	remark-01	c2	r	
# ::edge	organize-01	ARG1	character	o	c2	
# ::edge	sequence	ARG1-of	same-01	s2	s	
# ::edge	organize-01	manner	sequence	o	s2	
# ::edge	same-01	ARG2	sequence	s	s3	
# ::edge	name	op1	GB/I	n	2	
# ::edge	date-interval	op1	date-entity	d3	d	
# ::edge	date-interval	op2	date-entity	d3	d2	
# ::edge	date-entity	year	1979	d	0	
# ::edge	date-entity	year	1990	d2	1	
# ::edge	counterpart	time	date-interval	c3	d3	
# ::edge	sequence	mod	counterpart	s3	c3	
# ::edge	counterpart	poss	character	c3	c2	
# ::edge	organize-01	rel	name	o	n	
(o / organize-01
    :ARG1 (c2 / character
        :mod (c / certain)
        :part-of (r / remark-01
            :mod (s4 / single-character)))
    :manner (s2 / sequence
        :ARG1-of (s / same-01
            :ARG2 (s3 / sequence
                :mod (c3 / counterpart
                    :poss c2
                    :time (d3 / date-interval
                        :op1 (d / date-entity
                            :year 1979)
                        :op2 (d2 / date-entity
                            :year 1990))))))
    :rel (n / name
        :op1 "GB/I"))

# ::tok Double characters are ordered.
# ::node	d	double-01	0-1
# ::node	c	character	1-2
# ::node	o	order-01	3-4
# ::root	o	order-01
# ::edge	character	ARG1-of	double-01	c	d	
# ::edge	order-01	ARG1	character	o	c	
(o / order-01
    :ARG1 (c / character
        :ARG1-of (d / double-01)))

# ::tok The lower half of the double word's characters should be arranged in line with Appendix A.
# ::node	h2	have-degree-91	1-2
# ::node	l	low-04	1-2
# ::node	m	more	1-2
# ::node	h	half	2-3
# ::node	d	double	5-6
# ::node	w	word's	6-7
# ::node	c	character	7-8
# ::node	r	recommend-01	8-9
# ::node	a2	arrange-01	10-11
# ::node	i	in-line-04	12-13
# ::node	p	panel	14-15
# ::node	a	A.	15-16
# ::root	r	recommend-01
# ::edge	have-degree-91	ARG2	low-04	h2	l	
# ::edge	have-degree-91	ARG3	more	h2	m	
# ::edge	half	ARG1-of	have-degree-91	h	h2	
# ::edge	word's	mod	double	w	d	
# ::edge	character	mod	word's	c	w	
# ::edge	half	part-of	character	h	c	
# ::edge	recommend-01	ARG1	arrange-01	r	a2	
# ::edge	arrange-01	ARG1	half	a2	h	
# ::edge	arrange-01	ARG1-of	in-line-04	a2	i	
# ::edge	in-line-04	ARG2	panel	i	p	
# ::edge	panel	mod	A.	p	a	
(r / recommend-01
    :ARG1 (a2 / arrange-01
        :ARG1 (h / half
            :ARG1-of (h2 / have-degree-91
                :ARG2 (l / low-04)
                :ARG3 (m / more))
            :part-of (c / character
                :mod (w / word's
                    :mod (d / double))))
        :ARG1-of (i / in-line-04
            :ARG2 (p / panel
                :mod (a / A.)))))

# ::tok 6.3 The four-character brush's character arrangement
# ::node	1	6.3	0-1
# ::node	0	4	2-3
# ::node	c	character	4-5
# ::node	a	arrange-01	5-6
# ::root	a	arrange-01
# ::edge	character	quant	4	c	0	
# ::edge	arrange-01	ARG1	character	a	c	
# ::edge	arrange-01	li	6.3	a	1	
(a / arrange-01
    :li 6.3
    :ARG1 (c / character
        :quant 4))

# ::tok There are 50400 code points in GB/T 13000 for single-byte characters, organized in the same order as the double-byte ones, Chars: 0x81308130 - 0x8439FE39.gly
# ::node	4	50400	2-3
