(e / earthquake
    :quant (b / between
        :mod (m / moment)
        :op1 (s / seismic-quantity
            :quant 9.1)
        :op2 (s2 / seismic-quantity
            :quant 9.3.))
    :ARG1-of (d2 / deep-02
        :ARG2 (d4 / distance-quantity
            :quant 30
            :unit (k2 / kilometer)))
    :location (o / off
        :extent (d3 / distance-quantity
            :quant 160
            :unit (k / kilometer))
