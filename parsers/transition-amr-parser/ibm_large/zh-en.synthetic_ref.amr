(r / replace-01
    :ARG1 (d4 / document
        :mod (t4 / this))
    :ARG2 (t2 / thing
        :name (n / name
            :op2 "Technology")
        :ARG1-of (c2 / compare-01
            :ARG2 (t3 / thing
                :name (n3 / name
                    :op1 "GB")
                :time (d3 / date-interval
                    :op1 (d / date-entity
                        :day 30
                        :month 5
                        :year 2003)
                    :op2 (d2 / date-entity
                        :year 2003)))
            :ARG2 (c / change-01
                :ARG1 t2
                :ARG2-of (e2 / except-01
                    :ARG1 (a2 / and
                        :op1 (a / adjust-01
