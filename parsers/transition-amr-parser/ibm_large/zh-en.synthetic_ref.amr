(p3 / possible-01
    :ARG1 (o / operate-01
        :ARG1 (f2 / function-01
            :ARG1-of (f / follow-04))
        :instrument (a2 / and
            :mod (b / both)
            :op1 (p / phone
                :ARG1-of (l / left-19))
            :op2 (e / "earphones:"
                :ARG1-of (r2 / right-04))))
    :rel (p4 / press-01
        :purpose (a5 / answer-01
            :ARG0 (y / you)
