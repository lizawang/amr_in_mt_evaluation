# ::edge	and	rel	name	a2	n3	
(a2 / and
    :op1 (s / stand-08
        :ARG0 (s3 / string-entity
            :value "CJK"))
    :op2 (r / refer-01
        :ARG1 (c / character
            :ARG1-of (e / encode-01)
            :mod (c3 / country
                :name (n2 / name
                    :op1 "Japan,"))))
    :rel (s4 / string-entity
        :value "CJK")
    :rel (s2 / stand-08
        :ARG1 (a / and
            :op1 c3
            :op2 (c4 / country
                :name (n / name
                    :op1 "Korea,"))))
    :rel (a3 / and
        :op1 (c2 / character
            :name (u / unify-01)
            :ARG1-of u
            :domain c3)
        :op2 (p / publication
            :name (n4 / name
                :op1 "CCJK"
                :op2 "Unified"
                :op3 "Ideographs.")))
    :rel (n3 / name
        :op1 "CJK"
        :op2 "Chinese"))

