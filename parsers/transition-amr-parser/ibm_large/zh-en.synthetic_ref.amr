# ::edge	notation	mod	decimal	n2	d	
# ::edge	use-01	ARG1	notation	u2	n2	
# ::edge	contrast-01	ARG2	use-01	c	u2	
# ::edge	use-01	ARG2	value	u2	v	
# ::edge	value	ARG0-of	have-03	v	h	
# ::edge	have-03	polarity	-	h	0	
# ::edge	have-03	ARG1	string-entity	h	s2	
# ::edge	string-entity	value	0x.	s2	2	
(c / contrast-01
    :ARG1 (u / use-01
        :ARG0 (t / text)
        :ARG1 (n / notation
            :mod (h2 / hexadecimal))
        :ARG2 (n3 / numerical-quantity
            :ARG1-of (e / equal-01)
            :ARG1-of (m / mark-02
                :ARG2 (s / string-entity
                    :value 0x,))))
    :ARG2 (u2 / use-01
        :ARG1 (n2 / notation
            :mod (d / decimal))
        :ARG2 (v / value
            :ARG0-of (h / have-03
                :ARG1 (s2 / string-entity
                    :value 0x.)
                :polarity -))))

# ::tok The appendix's codes are all expressed in hexadecimal, while decimal is used for all other values.
