(t / trigger-01
    :ARG0 (e / earthquake)
    :ARG1 (t2 / tsunami
        :mod (m / massive)
        :prep-with (r / range-01
            :ARG1 (h / high-02
                :ARG1 (w / wave))
            :ARG3 (d / distance-quantity
                :quant 15
                :unit (m2 / meter))
            :ARG4 (d2 / distance-quantity
                :quant 30
                :unit (m3 / meter)))))

