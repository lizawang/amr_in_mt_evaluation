# ::edge	precede-01	rel	thing	p	t	
(p / precede-01
    :ARG1 (p2 / product)
    :ARG1 (s / schematic)
    :condition (o2 / or
        :op1 (u / update-01)
        :op2 (u2 / upgrade-02))
    :rel (t / thing
        :purpose (g / guide-01)
        :ARG2-of (s2 / summarize-01)
        :domain (a / and
            :location (m / manual)
            :op3 (i / illustrate-01))
        :mod (o / only,)))

