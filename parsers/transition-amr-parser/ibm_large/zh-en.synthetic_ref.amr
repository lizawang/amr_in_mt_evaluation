                :duration (a / about
                    :op1 (t / temporal-quantity
                        :quant 1
                        :unit (s / second))))))
    :rel (h / hang-up-03
        :ARG0 y
        :ARG1 c
        :time (o2 / or
            :op1 h
            :op2 (m / make-01
                :ARG0 y))))

# ::tok When a call comes in, reject the call. During a call, switch to earbuds/mobile phone listening by double-clicking.
# ::node	c	call-02	2-3
# ::node	c4	come-01	3-4
