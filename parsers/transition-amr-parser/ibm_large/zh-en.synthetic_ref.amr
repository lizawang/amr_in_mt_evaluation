# ::edge	treat-01	ARG1-of	care-04	t2	c2	
# ::edge	care-04	ARG0	you	c2	y	
# ::edge	and	rel	+	a	1	
(a / and
    :op1 (r / read-01
        :ARG0 (y / you)
        :ARG1 (m / manual
            :mod (t / this))
        :ARG1-of (c / care-04)
        :mode imperative
        :polite +)
    :op2 (t2 / treat-01
        :ARG0 y
        :ARG1-of (c2 / care-04
            :ARG0 y)
        :mode imperative
        :polite +)
    :rel +
    :time (b / before
        :op1 (u / use-01
            :ARG0 y)))

