# ::edge	component.	mod	double-byte	c4	d4	
# ::edge	include-01	ARG2	component.	i	c4	
(m / multi-sentence
    :snt1 (c / character
        :location (p2 / publication
            :name (n / name
                :op1 "GB/T")
            :time (d3 / date-interval
                :op1 (d / date-entity
                    :day 12
                    :month 3
                    :year 2008)
                :op2 (d2 / date-entity)))
        :mod (g / graphic)
        :mod (a / all))
    :snt2 (i / include-01
        :ARG1 (a2 / and
            :op1 c
            :op2 (c3 / characters,
                :name (n2 / name
                    :op1 "CJK")
                :ARG2-of (u / unify-01)
                :mod (c5 / country
                    :name (n3 / name
                        :op1 "China")))
            :op3 (p / portion
                :location (p3 / publication
                    :name (n4 / name
                        :op1 "GB/T"
                        :op2 13000))
                :mod (c2 / character
                    :mod (g2 / graphic))))
        :ARG2 (c4 / component.
            :mod (d4 / double-byte))))

