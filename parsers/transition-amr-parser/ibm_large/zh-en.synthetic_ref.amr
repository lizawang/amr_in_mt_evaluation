# ::edge	and	op3	table	a2	t	
# ::edge	table	mod	2.	t	0	
# ::edge	see-01	rel	code	s	c	
(s / see-01
    :purpose (a / allocate-01)
    :ARG0 (y / you)
    :ARG1 (a2 / and
        :op1 (f / figure
            :mod 3)
        :op2 (f2 / figure)
        :op3 (t / table
            :mod 2.))
