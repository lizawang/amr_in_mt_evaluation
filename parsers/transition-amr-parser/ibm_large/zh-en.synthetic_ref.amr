# ::root	e	establish-01
# ::edge	name	op2	Quality	n	5	
# ::edge	law	name	name	l	n	
# ::edge	name	op3	Law	n	1	
# ::edge	name	op1	People's	n	3	
# ::edge	name	op2	Republic	n	6	
# ::edge	name	op3	of	n	9	
# ::edge	and	op1	law	a2	l	
# ::edge	name	op2	Rights	n2	8	
# ::edge	name	op3	Protection	n2	4	
# ::edge	law	name	name	l2	n2	
# ::edge	and	op2	law	a2	l2	
# ::edge	name	op4	Law	n2	2	
# ::edge	law	poss	country	l2	c2	
# ::edge	country	name	law	c2	l	
# ::edge	name	op5	Republic	n2	7	
# ::edge	name	op6	of	n2	10	
# ::edge	name	op7	China	n2	0	
# ::edge	and	mod	both	a2	b	
# ::edge	establish-01	ARG0	and	e	a2	
# ::edge	after	op1	establish-01	a	e	
# ::edge	after	op1	guarantee-01	a	g2	
