# ::edge	adhere-02	ARG1	chapter	a	c	
# ::edge	chapter	mod	et-cetera	c	e	
(o / obligate-01
    :ARG2 (a / adhere-02
        :ARG0 (o2 / order-03
            :ARG2 (c2 / character)
            :ARG3 (s / string-entity
                :value 4))
        :ARG1 (c / chapter
            :mod (e / et-cetera))))

