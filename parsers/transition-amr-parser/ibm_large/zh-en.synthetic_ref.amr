# ::root	c	contrast-01
# ::edge	use-01	ARG0	text	u	t	
# ::edge	notation	mod	hexadecimal	n	h2	
# ::edge	use-01	ARG1	notation	u	n	
# ::edge	use-01	ARG2	numerical-quantity	u	n3	
# ::edge	numerical-quantity	ARG1-of	equal-01	n3	e	
# ::edge	numerical-quantity	ARG1-of	mark-02	n3	m	
# ::edge	mark-02	ARG2	string-entity	m	s	
# ::edge	string-entity	value	0x,	s	1	
