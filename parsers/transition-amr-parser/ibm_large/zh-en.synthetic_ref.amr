# ::edge	contrast-01	ARG1	give-01	c5	g	
# ::edge	same-01	ARG2	letter	s	l	
# ::edge	glyph	ARG1-of	same-01	g3	s	
# ::edge	character	mod	glyph	c2	g3	
# ::edge	character	ARG1-of	contrast-01	c2	c6	
