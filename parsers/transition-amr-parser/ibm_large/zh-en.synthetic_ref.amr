# ::edge	reject-01	ARG0	you	r	y	
# ::edge	reject-01	mode	imperative	r	0	
# ::edge	reject-01	ARG1	call-02	r	c2	
# ::edge	switch-01	ARG0	you	s	y	
# ::edge	phone	ARG1-of	mobile-02	p	m	
# ::edge	listen-01	instrument	phone	l	p	
# ::edge	switch-01	ARG2	listen-01	s	l	
# ::edge	switch-01	manner	click-01	s	c3	
# ::edge	click-01	ARG0	you	c3	y	
# ::edge	switch-01	rel	reject-01	s	r	
(s / switch-01
    :ARG0 (y / you)
    :ARG2 (l / listen-01
        :instrument (p / phone
            :ARG1-of (m / mobile-02)))
    :manner (c3 / click-01
        :ARG0 y)
    :rel (r / reject-01
        :ARG0 y
        :ARG1 (c2 / call-02)
        :mode imperative
        :time (c4 / come-01
            :ARG1 (c / call-02))))

