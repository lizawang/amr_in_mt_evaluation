            :ARG0 k2
            :ARG2 (b / between
                :op1 (c4 / call-02
                    :quant 2))))
    :time (p3 / place-01
        :ARG1 (c / call-02
            :ARG1-of (n / new-01))
        :location (p / phone,
            :mod (m / mobile))))

