(p4 / possible-01
    :ARG1 (p6 / press-01
        :purpose (a / and
            :op1 (h / hold-01
                :ARG1 (c2 / call-02
                    :mod (p7 / previous)))
            :op2 (p2 / pick-up-04
                :ARG1 (c3 / call-02
                    :ord (o / ordinal-entity
                        :value 2))))
        :ARG1 (k / key
            :mod (m2 / multifunction)))
    :ARG1 (u / use-01
        :ARG1 (k2 / key
            :mod (m3 / multifunction)
            :mod (d / double-tap))
