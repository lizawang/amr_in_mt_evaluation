# ::tok Chinese characters with distinctive abstract glyphs are given their own code positions, while characters with the same abstract glyph but from various sources are given a similar code position.
# ::node	c7	country	0-1
# ::node	n	name	0-1
# ::node	0	China	0-1
# ::node	c	character	1-2
# ::node	h	have-03	2-3
