# ::edge	rate-entity-91	ARG1	concentration-quantity	r	c	
# ::edge	concentration-quantity	unit	nanomolar	c	n	
# ::edge	concentration-quantity	quant	5	c	0	
(v / volume-quantity
    :condition-of (o / out-06)
    :frequency (r / rate-entity-91
        :ARG1 (c / concentration-quantity
            :quant 5
            :unit (n / nanomolar))
        :ARG2 (a / alternating-current)))

# ::tok Charging time: about 2 hours
