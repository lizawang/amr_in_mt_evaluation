    :ARG0 (y / you
        :ARG0-of (e3 / ensure-01
            :ARG1 (m / move-01
                :ARG1 (h2 / headphone)
                :polarity -)
            :manner (s / shake-01
                :ARG0 y
                :ARG1 (h / head.)
