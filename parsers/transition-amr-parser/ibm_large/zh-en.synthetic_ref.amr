# ::edge	service,	ARG0-of	have-03	s	h	
# ::edge	component	ARG1-of	follow-04	c	f	
# ::edge	have-03	ARG1	component	h	c	
(e / establish-01
    :ARG0 (a2 / and
        :mod (b / both)
        :op1 (l / law
            :name (n / name
                :op1 "People's"
                :op2 "Quality"
                :op2 "Republic"
                :op3 "Law"
                :op3 "of"))
        :op2 (l2 / law
            :name (n2 / name
                :op2 "Rights"
                :op3 "Protection"
                :op4 "Law"
                :op5 "Republic"
                :op6 "of"
                :op7 "China")
            :poss (c2 / country
                :name l)))
    :ARG1 (s / service,
        :ARG0-of (h / have-03
            :ARG1 (c / component
                :ARG1-of (f / follow-04)))
        :ARG3-of (g / guarantee-01)
        :time (a / after
            :op1 e
            :op1 (g2 / guarantee-01))))

