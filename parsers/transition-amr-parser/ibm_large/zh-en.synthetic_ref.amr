(a / and
    :op1 (t2 / turn-on-13
        :ARG0 (y / you)
        :ARG1 (t / thing
            :ARG0-of (a3 / assist-01)
            :ARG0-of (v2 / voice-01))
        :mode imperative
        :time (s2 / standby
            :domain (d / device)))
    :op2 (n / need-01
        :ARG0 d
        :ARG1 (a2 / and
            :op1 (s3 / support-01
                :ARG0 d
                :ARG1 (f2 / function-01
                    :ARG0 t
                    :ARG1 (v / voice)))
            :op2 (t3 / turn-on-13
                :ARG0 y
                :ARG1 (s / set-02
                    :ARG1 (w / wake-up-02
                        :ARG1-of (f / fast-02)))))))

# ::tok Answer the second incoming call and switch calls.
